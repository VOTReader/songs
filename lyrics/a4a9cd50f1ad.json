{"v":1,"id":"a4a9cd50f1ad","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Awake, all you churches","s":21.22,"e":25.76},{"t":"From sleep in your seats","s":25.76,"e":30.42},{"t":"Woe to those called Roman","s":31.58,"e":35.34},{"t":"Pious conceit","s":37.16,"e":39.52},{"t":"On seven hills heavy","s":40.14,"e":44.44},{"t":"With rituals you have piled","s":46.1,"e":49.98},{"t":"The dark veil secure","s":49.98,"e":53.74},{"t":"And your pagan ways are defiled","s":53.74,"e":58.9},{"t":"Awake, awake","s":62.48,"e":64.36},{"t":"All you churches of men","s":65.32,"e":68.06},{"t":"Oh, to the holly","s":70.46,"e":73.26},{"t":"On the wide path again","s":73.26,"e":77.44},{"t":"The plumb line I hold","s":79.58,"e":82.36},{"t":"It cuts the value I've sown","s":83.74,"e":87.28},{"t":"No more pretense","s":89.64,"e":91.88},{"t":"Hear the trumpet blow","s":93.6,"e":96.8},{"t":"Wait, wait","s":96.8,"e":100.28},{"t":"Listen closely, my beloved ones","s":101.72,"e":105.74},{"t":"Why do you claim my name?","s":109.68,"e":113.12},{"t":"Then plug up your ears","s":113.74,"e":116.38},{"t":"I'll beckon you close, beloved","s":118.12,"e":121.42},{"t":"But who has drawn near","s":122.74,"e":125.48},{"t":"The volumes of truth","s":127.16,"e":129.82},{"t":"My testament true","s":132.16,"e":135.1},{"t":"You're locked in walls you have built","s":136.34,"e":139.44},{"t":"I'll break down to get through","s":141.22,"e":144.24},{"t":"Awake, awake","s":148.12,"e":149.9},{"t":"All you churches of men","s":150.54,"e":153.52},{"t":"Your daughters","s":156.96,"e":158.96},{"t":"Tread the wide path again","s":160.24,"e":162.96},{"t":"The plumb line I hold","s":165.26,"e":167.8},{"t":"Cuts the veil you have sewn","s":169.68,"e":172.66},{"t":"No more of your show","s":174.7,"e":177.3},{"t":"Stand before the throne","s":178.92,"e":182.12},{"t":"Away, away","s":182.74,"e":185.74},{"t":"Harden not your heart","s":188.88,"e":191.74},{"t":"I am the Lord","s":199.84,"e":202.08},{"t":"Who spoke calm to the storm","s":202.08,"e":205.56},{"t":"Your walls are void of my spirit","s":206.98,"e":210.34},{"t":"Your pump is without form","s":212.0,"e":215.0},{"t":"I'm not first in you","s":216.7,"e":219.62},{"t":"I see straight through your heart","s":219.62,"e":224.36},{"t":"Oh, if you slumber","s":224.36,"e":229.38},{"t":"How will you depart?","s":229.38,"e":233.42},{"t":"Wake all you churches","s":247.2,"e":253.04},{"t":"Let's sing.","s":282.94,"e":283.0},{"t":"Hear the trumpet call of God.","s":283.04,"e":289.64}],"match":null}
