{"v":1,"id":"a4a9cd50f1ad","synced":true,"offset":0,"source":"suno","lines":[{"t":"Awake, all you churches,","s":20.16,"e":28.47},{"t":"From sleep in your seats.","s":28.52,"e":32.73},{"t":"Woe to those called Roman,","s":32.75,"e":38.38},{"t":"Pious conceits.","s":38.44,"e":42.68},{"t":"On seven hills heavy,","s":42.79,"e":47.46},{"t":"With rituals you have piled -","s":47.51,"e":52.24},{"t":"The dark veil secure,","s":52.27,"e":55.46},{"t":"And your pagan ways are defiled.","s":55.5,"e":63.24},{"t":"Awake... awake, all you churches of men,","s":63.32,"e":71.59},{"t":"Woe to the harlot, on the wide path again.","s":71.61,"e":80.76},{"t":"The plumb line I hold, cuts the veil you have sewn,","s":80.8,"e":90.88},{"t":"No more pretense. hear the trumpet blow.","s":90.94,"e":100.17},{"t":"( Awake... awake...)","s":96.61,"e":103.07},{"t":"listen closely , my beloved ones.","s":103.14,"e":110.85},{"t":"Why do you claim My name,","s":110.87,"e":114.2},{"t":"Then plug up your ears?","s":114.25,"e":118.99},{"t":"I beckon you close, beloved,","s":119.09,"e":123.56},{"t":"But who has drawn near?","s":123.61,"e":128.27},{"t":"The Volumes of Truth","s":128.35,"e":133.14},{"t":"My testament true-","s":133.22,"e":137.07},{"t":"You're locked in walls you have built.","s":137.09,"e":142.13},{"t":"I'll break down to get through","s":142.15,"e":148.76},{"t":"Awake... awake, all you churches of men,","s":148.83,"e":157.74},{"t":"Your daughters tread the wide path again.","s":157.84,"e":166.18},{"t":"The plumb line I hold, cuts the veil you have sewn,","s":166.23,"e":175.9},{"t":"No more of your show. stand before the throne.","s":175.98,"e":182.32},{"t":"( Awake..... awake.....)","s":181.9,"e":189.39},{"t":"Harden not your hearts..","s":189.45,"e":200.87},{"t":"I am The Lord,","s":200.89,"e":203.39},{"t":"Who spoke calm to the storm.","s":203.4,"e":208.02},{"t":"Your walls are void of My Spirit,","s":208.09,"e":212.98},{"t":"Your pomp is without form.","s":213.03,"e":217.53},{"t":"I'm not first in you,","s":217.55,"e":220.46},{"t":"(Not first!)","s":219.57,"e":222.39},{"t":"I see straight through your heart. (Not first!)","s":222.5,"e":227.8},{"t":"Woe... if you slumber, (Not first!)","s":227.9,"e":232.09},{"t":"How will you depart!?","s":232.14,"e":234.24},{"t":"[Outro]","s":233.08,"e":234.92},{"t":"( Awake all you churches... (awake...)","s":234.33,"e":258.37},{"t":"Harden not your hearts...","s":258.46,"e":265.81},{"t":"( Hear the trumpet call of God. Hear the trumpet call of God)","s":261.45,"e":289.92}],"match":null}
