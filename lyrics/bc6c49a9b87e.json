{"v":1,"id":"bc6c49a9b87e","synced":true,"offset":0,"source":"suno","lines":[{"t":"Verse 1","s":9.81,"e":9.97},{"t":"From the dark, You spoke the light,","s":9.99,"e":14.22},{"t":"Stars awakened in the night.","s":14.31,"e":18.75},{"t":"Oceans formed at Your command,","s":18.83,"e":23.21},{"t":"Mountains rising from Your hand.","s":23.28,"e":28.07},{"t":"Chorus","s":28.1,"e":28.24},{"t":"Maker of it all—earth, sea, and sky,","s":28.35,"e":33.06},{"t":"Every living thing, You gave them life.","s":33.09,"e":37.04},{"t":"With every breath, creation calls","s":37.13,"e":41.65},{"t":"Praise to You, the Maker of it all.","s":41.7,"e":44.94},{"t":"Verse 2","s":45.03,"e":54.65},{"t":"Fields of green and rivers wide,","s":54.69,"e":59.13},{"t":"Gentle rain and morning tide.","s":59.22,"e":63.32},{"t":"From flower’s bloom to eagle’s flight,","s":63.37,"e":68.35},{"t":"Every wonder shows Your might.","s":68.4,"e":71.11},{"t":"Chorus","s":71.2,"e":73.09},{"t":"Maker of it all—earth, sea, and sky,","s":73.19,"e":77.98},{"t":"Every living thing, You gave them life.","s":78.01,"e":81.88},{"t":"With every breath, creation calls","s":81.97,"e":86.49},{"t":"Praise to You, the Maker of it all.","s":86.56,"e":97.44},{"t":"Verse 2","s":97.53,"e":99.49},{"t":"Fields of green and rivers wide,","s":99.53,"e":102.3},{"t":"Gentle rain and morning tide.","s":102.39,"e":108.26},{"t":"From flower’s bloom to eagle’s flight,","s":108.32,"e":113.27},{"t":"Every wonder shows Your might.","s":113.32,"e":117.83},{"t":"Chorus","s":117.86,"e":118.01},{"t":"Maker of it all—earth, sea, and sky,","s":118.11,"e":122.82},{"t":"Every living thing, You gave them life.","s":122.85,"e":126.8},{"t":"With every breath, creation calls","s":126.89,"e":131.41},{"t":"Praise to You, the Maker of it all.","s":131.46,"e":134.54},{"t":"Bridge","s":134.63,"e":135.4},{"t":"All the creatures great and small,","s":135.51,"e":140.24},{"t":"Every detail, seen by all—","s":140.29,"e":144.14},{"t":"From Eden’s dawn to world’s embrace,","s":144.19,"e":148.11},{"t":"Creation echoes all Your grace.","s":148.2,"e":152.9},{"t":"Final Chorus","s":152.99,"e":154.15},{"t":"Maker of it all—earth, sea, and sky,","s":154.2,"e":158.04},{"t":"With grateful hearts, we lift our eyes.","s":158.11,"e":161.75},{"t":"Forever let creation call","s":161.85,"e":167.31},{"t":"Praise to You, the Maker of it all.","s":167.38,"e":170.9}],"match":null}
