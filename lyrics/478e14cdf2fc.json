{"v":1,"id":"478e14cdf2fc","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I woke up to a voice calling me home","s":17.76,"e":26.04},{"t":"Heartbeatin' strong","s":28.86,"e":30.16},{"t":"This journey's my own","s":32.2,"e":34.82},{"t":"Shadows fade","s":38.06,"e":39.46},{"t":"The light breaks through","s":39.46,"e":42.3},{"t":"I see his arms","s":43.88,"e":46.12},{"t":"Reaching out for you","s":46.12,"e":48.22},{"t":"Waiting a lifetime just to step on through","s":56.32,"e":60.84},{"t":"Now I'm standing in a place where everything is new","s":62.54,"e":67.9},{"t":"I'm one of the lucky few","s":74.36,"e":77.52},{"t":"Carried past the darkness","s":79.5,"e":82.02},{"t":"Door closed tight","s":83.96,"e":86.38},{"t":"In a room full of laughter and love tonight","s":86.38,"e":92.12},{"t":"Got my coat of white","s":92.12,"e":95.86},{"t":"Song in my chest","s":97.6,"e":99.94},{"t":"Ain't no fear in this rest","s":100.5,"e":104.7},{"t":"Valleys rise and old wounds heal","s":112.26,"e":116.64},{"t":"Mountains crumble, peace becomes real","s":118.74,"e":123.74},{"t":"Looking in his eyes, all sorrow's gone","s":132.48,"e":135.94},{"t":"Ain't nothing left but a hope so strong","s":135.94,"e":142.44},{"t":"It takes every tear that I ever knew","s":142.98,"e":152.72},{"t":"Turns it into joy","s":152.72,"e":156.58},{"t":"I'm finally through","s":156.58,"e":159.64},{"t":"But I can't forget those walking along","s":168.08,"e":171.76},{"t":"Holding out, not answering the call","s":173.9,"e":178.18},{"t":"They're stuck in the struggle, refined by the fire","s":186.54,"e":191.68},{"t":"Waiting on a rain","s":193.9,"e":196.26},{"t":"That might never fall","s":197.24,"e":201.08},{"t":"Crops looking sparse","s":202.78,"e":204.98},{"t":"But hope remains","s":204.98,"e":207.16},{"t":"Someday they'll reach out","s":209.36,"e":212.28},{"t":"Through pain","s":213.34,"e":213.96},{"t":"Now I'm gathered in his embrace","s":221.68,"e":225.32},{"t":"Warm light on my face","s":226.8,"e":230.14},{"t":"No more losing, no more tears","s":230.14,"e":235.04},{"t":"Just a blues man smiling through the years","s":235.6,"e":241.16},{"t":"Thanks for watching!","s":257.1,"e":259.42}],"match":null}
