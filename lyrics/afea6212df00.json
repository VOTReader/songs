{"v":1,"id":"afea6212df00","synced":false,"offset":null,"source":"whisper","lines":[{"t":"In the land of sorrow","s":26.14,"e":28.78},{"t":"Oh, ashes on the ground","s":28.78,"e":31.68},{"t":"A faithful man was tested","s":31.68,"e":34.82},{"t":"The silence was profound","s":34.82,"e":38.0},{"t":"Riches turned to ruin","s":38.0,"e":40.86},{"t":"Friends turned into doubt","s":40.86,"e":43.74},{"t":"Still you whispered softly","s":43.74,"e":46.76},{"t":"I will not curse or shout","s":46.76,"e":50.14},{"t":"The storm rolled in","s":50.14,"e":53.0},{"t":"The thunder cried","s":53.0,"e":55.62},{"t":"But hope was burning deep inside","s":55.62,"e":60.54},{"t":"Though the sky falls down","s":62.18,"e":65.2},{"t":"And the night grows cold","s":65.2,"e":68.38},{"t":"Still my heart will stand","s":68.38,"e":71.1},{"t":"Still my soul will hold","s":71.1,"e":74.22},{"t":"You give and take away","s":74.22,"e":76.82},{"t":"But my faith remains","s":77.58,"e":79.96},{"t":"Through dust and pain","s":80.7,"e":83.1},{"t":"Your truth sustains","s":83.1,"e":86.26},{"t":"Questions fill the heavens","s":97.82,"e":100.86},{"t":"Cries fill the air","s":100.86,"e":103.64},{"t":"Why must the righteous suffer?","s":104.22,"e":106.74},{"t":"Does heaven even care?","s":107.6,"e":109.76},{"t":"But then came the voice from the whirlwind's flame","s":109.76,"e":115.88},{"t":"Were you there when I made the stars by name?","s":115.88,"e":122.16},{"t":"The mountains bow, the sea reply","s":122.58,"e":127.42},{"t":"And you'll be held the great most high","s":127.42,"e":132.76},{"t":"Though the sky falls down","s":134.08,"e":137.22},{"t":"And the night grows cold","s":137.8,"e":140.34},{"t":"Still my heart will stand","s":140.34,"e":143.08},{"t":"Still my soul will hold","s":143.08,"e":146.18},{"t":"You give and take away","s":146.18,"e":148.78},{"t":"But my faith remains","s":149.6,"e":151.9},{"t":"Through dust and pain","s":152.74,"e":155.1},{"t":"Your truth sustains","s":155.62,"e":158.18},{"t":"Now I see with open eyes","s":158.18,"e":162.88},{"t":"Your purpose shining through the sky","s":163.58,"e":168.74},{"t":"The end restored, the soul refined","s":169.62,"e":174.5},{"t":"Your mercy endless, your power divine","s":174.5,"e":180.9},{"t":"Though the sky falls down","s":181.86,"e":185.2},{"t":"And the night grows cold","s":185.2,"e":188.28},{"t":"Still my heart will stand","s":188.78,"e":191.1},{"t":"Still my soul will hold","s":191.1,"e":194.2},{"t":"You give and take away","s":194.2,"e":196.72},{"t":"But I'll still proclaim","s":197.54,"e":199.8},{"t":"Forever you are holy","s":200.38,"e":203.6},{"t":"Forever the same","s":203.6,"e":206.5},{"t":"In the ashes I've seen your face","s":207.08,"e":213.72},{"t":"My Redeemer lives","s":218.96,"e":222.7},{"t":"My heart finds grace","s":223.52,"e":225.8},{"t":"We'll be right back.","s":254.9,"e":254.96},{"t":"Thank you for watching!","s":281.28,"e":286.44}],"match":null}
