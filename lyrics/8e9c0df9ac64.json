{"v":1,"id":"8e9c0df9ac64","synced":true,"offset":0,"source":"suno","lines":[{"t":"The heavens split, the sky ignites,","s":22.2,"e":25.75},{"t":"A white horse cuts through fierce and might.","s":25.87,"e":29.45},{"t":"Eyes like flame, the earth stands still,","s":29.51,"e":32.79},{"t":"The King advances by His will.","s":32.85,"e":36.99},{"t":"many crowns upon His head,","s":37.08,"e":39.88},{"t":"A name unknown, a path of dread.","s":39.99,"e":43.59},{"t":"Faithful, True - He rides ahead","s":43.66,"e":50.43},{"t":"The ground shakes hard beneath His feet,","s":50.49,"e":54.21},{"t":"Justice rolls with thunder’s beat.","s":54.3,"e":57.75},{"t":"Nations cut through with the sword,","s":57.87,"e":60.58},{"t":"All creation will know the Lord.","s":60.66,"e":63.32},{"t":"(Chorus)","s":62.87,"e":65.25},{"t":"He rides to war,","s":65.31,"e":67.2},{"t":"In righteous flame,","s":67.28,"e":68.82},{"t":"The Word of God","s":68.92,"e":70.87},{"t":"Eternal Name!","s":70.96,"e":72.76},{"t":"King of kings!","s":72.83,"e":74.46},{"t":"Lord of lords!","s":74.54,"e":75.82},{"t":"The nations fall","s":75.9,"e":79.65},{"t":"Before His sword!","s":79.72,"e":94.39},{"t":"(Verse 2)","s":80.46,"e":94.58},{"t":"The armies follow, clothed in white,","s":94.6,"e":98.3},{"t":"Pure and ready for the fight.","s":98.37,"e":101.86},{"t":"He speaks once, His truth cuts deep,","s":101.96,"e":105.31},{"t":"Kings grow silent, strongholds weep.","s":105.37,"e":108.96},{"t":"From His mouth the sword goes forth,","s":109.01,"e":112.32},{"t":"Judgment burns from south to north.","s":112.36,"e":115.95},{"t":"No throne stands, no crown remains,","s":116.03,"e":119.02},{"t":"When He steps onto the plain.","s":119.05,"e":121.18},{"t":"(Pre-Chorus)","s":120.87,"e":122.83},{"t":"The winepress waits, the hour near,","s":122.88,"e":126.53},{"t":"Time is at hand, not ruled by fear.","s":126.58,"e":129.84},{"t":"He does not fail, He does not stall,","s":129.91,"e":132.99},{"t":"The true King now calls it all.","s":133.03,"e":137.69},{"t":"He rides to war,","s":137.79,"e":139.36},{"t":"In righteous flame,","s":139.46,"e":141.16},{"t":"The Word of God","s":141.24,"e":143.16},{"t":"Eternal Name!","s":143.25,"e":145.1},{"t":"King of kings!","s":145.15,"e":146.81},{"t":"Lord of lords!","s":146.88,"e":148.11},{"t":"The nations fall","s":148.19,"e":151.94},{"t":"Before His sword!","s":152.0,"e":166.18},{"t":"Trumpets cry,","s":166.2,"e":169.33},{"t":"Lightening collide!","s":169.41,"e":173.28},{"t":"Heaven’s host at His side!","s":173.33,"e":180.27},{"t":"Steel and fire, truth and might,","s":180.32,"e":187.07},{"t":"He rules the age, He wins the fight!","s":187.18,"e":195.94},{"t":"He rides to war!","s":196.04,"e":197.6},{"t":"No rival stands!","s":197.71,"e":199.41},{"t":"The world is judged","s":199.49,"e":201.09},{"t":"By nail-pierced hands!","s":201.2,"e":203.35},{"t":"King of kings!","s":203.4,"e":204.99},{"t":"Lord of lords!","s":205.07,"e":206.77},{"t":"All bow down","s":206.87,"e":210.18},{"t":"Before the Lord!","s":210.25,"e":213.32},{"t":"(Outro)","s":211.0,"e":224.58},{"t":"On His robe, on His thigh,","s":224.64,"e":227.98},{"t":"Written across the burning night:","s":228.07,"e":231.53},{"t":"KING OF KINGS — LORD OF LORDS","s":231.58,"e":236.43}],"match":null}
