{"v":1,"id":"ac959181ab06","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Thank you very much.","s":16.78,"e":27.66},{"t":"You are more than the filth that covers you","s":31.36,"e":35.62},{"t":"More than the sin that fills you","s":41.0,"e":44.94},{"t":"Much more than the choices you make","s":48.52,"e":52.44},{"t":"For I see your beauty","s":56.72,"e":59.16},{"t":"I know your heart","s":59.68,"e":60.98},{"t":"And the love which you have for me","s":60.98,"e":63.96},{"t":"Behold","s":67.5,"e":68.28},{"t":"I know you as you are","s":72.34,"e":75.96},{"t":"And will be with me where I am","s":77.48,"e":84.0},{"t":"You are not that which you choose","s":117.4,"e":120.74},{"t":"In a moment of weakness","s":121.48,"e":124.12},{"t":"You are that which I have created","s":124.7,"e":128.38},{"t":"And will become that which I restore","s":129.58,"e":135.08},{"t":"And will remain always","s":137.64,"e":143.32},{"t":"A beautiful finished work","s":144.36,"e":147.82},{"t":"Elect and precious","s":148.36,"e":151.0},{"t":"My everlasting treasure","s":155.8,"e":159.42},{"t":"Even as I shall be Yours also For I know my own, says the Lord","s":161.58,"e":183.48},{"t":"Thank you.","s":197.6,"e":199.0},{"t":"you","s":219.42,"e":219.86}],"match":{"letter":"wtlb1:elect-and-precious","score":0.938}}
