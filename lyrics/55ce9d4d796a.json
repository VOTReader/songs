{"v":1,"id":"55ce9d4d796a","synced":true,"offset":0,"source":"suno","lines":[{"t":"You think the fight is in desires,","s":0.24,"e":6.3},{"t":"in the pull you feel inside…","s":6.38,"e":11.95},{"t":"but the real temptation whispers","s":12.01,"e":17.47},{"t":"you should handle this alone tonight.","s":17.55,"e":23.72},{"t":"Independence is labeled strength,","s":23.75,"e":28.32},{"t":"you call on courage to endure,","s":28.4,"e":33.81},{"t":"but I never asked you to be fearless...","s":33.87,"e":40.13},{"t":"only close, only secure.","s":40.21,"e":42.16},{"t":"Every intent that makes for distance,","s":42.18,"e":51.66},{"t":"every time you brace for space,","s":51.7,"e":56.95},{"t":"Each transgression simply highlights","s":57.02,"e":62.89},{"t":"you forgot My embrace.","s":62.99,"e":67.6},{"t":"Stay with Me.","s":67.64,"e":72.0},{"t":"That’s what obedience has been.","s":72.03,"e":77.71},{"t":"Not proving you’re enough,","s":77.79,"e":79.79},{"t":"just locking in.","s":79.87,"e":83.75},{"t":"Every trial is a chance","s":83.8,"e":85.93},{"t":"to stop, and look to Me.","s":86.05,"e":87.95},{"t":"Don’t fight alone.","s":87.97,"e":89.47},{"t":"No! Stay with Me.","s":89.57,"e":94.28},{"t":"I see the moment pressure rises,","s":94.3,"e":100.34},{"t":"when the old resolve kicks in…","s":100.39,"e":102.35},{"t":"you start assembling your answers,","s":102.41,"e":111.47},{"t":"trying not to need Me then.","s":111.57,"e":116.01},{"t":"But child, the way through every trial","s":116.09,"e":121.52},{"t":"is never you alone, outpacing fear...","s":121.68,"e":128.36},{"t":"It was always us together,","s":128.41,"e":133.69},{"t":"step by step, right here.","s":133.74,"e":139.33},{"t":"What you call temptation’s voice","s":139.34,"e":145.13},{"t":"is calling for lonely strife.","s":145.25,"e":149.92},{"t":"But My Spirit quiet, in your heart...","s":150.0,"e":155.8},{"t":"Says “Let Me empower your life.”","s":155.85,"e":160.77},{"t":"Chorus]","s":160.8,"e":161.03},{"t":"Stay with Me.","s":161.12,"e":162.38},{"t":"That’s what obedience has been.","s":162.4,"e":171.14},{"t":"Not proving you’re enough,","s":171.22,"e":173.22},{"t":"just locking in.","s":173.3,"e":177.18},{"t":"Every trial is a chance","s":177.23,"e":179.36},{"t":"to stop, and look to Me.","s":179.48,"e":181.38},{"t":"Don’t fight alone.","s":181.4,"e":182.9},{"t":"No! Stay with Me.","s":183.01,"e":185.55},{"t":"The days ahead will test your footing,","s":185.57,"e":191.25},{"t":"not testing worth, nor what I see…","s":191.33,"e":194.42},{"t":"You won’t survive by standing stronger...","s":194.48,"e":201.98},{"t":"you’ll endure by leaning on Me.","s":201.99,"e":206.38},{"t":"When the weight feels impossible,","s":206.43,"e":209.06},{"t":"human wisdom runs thin and small,","s":209.15,"e":212.37},{"t":"Remember this before you wonder:","s":212.42,"e":214.75},{"t":"I have already carried it all.","s":214.87,"e":217.04},{"t":"Chorus]","s":217.13,"e":218.15},{"t":"Stay with Me.","s":218.25,"e":223.98},{"t":"That’s what obedience has been.","s":223.99,"e":229.69},{"t":"Not proving you’re enough,","s":229.75,"e":231.64},{"t":"just locking in.","s":231.73,"e":235.74},{"t":"Every trial is a chance","s":235.8,"e":237.95},{"t":"to stop, and look to Me.","s":238.06,"e":239.94},{"t":"Don’t fight alone.","s":239.96,"e":241.46},{"t":"No! Stay with Me.","s":241.57,"e":247.22},{"t":"This is how you’re kept.","s":247.23,"e":252.81},{"t":"This is how you stand.","s":252.86,"e":264.67},{"t":"Not alone. No!","s":264.77,"e":277.99},{"t":"Never alone.","s":278.09,"e":279.97}],"match":null}
