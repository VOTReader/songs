{"v":1,"id":"83134941bf33","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 1)","s":5.85,"e":12.63},{"t":"The love of man fades with the tide,","s":12.65,"e":15.82},{"t":"Chasing warmth where truth can’t hide.","s":15.9,"e":18.94},{"t":"Empty hearts that reach for more,","s":19.04,"e":22.35},{"t":"Still aching, still unsure.","s":22.41,"e":24.69},{"t":"But then You breathe into my bones,","s":24.74,"e":28.17},{"t":"Turn the silence into home.","s":28.23,"e":31.14},{"t":"All I lost, You make it right,","s":31.22,"e":34.65},{"t":"Your voice, my dawn, my light.","s":34.73,"e":38.35},{"t":"(Chorus)","s":38.02,"e":41.99},{"t":"Your light in the hollow,","s":42.07,"e":45.39},{"t":"Fills what was gone.","s":45.44,"e":48.13},{"t":"Your mercy is endless,","s":48.21,"e":51.56},{"t":"Your love is strong.","s":51.64,"e":54.28},{"t":"From ashes You call me,","s":54.36,"e":57.65},{"t":"To rise again —","s":57.76,"e":60.46},{"t":"Unconditional,","s":60.56,"e":62.28},{"t":"You wash me clean of sin.","s":62.38,"e":65.64},{"t":"(Verse 2)","s":65.26,"e":77.06},{"t":"The world taught me love was pain,","s":77.1,"e":80.22},{"t":"Promises built on the rain.","s":80.3,"e":82.9},{"t":"But You, oh Lord, are something more,","s":82.96,"e":86.15},{"t":"A steady flame my heart adores.","s":86.27,"e":89.08},{"t":"You warm the coldest part of me,","s":89.13,"e":92.06},{"t":"Your presence sets this captive free.","s":92.11,"e":95.58},{"t":"In Your peace, I lay my fight,","s":95.63,"e":97.65},{"t":"In Your truth, I find my life.","s":97.71,"e":100.58},{"t":"(Chorus)","s":99.14,"e":103.27},{"t":"Your light in the hollow,","s":103.35,"e":106.65},{"t":"Fills what was gone.","s":106.68,"e":109.33},{"t":"Your mercy is endless,","s":109.41,"e":112.76},{"t":"Your love is strong.","s":112.84,"e":115.47},{"t":"From ashes You call me,","s":115.55,"e":118.93},{"t":"To rise again —","s":119.04,"e":121.66},{"t":"Unconditional,","s":121.76,"e":123.47},{"t":"You wash me clean of sin.","s":123.57,"e":126.54},{"t":"(Bridge)","s":126.38,"e":127.87},{"t":"If I must die, let it be to live,","s":127.89,"e":130.87},{"t":"To know the depths of love You give.","s":130.95,"e":133.45},{"t":"No greater joy than to be near,","s":133.56,"e":136.48},{"t":"You whisper, “Child, I’m here.”","s":136.58,"e":138.43},{"t":"(Final Chorus)","s":138.25,"e":142.92},{"t":"Your light in the hollow,","s":143.0,"e":146.36},{"t":"Breaks every chain.","s":146.45,"e":148.92},{"t":"Your mercy forever,","s":149.02,"e":152.36},{"t":"It calls my name.","s":152.47,"e":155.05},{"t":"YahuShua, my refuge,","s":155.13,"e":158.48},{"t":"My soul redeemed —","s":158.56,"e":161.23},{"t":"Unconditional love,","s":161.33,"e":163.76},{"t":"Forever You’ll be.","s":163.86,"e":166.46}],"match":null}
