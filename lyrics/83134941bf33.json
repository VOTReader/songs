{"v":1,"id":"83134941bf33","synced":false,"offset":null,"source":"whisper","lines":[{"t":"The Love of Man","s":29.88,"e":29.98},{"t":"All I lost, you make it right","s":30.0,"e":33.28},{"t":"Your voice, my dawn, my light","s":33.28,"e":38.74},{"t":"Your light in the hollow fills what was gone","s":40.7,"e":46.98},{"t":"Your mercy is endless, your love is strong","s":46.98,"e":52.96},{"t":"From ashes you call me to rise again","s":52.96,"e":58.98},{"t":"Again, unconditional, you wash me clean of sin","s":58.98,"e":65.22},{"t":"The world taught me love was pain","s":75.32,"e":79.26},{"t":"Promises built on the rain","s":79.26,"e":82.32},{"t":"But you, oh Lord, are something more","s":82.32,"e":85.42},{"t":"A steady flame my heart adores","s":85.42,"e":88.6},{"t":"You warm the coldest part of me","s":88.6,"e":91.44},{"t":"Your presence sets this captive free","s":91.44,"e":94.52},{"t":"In your peace I lay my fight","s":94.52,"e":97.7},{"t":"In your truth I find my life","s":97.7,"e":101.42},{"t":"Your light in the hollow","s":102.3,"e":105.5},{"t":"Fills what was gone","s":105.5,"e":108.16},{"t":"Your mercy is endless","s":108.16,"e":111.8},{"t":"Your love is strong","s":111.8,"e":114.18},{"t":"From ashes you call me","s":114.74,"e":117.96},{"t":"To rise again","s":117.96,"e":120.22},{"t":"Unconditional","s":121.74,"e":122.62},{"t":"You wash me clean of sin","s":122.62,"e":126.4},{"t":"If I must die, let it be to live","s":127.28,"e":129.76},{"t":"To know the depths of love","s":130.3,"e":132.02},{"t":"You give no greater joy than to be near","s":132.02,"e":135.74},{"t":"You whisper, shout, I'm here","s":135.74,"e":138.68},{"t":"You're lying in the hollow","s":141.94,"e":145.16},{"t":"Breaks every chain","s":145.16,"e":147.78},{"t":"Your mercy forever","s":147.78,"e":150.76},{"t":"It calls my name","s":151.46,"e":154.02},{"t":"Yeah, who'll shield my refuge","s":154.02,"e":157.46},{"t":"My soul redeemed","s":157.46,"e":160.08},{"t":"Unconditional love","s":160.08,"e":162.94},{"t":"Forever you'll be","s":162.94,"e":165.86},{"t":"Thanks for watching!","s":186.52,"e":190.68}],"match":null}
