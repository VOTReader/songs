{"v":1,"id":"505215c0a9a9","synced":true,"offset":0,"source":"suno","lines":[{"t":"My child, in my embrace…","s":25.93,"e":31.28},{"t":"Trembling as though lost to Me.","s":31.36,"e":38.48},{"t":"You fear the fire","s":38.58,"e":43.01},{"t":"as if it burned your destiny.","s":43.12,"e":50.55},{"t":"But hear Me now...","s":50.62,"e":55.31},{"t":"I am the Judge of earth and sky,","s":55.37,"e":61.58},{"t":"yet I kept you in Salvation...","s":61.64,"e":67.78},{"t":"even when you cherished lies..","s":67.85,"e":73.59},{"t":"Discipline is not rejection;","s":73.6,"e":79.95},{"t":"Refinement bears My name.","s":80.03,"e":85.99},{"t":"You were not cast away...","s":86.05,"e":92.49},{"t":"I called through the flame.","s":92.55,"e":98.41},{"t":"You were always Mine...","s":98.43,"e":103.52},{"t":"no one could steal you from My hand.","s":103.58,"e":110.64},{"t":"You were always Mine...","s":110.7,"e":115.7},{"t":"your story written as I planned.","s":115.76,"e":121.7},{"t":"Not doomed to wrath,","s":121.8,"e":123.13},{"t":"not turned aside,","s":123.23,"e":125.59},{"t":"but held in love through trials.","s":125.66,"e":128.92},{"t":"You were always Mine…","s":128.98,"e":134.74},{"t":"and nothing breaks the line.","s":134.8,"e":141.44},{"t":"I searched your heart...","s":141.48,"e":146.87},{"t":"I knew what veiled your sight.","s":146.97,"e":153.55},{"t":"I saw the pride","s":153.67,"e":158.54},{"t":"That dimmed My living light.","s":158.64,"e":165.2},{"t":"So I must refine you...","s":165.26,"e":170.55},{"t":"Not as beasts that roam alone...","s":170.59,"e":176.33},{"t":"but as the sheep of My promise,","s":176.38,"e":182.57},{"t":"You're one I vowed to own.","s":182.59,"e":188.17},{"t":"The lost may be left to wander;","s":188.19,"e":194.36},{"t":"But redeemed are carried through.","s":194.44,"e":200.68},{"t":"You fear you’d slipped away...","s":200.78,"e":205.37},{"t":"but child, that fear was never true.","s":205.43,"e":212.99},{"t":"You were always Mine...","s":213.0,"e":218.01},{"t":"no one could steal you from My hand.","s":218.07,"e":220.49},{"t":"You were always Mine...","s":220.53,"e":229.84},{"t":"your story written as I planned.","s":229.91,"e":235.77},{"t":"Not doomed to wrath,","s":235.85,"e":237.15},{"t":"not turned aside,","s":237.25,"e":239.52},{"t":"but held in love through trials.","s":239.6,"e":242.69},{"t":"You were always Mine…","s":242.75,"e":248.36},{"t":"and nothing breaks the line.","s":248.42,"e":253.82},{"t":"When you fall, I am beside you.","s":253.84,"e":259.68},{"t":"When you hide, I still pursue.","s":259.72,"e":265.32},{"t":"If trumpet leaves you for next harvest,","s":265.43,"e":271.7},{"t":"My vow still covers you.","s":271.81,"e":277.79},{"t":"Refinement is My kindness...","s":277.85,"e":283.48},{"t":"its fire proves My claim.","s":283.56,"e":289.88},{"t":"Only My true children","s":289.98,"e":294.89},{"t":"are corrected in My name.","s":295.0,"e":301.46},{"t":"You are always Mine...","s":301.47,"e":306.36},{"t":"your place with Me was never shaken.","s":306.41,"e":313.22},{"t":"You are always Mine...","s":313.28,"e":318.14},{"t":"My covenant cannot be taken.","s":318.21,"e":325.29},{"t":"So rise, beloved…","s":325.37,"e":328.47},{"t":"lift your eyes..","s":328.53,"e":329.86},{"t":"the chosen never are denied.","s":329.9,"e":336.46},{"t":"You are always Mine…","s":336.54,"e":342.37},{"t":"Now and for all time.","s":342.45,"e":348.17},{"t":"Rest now in My promise...","s":348.2,"e":353.64},{"t":"salvation sealed and divine.","s":353.72,"e":358.64},{"t":"Walk forward in My refining…","s":358.72,"e":364.97},{"t":"My child, you’re wholly Mine.","s":365.08,"e":372.49},{"t":"... always mine.","s":366.89,"e":373.56}],"match":null}
