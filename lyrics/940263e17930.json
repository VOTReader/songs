{"v":1,"id":"940263e17930","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Yahushua is my shepherd, I shall not want","s":14.18,"e":22.84},{"t":"He makes me lie down in green pastures","s":25.92,"e":32.74},{"t":"He leads me beside still waters","s":32.74,"e":37.14},{"t":"He restores my soul","s":37.7,"e":41.44},{"t":"He leads me in paths of righteousness","s":43.74,"e":47.38},{"t":"For His name's sake","s":49.44,"e":52.42},{"t":"Yeah, though I walk through the valley of the shadow","s":53.0,"e":58.94},{"t":"Of death I will fear no evil","s":58.94,"e":64.32},{"t":"For You are with me","s":65.9,"e":69.36},{"t":"Your rod and Your staff, they comfort me","s":70.94,"e":75.08},{"t":"Yahushua is my shepherd","s":81.92,"e":86.38},{"t":"I shall not walk","s":86.38,"e":89.64},{"t":"Yahushua is my shepherd","s":95.52,"e":99.58},{"t":"I shall not walk","s":99.58,"e":103.14},{"t":"You prepare a table","s":112.24,"e":116.88},{"t":"Before me in the presence","s":116.88,"e":120.6},{"t":"Of my enemies","s":120.6,"e":123.4},{"t":"me. You anoint my head with oil. My cup runs over. Surely goodness and mercy shall follow me","s":123.4,"e":147.62},{"t":"All the days of my life","s":147.62,"e":151.34},{"t":"And I will dwell","s":151.34,"e":156.32},{"t":"In the house of Yahushua","s":157.96,"e":162.82},{"t":"Forever","s":163.34,"e":164.12},{"t":"Yahushua is my shepherd","s":169.72,"e":174.24},{"t":"I shall not walk","s":174.24,"e":177.5},{"t":"Yahushua is my shepherd","s":182.52,"e":187.7},{"t":"I shall not walk","s":187.7,"e":191.0},{"t":"Yahushua is my shepherd","s":196.72,"e":201.22},{"t":"I shall not walk","s":201.22,"e":204.56},{"t":"Yahushua is my shepherd","s":210.4,"e":214.52},{"t":"I shall not walk","s":215.22,"e":218.32},{"t":"Thank you.","s":232.94,"e":234.34}],"match":{"letter":"wtlb1:a-psalm-of-david","score":0.84}}
