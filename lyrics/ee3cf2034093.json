{"v":1,"id":"ee3cf2034093","synced":true,"offset":0,"source":"suno","lines":[{"t":"I Begin again in You,","s":13.16,"e":16.72},{"t":"You've not left me behind.","s":16.76,"e":20.17},{"t":"You are with me even now,","s":20.23,"e":23.64},{"t":"to the end of time.","s":23.75,"e":27.09},{"t":"I'm Your forgiven child,","s":27.13,"e":30.59},{"t":"no records left to keep...","s":30.69,"e":34.41},{"t":"Carrying no memory of the things","s":34.47,"e":37.1},{"t":"I rehearsed in my sleep.","s":37.26,"e":38.8},{"t":"So I begin again in You.","s":38.81,"e":44.04},{"t":"I lift my eyes, I turn my view.","s":44.12,"e":47.43},{"t":"I won’t keep count of what You don’t...","s":47.55,"e":51.28},{"t":"I begin again in You.","s":51.38,"e":54.46},{"t":"Even what is yet to come","s":54.49,"e":57.61},{"t":"You washed before it surfaced.","s":57.71,"e":61.12},{"t":"So I will stop rehearsing sin","s":61.2,"e":64.39},{"t":"and fix my eyes on grace.","s":64.47,"e":68.02},{"t":"I give temptation no thought,","s":68.14,"e":69.59},{"t":"the accuser fades from view...","s":69.61,"e":74.94},{"t":"I turn aside and come,","s":75.0,"e":78.55},{"t":"I come to You.","s":78.67,"e":81.66},{"t":"So I begin again in You.","s":81.67,"e":85.09},{"t":"I lift my eyes, I turn my view.","s":85.21,"e":88.52},{"t":"I won’t keep count of what You don’t...","s":88.64,"e":92.37},{"t":"I begin again in You.","s":92.47,"e":109.26},{"t":"Regaining the line I crossed,","s":109.28,"e":112.53},{"t":"we walk it side by side.","s":112.63,"e":116.15},{"t":"Choosing good, refusing evil,","s":116.21,"e":119.42},{"t":"Letting the old man die.","s":119.48,"e":123.27},{"t":"As far away as east from west,","s":123.35,"e":127.04},{"t":"that’s where my past now stays...","s":127.05,"e":130.25},{"t":"Won’t revive what You laid down,","s":130.27,"e":133.28},{"t":"I let it pass away.","s":133.4,"e":136.71},{"t":"If the Son has set me free,","s":136.73,"e":139.99},{"t":"then I am free indeed.","s":140.04,"e":143.62},{"t":"I won’t carry what You buried,","s":143.7,"e":146.05},{"t":"I won’t buy into what You released.","s":146.17,"e":149.32},{"t":"I come to You with all my weight,","s":149.33,"e":153.51},{"t":"Hear You call my name.","s":153.59,"e":156.12},{"t":"Taking Your yoke, I learn Your pace,","s":156.18,"e":160.46},{"t":"gentle, low, and safe.","s":160.55,"e":162.87},{"t":"In You my soul finds quiet ground,","s":162.9,"e":166.86},{"t":"my striving finally through...","s":166.97,"e":169.64},{"t":"Your burden light, Your mercy wide,","s":169.7,"e":174.61},{"t":"I rest in You.","s":174.73,"e":177.63},{"t":"So I begin again in You.","s":177.64,"e":181.12},{"t":"No backward glance, no residue.","s":181.2,"e":184.51},{"t":"I trust the work You say is through...","s":184.63,"e":188.44},{"t":"I begin again in You.","s":188.54,"e":189.35},{"t":"I begin again.","s":189.36,"e":198.39},{"t":"I begin again in You.","s":198.51,"e":203.46}],"match":null}
