{"v":1,"id":"2bf3b327789d","synced":true,"offset":0,"source":"suno","lines":[{"t":"Come, all those who know not My ways;","s":13.41,"e":18.97},{"t":"I will show you.","s":19.08,"e":25.97},{"t":"Come, all those who have been abandoned;","s":26.06,"e":31.25},{"t":"I will comfort you and give you shelter.","s":31.37,"e":38.26},{"t":"Come, all those who are crippled;","s":38.31,"e":43.63},{"t":"Let us run and leap for joy together!","s":43.69,"e":50.78},{"t":"Come, all those faithless;","s":50.87,"e":53.83},{"t":"I shall fill your cup,","s":53.95,"e":55.97},{"t":"And watch how it overflows!","s":56.07,"e":63.23},{"t":"Come, all murderers;","s":63.32,"e":66.57},{"t":"Watch Me raise you,","s":66.66,"e":68.84},{"t":"And all who sleep, from the grave.","s":68.9,"e":88.04},{"t":"Come, all you who blaspheme,","s":88.14,"e":105.78},{"t":"I will give you a new voice;","s":105.89,"e":111.17},{"t":"Bring with you all those who are blind and deaf,","s":111.26,"e":116.48},{"t":"For they too, shall see and hear!","s":116.54,"e":125.06},{"t":"Indeed, come all those","s":125.08,"e":127.21},{"t":"who have sinned against Me,","s":127.31,"e":130.62},{"t":"take My hand!","s":130.66,"e":132.34},{"t":"I will lead you to the waters","s":132.46,"e":135.77},{"t":"where I shall wash you,","s":135.81,"e":139.72},{"t":"And where your new clothes","s":139.8,"e":142.45},{"t":"hang upon the tree","s":142.54,"e":144.98},{"t":"Which grows next to the stream.","s":145.06,"e":150.2},{"t":"Come one, come all!","s":150.29,"e":153.55},{"t":"Ask, and it shall be given you!","s":153.65,"e":159.01},{"t":"For all things are possible with God","s":159.07,"e":162.86},{"t":"And made manifest through The Son.","s":162.96,"e":174.29},{"t":"Says The Lord YahuShua.","s":174.39,"e":181.29}],"match":{"letter":"wtlb1:come-love-awaits-you","score":1.0}}
