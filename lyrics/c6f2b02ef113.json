{"v":1,"id":"c6f2b02ef113","synced":true,"offset":0,"source":"suno","lines":[{"t":"Here I am, Lord.","s":26.7,"e":32.09},{"t":"I don’t know Your ways.","s":32.21,"e":38.87},{"t":"Show me now, Lord,","s":38.94,"e":44.05},{"t":"teach my feet Your pace.","s":44.09,"e":51.03},{"t":"I was abandoned","s":51.11,"e":56.1},{"t":"by the pride I chose.","s":56.16,"e":62.87},{"t":"Be my shelter,","s":62.98,"e":68.14},{"t":"be my only home.","s":68.21,"e":75.1},{"t":"Here I am, Lord…","s":75.13,"e":78.2},{"t":"Where I fell, Lord…","s":78.24,"e":79.79},{"t":"Take my hand and make me new.","s":79.8,"e":87.27},{"t":"Here I am, Lord…","s":87.33,"e":90.27},{"t":"Here I stand, Lord…","s":90.31,"e":93.28},{"t":"All I am is Yours to use.","s":93.35,"e":98.79},{"t":"Here I am, Lord.","s":98.81,"e":103.89},{"t":"crippled at Your door.","s":103.93,"e":110.74},{"t":"Lift me, heal me,","s":110.77,"e":115.99},{"t":"help my heart restore.","s":116.05,"e":122.78},{"t":"Here I’m faithless,","s":122.83,"e":127.93},{"t":"with an empty cup.","s":127.97,"e":134.57},{"t":"Fill it, Savior,","s":134.65,"e":139.4},{"t":"let it flow over and up.","s":139.44,"e":146.91},{"t":"Here I am, Lord…","s":146.94,"e":149.93},{"t":"Where I fell, Lord…","s":149.97,"e":152.93},{"t":"Take my hand and make me new.","s":152.99,"e":158.88},{"t":"Here I am, Lord…","s":158.93,"e":161.84},{"t":"Here I stand, Lord…","s":161.88,"e":164.81},{"t":"All I am is Yours to use.","s":164.86,"e":170.35},{"t":"Here I am, Lord.","s":170.36,"e":172.82},{"t":"In shadows I once fed.","s":172.92,"e":176.19},{"t":"Raise what’s sleeping,","s":176.26,"e":179.09},{"t":"wake what once was dead.","s":179.17,"e":182.02},{"t":"Hear this broken voice.","s":182.07,"e":184.94},{"t":"give me speech that’s true.","s":185.0,"e":187.95},{"t":"Eyes wide open,","s":188.03,"e":189.39},{"t":"ears that listen close to You.","s":189.47,"e":193.58},{"t":"Lead me to the waters,","s":193.6,"e":196.62},{"t":"wash me in Your name.","s":196.67,"e":199.56},{"t":"Dress