{"v":1,"id":"d5e466ee69e3","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I was holding on to sorrow, clutching pain that never died","s":12.58,"e":18.72},{"t":"My arms too weak to carry, but I still refused to cry","s":19.26,"e":25.1},{"t":"Then a whisper stirred within me","s":25.1,"e":28.9},{"t":"Give up everything, let go","s":28.9,"e":31.58},{"t":"I fell down to the darkness","s":31.58,"e":34.98},{"t":"The only way to rise and grow","s":34.98,"e":37.76},{"t":"Love destroyed my lonely prison","s":39.88,"e":43.02},{"t":"A fire breaking stone","s":43.02,"e":46.08},{"t":"Surrendered in the silence","s":47.36,"e":49.38},{"t":"Where no one walks alone","s":49.92,"e":52.28},{"t":"Now broken wings are mended","s":52.28,"e":56.06},{"t":"Our hand reached through the night","s":56.06,"e":59.1},{"t":"Grace rebuilt the ruins","s":59.64,"e":62.28},{"t":"Now I'm standing in new light","s":62.28,"e":65.38},{"t":"Shadows tried to bind me","s":71.28,"e":73.56},{"t":"But mercy called my name","s":73.56,"e":76.56},{"t":"Through tears and pure repentance","s":76.56,"e":79.46},{"t":"Not a single one in vain","s":79.46,"e":82.68},{"t":"There's a voice that never leaves me","s":82.68,"e":86.34},{"t":"No matter how I stray","s":86.34,"e":89.08},{"t":"He accepts each bruise and failing","s":89.08,"e":92.54},{"t":"And leads me all the way","s":92.54,"e":95.56},{"t":"Love destroyed my lonely prison","s":97.6,"e":100.68},{"t":"A fire breaking stone","s":100.68,"e":103.7},{"t":"Surrendered in the silence","s":104.88,"e":106.98},{"t":"Where no one walks alone","s":106.98,"e":109.86},{"t":"Now broken wings are mended","s":110.76,"e":113.64},{"t":"A hand reached through the night","s":113.64,"e":116.66},{"t":"Grace rebuilt the ruins","s":117.2,"e":119.92},{"t":"Now I'm standing in new light","s":120.44,"e":122.88},{"t":"Let it all be broken","s":126.44,"e":129.58},{"t":"Cry and wail undone","s":129.58,"e":132.56},{"t":"Release the pain you're holding","s":133.1,"e":135.96},{"t":"You are not alone","s":136.98,"e":138.66},{"t":"Every wound is healing","s":139.98,"e":142.3},{"t":"With every tear you weep","s":142.98,"e":145.8},{"t":"In the arms of love everlasting","s":145.8,"e":148.54},{"t":"You'll rise from the deep","s":148.54,"e":151.74},{"t":"Love destroyed my lonely prison","s":151.74,"e":155.26},{"t":"A fire breaking stone","s":155.98,"e":158.08},{"t":"Surrendered in the silence","s":159.18,"e":161.46},{"t":"Where no one walks alone","s":161.98,"e":164.3},{"t":"Now broken wings are mended","s":164.3,"e":168.06},{"t":"Her hand reached through the night","s":168.06,"e":171.1},{"t":"Grace rebuilt the ruins","s":171.68,"e":174.42},{"t":"Now I'm standing in new light","s":174.42,"e":177.48}],"match":null}
