{"v":1,"id":"d80b4689db25","synced":true,"offset":0,"source":"suno","lines":[{"t":"I hear the whispers in the breeze tonight","s":16.87,"e":24.29},{"t":"A voice that calls me to the shining light","s":24.45,"e":32.19},{"t":"The road is long but the stars still burn","s":32.27,"e":45.67},{"t":"Mountains bow and rivers sing","s":45.75,"e":52.21},{"t":"Every heart knows the joy He brings","s":52.26,"e":61.59},{"t":"YahuShua is waiting","s":61.62,"e":70.01},{"t":"His arms are wide","s":70.11,"e":76.23},{"t":"For the day we return","s":76.34,"e":84.37},{"t":"To the kingdom bright","s":84.49,"e":90.99},{"t":"YahuShua is waiting","s":91.1,"e":99.37},{"t":"Calling you","s":99.46,"e":106.79},{"t":"Calling me","s":106.88,"e":116.93},{"t":"The sky is painted with a holy fire","s":116.93,"e":124.02},{"t":"Each step we take climbs a little higher","s":124.12,"e":131.52},{"t":"We carry hope in the palm of our hands","s":131.64,"e":145.16},{"t":"Fields of gold and skies of blue","s":145.23,"e":151.95},{"t":"Every path leads us back to You","s":152.01,"e":161.24},{"t":"YahuShua is waiting","s":161.28,"e":169.66},{"t":"His arms are wide","s":169.77,"e":175.96},{"t":"For the day we return","s":176.04,"e":184.1},{"t":"To the kingdom bright","s":184.22,"e":190.72},{"t":"YahuShua is waiting","s":190.83,"e":199.1},{"t":"Calling you","s":199.19,"e":206.36},{"t":"Calling me","s":206.46,"e":208.04}],"match":null}
