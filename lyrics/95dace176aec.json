{"v":1,"id":"95dace176aec","synced":true,"offset":0,"source":"suno","lines":[{"t":"Beloved, there is a language of which","s":11.25,"e":18.27},{"t":"You know nothing about, says The Lord...","s":18.38,"e":26.38},{"t":"A language","s":26.41,"e":27.57},{"t":"which is pure and beautiful,","s":27.61,"e":33.79},{"t":"A language","s":33.91,"e":35.62},{"t":"in need of no words at all;","s":35.72,"e":41.29},{"t":"A language","s":41.41,"e":42.7},{"t":"which you shall soon come to know,","s":42.74,"e":48.79},{"t":"A language","s":48.91,"e":51.42},{"t":"which I have revealed","s":51.47,"e":53.78},{"t":"To My servant already...","s":53.9,"e":60.13},{"t":"A language","s":60.16,"e":61.91},{"t":"of overwhelming love,","s":61.99,"e":67.82},{"t":"pure and undefiled,","s":67.9,"e":70.54},{"t":"Bringing forth much understanding;","s":70.63,"e":75.04},{"t":"A language","s":75.16,"e":76.84},{"t":"of power and great glory,","s":76.91,"e":82.05},{"t":"In which all My servants shall come to stand...","s":82.15,"e":89.74},{"t":"The unspoken Word of God received in the presence","s":89.77,"e":97.02},{"t":"Of The Almighty, The Holiest of Holies,","s":97.14,"e":101.38},{"t":"Revealing the essence of who I am...","s":101.42,"e":110.0},{"t":"Union in The Spirit of God...","s":110.05,"e":120.19},{"t":"A place","s":120.24,"e":122.17},{"t":"beyond time and space,","s":122.26,"e":127.82},{"t":"beyond the knowledge","s":127.9,"e":129.26},{"t":"Contained within creation,","s":129.34,"e":133.1},{"t":"surpassing all boundaries,","s":133.15,"e":135.16},{"t":"A place","s":135.24,"e":136.53},{"t":"even angels long to know...","s":136.63,"e":142.59},{"t":"The place","s":142.61,"e":143.98},{"t":"where I am and have always been seated,","s":144.02,"e":147.22},{"t":"Where you shall be also...","s":147.31,"e":151.32},{"t":"A place without time, The Eternal,","s":151.36,"e":157.8},{"t":"The Bosom of The Father, of which I AM...","s":157.86,"e":164.68},{"t":"Says The Lord YahuShua.","s":164.72,"e":166.99}],"match":null}
