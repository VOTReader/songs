{"v":1,"id":"5a9ed20f110c","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Ayy","s":0.0,"e":1.3},{"t":"Blessed is the wise and faithful servant","s":33.96,"e":38.28},{"t":"Who walks in truth and grace","s":38.28,"e":41.14},{"t":"They care not for praise or honor","s":41.14,"e":46.4},{"t":"The mirror of another's face","s":46.4,"e":49.34},{"t":"They obey the voice of heaven","s":50.62,"e":54.68},{"t":"Through every trial and test","s":54.68,"e":57.8},{"t":"Their heart remains unshaken by the world that mocks the blessed","s":58.78,"e":66.08},{"t":"They seek to please their master","s":66.08,"e":68.78},{"t":"Whose eyes alone can see","s":70.18,"e":72.56},{"t":"The faith that burns within them","s":74.5,"e":77.4},{"t":"Pure and endlessly","s":78.98,"e":80.62},{"t":"No need for man's approval","s":82.74,"e":85.0},{"t":"Prove all, no fear of fleeting fame","s":85.0,"e":89.6},{"t":"Blessed is the faithful servant","s":89.6,"e":94.96},{"t":"Who walks in his holy name","s":94.96,"e":99.52},{"t":"They stand while others stumble","s":108.22,"e":112.26},{"t":"Humble, firm upon the rock Unafraid of human judgment","s":112.26,"e":121.54},{"t":"They heed the shepherd's knock For wisdom lights their pathway","s":121.54,"e":129.02},{"t":"And truth their only guide They walk with eyes on heaven","s":129.02,"e":137.24},{"t":"With love they can't hide","s":138.14,"e":141.54},{"t":"They seek to please their master","s":143.42,"e":146.06},{"t":"Whose eyes alone can see","s":147.72,"e":149.92},{"t":"The fate that burns within them","s":151.9,"e":154.64},{"t":"Pure and endlessly","s":156.4,"e":157.92},{"t":"No need for man's approval","s":160.14,"e":162.32},{"t":"No fear of fleeting fate","s":163.9,"e":166.8},{"t":"Babe, blessed is the faithful servant Who walks in His only name","s":166.8,"e":178.18},{"t":"Blessed are they who follow","s":193.82,"e":196.12},{"t":"In obedience and light","s":197.44,"e":200.14},{"t":"Their hearts a living offering","s":201.86,"e":204.44},{"t":"Their steps forever right","s":206.04,"e":208.58},{"t":"They serve to please their master","s":210.06,"e":212.88},{"t":"Their purpose ever true","s":214.42,"e":216.74},{"t":"No crown for man could measure","s":218.66,"e":221.06},{"t":"The joy they're passing through","s":222.9,"e":225.16},{"t":"For blessed is the servant","s":227.02,"e":229.72},{"t":"In whom the Lord delights","s":229.72,"e":234.56},{"t":"Faithful through the darkness","s":234.56,"e":237.98},{"t":"Shining in","s":237.98,"e":239.32},{"t":"Shining in his light","s":240.76,"e":243.96}],"match":null}
