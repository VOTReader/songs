{"v":1,"id":"5a9ed20f110c","synced":true,"offset":0,"source":"suno","lines":[{"t":"Blessed is the wise and faithful servant,","s":7.49,"e":38.97},{"t":"Who walks in truth and grace.","s":39.01,"e":43.37},{"t":"They care not for praise or honor,","s":43.42,"e":46.91},{"t":"Nor the mirror of another’s face.","s":46.99,"e":51.89},{"t":"They obey the voice of heaven,","s":51.98,"e":55.6},{"t":"Through every trial and test.","s":55.62,"e":59.76},{"t":"Their heart remains unshaken,","s":59.79,"e":63.07},{"t":"By the world that mocks the blessed.","s":63.17,"e":67.34},{"t":"They seek to please their Master,","s":67.35,"e":71.28},{"t":"Whose eyes alone can see.","s":71.32,"e":75.51},{"t":"The faith that burns within them,","s":75.55,"e":79.92},{"t":"Pure and endlessly.","s":79.96,"e":83.91},{"t":"No need for man’s approval,","s":83.96,"e":88.06},{"t":"No fear of fleeting fame.","s":88.11,"e":89.9},{"t":"Blessed is the faithful servant,","s":89.93,"e":97.29},{"t":"Who walks in His holy name.","s":97.33,"e":99.67},{"t":"They stand while others stumble,","s":99.68,"e":101.68},{"t":"Firm upon the rock.","s":101.77,"e":118.84},{"t":"Unafraid of human judgment,","s":118.93,"e":122.53},{"t":"They heed the Shepherd’s knock.","s":122.56,"e":124.82},{"t":"For wisdom lights their pathway,","s":124.91,"e":130.88},{"t":"And truth their only guide.","s":130.92,"e":135.05},{"t":"They walk with eyes on heaven,","s":135.1,"e":139.24},{"t":"With love they can’t hide.","s":139.28,"e":144.36},{"t":"They seek to please their Master,","s":144.37,"e":148.56},{"t":"Whose eyes alone can see.","s":148.58,"e":152.78},{"t":"The faith that burns within them,","s":152.81,"e":157.36},{"t":"Pure and endlessly.","s":157.39,"e":161.26},{"t":"No need for man’s approval,","s":161.29,"e":165.42},{"t":"No fear of fleeting fame.","s":165.49,"e":169.84},{"t":"Blessed is the faithful servant,","s":169.89,"e":174.69},{"t":"Who walks in His holy name.","s":174.73,"e":187.1},{"t":"Blessed are they who follow,","s":187.11,"e":187.54},{"t":"In obedience and light.","s":187.56,"e":189.31},{"t":"Their hearts a living offering,","s":189.33,"e":191.22},{"t":"Their steps forever right.","s":191.24,"e":193.65},{"t":"They serve to please their Master,","s":193.66,"e":196.12},{"t":"Their purpose ever true.","s":196.15,"e":219.71},{"t":"No crown from man could measure,","s":219.76,"e":223.84},{"t":"The joy they’re passing through.","s":223.88,"e":228.06},{"t":"For blessed is the servant,","s":228.1,"e":232.24},{"t":"In whom the Lord delights.","s":232.28,"e":236.69},{"t":"Faithful through the darkness,","s":236.74,"e":241.85},{"t":"Shining in His light.","s":241.94,"e":244.14}],"match":null}
