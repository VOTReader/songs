{"v":1,"id":"3a47c83dcc8e","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I ran where your voice grows thin","s":9.06,"e":14.2},{"t":"Where light fades and noise rushes in","s":14.74,"e":20.68},{"t":"Spent all the breath you breathed in me","s":21.84,"e":25.24},{"t":"Just to come undone","s":26.8,"e":29.66},{"t":"I chose the road that pulled away","s":37.7,"e":41.52},{"t":"Chased every fire that would not stay","s":44.38,"e":47.72},{"t":"Turned from the truth I knew was you","s":50.28,"e":53.66},{"t":"And call it freedom","s":56.16,"e":58.56},{"t":"And I ran and I ran and I ran and I ran","s":59.1,"e":62.58},{"t":"And I ran and I ran and I ran","s":62.58,"e":64.64},{"t":"Till my strength gave way","s":64.64,"e":70.02},{"t":"Till I hit the ground","s":72.84,"e":77.06},{"t":"Till I hit the ground","s":78.6,"e":82.78},{"t":"Did you see me there?","s":85.64,"e":88.6},{"t":"The sweetness turned to ash and dust","s":96.38,"e":100.1},{"t":"Every promise broke my trust","s":102.72,"e":106.0},{"t":"And all the pride I held so hard","s":107.42,"e":111.08},{"t":"Came crashing through me","s":112.76,"e":115.78},{"t":"And I fell, and I fell, and I fell, and I fell, and I fell, and I fell","s":117.94,"e":122.84},{"t":"And I fell till I could not move","s":122.84,"e":128.46},{"t":"Face down in the dust","s":131.72,"e":135.54},{"t":"Facedown in the dust","s":137.76,"e":141.34},{"t":"Did you leave me there?","s":144.24,"e":147.16},{"t":"Did you leave me there?","s":150.04,"e":153.1},{"t":"I turned back","s":155.78,"e":159.04},{"t":"Through my shame","s":161.7,"e":164.56},{"t":"Through the ruin","s":167.5,"e":171.06},{"t":"Called your name","s":173.12,"e":176.48},{"t":"And you were there","s":193.84,"e":196.9},{"t":"You were there","s":196.9,"e":198.46},{"t":"You were there","s":198.46,"e":199.72},{"t":"Where I fell","s":203.04,"e":205.56},{"t":"We'll be right back.","s":213.0,"e":218.06},{"t":"We'll be right back.","s":247.02,"e":248.14},{"t":"We'll see you next time.","s":276.1,"e":281.24}],"match":null}
