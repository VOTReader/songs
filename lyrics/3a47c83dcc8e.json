{"v":1,"id":"3a47c83dcc8e","synced":true,"offset":0,"source":"suno","lines":[{"t":"I ran where Your voice grows thin","s":-0.66,"e":16.19},{"t":"Where light fades and noise rushes in","s":16.23,"e":22.89},{"t":"Spent all the breath You breathed in me","s":22.93,"e":27.74},{"t":"Just to come undone","s":27.78,"e":29.83},{"t":"I chose the road that pulled away","s":29.83,"e":45.16},{"t":"Chased every fire that would not stay","s":45.21,"e":51.06},{"t":"Turned from the truth I knew was You","s":51.11,"e":57.07},{"t":"And called it freedom","s":57.14,"e":59.91},{"t":"And I ran, and I ran, and I ran, and I ran","s":59.93,"e":62.95},{"t":"And I ran, and I ran, and I ran","s":62.99,"e":65.24},{"t":"Til my strength gave way","s":65.32,"e":73.65},{"t":"Til I hit the ground","s":73.67,"e":79.54},{"t":"Til I hit the ground","s":79.59,"e":86.8},{"t":"Did You see me then?","s":86.85,"e":88.79},{"t":"The sweetness turned to ash and dust","s":88.8,"e":103.56},{"t":"Every promise broke my trust","s":103.66,"e":108.54},{"t":"And all the pride I held so high","s":108.6,"e":113.57},{"t":"Came crashing through me","s":113.64,"e":118.63},{"t":"And I fell, and I fell, and I fell, and I fell","s":118.64,"e":121.64},{"t":"And I fell, and I fell, and I fell","s":121.67,"e":123.94},{"t":"Til I could not move","s":124.0,"e":132.31},{"t":"Face down in the dust","s":132.36,"e":138.28},{"t":"Face down in the dust","s":138.37,"e":145.37},{"t":"Did You leave me then?","s":145.41,"e":151.17},{"t":"Did You leave me then?","s":151.2,"e":157.35},{"t":"I turned back","s":157.4,"e":163.28},{"t":"Through my shame","s":163.36,"e":169.11},{"t":"Through the ruin","s":169.18,"e":174.49},{"t":"Called Your name","s":174.58,"e":196.03},{"t":"And You were there, You were there, You were there, You were there","s":196.04,"e":202.1},{"t":"You were there, You were there, You were there","s":202.14,"e":204.61},{"t":"Where I fell apart","s":204.68,"e":208.54},{"t":"You were there, waiting still","s":208.65,"e":214.48},{"t":"You were there, waiting still","s":214.57,"e":218.54},{"t":"Arms wide open then","s":218.64,"e":223.22}],"match":null}
