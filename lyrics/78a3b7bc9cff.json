{"v":1,"id":"78a3b7bc9cff","synced":true,"offset":0,"source":"suno","lines":[{"t":"Blessed are those who answer,","s":25.64,"e":28.04},{"t":"“Yes, Lord,”","s":27.39,"e":32.28},{"t":"For their faith is revealed.","s":32.33,"e":34.87},{"t":"Blessed are those who answer,","s":34.9,"e":36.34},{"t":"“Yes, Lord,”","s":35.83,"e":37.01},{"t":"For their faith is revealed.","s":37.02,"e":38.11},{"t":"Blessed are those who pray,","s":38.21,"e":40.1},{"t":"“Your will be done, Lord,”","s":39.63,"e":44.59},{"t":"For they have great trust.","s":44.68,"e":50.25},{"t":"Blessed are those who say,","s":50.3,"e":54.33},{"t":"“Amen, Lord,”","s":51.84,"e":55.8},{"t":"At all times and in every season,","s":55.84,"e":60.53},{"t":"For they have understood.","s":60.63,"e":86.93},{"t":"Blessed are those who know,","s":86.97,"e":90.25},{"t":"I AM WHO I AM;","s":90.35,"e":94.88},{"t":"They shall have peace...","s":94.95,"e":107.79},{"t":"Says The Lord.","s":107.86,"e":108.94}],"match":null}
