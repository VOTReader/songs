{"v":1,"id":"78a3b7bc9cff","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Blessed are those who answer","s":24.72,"e":27.54},{"t":"Yes, Lord","s":27.54,"e":30.3},{"t":"For their faith is revealed","s":31.88,"e":34.86},{"t":"Blessed are those who pray","s":36.86,"e":39.48},{"t":"Your will be done, Lord","s":39.48,"e":42.56},{"t":"For they have great trust","s":44.0,"e":47.12},{"t":"Blessed are those who say","s":49.12,"e":51.84},{"t":"Amen, Lord","s":52.9,"e":54.8},{"t":"At all times and in every season","s":54.8,"e":59.52},{"t":"For they have understood","s":59.52,"e":62.14},{"t":"Blessed are those who know I am who I am","s":85.64,"e":93.08},{"t":"They shall have peace","s":93.62,"e":96.08},{"t":"Says the Lord","s":105.48,"e":108.48},{"t":"Thank you.","s":116.38,"e":119.12},{"t":"Thank you for watching.","s":153.28,"e":160.54}],"match":null}
