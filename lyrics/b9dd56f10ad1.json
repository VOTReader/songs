{"v":1,"id":"b9dd56f10ad1","synced":false,"offset":null,"source":"flow","lines":[{"t":"For I tell you the truth,","s":12.81,"e":14.95},{"t":"That which is tipped","s":16.25,"e":19.1},{"t":"Can not be set upright again,","s":20.28,"e":23.56},{"t":"And that which has been set","s":24.92,"e":26.7},{"t":"In motion can not be stopped.","s":27.46,"e":29.84},{"t":"Lo, even that which was held","s":36.75,"e":41.45},{"t":"Captive in the depths of silence","s":48.06,"e":52.28},{"t":"Has been released,","s":53.58,"e":55.87},{"t":"Behold, it comes forth,","s":83.23,"e":85.01},{"t":"Increasing by order of magnitude","s":87.61,"e":92.49},{"t":"And can in no wise","s":92.84,"e":96.92},{"t":"Be put back again,","s":97.84,"e":99.78},{"t":"Says The Lord","s":104.06,"e":106.79}],"match":null}
