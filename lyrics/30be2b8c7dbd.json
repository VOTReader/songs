{"v":1,"id":"30be2b8c7dbd","synced":true,"offset":0,"source":"suno","lines":[{"t":"Verse 1","s":16.64,"e":16.78},{"t":"I’ve been holding on to shadows,","s":16.8,"e":20.39},{"t":"Trying not to lose my way.","s":20.47,"e":24.15},{"t":"Every heartbeat felt so hollow","s":24.24,"e":27.49},{"t":"Till Your whisper filled the ache.","s":27.53,"e":31.32},{"t":"You stepped into my silence,","s":31.4,"e":34.95},{"t":"A calm within the storm,","s":35.07,"e":38.44},{"t":"And suddenly the pieces","s":38.54,"e":42.25},{"t":"Began to feel reborn.","s":42.34,"e":46.97},{"t":"You lift the veil of all I’ve carried,","s":47.02,"e":50.53},{"t":"The weight I thought was mine alone.","s":50.59,"e":54.24},{"t":"In every tear, Your mercy met me—","s":54.35,"e":57.53},{"t":"Now I know I’m finally home.","s":57.57,"e":59.42},{"t":"Chorus","s":59.51,"e":62.7},{"t":"So take my heart—","s":62.81,"e":65.71},{"t":"Make it Your kingdom.","s":65.78,"e":69.71},{"t":"Let every wall","s":69.81,"e":72.73},{"t":"Fall where Your light comes.","s":72.83,"e":76.41},{"t":"Write Your love","s":76.5,"e":79.11},{"t":"On every heartbeat.","s":79.23,"e":80.76},{"t":"Reign in me,","s":80.81,"e":82.98},{"t":"Until I am complete.","s":83.02,"e":88.07},{"t":"My heart…","s":88.18,"e":90.36},{"t":"Your kingdom.","s":90.44,"e":91.66},{"t":"Verse 2","s":91.75,"e":95.64},{"t":"There were roads I walked in darkness,","s":95.67,"e":99.18},{"t":"There were wounds I hid so deep.","s":99.22,"e":102.47},{"t":"But Your love kept gently calling,","s":102.53,"e":106.08},{"t":"Awakening what fell asleep.","s":106.16,"e":109.83},{"t":"You pulled me from the wreckage,","s":109.91,"e":113.02},{"t":"You breathed hope into my dust,","s":113.1,"e":116.45},{"t":"And from the ashes of my story","s":116.53,"e":120.2},{"t":"You built something I can trust.","s":120.28,"e":123.98},{"t":"Pre-Chorus","s":124.08,"e":125.76},{"t":"You take the ruins of my trying,","s":125.82,"e":129.36},{"t":"And shape them with a holy hand.","s":129.42,"e":132.91},{"t":"You’re the peace my soul’s been craving—","s":132.93,"e":136.14},{"t":"The One who helps me stand.","s":136.2,"e":138.89},{"t":"Chorus","s":138.98,"e":140.63},{"t":"So take my heart—","s":140.71,"e":144.46},{"t":"Make it Your kingdom.","s":144.53,"e":148.07},{"t":"Let every wall","s":148.17,"e":149.16},{"t":"Fall where Your light comes.","s":149.26,"e":152.1},{"t":"Write Your love","s":152.17,"e":154.43},{"t":"On every heartbeat.","s":154.55,"e":156.08},{"t":"Reign in me,","s":156.13,"e":158.22},{"t":"Until I am complete.","s":158.26,"e":163.31},{"t":"My heart…","s":163.42,"e":165.46},{"t":"Your kingdom.","s":165.55,"e":171.53},{"t":"Open every door in me,","s":171.62,"e":174.12},{"t":"Let Your presence fill the rooms.","s":174.18,"e":176.56},{"t":"Shine through every memory","s":176.58,"e":180.52},{"t":"And heal the places I once knew.","s":181.24,"e":184.3},{"t":"If all I am is Yours, O Lord,","s":184.4,"e":188.0},{"t":"Then I will never be alone—","s":188.07,"e":191.53},{"t":"You built a kingdom in my heart,","s":191.61,"e":194.82},{"t":"And called this wandering soul Your home.","s":194.92,"e":198.14},{"t":"Final Chorus","s":198.17,"e":202.38},{"t":"So take my heart—","s":202.46,"e":205.4},{"t":"Make it Your kingdom.","s":205.46,"e":210.04},{"t":"Every breath","s":210.09,"e":212.11},{"t":"A place Your light runs.","s":212.27,"e":216.12},{"t":"Hold my soul","s":216.22,"e":219.14},{"t":"Till all is restored…","s":219.24,"e":223.22},{"t":"Yours forever,","s":223.31,"e":226.16},{"t":"Now and evermore.","s":226.24,"e":231.37},{"t":"My heart…","s":231.48,"e":234.39},{"t":"Your kingdom.","s":234.49,"e":235.65}],"match":null}
