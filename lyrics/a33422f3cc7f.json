{"v":1,"id":"a33422f3cc7f","synced":true,"offset":0,"source":"suno","lines":[{"t":"Blessed is the wise and faithful servant,","s":6.62,"e":38.1},{"t":"Who walks in truth and grace.","s":38.14,"e":42.5},{"t":"They care not for praise or honor,","s":42.55,"e":46.04},{"t":"Nor the mirror of another’s face.","s":46.12,"e":51.02},{"t":"They obey the voice of heaven,","s":51.11,"e":54.73},{"t":"Through every trial and test.","s":54.75,"e":58.89},{"t":"Their heart remains unshaken,","s":58.92,"e":62.2},{"t":"By the world that mocks the blessed.","s":62.3,"e":66.47},{"t":"They seek to please their Master,","s":66.48,"e":70.41},{"t":"Whose eyes alone can see.","s":70.45,"e":74.64},{"t":"The faith that burns within them,","s":74.68,"e":79.05},{"t":"Pure and endlessly.","s":79.09,"e":83.04},{"t":"No need for man’s approval,","s":83.09,"e":87.19},{"t":"No fear of fleeting fame.","s":87.24,"e":89.03},{"t":"Blessed is the faithful servant,","s":89.06,"e":96.42},{"t":"Who walks in His holy name.","s":96.46,"e":98.8},{"t":"They stand while others stumble,","s":98.81,"e":100.81},{"t":"Firm upon the rock.","s":100.9,"e":117.97},{"t":"Unafraid of human judgment,","s":118.06,"e":121.66},{"t":"They heed the Shepherd’s knock.","s":121.69,"e":123.95},{"t":"For wisdom lights their pathway,","s":124.04,"e":130.01},{"t":"And truth their only guide.","s":130.05,"e":134.18},{"t":"They walk with eyes on heaven,","s":134.23,"e":138.37},{"t":"With love they can’t hide.","s":138.41,"e":143.49},{"t":"They seek to please their Master,","s":143.5,"e":147.69},{"t":"Whose eyes alone can see.","s":147.71,"e":151.91},{"t":"The faith that burns within them,","s":151.94,"e":156.49},{"t":"Pure and endlessly.","s":156.52,"e":160.39},{"t":"No need for man’s approval,","s":160.42,"e":164.55},{"t":"No fear of fleeting fame.","s":164.62,"e":168.97},{"t":"Blessed is the faithful servant,","s":169.02,"e":173.82},{"t":"Who walks in His holy name.","s":173.86,"e":186.23},{"t":"Blessed are they who follow,","s":186.24,"e":186.67},{"t":"In obedience and light.","s":186.69,"e":188.44},{"t":"Their hearts a living offering,","s":188.46,"e":190.35},{"t":"Their steps forever right.","s":190.37,"e":192.78},{"t":"They serve to please their Master,","s":192.79,"e":195.25},{"t":"Their purpose ever true.","s":195.28,"e":218.84},{"t":"No crown from man could measure,","s":218.89,"e":222.97},{"t":"The joy they’re passing through.","s":223.01,"e":227.19},{"t":"For blessed is the servant,","s":227.23,"e":231.37},{"t":"In whom the Lord delights.","s":231.41,"e":235.82},{"t":"Faithful through the darkness,","s":235.87,"e":240.98},{"t":"Shining in His light.","s":241.07,"e":243.27}],"match":null}
