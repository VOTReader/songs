{"v":1,"id":"16f7eb8dd902","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 1)","s":2.61,"e":2.73},{"t":"Your love is pure,","s":2.75,"e":6.17},{"t":"Your love is strong.","s":6.22,"e":9.73},{"t":"Your love is whole,","s":9.78,"e":13.25},{"t":"Your love is real.","s":13.29,"e":15.96},{"t":"Yet it is even more,","s":16.02,"e":19.16},{"t":"More than words can express.","s":19.22,"e":22.93},{"t":"More beautiful than anything,","s":22.98,"e":26.27},{"t":"Like a gentle caress.","s":26.32,"e":32.07},{"t":"(Pre-Chorus)","s":28.11,"e":32.72},{"t":"How can I describe true love?","s":32.77,"e":38.22},{"t":"How can anything compare to what's above?","s":38.32,"e":46.78},{"t":"(Chorus)","s":42.1,"e":46.9},{"t":"Your love is a mystery,","s":46.92,"e":50.8},{"t":"But I know its real.","s":50.86,"e":53.37},{"t":"Your love is greater than I can see,","s":53.43,"e":57.87},{"t":"Yet I can feel it here.","s":57.93,"e":60.5},{"t":"I cannot comprehend,","s":60.54,"e":62.18},{"t":"I hardly understand.","s":62.19,"e":63.95},{"t":"But I feel Your love holding my heart,","s":63.98,"e":65.98},{"t":"Reaching for my hand.","s":66.03,"e":67.79},{"t":"And I know.","s":67.84,"e":69.31},{"t":"I don't need all the answers.","s":69.35,"e":72.68},{"t":"I just need You.","s":72.72,"e":87.34},{"t":"(Verse 2)","s":74.35,"e":87.48},{"t":"My heart burns with passion,","s":87.49,"e":90.47},{"t":"Whenever I think of You.","s":90.54,"e":93.75},{"t":"How can I feel a love so deeply,","s":93.81,"e":97.95},{"t":"When there's so much I don't know?","s":98.0,"e":101.45},{"t":"Sometimes I'm overwhelmed,","s":101.51,"e":104.96},{"t":"Sometimes I stand in awe.","s":105.02,"e":108.16},{"t":"But there's one thing I'm certain of,","s":108.21,"e":112.03},{"t":"Your love will never let me go.","s":112.08,"e":116.84},{"t":"(Bridge, stripped back, quiet)","s":114.98,"e":116.88},{"t":"I'll keep my eyes on You,","s":116.89,"e":118.75},{"t":"I won't turn left or right.","s":118.81,"e":120.22},{"t":"I'll keep pushing forward.","s":120.24,"e":121.73},{"t":"I'll try and do what is right.","s":121.74,"e":123.81},{"t":"Maybe one day I'll understand","s":123.88,"e":125.51},{"t":"Just how Your love is infinite.","s":125.56,"e":127.74},{"t":"But for now,","s":127.78,"e":128.61},{"t":"I'll just look to You.","s":128.65,"e":131.48},{"t":"(Chorus)","s":130.35,"e":131.6},{"t":"Your love is a mystery,","s":131.62,"e":135.5},{"t":"But I know its real.","s":135.56,"e":138.07},{"t":"Your love is greater than I can see,","s":138.11,"e":142.53},{"t":"Yet I can feel it here.","s":142.59,"e":145.2},{"t":"I cannot comprehend,","s":145.24,"e":146.9},{"t":"I hardly understand.","s":146.94,"e":148.68},{"t":"But I feel Your love holding my heart,","s":148.71,"e":150.64},{"t":"Reaching for my hand.","s":150.69,"e":152.5},{"t":"And I know.","s":152.55,"e":153.96},{"t":"I don't need all the answers.","s":154.0,"e":157.39},{"t":"I just need You.","s":157.43,"e":159.47}],"match":null}
