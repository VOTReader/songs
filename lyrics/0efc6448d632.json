{"v":1,"id":"0efc6448d632","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 1)","s":13.8,"e":13.98},{"t":"The love of man fades with the day,","s":14.0,"e":17.22},{"t":"Built on need, it slips away.","s":17.29,"e":20.25},{"t":"But You remain when all is gone,","s":20.31,"e":23.6},{"t":"Your whisper pulls my spirit on.","s":23.66,"e":27.0},{"t":"You breathe Your peace into my chest,","s":27.1,"e":30.36},{"t":"A quiet place, a holy rest.","s":30.48,"e":33.99},{"t":"All I am is Yours to keep,","s":34.07,"e":36.94},{"t":"You sing me softly out of sleep.","s":37.02,"e":42.18},{"t":"(Chorus)","s":40.39,"e":42.3},{"t":"Your light in the hollow,","s":42.32,"e":45.69},{"t":"Fills every space.","s":45.73,"e":48.67},{"t":"Your mercy surrounds me,","s":48.75,"e":52.42},{"t":"Your love is grace.","s":52.5,"e":53.81},{"t":"From ashes You lift me,","s":53.84,"e":59.14},{"t":"You call my name —","s":59.24,"e":62.99},{"t":"Unconditional,","s":63.09,"e":65.75},{"t":"Forever the same.","s":65.84,"e":70.48},{"t":"(Verse 2)","s":67.04,"e":70.58},{"t":"The world taught love was just a flame,","s":70.59,"e":73.63},{"t":"That flickers out, that can’t remain.","s":73.69,"e":76.97},{"t":"But You are fire that never dies,","s":77.03,"e":80.31},{"t":"A steady glow that lights the skies.","s":80.43,"e":83.71},{"t":"You warm the coldest part of me,","s":83.76,"e":86.35},{"t":"Your truth restores what used to be.","s":86.45,"e":90.66},{"t":"In Your arms, I finally see,","s":90.77,"e":93.51},{"t":"What love was always meant to be.","s":93.59,"e":96.82},{"t":"(Bridge)","s":96.39,"e":97.82},{"t":"If I must fall, let it be to rise,","s":97.9,"e":104.47},{"t":"To see Your hope in these tired eyes.","s":104.57,"e":110.98},{"t":"Your cup runs over, and I believe,","s":111.06,"e":118.32},{"t":"Your joy is the breath I breathe.","s":118.4,"e":122.41},{"t":"(Final Chorus)","s":122.02,"e":125.41},{"t":"Your light in the hollow,","s":125.47,"e":129.08},{"t":"Breaks through the dark.","s":129.15,"e":131.98},{"t":"Your mercy forever,","s":132.08,"e":135.65},{"t":"Consumes my heart.","s":135.66,"e":138.61},{"t":"YahuShua, my refuge,","s":138.71,"e":142.05},{"t":"My soul redeemed —","s":142.15,"e":143.9},{"t":"Unconditional love,","s":143.96,"e":149.13},{"t":"Forever You’ll be.","s":149.22,"e":150.72}],"match":null}
