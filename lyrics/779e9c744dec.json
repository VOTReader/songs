{"v":1,"id":"779e9c744dec","synced":true,"offset":0,"source":"suno","lines":[{"t":"I Begin again in You,","s":13.89,"e":17.44},{"t":"You've not left me behind.","s":17.48,"e":20.97},{"t":"You are with me even now,","s":21.03,"e":24.42},{"t":"to the end of time.","s":24.5,"e":27.81},{"t":"I'm Your forgiven child,","s":27.85,"e":31.31},{"t":"no records left to keep...","s":31.42,"e":35.18},{"t":"Carrying no memory of the things","s":35.23,"e":37.83},{"t":"I rehearsed in my sleep.","s":37.99,"e":39.61},{"t":"So I begin again in You.","s":39.62,"e":44.81},{"t":"I lift my eyes, I turn my view.","s":44.93,"e":48.2},{"t":"I won’t keep count of what You don’t...","s":48.28,"e":52.09},{"t":"I begin again in You.","s":52.19,"e":55.27},{"t":"Even what is yet to come","s":55.29,"e":58.33},{"t":"You washed before it surfaced.","s":58.44,"e":61.9},{"t":"So I will stop rehearsing sin","s":61.95,"e":65.19},{"t":"and fix my eyes on grace.","s":65.27,"e":68.78},{"t":"I give temptation no thought,","s":68.86,"e":70.4},{"t":"the accuser fades from view...","s":70.42,"e":75.75},{"t":"I turn aside and come,","s":75.81,"e":79.36},{"t":"I come to You.","s":79.48,"e":82.46},{"t":"So I begin again in You.","s":82.48,"e":85.9},{"t":"I lift my eyes, I turn my view.","s":86.02,"e":89.33},{"t":"I won’t keep count of what You don’t...","s":89.45,"e":93.18},{"t":"I begin again in You.","s":93.28,"e":97.85},{"t":"Regaining the line I crossed,","s":97.86,"e":101.28},{"t":"we walk it side by side.","s":101.39,"e":104.53},{"t":"Choosing good, refusing evil,","s":104.61,"e":108.18},{"t":"Letting the old man die.","s":108.24,"e":110.35},{"t":"As far away as east from west,","s":110.43,"e":114.12},{"t":"that’s where my past now stays...","s":114.14,"e":117.33},{"t":"Won’t revive what You laid down,","s":117.35,"e":120.21},{"t":"I let it pass away.","s":120.33,"e":123.79},{"t":"If the Son has set me free,","s":123.81,"e":127.0},{"t":"then I am free indeed.","s":127.04,"e":130.7},{"t":"I won’t carry what You buried,","s":130.78,"e":132.89},{"t":"I won’t buy into what You released.","s":132.93,"e":136.48},{"t":"I come to You with all my weight,","s":136.5,"e":140.59},{"t":"Hear You call my name.","s":140.67,"e":143.19},{"t":"Taking Your yoke, I learn Your pace,","s":143.23,"e":147.47},{"t":"gentle, low, and safe.","s":147.56,"e":149.74},{"t":"In You my soul finds quiet ground,","s":149.79,"e":153.86},{"t":"my striving finally through...","s":153.97,"e":156.64},{"t":"Your burden light, Your mercy wide,","s":156.7,"e":161.62},{"t":"I rest in You.","s":161.74,"e":164.71},{"t":"So I begin again in You.","s":164.72,"e":168.2},{"t":"No backward glance, no residue.","s":168.28,"e":171.59},{"t":"I trust the work You say is through...","s":171.71,"e":175.52},{"t":"I begin again in You.","s":175.62,"e":178.74},{"t":"I begin again.","s":178.78,"e":185.55},{"t":"I begin again in You.","s":185.67,"e":190.7}],"match":null}
