{"v":1,"id":"9d6f4b9589f8","synced":true,"offset":0,"source":"suno","lines":[{"t":"My love is equal for all who breathe..","s":20.94,"e":26.43},{"t":"Forgiveness for everyone alike..","s":26.47,"e":31.85},{"t":"I spilled My blood freely,","s":31.95,"e":36.26},{"t":"My offer crosses every line.","s":36.34,"e":41.97},{"t":"I did not measure for worth,","s":42.09,"e":46.74},{"t":"nor favor by name…","s":46.85,"e":51.98},{"t":"What differs is the answers,","s":52.06,"e":55.27},{"t":"when truth is forsaken or claimed.","s":55.36,"e":62.08},{"t":"I stand before them openly,","s":62.11,"e":67.16},{"t":"with nothing held behind.","s":67.25,"e":72.19},{"t":"No hidden terms, no double edges.","s":72.3,"e":76.81},{"t":"only mercy on borrowed time.","s":76.91,"e":83.06},{"t":"They choose death.","s":83.08,"e":85.39},{"t":"for what reason no one knows.","s":85.45,"e":91.92},{"t":"They lock arms in rebellion","s":91.97,"e":95.54},{"t":"against the Lover of their souls.","s":95.59,"e":101.86},{"t":"When struck upon My cheek,","s":101.96,"e":106.99},{"t":"I do not pull away…","s":107.11,"e":111.92},{"t":"They turn from Life itself,","s":112.01,"e":116.29},{"t":"and welcome darkness as if day..","s":116.37,"e":123.3},{"t":"I wait past what mercy asks,","s":123.32,"e":127.76},{"t":"past what patience can endure.","s":127.83,"e":129.69},{"t":"I bear the weight of every plea,","s":129.77,"e":137.74},{"t":"wishing hearts would still be cured.","s":137.81,"e":143.14},{"t":"I am long-suffering.","s":143.26,"e":147.38},{"t":"through suffering they can see…","s":147.43,"e":153.07},{"t":"But rejected love.","s":153.15,"e":157.7},{"t":"cannot force itself to be.","s":157.78,"e":163.0},{"t":"You know this grief already","s":163.01,"e":168.1},{"t":"it lives inside My chest.","s":168.2,"e":173.04},{"t":"My love is without coercion","s":173.15,"e":178.2},{"t":"It is Mine to risk.","s":178.32,"e":182.95},{"t":"They choose death.","s":182.98,"e":185.29},{"t":"for what reason no one knows.","s":185.35,"e":191.82},{"t":"They lock arms in rebellion","s":191.86,"e":195.44},{"t":"against the Lover of their souls.","s":195.48,"e":201.76},{"t":"When struck upon My cheek,","s":201.85,"e":206.73},{"t":"I do not pull away…","s":206.85,"e":211.65},{"t":"They turn from Life itself,","s":211.75,"e":216.02},{"t":"and welcome darkness as if day..","s":216.1,"e":222.28},{"t":"I am not divided in My heart.","s":222.3,"e":227.23},{"t":"I love those who cause My pain.","s":227.35,"e":231.96},{"t":"The same hands stretch out to heal","s":232.02,"e":235.25},{"t":"wearing scars that will always remain","s":235.34,"e":242.03},{"t":"I grieve what would perish,","s":242.19,"e":247.0},{"t":"even as I stand to act…","s":247.09,"e":252.73},{"t":"Justice rises from love itself,","s":252.81,"e":257.75},{"t":"not from absence nor lack.","s":257.83,"e":262.65},{"t":"They choose death.","s":262.66,"e":264.91},{"t":"for what reason no one knows.","s":264.97,"e":271.44},{"t":"They lock arms in rebellion","s":271.48,"e":274.99},{"t":"against the Lover of their souls.","s":275.03,"e":281.32},{"t":"My love is still the same.","s":281.42,"e":286.26},{"t":"My forgiveness still stands wide…","s":286.37,"e":291.2},{"t":"But life cannot be forced","s":291.3,"e":295.09},{"t":"on those who choose the other side.","s":295.21,"e":301.83},{"t":"This is My ache.","s":301.85,"e":306.79},{"t":"This is My grief.","s":306.84,"e":311.41},{"t":"I've given you a taste, My child,","s":311.45,"e":314.98},{"t":"because you stay with Me.","s":315.0,"e":321.18},{"t":"oh . My scars remain forever.","s":321.26,"e":331.4},{"t":"My scars remain","s":331.48,"e":332.91}],"match":null}
