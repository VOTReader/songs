{"v":1,"id":"9d6f4b9589f8","synced":false,"offset":null,"source":"whisper","lines":[{"t":"My Love Is Equal","s":19.86,"e":22.06},{"t":"I spilled my blood freely","s":30.42,"e":33.34},{"t":"My offer crosses every line","s":35.02,"e":38.18},{"t":"I did not measure","s":40.58,"e":43.24},{"t":"For worth nor favor by name","s":43.24,"e":48.4},{"t":"What difference is the answer","s":50.74,"e":53.76},{"t":"When truth is forsaken or claimed","s":53.76,"e":58.38},{"t":"I stand before them openly","s":60.64,"e":63.96},{"t":"With nothing held behind","s":65.86,"e":68.38},{"t":"No hidden terms, no double edges","s":70.8,"e":75.06},{"t":"Only mercy about time","s":75.6,"e":78.98},{"t":"They choose death","s":81.76,"e":84.04},{"t":"For what reason","s":84.04,"e":86.68},{"t":"No one knows","s":86.68,"e":88.8},{"t":"The law comes in rebellion","s":90.6,"e":93.6},{"t":"Against the lover of their souls","s":94.16,"e":98.7},{"t":"When struck upon my cheek","s":100.6,"e":104.9},{"t":"I do not pull away","s":104.9,"e":109.24},{"t":"They turn from life itself","s":109.8,"e":114.82},{"t":"And welcome darkness as if day","s":114.82,"e":118.88},{"t":"I wait past what mercy asks","s":122.28,"e":125.36},{"t":"Past what patience can endure","s":126.78,"e":129.38},{"t":"I bear the weight of every plea","s":131.94,"e":135.08},{"t":"Wishing hearts would still be cured","s":136.94,"e":139.92},{"t":"I am long suffering","s":141.56,"e":144.5},{"t":"Through suffering they can't see","s":144.5,"e":149.28},{"t":"But rejected love","s":151.64,"e":154.92},{"t":"Cannot force itself to be","s":156.54,"e":159.8},{"t":"You know this grief already","s":161.6,"e":164.8},{"t":"It lives inside my chest","s":166.68,"e":169.84},{"t":"My love is without coercion","s":171.76,"e":175.44},{"t":"It is mine to risk","s":177.14,"e":181.22},{"t":"They choose death","s":181.22,"e":183.98},{"t":"For what reason no one knows","s":184.48,"e":188.84},{"t":"The law comes in rebellion","s":190.6,"e":193.5},{"t":"Against the lover of their souls","s":193.5,"e":198.62},{"t":"When struck upon my cheek","s":200.16,"e":204.7},{"t":"I do not pull away","s":204.7,"e":209.04},{"t":"They turn from life itself","s":209.6,"e":214.6},{"t":"And welcome darkness as if dead","s":214.6,"e":218.66},{"t":"I am not divided in my heart","s":221.1,"e":224.98},{"t":"I love those who cause my pain","s":226.02,"e":229.78},{"t":"The same hands stretch out to heal","s":230.9,"e":234.7},{"t":"Wearing scars that will always remain","s":234.7,"e":239.52},{"t":"I grieve what would perish","s":240.92,"e":243.64},{"t":"Even as I stand to wear","s":245.64,"e":248.92},{"t":"Justice rises from love itself","s":251.22,"e":255.64},{"t":"Not from absence, no, that","s":255.64,"e":260.68},{"t":"They choose death","s":260.68,"e":263.62},{"t":"For what reason no one knows","s":263.62,"e":268.46},{"t":"Law comes in rebellion","s":270.16,"e":273.28},{"t":"Against the lover of their souls","s":273.28,"e":278.16},{"t":"My love is still the same","s":279.9,"e":284.3},{"t":"My forgiveness still stands wide","s":284.3,"e":289.08},{"t":"But life cannot be forced","s":289.08,"e":294.38},{"t":"On those who choose the other side","s":294.92,"e":297.78},{"t":"This is my","s":300.68,"e":302.38},{"t":"This is my grief","s":302.38,"e":307.82},{"t":"I've given you a taste, my child","s":310.38,"e":313.9},{"t":"Because you stayed with me","s":313.9,"e":317.66},{"t":"My scars remain","s":319.96,"e":322.2},{"t":"Forever","s":323.32,"e":324.44},{"t":"Forever","s":326.02,"e":327.42},{"t":"My scars remain","s":327.42,"e":332.1}],"match":null}
