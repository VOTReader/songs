{"v":1,"id":"5749282b350c","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Amen","s":0.0,"e":1.38},{"t":"Amen","s":7.6,"e":9.0},{"t":"Amen","s":11.04,"e":12.44},{"t":"Amen","s":14.46,"e":15.86},{"t":"Amen","s":15.86,"e":18.12},{"t":"Amen","s":23.48,"e":23.52},{"t":"Lord, if they strike again","s":26.4,"e":30.78},{"t":"Teach me to turn my cheek","s":30.78,"e":34.62},{"t":"If curses fill the room","s":34.62,"e":38.02},{"t":"Let your blessings rise in me","s":38.02,"e":42.38},{"t":"I take refuge in you","s":42.38,"e":45.26},{"t":"My sanctuary from the storm","s":45.26,"e":47.98},{"t":"In the heat of the day","s":49.26,"e":51.46},{"t":"Keep me hidden, keep me warm","s":52.5,"e":56.46},{"t":"Faith in my mind","s":56.46,"e":58.7},{"t":"Feet on the rock","s":60.2,"e":62.18},{"t":"No fear in my heart","s":62.18,"e":65.8},{"t":"No answer but your love","s":66.92,"e":69.4},{"t":"Amen","s":71.74,"e":72.7},{"t":"Amen to the amen","s":74.02,"e":76.38},{"t":"The way, the truth, the lie","s":77.12,"e":79.72},{"t":"If you are my, yes again","s":81.04,"e":84.92},{"t":"Amen, amen","s":87.56,"e":89.24},{"t":"Let it be so in me","s":89.24,"e":92.0},{"t":"If the whole earth shakes, shakes","s":92.0,"e":95.12},{"t":"You are my sanctuary","s":95.12,"e":98.42},{"t":"They cannot kill what's already crucified","s":100.3,"e":104.02},{"t":"They cannot make me hate while your mercy burns inside","s":104.02,"e":107.64},{"t":"Make me strange in you, peculiar in your love","s":107.64,"e":110.8},{"t":"Not hardened by the storm, but hidden high above","s":110.8,"e":114.14},{"t":"I was bound like them, but you set me free","s":114.14,"e":117.82},{"t":"Let them see your light as they look at me","s":117.82,"e":121.28},{"t":"Amen, amen to the amen","s":121.28,"e":125.78},{"t":"The way, the truth, the life","s":126.9,"e":129.94},{"t":"You are my yes again","s":130.62,"e":134.18},{"t":"Amen","s":135.26,"e":135.94},{"t":"Amen, let it be so in me","s":137.8,"e":141.2},{"t":"If the whole earth shakes","s":141.2,"e":143.6},{"t":"You are my sanctuary","s":143.6,"e":147.44},{"t":"If the blade is raised","s":150.04,"e":151.6},{"t":"If my breath grows thin","s":151.6,"e":153.26},{"t":"Let me speak your name","s":153.26,"e":155.06},{"t":"No, no hatred within","s":155.06,"e":156.9},{"t":"If they curse again","s":156.9,"e":158.44},{"t":"Teach me blessing, not defense","s":158.44,"e":160.18},{"t":"If they take my life","s":160.18,"e":162.24},{"t":"Let it fall in your hands","s":162.24,"e":164.24},{"t":"I remain in your love","s":164.24,"e":167.72},{"t":"I remain in your love","s":167.72,"e":171.18},{"t":"I remain in your love","s":171.18,"e":175.14},{"t":"Amen","s":176.8,"e":177.96},{"t":"Amen","s":183.58,"e":184.74},{"t":"Amen","s":187.04,"e":188.2},{"t":"Amen","s":188.9,"e":189.62},{"t":"Amen","s":204.26,"e":205.44},{"t":"Amen","s":205.44,"e":205.82},{"t":"Amen to the amen","s":205.82,"e":209.3},{"t":"My shelter and my song","s":209.3,"e":213.0},{"t":"My beginning and my end","s":213.0,"e":217.84},{"t":"Amen","s":217.84,"e":219.54},{"t":"Amen","s":219.54,"e":221.74},{"t":"Let it be so in me","s":221.74,"e":224.58},{"t":"Under healing wings","s":224.58,"e":226.64},{"t":"I am Yours eternally","s":227.84,"e":231.44},{"t":"Lord, You are everything","s":234.46,"e":236.36},{"t":"Amen","s":239.74,"e":240.14},{"t":"So let it be","s":241.74,"e":242.94},{"t":"Amen","s":244.26,"e":245.18}],"match":null}
