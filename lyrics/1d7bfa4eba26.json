{"v":1,"id":"1d7bfa4eba26","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 1)","s":32.21,"e":32.87},{"t":"On the seventh day,","s":32.91,"e":35.96},{"t":"My weary heart can rest.","s":36.03,"e":39.63},{"t":"And I can be at peace,","s":39.71,"e":42.26},{"t":"And think of Your holiness.","s":42.34,"e":46.03},{"t":"Six days I labor,","s":46.13,"e":48.56},{"t":"But on the seventh my worries cease,","s":48.64,"e":54.13},{"t":"And in the quiet stillness,","s":54.19,"e":56.54},{"t":"My soul can rest at peace.","s":56.62,"e":58.73},{"t":"(Pre-Chorus)","s":58.33,"e":62.09},{"t":"I'll carry my cross six days,","s":62.13,"e":65.46},{"t":"But on the seventh I'll rest.","s":65.52,"e":69.61},{"t":"The Sabbath is a day I cherish,","s":69.67,"e":73.14},{"t":"In its peace my worries perish.","s":73.22,"e":77.31},{"t":"(Chorus)","s":75.56,"e":77.39},{"t":"Shabbat Shalom!","s":77.42,"e":79.39},{"t":"It's finally the Sabbath day.","s":79.41,"e":83.77},{"t":"On it I find peace,","s":83.88,"e":86.04},{"t":"And I think of You,","s":86.1,"e":87.74},{"t":"Lord,","s":87.82,"e":88.16},{"t":"In every way.","s":88.27,"e":90.82},{"t":"As I rest on this day,","s":90.88,"e":94.48},{"t":"I put my worries aside.","s":94.6,"e":98.19},{"t":"You made the Sabbath for love,","s":98.27,"e":101.04},{"t":"And I thank you for it.","s":101.1,"e":103.48},{"t":"Oh, it's the seventh day,","s":103.59,"e":109.98},{"t":"The Sabbath day.","s":110.04,"e":115.71},{"t":"(Verse 2)","s":110.98,"e":116.25},{"t":"Morning light through the window,","s":116.32,"e":120.34},{"t":"Gentle warmth on my face.","s":120.38,"e":123.85},{"t":"In the peace of this day,","s":123.91,"e":126.63},{"t":"I feel Your loving embrace.","s":126.75,"e":129.41},{"t":"It's a day free from the worries of this world.","s":129.44,"e":134.3},{"t":"Your love is whispered in the breeze.","s":134.35,"e":138.76},{"t":"Every moment a reminder,","s":138.8,"e":141.35},{"t":"Of Your love that never leaves.","s":141.43,"e":145.54},{"t":"(Pre-Chorus)","s":143.28,"e":146.42},{"t":"I'll carry my cross six days,","s":146.46,"e":148.79},{"t":"But on the seventh I'll rest.","s":148.89,"e":154.02},{"t":"The Sabbath is a day I cherish,","s":154.08,"e":157.55},{"t":"In its peace my worries perish.","s":157.63,"e":161.73},{"t":"(Chorus)","s":159.97,"e":161.8},{"t":"Shabbat Shalom!","s":161.82,"e":163.8},{"t":"It's finally the Sabbath day.","s":163.83,"e":168.19},{"t":"On it I find peace,","s":168.3,"e":170.46},{"t":"And I think of You,","s":170.52,"e":171.93},{"t":"Lord,","s":172.02,"e":172.58},{"t":"In every way.","s":172.68,"e":175.16},{"t":"As I rest on this day,","s":175.21,"e":176.66},{"t":"I put my worries aside.","s":176.7,"e":182.6},{"t":"You made the Sabbath for love,","s":182.68,"e":185.46},{"t":"And I thank you for it.","s":185.52,"e":187.82},{"t":"Oh, it's the seventh day,","s":187.92,"e":194.31},{"t":"The Sabbath day.","s":194.37,"e":209.92},{"t":"(Final Chorus)","s":195.32,"e":229.26},{"t":"Shabbat Shalom!","s":229.32,"e":231.83},{"t":"It is the Sabbath day.","s":231.91,"e":236.09},{"t":"On this day I'll think of You,","s":236.19,"e":238.42},{"t":"In every day.","s":238.53,"e":243.9},{"t":"YahuShua,","s":244.0,"e":251.79},{"t":"Thank You for this day.","s":251.89,"e":258.06},{"t":"The Sabbath day.","s":258.12,"e":259.52}],"match":null}
