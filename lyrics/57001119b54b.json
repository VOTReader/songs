{"v":1,"id":"57001119b54b","synced":true,"offset":0,"source":"suno","lines":[{"t":"I chased the fading echoes","s":26.57,"e":29.84},{"t":"Of all I thought I’d be,","s":29.88,"e":32.69},{"t":"And held so tightly to my plans","s":32.75,"e":35.27},{"t":"I had no hands left free.","s":35.43,"e":39.51},{"t":"But here beneath the silence,","s":39.56,"e":42.47},{"t":"My heart can finally see:","s":42.58,"e":45.84},{"t":"I asked for You to lead the way,","s":45.96,"e":48.56},{"t":"Then kept the reins with me.","s":48.61,"e":77.13},{"t":"Now here beneath the noise,","s":77.15,"e":80.31},{"t":"With nothing left to prove,","s":80.36,"e":83.58},{"t":"I bring the things I guarded","s":83.7,"e":86.41},{"t":"And lay them down to You.","s":86.52,"e":89.78},{"t":"The anger I called justice,","s":89.82,"e":92.91},{"t":"The pride I called my strength—","s":92.95,"e":95.9},{"t":"I cannot call it turning","s":96.06,"e":98.78},{"t":"And walk the same old way.","s":98.88,"e":101.62},{"t":"Turn my face toward You.","s":101.69,"e":104.62},{"t":"Set my feet in truth.","s":104.72,"e":107.73},{"t":"Let the love I sing","s":107.83,"e":110.67},{"t":"Become the things I do.","s":110.73,"e":138.69},{"t":"Let me notice those forgotten,","s":138.7,"e":141.61},{"t":"Make some room for them instead.","s":141.67,"e":145.09},{"t":"Where I have wounded others,","s":145.13,"e":147.59},{"t":"Let me face the words I said.","s":147.65,"e":151.21},{"t":"Not only in the gathering,","s":151.26,"e":154.15},{"t":"Not only in the song—","s":154.23,"e":157.32},{"t":"But in the hidden hours,","s":157.38,"e":159.8},{"t":"Teach my heart where it belongs.","s":159.87,"e":162.9},{"t":"Turn my face toward You.","s":162.97,"e":165.9},{"t":"Set my feet in truth.","s":166.0,"e":168.99},{"t":"Let the love I sing","s":169.07,"e":171.94},{"t":"Become the things I do.","s":172.02,"e":197.83},{"t":"YahuShua,","s":197.84,"e":201.54},{"t":"Here is my heart.","s":201.64,"e":203.74},{"t":"No speech to dress it.","s":203.84,"e":207.39},{"t":"No veil to hide.","s":207.5,"e":209.73},{"t":"You bore the cross—","s":209.79,"e":212.63},{"t":"I lay down my pride.","s":212.79,"e":223.84},{"t":"Until my hands learn mercy,","s":223.88,"e":226.97},{"t":"Until my feet choose truth,","s":227.02,"e":230.16},{"t":"Until the way I live","s":230.21,"e":232.9},{"t":"Turns someone’s eyes to You—","s":232.99,"e":236.78},{"t":"Let my life say Your name.","s":236.84,"e":239.84},{"t":"Let my life say Your name.","s":239.92,"e":242.6},{"t":"More than the words I raise,","s":242.65,"e":245.66},{"t":"Let my life say Your name.","s":245.74,"e":249.22},{"t":"Let my life say Your name.","s":249.29,"e":252.29},{"t":"Let my life say Your name.","s":252.37,"e":255.45},{"t":"In the quiet, in the waiting,","s":255.51,"e":258.43},{"t":"Let my life say Your name.","s":258.51,"e":284.03},{"t":"My first Love…","s":284.06,"e":293.5},{"t":"I am turning.","s":293.62,"e":296.58},{"t":"My first Love…","s":296.58,"e":306.0},{"t":"Lead me home.","s":306.1,"e":308.14}],"match":null}
