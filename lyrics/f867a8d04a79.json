{"v":1,"id":"f867a8d04a79","synced":true,"offset":0,"source":"suno","lines":[{"t":"My children…","s":4.07,"e":10.17},{"t":"I still know your names.","s":10.29,"e":15.93},{"t":"Even now…","s":15.97,"e":16.36},{"t":"I still know your names.","s":18.59,"e":27.26},{"t":"I walked among the trees I planted,","s":27.28,"e":32.59},{"t":"Reached for fruit on every limb.","s":32.63,"e":36.9},{"t":"Found the branches bare and broken,","s":36.94,"e":40.89},{"t":"Found the daylight growing dim.","s":40.93,"e":44.87},{"t":"There were cries behind your windows,","s":44.89,"e":48.38},{"t":"There was blood upon your stones,","s":48.4,"e":51.98},{"t":"And you learned to call it living","s":52.02,"e":55.21},{"t":"While you left each other alone.","s":55.24,"e":58.68},{"t":"I have seen the little children","s":58.72,"e":62.07},{"t":"Learn to hide before they pray.","s":62.14,"e":65.78},{"t":"I have heard you ask for mercy,","s":65.9,"e":68.84},{"t":"Then turn the merciful away.","s":68.9,"e":74.07},{"t":"Do you think I do not feel it?","s":74.09,"e":78.8},{"t":"Do you think I cannot weep?","s":78.86,"e":82.1},{"t":"Every heart you leave in pieces","s":82.18,"e":85.21},{"t":"Cuts a wound in Me so deep.","s":85.29,"e":89.34},{"t":"My tears run down,","s":89.37,"e":93.3},{"t":"My blood runs down.","s":93.4,"e":96.58},{"t":"I call your name—","s":96.7,"e":99.51},{"t":"You drown Me out.","s":99.61,"e":102.87},{"t":"My arms are open,","s":102.98,"e":106.05},{"t":"Your fists are closed.","s":106.15,"e":109.19},{"t":"I reach for children","s":109.31,"e":112.26},{"t":"Who won’t come home.","s":112.37,"e":116.6},{"t":"No pleasure in the breaking,","s":116.7,"e":120.74},{"t":"No joy in what must come.","s":120.85,"e":125.37},{"t":"Oh, My people…","s":125.48,"e":131.47},{"t":"What have you done?","s":131.54,"e":137.21},{"t":"Every tree is drinking sorrow,","s":137.24,"e":140.27},{"t":"Every root is wrapped in stone.","s":140.35,"e":143.32},{"t":"There’s a hunger in your houses","s":143.35,"e":145.93},{"t":"Bread and gold have never known.","s":145.99,"e":149.24},{"t":"And the darkness you keep feeding","s":149.28,"e":152.0},{"t":"Has become a canyon wide.","s":152.1,"e":155.39},{"t":"Still I call across the distance;","s":155.43,"e":158.34},{"t":"Still you find a place to hide.","s":158.38,"e":161.55},{"t":"Even those who wore My name","s":161.62,"e":164.92},{"t":"Have learned to turn their eyes.","s":165.0,"e":167.59},{"t":"They have left the wounded waiting","s":167.62,"e":170.43},{"t":"With My words upon their lips.","s":170.49,"e":175.24},{"t":"Must you make a stranger of Me?","s":175.25,"e":179.49},{"t":"Must you teach your hearts to hate?","s":179.54,"e":182.63},{"t":"I am calling through your silence—","s":182.71,"e":185.74},{"t":"Do not turn your face away.","s":185.82,"e":189.75},{"t":"My tears run down,","s":189.8,"e":194.07},{"t":"My blood runs down.","s":194.18,"e":197.51},{"t":"I call your name—","s":197.63,"e":200.37},{"t":"You drown Me out.","s":200.47,"e":203.96},{"t":"My arms are open,","s":204.07,"e":207.05},{"t":"Your fists are closed.","s":207.13,"e":210.28},{"t":"I reach for children","s":210.4,"e":213.27},{"t":"Who won’t come home.","s":213.38,"e":217.69},{"t":"No pleasure in the breaking,","s":217.79,"e":222.07},{"t":"No joy in what must come.","s":222.18,"e":226.86},{"t":"Oh, My people…","s":226.97,"e":232.8},{"t":"What have you done?","s":232.87,"e":236.85},{"t":"You bound My hands…","s":236.88,"e":239.36},{"t":"I would have held you.","s":239.36,"e":241.04},{"t":"You bound My feet…","s":241.12,"e":242.71},{"t":"I came to find you.","s":242.71,"e":244.33},{"t":"You struck My face…","s":244.35,"e":246.14},{"t":"I looked for yours.","s":246.14,"e":247.74},{"t":"You pierced My side…","s":247.82,"e":249.44},{"t":"And still, these arms—","s":249.46,"e":260.05},{"t":"These arms are yours.","s":260.06,"e":263.85},{"t":"And still the hammer rises.","s":263.89,"e":267.15},{"t":"And still I hear the sound.","s":267.25,"e":270.58},{"t":"And still I call you children","s":270.68,"e":273.43},{"t":"As My blood falls to the ground.","s":273.55,"e":277.62},{"t":"I do not want to lose you.","s":277.74,"e":280.35},{"t":"Can you hear Me through the rain?","s":280.41,"e":283.77},{"t":"Have you grown so far from mercy","s":283.82,"e":288.99},{"t":"You no longer know My pain?","s":289.07,"e":294.46},{"t":"My tears run down,","s":294.48,"e":299.23},{"t":"My blood runs down.","s":299.33,"e":303.15},{"t":"There is no gladness","s":303.19,"e":305.58},{"t":"In this wounded sound.","s":305.7,"e":309.28},{"t":"My arms are open—","s":309.39,"e":312.7},{"t":"They’re open still.","s":312.72,"e":316.06},{"t":"You turn against Me…","s":316.16,"e":320.07},{"t":"I love you still.","s":320.19,"e":324.77},{"t":"No pleasure in the breaking—","s":324.89,"e":328.51},{"t":"No pleasure… none at all.","s":328.62,"e":333.07},{"t":"I never stopped calling.","s":333.19,"e":337.32},{"t":"Did you hear Me call?","s":337.38,"e":341.9},{"t":"OH, MY PEOPLE…","s":341.99,"e":347.33},{"t":"WHY HAVE YOU FORSAKEN ME?","s":347.43,"e":353.32},{"t":"The earth falls quiet.","s":353.33,"e":356.57},{"t":"The branches bow.","s":356.65,"e":359.24},{"t":"I called you then…","s":359.36,"e":363.39},{"t":"I call you now.","s":363.51,"e":367.93},{"t":"My children…","s":368.03,"e":371.84},{"t":"My children…","s":371.94,"e":375.16},{"t":"My arms…","s":375.16,"e":384.0},{"t":"Are open…","s":384.06,"e":387.77},{"t":"Still.","s":387.86,"e":388.48}],"match":null}
