{"v":1,"id":"72c8e014cafd","synced":true,"offset":0,"source":"suno","lines":[{"t":"O Lord, how shall I thank You for all You have done?","s":26.25,"e":36.91},{"t":"I haven’t the words to express my gratitude","s":37.02,"e":42.93},{"t":"For what You did for me on the cross;","s":43.03,"e":48.71},{"t":"I am forever indebted to You...","s":48.83,"e":54.52},{"t":"You are my Passover,","s":54.56,"e":57.8},{"t":"You rescued me from death,","s":57.89,"e":62.97},{"t":"You restored my soul...","s":63.07,"e":73.67},{"t":"Oh my God, my God,","s":73.74,"e":78.99},{"t":"In the name of YahuShua my Savior,","s":79.07,"e":85.35},{"t":"I say, amen, forever amen...","s":85.45,"e":96.6},{"t":"MY REDEEMER LIVES!","s":96.65,"e":107.75},{"t":"MY REDEEMER LIVES!","s":107.81,"e":130.33},{"t":"MY REDEEMER LIVES!","s":130.43,"e":137.39}],"match":null}
