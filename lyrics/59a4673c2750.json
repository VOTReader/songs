{"v":1,"id":"59a4673c2750","synced":true,"offset":0,"source":"suno","lines":[{"t":"Verse 1","s":0.45,"e":4.26},{"t":"The silence echoes deep inside my chest,","s":4.29,"e":6.83},{"t":"Flickers fade where I once found rest.","s":6.88,"e":31.59},{"t":"I chased the dawn through an empty sky,","s":31.65,"e":37.02},{"t":"Till I heard Your voice reply.","s":37.05,"e":40.28},{"t":"Pre-Chorus","s":40.38,"e":42.34},{"t":"In the stillness, You whisper my name,","s":42.38,"e":46.57},{"t":"A spark through the dark—unchained by shame.","s":46.65,"e":50.5},{"t":"Chorus","s":50.52,"e":50.73},{"t":"YahuShua, break through the shadow,","s":50.78,"e":59.91},{"t":"Lift me where the lost wind blows.","s":59.95,"e":64.78},{"t":"Your light cuts through my sorrow,","s":64.82,"e":67.83},{"t":"Now my weary spirit knows—","s":67.92,"e":71.36},{"t":"Every tear was leading home.","s":71.38,"e":76.59},{"t":"Verse 2","s":76.62,"e":76.82},{"t":"The storm surrounds, but You still remain,","s":76.84,"e":91.27},{"t":"Turning fear to holy flame.","s":91.36,"e":96.71},{"t":"The chains I wore fall to the ground,","s":96.75,"e":101.88},{"t":"Your mercy sings, a healing sound.","s":101.92,"e":105.22},{"t":"Bridge (Instrumental Build + Short Lyrical Lift)","s":105.23,"e":108.67},{"t":"Every scar You turn to gold,","s":108.76,"e":112.16},{"t":"Every story grace foretold.","s":112.19,"e":118.59},{"t":"You breathe life where ashes lay,","s":118.69,"e":123.44},{"t":"And darkness fades away.","s":123.48,"e":126.13},{"t":"Final Chorus (Grand & Emotional)","s":126.14,"e":127.83},{"t":"YahuShua, break through the shadow,","s":127.92,"e":132.78},{"t":"Raise my heart where the rivers flow.","s":132.82,"e":137.66},{"t":"Your love conquers the sorrow,","s":137.71,"e":140.83},{"t":"Every wound You overflow—","s":140.91,"e":144.18},{"t":"Now I’m finally home.","s":144.19,"e":191.47},{"t":"Outro (Quiet Fade)","s":191.57,"e":194.15},{"t":"YahuShua… You lead me home.","s":194.25,"e":208.53}],"match":null}
