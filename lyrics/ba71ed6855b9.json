{"v":1,"id":"ba71ed6855b9","synced":true,"offset":0,"source":"suno","lines":[{"t":"Beloved, be My examples...","s":0.16,"e":5.27},{"t":"Order your speech like David,","s":5.34,"e":9.49},{"t":"And conduct yourselves as Daniel...","s":9.57,"e":14.98},{"t":"Let your speech express your","s":15.01,"e":16.76},{"t":"Love for Me in every situation,","s":16.86,"e":20.09},{"t":"And let your conduct reveal My spirit","s":20.15,"e":22.74},{"t":"In you in open and in secret...","s":22.86,"e":32.79},{"t":"Beloved, prepare as though I were","s":32.83,"e":38.22},{"t":"Coming to take you this very day;","s":38.28,"e":41.23},{"t":"Walk with Me as though we walk","s":41.3,"e":43.48},{"t":"Together in the Garden already...","s":43.54,"e":49.98},{"t":"Says The Lord.","s":50.05,"e":51.14}],"match":null}
