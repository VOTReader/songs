{"v":1,"id":"343181338558","synced":true,"offset":0,"source":"suno","lines":[{"t":"YahuShua,","s":4.97,"e":9.54},{"t":"The Lion rises, fierce and bold.","s":9.58,"e":15.72},{"t":"The earth stands still beneath His flame,","s":15.78,"e":18.95},{"t":"For every knee will bow to His name.","s":19.05,"e":28.33},{"t":"His voice commands the winds of night,","s":28.39,"e":31.58},{"t":"His glory blinds the strongest light.","s":31.62,"e":34.29},{"t":"With righteousness His robe is sealed,","s":34.33,"e":37.92},{"t":"His hidden mysteries revealed.","s":38.0,"e":41.1},{"t":"The mountains crack before His pace,","s":41.13,"e":44.21},{"t":"The nations crumble in His face.","s":44.27,"e":47.34},{"t":"He shakes the heavens with a word,","s":47.42,"e":50.49},{"t":"The King of Truth, the only Lord.","s":50.53,"e":56.28},{"t":"YahuShua,","s":56.36,"e":58.55},{"t":"Stormbreaker of Zion,","s":58.59,"e":60.24},{"t":"Righteous Judge we rely on.","s":60.29,"e":62.51},{"t":"Thunder falls at Your decree,","s":62.52,"e":66.55},{"t":"Chains dissolve and captives flee.","s":66.6,"e":69.14},{"t":"YahuShua,","s":69.18,"e":71.28},{"t":"Fire on the throne,","s":71.36,"e":72.86},{"t":"Claiming every soul You own.","s":72.92,"e":76.0},{"t":"All creation bows before","s":76.1,"e":78.7},{"t":"The mighty King forevermore.","s":78.78,"e":91.41},{"t":"He stands where ancient prophets saw,","s":91.51,"e":94.11},{"t":"The living Word, the final law.","s":94.13,"e":97.68},{"t":"His eyes like coals, His presence strong,","s":97.76,"e":101.02},{"t":"The Shepherd calling every child.","s":101.08,"e":104.04},{"t":"The wicked flee from His burning gaze,","s":104.1,"e":107.16},{"t":"The humble rise in newborn blaze.","s":107.22,"e":110.29},{"t":"For mercy flows from His hand,","s":110.37,"e":113.22},{"t":"And His truth restores the broken land.","s":113.28,"e":119.41},{"t":"YahuShua,","s":119.51,"e":121.67},{"t":"Stormbreaker of Zion,","s":121.73,"e":123.42},{"t":"Righteous Judge we rely on.","s":123.46,"e":126.