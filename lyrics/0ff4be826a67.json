{"v":1,"id":"0ff4be826a67","synced":false,"offset":null,"source":"whisper","lines":[{"t":"You are more than the filth that covers you","s":23.78,"e":29.08},{"t":"More than the sin that fills you","s":29.08,"e":34.96},{"t":"Much more than the choices you make","s":34.96,"e":40.0},{"t":"For I see your beauty","s":41.6,"e":45.64},{"t":"I know your heart","s":49.18,"e":54.36},{"t":"And the love which you have for me","s":54.36,"e":59.08},{"t":"Behold, I know you as you are","s":60.22,"e":64.8},{"t":"And will be with me where I am","s":65.32,"e":70.6},{"t":"You are not that which you choose","s":73.78,"e":77.74},{"t":"In the moment of weakness","s":80.24,"e":83.28},{"t":"You are that which I have created","s":86.76,"e":90.44},{"t":"And will become that which I restore","s":92.88,"e":98.42},{"t":"And will remain","s":99.72,"e":102.48},{"t":"Always a beautiful finished work","s":104.32,"e":109.84},{"t":"Elect and precious","s":112.26,"e":115.08},{"t":"My everlasting treasure","s":118.24,"e":122.2},{"t":"Even as I shall be yours also","s":122.2,"e":128.72},{"t":"For I know my own","s":132.48,"e":134.84},{"t":"For I know my own","s":138.12,"e":141.38},{"t":"For I know my own","s":144.66,"e":147.68},{"t":"Says the Lord","s":151.86,"e":154.0}],"match":{"letter":"wtlb1:elect-and-precious","score":0.953}}
