{"v":1,"id":"93ff1ae57385","synced":true,"offset":0,"source":"suno","lines":[{"t":"I came to you with servant hands,","s":22.82,"e":27.87},{"t":"no sword upon My side.","s":27.98,"e":32.83},{"t":"I wore the weight you couldn’t lift,","s":32.95,"e":36.98},{"t":"I let My innocence be tried.","s":37.1,"e":42.49},{"t":"A thorny crown left these marks...","s":42.61,"e":47.29},{"t":"They pierced hand and feet.","s":47.34,"e":52.39},{"t":"This was not weakness, child...","s":52.44,"e":56.73},{"t":"I gave all for My sheep.","s":56.81,"e":63.07},{"t":"Do not mistake the quiet","s":63.09,"e":67.5},{"t":"for a heart that does not burn.","s":67.61,"e":73.1},{"t":"Mercy called in gentle whispers","s":73.19,"e":78.35},{"t":"so the world could finally learn.","s":78.47,"e":85.2},{"t":"I am the same One.","s":85.23,"e":89.09},{"t":"That banked wrath into a cup.","s":89.14,"e":94.05},{"t":"The hand that healed and holds you","s":94.11,"e":98.7},{"t":"will pour wrath out when time is up.","s":98.8,"e":103.68},{"t":"I can not shift My nature","s":103.8,"e":108.43},{"t":"My eyes burn with Holy flame.","s":108.55,"e":113.42},{"t":"I am the same One.","s":113.54,"e":118.44},{"t":"I will always remain.","s":118.56,"e":129.69},{"t":"I did not come confused or late,","s":129.71,"e":134.52},{"t":"nor unaware of men.","s":134.6,"e":139.43},{"t":"I knew the cost of waiting long,","s":139.55,"e":144.22},{"t":"I knew what terries then.","s":144.34,"e":149.1},{"t":"The Lamb who stood before you","s":149.16,"e":153.83},{"t":"was never blind to wrong…","s":153.94,"e":158.82},{"t":"I chose to bear it silently","s":158.94,"e":163.8},{"t":"until the time was gone.","s":163.88,"e":169.66},{"t":"Compassion held the hour,","s":169.67,"e":174.9},{"t":"patience stayed My hand…","s":174.99,"e":179.44},{"t":"But justice was not sleeping,","s":179.52,"e":185.2},{"t":"only waiting to stand.","s":185.3,"e":191.88},{"t":"I am the same One.","s":191.91,"e":195.72},{"t":"That banked wrath into a cup.","s":195.8,"e":200.64},{"t":"The One that heals and holds you","s":200.7,"e":205.29},{"t":"will pour out wrath when time is up.","s":205.39,"e":208.48},{"t":"I can not shift My nature","s":208.56,"e":215.11},{"t":"My eyes burn with Holy flame.","s":215.23,"e":220.09},{"t":"I am the same One.","s":220.21,"e":225.2},{"t":"I will always remain.","s":225.32,"e":229.6},{"t":"To show love by suffering,","s":229.62,"e":234.53},{"t":"I chose the longest road.","s":234.65,"e":239.44},{"t":"To heal wounds by waiting,","s":239.52,"e":244.27},{"t":"I carried every load.","s":244.39,"e":247.02},{"t":"But a love without passion","s":247.1,"e":251.17},{"t":"will not rise and guard the pure…","s":251.25,"e":256.38},{"t":"So My justice carried out,","s":256.49,"e":261.81},{"t":"is evil's final cure","s":261.91,"e":269.53},{"t":"I am the same One.","s":269.54,"e":273.35},{"t":"That banked wrath into a cup.","s":273.43,"e":278.22},{"t":"The One that heals and holds you","s":278.3,"e":282.93},{"t":"will pour out wrath when time is up.","s":283.03,"e":287.55},{"t":"Do not fear the hour coming..","s":287.63,"e":292.29},{"t":"Dread mistaking Who I AM","s":292.31,"e":297.53},{"t":"I am the same One, child.","s":297.69,"e":303.15},{"t":"I always have been.","s":303.27,"e":311.93},{"t":"Stay close.","s":312.0,"e":324.93},{"t":"I will help you see...","s":325.05,"e":349.36},{"t":"To understand what comes,","s":349.45,"e":354.27},{"t":"Seek to know Me.","s":354.37,"e":356.41}],"match":null}
