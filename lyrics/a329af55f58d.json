{"v":1,"id":"a329af55f58d","synced":true,"offset":0,"source":"suno","lines":[{"t":"Sabbath peace…","s":12.37,"e":16.89},{"t":"Set-apart time…","s":16.95,"e":21.86},{"t":"YahuShua reigns…","s":21.94,"e":28.53},{"t":"On the Sabbath day, I guard my tongue,","s":28.55,"e":35.21},{"t":"No careless word, no evil one,","s":35.32,"e":41.66},{"t":"Only praise rising from my mouth,","s":41.76,"e":48.19},{"t":"Beauty clothed in truth and light.","s":48.27,"e":54.83},{"t":"Grace surrounds me like a shield,","s":54.92,"e":61.37},{"t":"Gentle heart, my spirit kneels,","s":61.46,"e":68.0},{"t":"Humility walks by my side,","s":68.1,"e":72.87},{"t":"In stillness, Yah is glorified.","s":72.98,"e":79.09},{"t":"Sabbath peace, let the world be still,","s":79.11,"e":85.39},{"t":"Put away the work, submit the will,","s":85.49,"e":91.93},{"t":"From sunset glow to evening star,","s":92.03,"e":98.5},{"t":"I remember You — You remember me, Yah.","s":98.62,"e":104.79},{"t":"Sabbath peace, holy rest,","s":104.89,"e":109.75},{"t":"Seventh day, forever blessed,","s":109.87,"e":117.49},{"t":"I let it go, every care released,","s":117.61,"e":124.89},{"t":"In Your presence — Sabbath peace.","s":125.0,"e":159.7},{"t":"Lay down burdens, lay down fear,","s":159.72,"e":166.1},{"t":"The noise of man won’t enter here,","s":166.16,"e":172.77},{"t":"No buying, selling, no heavy load,","s":172.87,"e":179.27},{"t":"Just awe of Yah and His holy road.","s":179.33,"e":186.21},{"t":"Heaven and earth by His command,","s":186.28,"e":192.87},{"t":"All creation from His hand,","s":192.97,"e":199.56},{"t":"Even Yahuwah paused and blessed,","s":199.66,"e":204.43},{"t":"And called this day His sacred rest.","s":204.53,"e":210.66},{"t":"Sabbath peace, let the world be still,","s":210.68,"e":216.88},{"t":"Put away the work, submit the will,","s":216.98,"e":223.42},{"t":"From sunset glow to evening star,","s":223.52,"e":230.07},{"t":"I remember You — You remember me, Yah.","s":230.19,"e":236.36},{"t":"Sabbath peace, holy rest,","s":236.46,"e":242.82},{"t":"Seventh day, forever blessed,","s":242.93,"e":248.98},{"t":"I let it go, every care released,","s":249.1,"e":256.38},{"t":"In Your presence — Sabbath peace.","s":256.49,"e":263.71},{"t":"Remember the Sabbath…","s":263.72,"e":267.05},{"t":"And your God…","s":267.13,"e":269.66},{"t":"And He shall remember you.","s":269.72,"e":272.78},{"t":"Love one another…","s":272.84,"e":275.82},{"t":"As I have loved you…","s":275.9,"e":280.39},{"t":"Rest… and be renewed.","s":280.48,"e":291.59},{"t":"Crown of glory, promised true,","s":291.61,"e":297.86},{"t":"Given by the Faithful and True,","s":297.95,"e":304.63},{"t":"Says the Lord, YahuShua reigns,","s":304.71,"e":309.28},{"t":"Sabbath peace remains…","s":309.31,"e":315.85},{"t":"Sabbath peace remains…","s":315.9,"e":317.95}],"match":null}
