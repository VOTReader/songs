{"v":1,"id":"df384cf173c9","synced":true,"offset":0,"source":"suno","lines":[{"t":"The morning dove rests peacefully","s":15.92,"e":19.65},{"t":"In a nearby pecan tree,","s":19.72,"e":24.12},{"t":"Cooing sweet and softly,","s":24.14,"e":28.18},{"t":"Nature’s sunrise choir.","s":28.24,"e":35.96},{"t":"The gentle sounds are echoing","s":35.97,"e":39.82},{"t":"Throughout the universe,","s":39.87,"e":42.9},{"t":"Shabbat Shalom,","s":42.93,"e":46.85},{"t":"Shabbat Shalom.","s":46.91,"e":52.26},{"t":"Calling to its Creator","s":52.37,"e":59.43},{"t":"As each line is rehearsed.","s":59.66,"e":92.02},{"t":"The morning dove has wings","s":92.03,"e":95.41},{"t":"So beautiful and white;","s":95.63,"e":99.89},{"t":"When soaring toward the sun,","s":99.95,"e":103.14},{"t":"You behold God’s awesome light.","s":103.21,"e":107.82},{"t":"So radiant in beauty,","s":107.86,"e":112.58},{"t":"Dazzling and bright,","s":112.77,"e":115.76},{"t":"No words can describe it","s":116.09,"e":120.53},{"t":"As the dove takes flight.","s":120.71,"e":152.37},{"t":"It praises its Creator","s":152.39,"e":159.6},{"t":"And coos, “Shabbat Shalom.”","s":159.69,"e":168.78},{"t":"The Sabbath peace He gave us—","s":168.81,"e":172.64},{"t":"This rest will never cease.","s":172.72,"e":183.93},{"t":"Shabbat Shalom,","s":183.94,"e":188.03},{"t":"Shabbat Shalom.","s":188.1,"e":189.58}],"match":null}
