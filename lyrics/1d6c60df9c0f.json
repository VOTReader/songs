{"v":1,"id":"1d6c60df9c0f","synced":true,"offset":0,"source":"suno","lines":[{"t":"We hear it. We feel it.","s":21.06,"e":24.93},{"t":"Breath unsteady in our chests.","s":24.96,"e":27.45},{"t":"You say You’re coming down...","s":27.53,"e":30.64},{"t":"The earth shakes beneath our steps.","s":30.66,"e":32.99},{"t":"The nations quake at prophecy,","s":33.03,"e":36.93},{"t":"Trembling starts within…","s":36.99,"e":38.86},{"t":"Burn what clings to darkness, Lord;","s":38.94,"e":41.55},{"t":"Make all straight when You descend.","s":41.62,"e":44.29},{"t":"You say, “Cry out for Mercy…”","s":44.3,"e":46.78},{"t":"Mercy, Lord is my cry.","s":46.87,"e":50.51},{"t":"Saying, “Lift your voice, ‘Grace! Grace!’”","s":50.59,"e":53.82},{"t":"May Grace become our life.","s":53.86,"e":56.96},{"t":"Grace… grace…","s":57.0,"e":58.28},{"t":"let it pour on us like rain.","s":58.32,"e":62.41},{"t":"Mercy… mercy…","s":62.5,"e":63.78},{"t":"Etch it on our heart again.","s":63.8,"e":67.12},{"t":"Holy One of Israel...","s":67.21,"e":69.69},{"t":"Prepare us for Your flame.","s":69.73,"e":73.58},{"t":"Grace… grace…","s":73.67,"e":77.31},{"t":"We call upon Your name.","s":77.39,"e":83.0},{"t":"You warned the world of judgment...","s":83.01,"e":87.18},{"t":"Even weak ears heard Your call.","s":87.23,"e":89.52},{"t":"Melt what stands in pride, Lord;","s":89.6,"e":92.18},{"t":"On feet of clay we stood tall","s":92.29,"e":94.91},{"t":"The lofty crash down before You...","s":94.95,"e":98.54},{"t":"so bring our heights to low;","s":98.62,"e":100.53},{"t":"Let reverence be our trembling,","s":100.61,"e":103.22},{"t":"And holy fear be all we know.","s":103.28,"e":105.49},{"t":"You say, “The Lord shall roar…”","s":105.49,"e":106.4},{"t":"so let that roar awaken us.","s":106.5,"e":111.7},{"t":"You said You’d search the hearts of men...","s":111.78,"e":114.63},{"t":"Find in us the fire You seek.","s":114.68,"e":118.4},{"t":"Grace… grace…","s":118.44,"e":119.74},{"t":"let it pour on us like rain.","s":119.8,"e":123.92},{"t":"Mercy… mercy…","s":124.02,"e":125.23},{"t":"pull me from our former ways.","s":125.28,"e":128.63},{"t":"Holy One of Israel...","s":128.73,"e":131.17},{"t":"prepare us for Your flame.","s":131.2,"e":133.5},{"t":"Grace… grace…","s":133.51,"e":134.02},{"t":"We call upon Your name.","s":134.07,"e":150.51},{"t":"And as we cry, we hear the others","s":150.53,"e":153.67},{"t":"voices rising where we stand.","s":153.76,"e":156.3},{"t":"Our trembling gathers into one,","s":156.38,"e":159.43},{"t":"Our hearts moved by Your hand.","s":159.53,"e":162.11},{"t":"You say, “Peoples of the earth, cry out!”","s":162.17,"e":165.32},{"t":"so we lift the name You gave…","s":165.36,"e":167.49},{"t":"Grace… grace…","s":167.58,"e":170.44},{"t":"Mercy for the nations You shake.","s":170.53,"e":180.24},{"t":"Grace… grace…","s":180.29,"e":181.68},{"t":"we cry out as Your own.","s":181.76,"e":185.92},{"t":"Mercy… mercy…","s":186.01,"e":187.34},{"t":"let Your righteousness be made known.","s":187.42,"e":190.87},{"t":"Holy One of Israel...","s":190.96,"e":193.44},{"t":"Your footsteps shake the ground.","s":193.53,"e":195.41},{"t":"Grace… grace…","s":195.43,"e":197.07},{"t":"Your remnant gathers now.","s":199.71,"e":201.89},{"t":"We cry out…","s":201.9,"e":206.44},{"t":"We call Your name…","s":206.54,"e":211.77},{"t":"Holy One of Israel...","s":211.87,"e":215.92},{"t":"come down.","s":215.97,"e":218.6},{"t":"Come down.","s":218.66,"e":223.76},{"t":"oh, come!","s":223.86,"e":224.76}],"match":null}
