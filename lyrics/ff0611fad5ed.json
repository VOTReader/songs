{"v":1,"id":"ff0611fad5ed","synced":true,"offset":0,"source":"suno","lines":[{"t":"Beloved, be My examples...","s":1.15,"e":6.26},{"t":"Order your speech like David,","s":6.33,"e":10.48},{"t":"And conduct yourselves as Daniel...","s":10.56,"e":15.97},{"t":"Let your speech express your","s":16.0,"e":17.75},{"t":"Love for Me in every situation,","s":17.85,"e":21.08},{"t":"And let your conduct reveal My spirit","s":21.14,"e":23.73},{"t":"In you in open and in secret...","s":23.85,"e":33.78},{"t":"Beloved, prepare as though I were","s":33.82,"e":39.21},{"t":"Coming to take you this very day;","s":39.27,"e":42.22},{"t":"Walk with Me as though we walk","s":42.29,"e":44.47},{"t":"Together in the Garden already...","s":44.53,"e":50.97},{"t":"Says The Lord.","s":51.04,"e":52.13}],"match":null}
