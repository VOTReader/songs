{"v":1,"id":"060a0a8f4556","synced":true,"offset":0,"source":"suno","lines":[{"t":"My children…","s":4.73,"e":11.19},{"t":"I still know your names.","s":11.19,"e":17.46},{"t":"Even now…","s":17.51,"e":20.37},{"t":"I still know your names.","s":20.37,"e":27.63},{"t":"I walked among the trees I planted,","s":27.68,"e":33.58},{"t":"Reached for fruit on every limb.","s":33.63,"e":38.04},{"t":"Found the branches bare and broken,","s":38.08,"e":42.27},{"t":"Found the daylight growing dim.","s":42.31,"e":46.4},{"t":"There were cries behind your windows,","s":46.43,"e":50.15},{"t":"There was blood upon your stones,","s":50.18,"e":53.92},{"t":"And you learned to call it living","s":53.96,"e":57.39},{"t":"While you left each other alone.","s":57.44,"e":61.1},{"t":"I have seen the little children","s":61.14,"e":64.81},{"t":"Learn to hide before they pray.","s":64.89,"e":68.96},{"t":"I have heard you ask for mercy,","s":69.04,"e":72.31},{"t":"Then turn the merciful away.","s":72.39,"e":75.19},{"t":"Do you think I do not feel it?","s":75.28,"e":82.92},{"t":"Do you think I cannot weep?","s":83.0,"e":86.43},{"t":"Every heart you leave in pieces","s":86.51,"e":89.7},{"t":"Cuts a wound in Me so deep.","s":89.78,"e":94.48},{"t":"My tears run down,","s":94.52,"e":98.67},{"t":"My blood runs down.","s":98.77,"e":102.11},{"t":"I call your name—","s":102.23,"e":105.2},{"t":"You drown Me out.","s":105.3,"e":108.64},{"t":"My arms are open,","s":108.67,"e":111.98},{"t":"Your fists are closed.","s":112.08,"e":115.43},{"t":"I reach for children","s":115.55,"e":118.74},{"t":"Who won’t come home.","s":118.85,"e":123.48},{"t":"No pleasure in the breaking,","s":123.59,"e":128.11},{"t":"No joy in what must come.","s":128.21,"e":132.42},{"t":"Oh, My people…","s":132.52,"e":138.5},{"t":"What have you done?","s":138.55,"e":144.25},{"t":"Every tree is drinking sorrow,","s":144.28,"e":147.47},{"t":"Every root is wrapped in stone.","s":147.55,"e":149.92},{"t":"There’s a hunger in your houses","s":149.98,"e":153.53},{"t":"Bread and gold have never known.","s":153.58,"e":156.86},{"t":"And the darkness you keep feeding","s":156.92,"e":159.84},{"t":"Has become a canyon wide.","s":159.94,"e":163.55},{"t":"Still I call across the distance;","s":163.59,"e":166.58},{"t":"Still you find a place to hide.","s":166.62,"e":170.18},{"t":"Even those who wore My name","s":170.22,"e":173.24},{"t":"Have learned to turn their eyes.","s":173.34,"e":176.72},{"t":"They have left the wounded waiting","s":176.77,"e":179.7},{"t":"With My words upon their lips.","s":179.78,"e":184.83},{"t":"Must you make a stranger of Me?","s":184.85,"e":189.64},{"t":"Must you teach your hearts to hate?","s":189.69,"e":193.03},{"t":"I am calling through your silence—","s":193.11,"e":196.14},{"t":"Do not turn your face away.","s":196.22,"e":199.97},{"t":"My tears run down,","s":200.02,"e":204.38},{"t":"My blood runs down.","s":204.49,"e":208.07},{"t":"I call your name—","s":208.19,"e":210.9},{"t":"You drown Me out.","s":211.01,"e":214.6},{"t":"My arms are open,","s":214.7,"e":217.7},{"t":"Your fists are closed.","s":217.79,"e":221.23},{"t":"I reach for children","s":221.35,"e":224.46},{"t":"Who won’t come home.","s":224.57,"e":228.93},{"t":"No pleasure in the breaking,","s":229.05,"e":233.91},{"t":"No joy in what must come.","s":234.01,"e":239.57},{"t":"Oh, My people…","s":239.68,"e":243.85},{"t":"What have you done?","s":243.93,"e":245.7},{"t":"You bound My hands…","s":245.7,"e":246.36},{"t":"I would have held you.","s":246.4,"e":250.97},{"t":"You bound My feet…","s":250.99,"e":253.51},{"t":"I came to find you.","s":253.51,"e":255.28},{"t":"You struck My face…","s":255.38,"e":257.02},{"t":"I looked for yours.","s":257.02,"e":258.93},{"t":"You pierced My side…","s":259.01,"e":264.7},{"t":"And still, these arms—","s":264.8,"e":270.52},{"t":"These arms are yours.","s":270.53,"e":275.21},{"t":"And still the hammer rises.","s":275.26,"e":278.82},{"t":"And still I hear the sound.","s":278.92,"e":282.33},{"t":"And still I call you children","s":282.43,"e":285.18},{"t":"As My blood falls to the ground.","s":285.3,"e":289.13},{"t":"I do not want to lose you.","s":289.25,"e":292.32},{"t":"Can you hear Me through the rain?","s":292.36,"e":295.84},{"t":"Have you grown so far from mercy","s":295.89,"e":302.1},{"t":"You no longer know My pain?","s":302.2,"e":307.76},{"t":"My tears run down,","s":307.79,"e":312.89},{"t":"My blood runs down.","s":313.0,"e":316.58},{"t":"There is no gladness","s":316.62,"e":319.01},{"t":"In this wounded sound.","s":319.13,"e":323.03},{"t":"My arms are open—","s":323.13,"e":326.45},{"t":"They’re open still.","s":326.46,"e":330.52},{"t":"You turn against Me…","s":330.62,"e":334.73},{"t":"I love you still.","s":334.73,"e":339.14},{"t":"No pleasure in the breaking—","s":339.25,"e":343.21},{"t":"No pleasure… none at all.","s":343.32,"e":347.69},{"t":"I never stopped calling.","s":347.81,"e":350.09},{"t":"Did you hear Me call?","s":350.13,"e":352.88},{"t":"Did you hear Me call?","s":352.92,"e":356.9},{"t":"OH, MY PEOPLE…","s":356.97,"e":361.7},{"t":"WHY HAVE YOU FORSAKEN ME?","s":361.7,"e":370.99},{"t":"The earth falls quiet.","s":371.01,"e":373.96},{"t":"The branches bow.","s":374.02,"e":378.17},{"t":"I called you then…","s":378.29,"e":380.73},{"t":"I call you now.","s":380.85,"e":387.26},{"t":"My children…","s":387.36,"e":388.51},{"t":"My children…","s":391.54,"e":392.49},{"t":"My arms…","s":395.37,"e":399.2},{"t":"Are open…","s":399.2,"e":404.94},{"t":"Still.","s":404.94,"e":405.58}],"match":null}
