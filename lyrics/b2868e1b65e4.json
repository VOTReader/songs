{"v":1,"id":"b2868e1b65e4","synced":true,"offset":0,"source":"suno","lines":[{"t":"Awake, all you churches,","s":29.04,"e":37.36},{"t":"From sleep in your seats.","s":37.4,"e":41.69},{"t":"Woe to those called Roman,","s":41.73,"e":47.14},{"t":"Pious conceits.","s":47.19,"e":51.41},{"t":"On seven hills heavy,","s":51.52,"e":56.27},{"t":"With rituals you have piled -","s":56.31,"e":60.9},{"t":"The dark veil secure,","s":60.95,"e":63.99},{"t":"And your pagan ways are defiled.","s":64.04,"e":71.63},{"t":"Awake... awake, all you churches of men,","s":71.7,"e":80.0},{"t":"Woe to the harlot, on the wide path again.","s":80.01,"e":88.94},{"t":"The plumb line I hold, cuts the veil you have sewn,","s":89.0,"e":98.68},{"t":"No more pretense. hear the trumpet blow.","s":98.73,"e":105.51},{"t":"( Awake... awake...)","s":104.54,"e":110.81},{"t":"listen closely , my beloved ones.","s":110.86,"e":118.36},{"t":"Why do you claim My name,","s":118.38,"e":121.49},{"t":"Then plug up your ears?","s":121.54,"e":126.12},{"t":"I beckon you close, beloved,","s":126.22,"e":130.61},{"t":"But who has drawn near?","s":130.64,"e":132.77},{"t":"The Volumes of Truth","s":135.16,"e":139.95},{"t":"My testament true-","s":140.03,"e":143.72},{"t":"You're locked in walls you have built.","s":143.74,"e":148.46},{"t":"I'll break down to get through","s":148.48,"e":154.86},{"t":"Awake... awake, all you churches of men,","s":154.93,"e":163.52},{"t":"Your daughters tread the wide path again.","s":163.61,"e":171.72},{"t":"The plumb line I hold, cuts the veil you have sewn,","s":171.77,"e":180.91},{"t":"No more of your show. stand before the throne.","s":180.97,"e":187.3},{"t":"( Awake..... awake.....)","s":186.68,"e":194.12},{"t":"Harden not your hearts..","s":194.14,"e":200.32},{"t":"I am The Lord,","s":200.34,"e":203.02},{"t":"Who spoke calm to the storm.","s":203.09,"e":207.23},{"t":"Your walls are void of My Spirit,","s":207.26,"e":211.97},{"t":"Your pomp is without form.","s":212.02,"e":216.36},{"t":"I'm not first in you,","s":216.38,"e":218.94},{"t":"(Not first!)","s":217.93,"e":220.93},{"t":"I see straight through your heart. (Not first!)","s":221.01,"e":225.75},{"t":"Woe... if you slumber, (Not first!)","s":225.85,"e":230.15},{"t":"How will you depart!?","s":230.22,"e":236.19},{"t":"[Outro]","s":231.2,"e":236.88},{"t":"( Awake all you churches... (awake...)","s":236.28,"e":251.8},{"t":"Harden not your hearts...","s":251.86,"e":256.99},{"t":"( Hear the trumpet call of God. Hear the trumpet call of God)","s":255.62,"e":267.69}],"match":null}
