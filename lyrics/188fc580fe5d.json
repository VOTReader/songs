{"v":1,"id":"188fc580fe5d","synced":true,"offset":0,"source":"suno","lines":[{"t":"Verse 1)","s":14.78,"e":15.07},{"t":"Soft haze hums above the bay,","s":15.1,"e":18.23},{"t":"quiet hearts forget the fray.","s":18.29,"e":21.35},{"t":"I turn off the noise inside,","s":21.4,"e":24.16},{"t":"and watch the waves collide.","s":24.22,"e":28.17},{"t":"Morning hums a gentle tune,","s":28.23,"e":31.7},{"t":"sunlight melts the silver moon.","s":31.73,"e":35.06},{"t":"Every breath, a sacred start,","s":35.09,"e":37.78},{"t":"stillness anchors every part.","s":37.84,"e":41.69},{"t":"The world feels far, yet close to grace,","s":41.71,"e":45.06},{"t":"I find Your calm in every space.","s":45.1,"e":48.47},{"t":"I let the silence settle in,","s":48.53,"e":50.64},{"t":"this is where peace begins.","s":50.73,"e":54.38},{"t":"(Chorus)","s":53.57,"e":54.5},{"t":"I don’t need to chase the sound,","s":54.52,"e":57.71},{"t":"heaven’s rhythm all around.","s":57.73,"e":61.28},{"t":"Every motion slows within,","s":61.3,"e":64.5},{"t":"this is where peace begins.","s":64.56,"e":74.43},{"t":"(Verse 2)","s":66.9,"e":74.98},{"t":"Leaves drift low, the hours pass,","s":75.07,"e":85.0},{"t":"sunlight dancing through the glass.","s":85.03,"e":88.04},{"t":"Rest feels like an open door,","s":88.1,"e":91.1},{"t":"I’m not running anymore.","s":91.14,"e":94.66},{"t":"Ocean breeze and drifting sand,","s":94.76,"e":98.06},{"t":"time unfolding in Your hand.","s":98.1,"e":101.46},{"t":"Gentle whispers calm the skin,","s":101.52,"e":104.47},{"t":"this is where peace begins.","s":104.53,"e":107.12},{"t":"(Bridge)","s":106.74,"e":108.31},{"t":"No weight to prove, no rush to try,","s":108.34,"e":110.69},{"t":"the highest grace is simply “why.”","s":110.71,"e":114.9},{"t":"I’m here, I breathe, I let You in,","s":114.92,"e":117.84},{"t":"this is where peace begins.","s":117.89,"e":131.06},{"t":"(Verse 3)","s":120.19,"e":134.9},{"t":"Evening paints the sky with rest,","s":134.94,"e":138.16},{"t":"colors fade but I am blessed.","s":138.22,"e":140.19},{"t":"Night songs rise, the stars appear,","s":140.21,"e":144.06},{"t":"I know Your presence lingers near.","s":144.12,"e":148.31},{"t":"Every heartbeat, soft and slow,","s":148.35,"e":151.71},{"t":"every breath reminds me You know.","s":151.74,"e":154.71},{"t":"Love restores what fear had thinned,","s":154.75,"e":157.82},{"t":"this is where peace begins.","s":157.86,"e":160.98},{"t":"(Final Chorus)","s":160.17,"e":161.14},{"t":"I don’t need to chase the sound,","s":161.15,"e":164.36},{"t":"heaven’s rhythm all around.","s":164.37,"e":167.87},{"t":"Every motion slows within,","s":167.89,"e":173.14},{"t":"I’m home again—","s":173.16,"e":174.91},{"t":"where peace begins.","s":174.96,"e":176.74},{"t":"Grace like rain, still and wide,","s":176.8,"e":180.15},{"t":"calm waves meet the rising tide.","s":180.22,"e":183.17},{"t":"All I am, I let it in,","s":183.21,"e":185.01},{"t":"and this is where peace begins.","s":185.05,"e":188.8}],"match":null}
