{"v":1,"id":"7723b82ec16d","synced":true,"offset":0,"source":"suno","lines":[{"t":"The power of The Lord is without end!","s":23.38,"e":28.1},{"t":"His love covers His creation like a blanket,","s":28.15,"e":32.78},{"t":"and the light of His glory reaches beyond","s":32.81,"e":36.92},{"t":"the stars of heaven!","s":36.98,"e":42.21},{"t":"His majesty is beyond comprehension;","s":42.29,"e":46.88},{"t":"it transcends space and time!","s":46.97,"e":52.14},{"t":"The Everlasting is His name!","s":52.18,"e":56.45},{"t":"The express image of The Holy is revealed,","s":56.49,"e":60.56},{"t":"He is known of His own!","s":60.6,"e":65.55},{"t":"His glory shines from the east","s":65.62,"e":68.79},{"t":"even unto the west,","s":68.89,"e":71.35},{"t":"The Sh’khinah of The Father’s only Son!","s":71.39,"e":77.97},{"t":"WONDERFUL","s":78.05,"e":80.29},{"t":"is His name! (wonderful)","s":80.4,"e":82.75},{"t":"WONDERFUL","s":82.84,"e":84.89},{"t":"are His ways! (are His ways)","s":84.97,"e":87.29},{"t":"He wears TRUTH as a garment,","s":87.37,"e":90.1},{"t":"and GLORY is His vesture,","s":90.14,"e":92.43},{"t":"and LOVE is His crowning glory!","s":92.52,"e":99.85},{"t":"All life proceeds from Him;","s":99.94,"e":104.04},{"t":"He holds all things together by the Word of His power!","s":104.12,"e":108.8},{"t":"His way is from everlasting,","s":108.86,"e":112.76},{"t":"And with His mouth He testifies","s":112.86,"e":117.69},{"t":"To the Truth, always!","s":117.81,"e":122.8},{"t":"Therefore, let us testify also;","s":122.85,"e":127.42},{"t":"The Father and The Son are One!","s":127.5,"e":131.36},{"t":"ONE!...","s":131.46,"e":132.49},{"t":"YAHUSHUA-YAHUWAH!","s":132.53,"e":135.89},{"t":"YAHUSHUA-YAHUWAH!","s":135.94,"e":140.55},{"t":"YAHUSHUA-YAHUWAH!","s":140.62,"e":145.71},{"t":"WONDERFUL","s":145.79,"e":148.09},{"t":"is His name! (wonderful)","s":148.16,"e":150.41},{"t":"WONDERFUL","s":150.49,"e":152.79},{"t":"are His ways! (are His ways)","s":152.87,"e":154.97},{"t":"He wears TRUTH as a garment,","s":155.08,"e":157.87},{"t":"and GLORY is His vesture,","s":157.93,"e":160.18},{"t":"and LOVE is His crowning glory!","s":160.24,"e":164.54},{"t":"and LOVE is His crowning glory!","s":164.64,"e":170.27}],"match":null}
