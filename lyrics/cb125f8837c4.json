{"v":1,"id":"cb125f8837c4","synced":true,"offset":0,"source":"suno","lines":[{"t":"Come, all those who know not My ways;","s":13.24,"e":21.91},{"t":"I will show you.","s":22.02,"e":26.36},{"t":"Come, all those who have been abandoned;","s":26.45,"e":32.27},{"t":"I will comfort you and give you shelter.","s":32.39,"e":39.26},{"t":"Come, all those who are crippled;","s":39.3,"e":41.51},{"t":"Let us run and leap for joy together!","s":41.61,"e":50.98},{"t":"Come, all those faithless;","s":51.02,"e":54.61},{"t":"I shall fill your cup,","s":54.73,"e":58.45},{"t":"And watch how it overflows!","s":58.52,"e":61.68},{"t":"Come, all murderers;","s":61.72,"e":67.25},{"t":"Watch Me raise you,","s":67.31,"e":71.46},{"t":"And all who sleep, from the grave.","s":71.52,"e":83.38},{"t":"Come, all you who blaspheme,","s":83.42,"e":85.59},{"t":"I will give you a new voice;","s":85.69,"e":89.1},{"t":"Bring with you all those who are blind and deaf,","s":89.15,"e":92.53},{"t":"For they too, shall see and hear!","s":92.59,"e":95.85},{"t":"Indeed, come all those","s":95.86,"e":98.38},{"t":"who have sinned against Me,","s":98.46,"e":101.44},{"t":"take My hand!","s":101.53,"e":105.12},{"t":"I will lead you to the waters","s":105.24,"e":107.83},{"t":"where I shall wash you,","s":107.87,"e":111.06},{"t":"And where your new clothes","s":111.14,"e":114.59},{"t":"hang upon the tree","s":114.69,"e":118.24},{"t":"Which grows next to the stream.","s":118.31,"e":121.62},{"t":"Come one, come all!","s":121.68,"e":123.22},{"t":"Ask, and it shall be given you!","s":123.32,"e":127.96},{"t":"For all things are possible with God","s":128.02,"e":130.93},{"t":"And made manifest through The Son.","s":131.04,"e":136.06},{"t":"Says The Lord YahuShua.","s":136.12,"e":138.91}],"match":null}
