{"v":1,"id":"848637db40f5","synced":true,"offset":0,"source":"suno","lines":[{"t":"Hear and seek to understand,","s":4.79,"e":10.69},{"t":"The Word of God is fire,","s":10.77,"e":16.94},{"t":"each word a burning flame","s":17.03,"e":21.41},{"t":"in the midst of an immense fire.","s":21.52,"e":27.54},{"t":"The countenance of The Lord is a fire,","s":27.59,"e":34.18},{"t":"and a flame within a fire.","s":34.28,"e":38.95},{"t":"The glory of The Lord is perfect, a pure light,","s":39.0,"e":46.09},{"t":"a flame within a flame,","s":46.2,"e":49.99},{"t":"a fire engulfing all creation!","s":50.09,"e":59.95},{"t":"YAHUWAH is One,","s":60.05,"e":63.77},{"t":"and His name, One;","s":63.81,"e":66.03},{"t":"His name is in Him and is Him.","s":66.1,"e":71.44},{"t":"YAHUWAH is His name,","s":71.54,"e":74.46},{"t":"and His name is One with Him.","s":74.51,"e":77.42},{"t":"They are not separate, but one,","s":77.47,"e":83.83},{"t":"even as The Father and The Son are One -","s":83.9,"e":88.7},{"t":"a flame within a flame,","s":88.8,"e":94.95},{"t":"within an immense fire.","s":94.99,"e":102.54},{"t":"YAHUWAH has no beginning and no end,","s":102.59,"e":106.46},{"t":"even as His name.","s":106.52,"e":108.04},{"t":"Therefore nothing is outside YAHUWAH,","s":108.09,"e":111.0},{"t":"for His being is infinite.","s":111.05,"e":113.87},{"t":"And those who pass outside creation","s":113.92,"e":117.3},{"t":"enter into His eternal glory,","s":117.39,"e":119.56},{"t":"or are burned up in His devouring fire,","s":119.66,"e":124.83},{"t":"in His everlasting flame.","s":124.89,"e":128.87},{"t":"Therefore no one may come to The Father","s":128.91,"e":134.11},{"t":"except through The Son, YAHUSHUA,","s":134.18,"e":139.6},{"t":"The Purifying Flame.","s":139.66,"e":143.94},{"t":"For only The Holy Flame","s":144.02,"e":150.86},{"t":"may dwell within The Fire,","s":150.92,"e":156.75},{"t":"for YAH is holy.","s":156.81,"e":162.45},{"t":"And all those void of The Flame","s":162.53,"e":166.28},{"t":"will consume away; they shall cease to exist.","s":166.36,"e":173.86},{"t":"For ALL must pass through the fire,","s":173.94,"e":181.31},{"t":"ALL are subject to the power of The Flame -","s":181.4,"e":191.09},{"t":"the wicked purged, and the penitent purified.","s":191.14,"e":198.59}],"match":null}
