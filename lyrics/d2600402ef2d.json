{"v":1,"id":"d2600402ef2d","synced":true,"offset":0,"source":"suno","lines":[{"t":"Everything which comes from the mouth of The Lord your God,","s":13.75,"e":22.08},{"t":"is a blessing for all!","s":22.14,"e":26.48},{"t":"A song for all those who have ears to hear!","s":26.59,"e":33.05},{"t":"A vision to all who have eyes to see My splendor,","s":33.13,"e":37.61},{"t":"Painted by The Word of My glory!","s":37.7,"e":48.25},{"t":"An overflowing fountain inside those,","s":48.35,"e":53.04},{"t":"Whose hearts are open to Me!","s":53.08,"e":60.08},{"t":"Says The Lord.","s":60.14,"e":63.53},{"t":"It is written.","s":63.57,"e":64.25},{"t":"“Man shall not live by bread alone,","s":63.9,"e":72.93},{"t":"But by every word,","s":72.99,"e":74.89},{"t":"that proceeds,","s":74.94,"e":77.94},{"t":"From the mouth, of God.”","s":77.99,"e":80.69}],"match":{"letter":"blessed:introduction","score":1.0}}
