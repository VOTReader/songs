{"v":1,"id":"f7c38f9f7d7f","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Faith","s":14.58,"e":15.98},{"t":"Faith can by no means be attained","s":30.9,"e":34.46},{"t":"Nor can one grab hold of it by human means","s":35.0,"e":41.44},{"t":"For there are works done without faith","s":43.3,"e":47.18},{"t":"Which are dead","s":47.18,"e":49.16},{"t":"And a faith which has works","s":49.74,"e":52.9},{"t":"Which is also dead","s":54.04,"e":56.56},{"t":"Yet your faith came by my works","s":57.58,"e":61.1},{"t":"Which enable you to believe","s":61.1,"e":64.78},{"t":"I am who I am","s":65.32,"e":67.68},{"t":"And all good works","s":69.28,"e":71.38},{"t":"Which come forth from you","s":72.92,"e":75.28},{"t":"Are my works also","s":76.6,"e":78.64},{"t":"Therefore if one is to be healed","s":80.88,"e":83.52},{"t":"In accordance with my will","s":83.52,"e":85.74},{"t":"That same one must surrender to me and my will","s":85.74,"e":93.52},{"t":"Making no effort to increase their faith","s":94.04,"e":98.54},{"t":"By human power as a means to a desired end","s":99.34,"e":106.04},{"t":"Rather they acquiesce","s":108.9,"e":112.06},{"t":"Oh, my God.","s":116.6,"e":123.72},{"t":"Knowing that all things will be done","s":142.16,"e":145.98},{"t":"In their proper time and season","s":145.98,"e":151.02},{"t":"According to the love of their Father in Heaven","s":151.02,"e":158.26},{"t":"Doubting nothing","s":165.0,"e":167.2},{"t":"I am who I am","s":171.46,"e":174.8},{"t":"I am who I am","s":190.24,"e":193.12},{"t":"I am who I am","s":196.98,"e":200.86},{"t":"Says the Lord","s":205.84,"e":207.92},{"t":"Thank you.","s":211.02,"e":211.56}],"match":{"letter":"wtlb1:healing-by-faith","score":0.882}}
