{"v":1,"id":"396b1454d337","synced":true,"offset":0,"source":"suno","lines":[{"t":"Hear the call…","s":3.75,"e":8.86},{"t":"Hear the call…","s":8.94,"e":12.01},{"t":"The night is not the ruler of it all.","s":12.05,"e":16.06},{"t":"Gold on the gates, but the halls lie hollow,","s":16.07,"e":19.07},{"t":"Crowns made of dust in a kingdom of stone.","s":19.1,"e":26.81},{"t":"Gold on the gates, but the halls lie hollow,","s":26.89,"e":31.46},{"t":"Crowns made of dust in a kingdom of stone.","s":31.52,"e":36.35},{"t":"Thousands of voices with nothing to follow,","s":36.42,"e":40.08},{"t":"Still through the thunder, the Truth stands alone.","s":40.09,"e":41.02},{"t":"Still through the thunder, the Truth stands alone.","s":41.12,"e":45.27},{"t":"Under the noise, there’s a holy invitation,","s":45.29,"e":47.55},{"t":"Out of the shadows, away from the lie.","s":47.58,"e":49.96},{"t":"No earthly power can purchase salvation,","s":49.99,"e":52.36},{"t":"No painted heaven can open the sky.","s":52.39,"e":54.99},{"t":"Let the false lights fade,","s":55.0,"e":57.37},{"t":"Let the proud walls fall.","s":57.39,"e":59.73},{"t":"Through the trembling earth—","s":59.74,"e":61.97},{"t":"Hear the Savior call!","s":62.02,"e":66.27},{"t":"Darkness has no throne!","s":66.3,"e":68.38},{"t":"The King of Light is coming!","s":68.4,"e":71.05},{"t":"Let the whole world know—","s":71.09,"e":73.09},{"t":"His Word cannot be broken!","s":73.14,"e":76.15},{"t":"Oh-oh, let the heavens roar!","s":76.21,"e":78.54},{"t":"Oh-oh, let the lost come home!","s":78.61,"e":80.76},{"t":"At the sound of His name,","s":80.79,"e":82.03},{"t":"Every shadow gives way—","s":82.06,"e":84.36},{"t":"Darkness has no throne!","s":84.44,"e":87.07},{"t":"No throne! No throne!","s":87.09,"e":89.59},{"t":"Darkness has no throne!","s":89.64,"e":91.95},{"t":"One King! One Light!","s":91.99,"e":93.99},{"t":"Let the Truth be known!","s":94.04,"e":100.87},{"t":"Mercy still calls where the wounded gather,","s":100.93,"e":105.77},{"