{"v":1,"id":"ed2644fed617","synced":true,"offset":0,"source":"suno","lines":[{"t":"Search me, Lord.","s":16.95,"e":19.61},{"t":"my heart’s laid bare before Your face.","s":19.72,"e":28.94},{"t":"Try me, Lord.","s":29.04,"e":31.79},{"t":"test the corners I can’t trace.","s":31.87,"e":40.23},{"t":"You know Your own,","s":40.29,"e":43.2},{"t":"so call me by the name You gave;","s":43.28,"e":49.59},{"t":"Make my love steadfast,","s":49.67,"e":52.41},{"t":"make my faith unmoved and brave.","s":52.44,"e":61.83},{"t":"I am Yours, Lord.","s":61.85,"e":64.72},{"t":"write Your will on my soul.","s":64.77,"e":67.82},{"t":"I am Yours, Lord","s":67.94,"e":70.57},{"t":"make this temple wholly whole.","s":70.67,"e":73.66},{"t":"Not in walls, not for crowds,","s":73.72,"e":76.38},{"t":"but in this heart You set apart…","s":76.44,"e":79.67},{"t":"I am Yours, Lord.","s":79.75,"e":82.51},{"t":"keep Your Kingdom in my heart.","s":82.56,"e":93.94},{"t":"Find me here, within,","s":93.97,"e":97.03},{"t":"where flesh can’t hide.","s":97.09,"e":105.69},{"t":"Speak to me.","s":105.78,"e":107.53},{"t":"Your whisper breaks the noise inside.","s":107.62,"e":116.59},{"t":"The church of brick and stone,","s":116.65,"e":119.7},{"t":"crumbles down like shifting sand","s":119.77,"e":126.66},{"t":"but Your true house rises","s":126.77,"e":131.69},{"t":"in the ones who grasp Your hand.","s":131.77,"e":138.6},{"t":"I am Yours, Lord.","s":138.63,"e":141.56},{"t":"write Your will on my soul.","s":141.61,"e":143.74},{"t":"I am Yours, Lord.","s":143.82,"e":147.49},{"t":"make this temple wholly whole.","s":147.57,"e":150.44},{"t":"Not in walls, not for crowds,","s":150.52,"e":153.15},{"t":"but in this heart You set apart…","s":153.23,"e":156.38},{"t":"I am Yours, Lord.","s":156.5,"e":159.22},{"t":"keep Your Kingdom in my heart.","s":159.29,"e":164.44},{"t":"You search the hearts and minds.","s":164.45,"e":166.72},{"t":"so let Your gaze find faith in me.","s":166.79,"e":170.07},{"t":"You know whose love is steady.","s":170.15,"e":172.62},{"t":"Lord, make mine what You see.","s":172.7,"e":175.27},{"t":"Not the old, not the broken vow,","s":175.29,"e":178.34},{"t":"not the fear that held me back…","s":178.4,"e":181.32},{"t":"Call me “Your remnant now,”","s":181.4,"e":183.6},{"t":"and keep me on Your narrow track.","s":183.66,"e":188.69},{"t":"I am Yours, Lord.","s":188.7,"e":191.6},{"t":"write Your will on my soul.","s":191.66,"e":194.6},{"t":"I am Yours, Lord.","s":194.72,"e":197.43},{"t":"make this temple wholly whole.","s":197.51,"e":200.41},{"t":"You remain, I remain.","s":200.5,"e":203.42},{"t":"never torn again apart…","s":203.5,"e":206.33},{"t":"I am Yours, Lord.","s":206.45,"e":209.24},{"t":"keep Your Kingdom in my heart.","s":209.32,"e":223.81},{"t":"Search me, know me.","s":223.84,"e":228.97},{"t":"See of Yourself in me.","s":229.07,"e":253.16},{"t":"I am Yours.","s":253.28,"e":254.56}],"match":null}
