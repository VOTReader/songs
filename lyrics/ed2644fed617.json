{"v":1,"id":"ed2644fed617","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Search me, Lord","s":15.92,"e":18.22},{"t":"My heart's laid bare before your face","s":18.22,"e":22.74},{"t":"Try me Lord, test the corners I can't trace","s":27.64,"e":34.22},{"t":"You know your own, so call me by the name you gave","s":39.02,"e":47.84},{"t":"Make my love steadfast","s":47.84,"e":52.12},{"t":"Make my faith unmoved and brave","s":53.7,"e":58.18},{"t":"I am Yours, Lord","s":60.76,"e":63.74},{"t":"Write Your will on my soul","s":63.74,"e":67.0},{"t":"I am Yours, Lord","s":67.0,"e":69.62},{"t":"Make this temple holy, holy","s":69.62,"e":72.84},{"t":"Not in walls, not for crowds","s":72.84,"e":75.92},{"t":"But in this heart you set apart","s":75.92,"e":78.66},{"t":"I am yours, Lord","s":78.66,"e":81.44},{"t":"Keep your kingdom in my heart","s":81.44,"e":86.24},{"t":"Find me here","s":92.9,"e":95.12},{"t":"Within where flesh can't hide","s":95.82,"e":98.6},{"t":"Speak to me","s":104.4,"e":106.8},{"t":"Your whisper breaks the noise inside","s":106.8,"e":110.06},{"t":"The church of brick and stone","s":114.82,"e":118.08},{"t":"Crumbles down like shifting sand","s":118.72,"e":122.42},{"t":"But your true house rises","s":125.68,"e":129.52},{"t":"In the ones who grasp your hand","s":130.82,"e":134.36},{"t":"I am yours, Lord","s":137.64,"e":140.48},{"t":"Write your will on my soul","s":140.48,"e":143.84},{"t":"I am yours, Lord","s":143.84,"e":146.38},{"t":"Make this temple holy, oh","s":146.38,"e":149.66},{"t":"Not in walls, not for crowds","s":149.66,"e":152.78},{"t":"But in this heart you set apart","s":152.78,"e":155.46},{"t":"I am yours, Lord","s":155.46,"e":158.16},{"t":"Keep your kingdom in my heart","s":158.16,"e":163.04},{"t":"You search the hearts and minds","s":163.04,"e":166.3},{"t":"So let your gaze find faith in me","s":166.3,"e":169.02},{"t":"You know whose love is steady","s":169.02,"e":171.98},{"t":"Lord, make mine what you see","s":171.98,"e":174.74},{"t"