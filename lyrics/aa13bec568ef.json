{"v":1,"id":"aa13bec568ef","synced":true,"offset":0,"source":"suno","lines":[{"t":"Hear and seek to understand,","s":5.78,"e":11.68},{"t":"The Word of God is fire,","s":11.76,"e":17.93},{"t":"each word a burning flame","s":18.02,"e":22.4},{"t":"in the midst of an immense fire.","s":22.51,"e":28.53},{"t":"The countenance of The Lord is a fire,","s":28.58,"e":35.17},{"t":"and a flame within a fire.","s":35.27,"e":39.94},{"t":"The glory of The Lord is perfect, a pure light,","s":39.99,"e":47.08},{"t":"a flame within a flame,","s":47.19,"e":50.98},{"t":"a fire engulfing all creation!","s":51.08,"e":60.94},{"t":"YAHUWAH is One,","s":61.04,"e":64.76},{"t":"and His name, One;","s":64.8,"e":67.02},{"t":"His name is in Him and is Him.","s":67.09,"e":72.43},{"t":"YAHUWAH is His name,","s":72.53,"e":75.45},{"t":"and His name is One with Him.","s":75.5,"e":78.41},{"t":"They are not separate, but one,","s":78.46,"e":84.82},{"t":"even as The Father and The Son are One -","s":84.89,"e":89.69},{"t":"a flame within a flame,","s":89.79,"e":95.94},{"t":"within an immense fire.","s":95.98,"e":103.53},{"t":"YAHUWAH has no beginning and no end,","s":103.58,"e":107.45},{"t":"even as His name.","s":107.51,"e":109.03},{"t":"Therefore nothing is outside YAHUWAH,","s":109.08,"e":111.99},{"t":"for His being is infinite.","s":112.04,"e":114.86},{"t":"And those who pass outside creation","s":114.91,"e":118.29},{"t":"enter into His eternal glory,","s":118.38,"e":120.55},{"t":"or are burned up in His devouring fire,","s":120.65,"e":125.82},{"t":"in His everlasting flame.","s":125.88,"e":129.86},{"t":"Therefore no one may come to The Father","s":129.9,"e":135.1},{"t":"except through The Son, YAHUSHUA,","s":135.17,"e":140.59},{"t":"The Purifying Flame.","s":140.65,"e":144.93},{"t":"For only The Holy Flame","s":145.01,"e":151.85},{"t":"may dwell within The Fire,","s":151.91,"e":157.74},{"t":"for YAH is holy.","s":157.8,"e":163.44},{"t":"And all those void of The Flame","s":163.52,"e":167.27},{"t":"will consume away; they shall cease to exist.","s":167.35,"e":174.85},{"t":"For ALL must pass through the fire,","s":174.93,"e":182.3},{"t":"ALL are subject to the power of The Flame -","s":182.39,"e":192.08},{"t":"the wicked purged, and the penitent purified.","s":192.13,"e":199.58}],"match":{"letter":"wtlb1:the-holy-flame","score":1.0}}
