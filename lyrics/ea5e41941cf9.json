{"v":1,"id":"ea5e41941cf9","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 1)","s":16.84,"e":17.03},{"t":"On the seventh day,","s":17.05,"e":19.73},{"t":"My weary heart can rest.","s":19.84,"e":24.65},{"t":"And I can be at peace,","s":24.73,"e":26.97},{"t":"And think of Your holiness.","s":27.05,"e":32.81},{"t":"Six days I labor,","s":32.91,"e":35.25},{"t":"But on the seventh my worries cease,","s":35.31,"e":39.87},{"t":"And in the quiet stillness,","s":39.93,"e":43.91},{"t":"My soul can rest at peace.","s":44.02,"e":47.33},{"t":"(Pre-Chorus)","s":46.37,"e":47.39},{"t":"I'll carry my cross six days,","s":47.39,"e":50.9},{"t":"But on the seventh I'll rest.","s":50.98,"e":54.87},{"t":"The Sabbath is a day I cherish,","s":54.93,"e":59.2},{"t":"In its peace my worries perish.","s":59.28,"e":63.45},{"t":"(Chorus)","s":60.98,"e":63.5},{"t":"Shabbat Shalom!","s":63.5,"e":66.41},{"t":"It's finally the Sabbath day.","s":66.44,"e":71.33},{"t":"On it I find peace,","s":71.41,"e":73.38},{"t":"And I think of You,","s":73.44,"e":75.1},{"t":"Lord,","s":75.19,"e":75.67},{"t":"In every way.","s":75.77,"e":79.15},{"t":"As I rest on this day,","s":79.23,"e":82.14},{"t":"I put my worries aside.","s":82.26,"e":84.16},{"t":"You made the Sabbath for love,","s":84.22,"e":87.19},{"t":"And I thank you for it.","s":87.25,"e":91.2},{"t":"Oh, it's the seventh day,","s":91.28,"e":95.72},{"t":"The Sabbath day.","s":95.78,"e":112.42},{"t":"(Verse 2)","s":96.97,"e":112.64},{"t":"Morning light through the window,","s":112.67,"e":114.64},{"t":"Gentle warmth on my face.","s":114.71,"e":116.7},{"t":"In the peace of this day,","s":116.76,"e":118.44},{"t":"I feel Your loving embrace.","s":118.56,"e":120.66},{"t":"It's a day free from the worries of this world.","s":120.69,"e":124.44},{"t":"Your love is whispered in the breeze.","s":124.48,"e":126.78},{"t":"Every moment a reminder,","s":126.86,"e":128.86},{"t":"Of Your love that never leaves.","s":128.94,"e":131.98},{"t":"(Pre-Chorus)","s":