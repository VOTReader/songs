{"v":1,"id":"ed6c01627f0c","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 1)","s":5.82,"e":11.19},{"t":"As I'm walking down the street,","s":11.22,"e":13.6},{"t":"I see people staring at me.","s":13.64,"e":16.0},{"t":"Looking at me funny, thinking I'm strange,","s":16.04,"e":18.73},{"t":"Because I follow You, YahuShua.","s":18.79,"e":22.68},{"t":"They tell me to stop, but I say I won't.","s":22.69,"e":25.18},{"t":"That my faiths not weak, that You're the one I love,","s":25.23,"e":28.39},{"t":"More than all, and that I'll walk with You, I will not fall.","s":28.45,"e":32.99},{"t":"(Pre-Chorus)","s":32.89,"e":33.13},{"t":"They laugh,","s":33.14,"e":33.29},{"t":"They scoff,","s":33.3,"e":36.03},{"t":"Tell me to stop.","s":36.08,"e":36.84},{"t":"But I close my eyes,","s":36.9,"e":38.74},{"t":"I shut my ears,","s":38.86,"e":39.81},{"t":"To all the noise I don't wanna hear.","s":39.89,"e":42.61},{"t":"All always walk with You,","s":42.69,"e":45.86},{"t":"YahuShua,","s":45.92,"e":47.11},{"t":"I'll be strange and peculiar.","s":47.15,"e":49.57},{"t":"(Chorus)","s":48.11,"e":49.67},{"t":"I'll always follow You.","s":49.71,"e":54.1},{"t":"To You I'll remain true.","s":54.18,"e":56.87},{"t":"YahuShua,","s":56.93,"e":60.04},{"t":"With You I'll forever abound.","s":60.16,"e":68.65},{"t":"With You my heart is sound,","s":68.68,"e":69.92},{"t":"In You","s":70.03,"e":70.85},{"t":"My faith is found.","s":70.97,"e":73.8},{"t":"I don't care what this world says,","s":73.88,"e":76.7},{"t":"If they tell me to stop,","s":76.73,"e":78.15},{"t":"I won't.","s":78.27,"e":79.4},{"t":"When they tell me to turn away from You,","s":79.42,"e":83.26},{"t":"I don't.","s":83.38,"e":84.31},{"t":"YahuShua,","s":84.38,"e":85.25},{"t":"I'll always walk with You.","s":85.37,"e":89.31},{"t":"(Bridge)","s":89.18,"e":89.44},{"t":"I hear whispers in the night, voices calling out to me.","s":89.52,"e":93.95},{"t":"Trying to pull me away, but I hold on tight.","s":94.07,"e":101.36},{"t":"Stand