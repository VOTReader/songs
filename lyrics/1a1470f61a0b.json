{"v":1,"id":"1a1470f61a0b","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Shabbat Shalom","s":13.38,"e":15.24},{"t":"Shabbat Shalom","s":37.94,"e":39.8},{"t":"Our joys increase","s":60.0,"e":61.84},{"t":"You are pleased in all we do","s":73.66,"e":79.88},{"t":"Your commandments kept, your word is true","s":82.0,"e":86.6},{"t":"Holy Sabbath, we won't forget","s":86.6,"e":90.52},{"t":"Every seventh day, your love we met","s":90.52,"e":93.72},{"t":"Grafted in, called your own","s":93.72,"e":96.86},{"t":"Together in your rest is one","s":96.86,"e":99.88},{"t":"Shabbat Shalom","s":99.88,"e":101.3},{"t":"Shabbat Shalom","s":102.94,"e":104.36},{"t":"We remember your days","s":104.88,"e":107.42},{"t":"We sing this song","s":108.28,"e":110.46},{"t":"In Messiah's shadow","s":110.46,"e":113.34},{"t":"Oh, we find our peace","s":113.34,"e":116.86},{"t":"Shabbat shalom","s":118.88,"e":119.76},{"t":"Our joys increase","s":119.76,"e":123.32},{"t":"From week to week","s":124.6,"e":127.32},{"t":"We wait for this day","s":127.32,"e":129.24},{"t":"To rest and rejoice","s":130.8,"e":133.4},{"t":"In your perfect way","s":133.4,"e":135.32},{"t":"Families gather","s":137.86,"e":139.8},{"t":"Sing in your praise, Shabbat Shalom","s":139.8,"e":144.28},{"t":"Our hearts we raise","s":144.28,"e":148.22},{"t":"Shabbat Shalom, Shabbat Shalom","s":148.74,"e":153.56},{"t":"We remember your days, we sing this song","s":153.56,"e":159.76},{"t":"In Messiah's shadow, we find our peace","s":159.76,"e":165.88},{"t":"Shabbat Shalom","s":165.88,"e":168.92},{"t":"Our joys increase","s":168.92,"e":172.56},{"t":"Continue in the way","s":184.52,"e":187.82},{"t":"Let peace remain","s":187.82,"e":190.54},{"t":"Shabbat Shalom","s":191.46,"e":193.66},{"t":"We proclaim your name","s":193.66,"e":197.56}],"match":null}
