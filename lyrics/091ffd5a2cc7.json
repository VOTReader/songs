{"v":1,"id":"091ffd5a2cc7","synced":true,"offset":0,"source":"suno","lines":[{"t":"For I tell you the truth,","s":8.66,"e":17.6},{"t":"That which is tipped","s":17.68,"e":24.21},{"t":"Can not be set upright again,","s":24.28,"e":33.36},{"t":"And that which has been set","s":33.39,"e":38.93},{"t":"In motion can not be stopped.","s":38.98,"e":50.19},{"t":"Lo, even that which was held","s":50.36,"e":58.73},{"t":"Captive in the depths of silence","s":58.83,"e":64.04},{"t":"Has been released,","s":64.15,"e":83.28},{"t":"Behold, it comes forth,","s":83.36,"e":91.37},{"t":"Increasing by order of magnitude","s":91.48,"e":97.2},{"t":"And can in no wise","s":97.29,"e":102.4},{"t":"Be put back again,","s":102.45,"e":109.64},{"t":"Says The Lord","s":109.79,"e":111.89}],"match":null}
