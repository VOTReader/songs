{"v":1,"id":"20cb31ae5720","synced":true,"offset":0,"source":"suno","lines":[{"t":"Eat of me","s":21.43,"e":24.63},{"t":"Partake of my words","s":24.73,"e":26.86},{"t":"And be filled","s":26.97,"e":29.41},{"t":"Breathe me in","s":29.48,"e":31.49},{"t":"That the song of the lamb may dwell within you","s":31.57,"e":36.43},{"t":"For it is the knowledge of my love","s":36.54,"e":43.3},{"t":"The revelation of who I truly am","s":43.38,"e":50.08},{"t":"A song","s":50.24,"e":53.59},{"t":"A chorus","s":53.75,"e":56.7},{"t":"Soon to be a symphony","s":56.8,"e":63.48},{"t":"A great outpouring of revelation to the praise of my glory","s":63.64,"e":92.15},{"t":"Beloved","s":92.26,"e":94.2},{"t":"It is also the music we share","s":94.32,"e":99.47},{"t":"Sweet melodies of grace and peace playing softly","s":99.56,"e":106.17},{"t":"Within your heart","s":106.23,"e":108.32},{"t":"Each string plucked gently and surely","s":108.42,"e":113.67},{"t":"The sound of my love revealed in you and through you","s":113.77,"e":124.28},{"t":"My spirit","s":124.4,"e":125.64},{"t":"My breath","s":125.76,"e":127.31},{"t":"My life","s":127.43,"e":129.16},{"t":"given and received","s":129.25,"e":132.66},{"t":"Bearing much fruit","s":132.72,"e":134.52},{"t":"in The Beloved...","s":134.63,"e":138.38},{"t":"Says The Lord","s":138.47,"e":149.83},{"t":"YahuShua","s":149.93,"e":153.32}],"match":{"letter":"wtlb1:the-song-of-the-lamb","score":1.0}}
