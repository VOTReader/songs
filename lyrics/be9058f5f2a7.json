{"v":1,"id":"be9058f5f2a7","synced":true,"offset":0,"source":"suno","lines":[{"t":"YahuShua…","s":3.97,"e":9.1},{"t":"Your Word… it breathes","s":9.13,"e":15.46},{"t":"Before time… beyond time… within me","s":15.5,"e":26.31},{"t":"In the quiet where my thoughts fall still","s":26.39,"e":30.9},{"t":"Where the noise fades into nothing","s":30.92,"e":35.11},{"t":"There… I hear You","s":35.2,"e":38.84},{"t":"Not in thunder alone","s":38.89,"e":40.06},{"t":"But in the whisper of Truth","s":40.08,"e":40.86},{"t":"That pierces deeper than sound","s":40.95,"e":48.25},{"t":"Your Word…","s":48.31,"e":50.67},{"t":"Alive","s":50.76,"e":52.24},{"t":"Unshaken","s":52.32,"e":54.42},{"t":"Holy","s":54.51,"e":56.87},{"t":"It found me in the dark places","s":56.99,"e":59.68},{"t":"And called me by name","s":59.72,"e":65.48},{"t":"Thank You for Your Word of Truth","s":65.55,"e":68.58},{"t":"Living light that carries me through","s":68.61,"e":81.2},{"t":"Every shadow bows to You","s":81.28,"e":87.74},{"t":"YahuShua… I rest in You","s":87.82,"e":97.0},{"t":"Your Word is not ink on a page","s":97.06,"e":100.23},{"t":"It is fire in my bones","s":100.25,"e":101.76},{"t":"A river through my soul","s":101.79,"e":106.65},{"t":"It corrects me… restores me","s":106.77,"e":109.71},{"t":"Breaks me… then makes me whole","s":109.72,"e":113.92},{"t":"When I wander","s":113.95,"e":115.59},{"t":"It calls me back","s":115.67,"e":117.43},{"t":"When I fall","s":117.47,"e":118.94},{"t":"It lifts me again","s":119.02,"e":121.42},{"t":"Faith rises…","s":121.49,"e":123.65},{"t":"Not from what I see","s":123.7,"e":125.74},{"t":"But from every promise You have spoken","s":125.79,"e":127.88},{"t":"Thank You for Your Word of Truth","s":127.89,"e":136.12},{"t":"Anchor firm, forever true","s":136.21,"e":140.03},{"t":"Every breath belongs to You","s":140.12,"e":143.97},{"t":"YahuShua… I trust in You","s":144.07,"e":151.5},{"t":"Heaven and earth… will pass away","s":151.55,"e":155.23},{"t":"But Your Word… remains","s":155.26,"e":157.8},{"t":"Unchanging","s":157.92,"e":159.03},{"t":"Unfailing","s":159.13,"e":160.29},{"t":"Eternal","s":160.38,"e":161.47},{"t":"It speaks… and life begins","s":161.59,"e":165.66},{"t":"It calls… and dead hearts rise","s":165.72,"e":169.37},{"t":"Your Truth…","s":169.45,"e":170.99},{"t":"Is my foundation","s":171.06,"e":173.36},{"t":"Your Voice…","s":173.42,"e":175.34},{"t":"Is my peace","s":175.38,"e":177.43},{"t":"Holy… Holy… Holy…","s":177.53,"e":182.71},{"t":"Your Word is Holy","s":182.75,"e":186.76},{"t":"Thank You for Your Word of Truth","s":186.82,"e":190.4},{"t":"Light that breaks the deepest blue","s":190.51,"e":194.8},{"t":"All I am I give to You","s":194.84,"e":198.78},{"t":"YahuShua… You make me new","s":198.89,"e":207.59},{"t":"Your Word…","s":207.64,"e":210.25},{"t":"My breath…","s":210.31,"e":212.72},{"t":"My life…","s":212.79,"e":215.6},{"t":"My King","s":215.66,"e":221.47},{"t":"YahuShua…","s":221.63,"e":227.97},{"t":"Thank You","s":228.01,"e":228.65}],"match":null}
