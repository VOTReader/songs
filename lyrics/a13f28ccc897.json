{"v":1,"id":"a13f28ccc897","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Before the dawn, before the stars took flame","s":46.96,"e":52.62},{"t":"He wrote each line, he called each name","s":52.62,"e":56.48},{"t":"No heart unseen","s":56.48,"e":58.7},{"t":"No spark misplaced","s":58.7,"e":61.68},{"t":"Each soul is breathed","s":62.38,"e":64.74},{"t":"With love embraced","s":64.74,"e":66.72},{"t":"A whisper falls within the dark","s":67.48,"e":71.94},{"t":"The smallest light","s":71.94,"e":74.44},{"t":"A holy spark","s":74.44,"e":76.82},{"t":"The hand unseen","s":76.82,"e":79.22},{"t":"Begins to weep","s":79.22,"e":82.14},{"t":"And life awakens heart's belief","s":82.14,"e":87.06},{"t":"For life is before its very conception","s":87.76,"e":94.84},{"t":"A thought of love","s":98.1,"e":101.14},{"t":"A perfect reflection","s":101.14,"e":105.44},{"t":"Blessed be the name","s":107.74,"e":110.44},{"t":"Of the one who commands","s":110.44,"e":115.08},{"t":"Every child formed","s":117.86,"e":120.44},{"t":"Gently by his hands","s":122.26,"e":125.52},{"t":"He paints their eyes with skies of peace","s":128.4,"e":133.08},{"t":"Their hearts with songs that never cease","s":133.72,"e":138.12},{"t":"Each breath a promise, each cry a sign","s":138.12,"e":143.28},{"t":"That heaven's mercy is by design","s":143.28,"e":148.28},{"t":"He gathers souls before they are born","s":148.28,"e":153.82},{"t":"Shelters them safe through trial and storm","s":153.82,"e":158.56},{"t":"No child forgotten, no tear in vain","s":158.56,"e":163.7},{"t":"There are lives inscribed in His refrain","s":163.7,"e":168.74},{"t":"For life ends before its very conception","s":168.74,"e":176.76},{"t":"A thought of love, a perfect reflection","s":176.76,"e":186.62},{"t":"Blessings be the name","s":189.7,"e":192.12},{"t":"Of the one who commands","s":192.12,"e":196.78},{"t":"Every child formed","s":199.54,"e":202.12},{"t":"Gently by his hands","s":203.8,"e":207.18},{"t":"From nothing I'm free","s":209.54,"e":212.48},{"t":"From silence to sound","s":214.92,"e":217.78},{"t":"His love is the womb","s":220.2,"e":222.72},{"t":"Where all life is found","s":225.32,"e":227.9},{"t":"Blessed be the one","s":230.76,"e":232.94},{"t":"Both now and forever","s":235.52,"e":237.88},{"t":"The giver of life","s":239.88,"e":243.26},{"t":"Forsaken ever","s":245.94,"e":248.04},{"t":"Thank you.","s":267.92,"e":268.58}],"match":null}
