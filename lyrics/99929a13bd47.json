{"v":1,"id":"99929a13bd47","synced":false,"offset":null,"source":"whisper","lines":[{"t":"作词作曲 李宗盛","s":2.56,"e":3.96},{"t":"You wore your heart upon your sleeve","s":27.72,"e":33.0},{"t":"字幕志愿者 杨茜茜","s":42.14,"e":60.62},{"t":"中文字幕 李宗盛","s":69.92,"e":75.08},{"t":"Your tears were falling","s":96.3,"e":98.96},{"t":"We were sleeping","s":98.96,"e":100.34},{"t":"Afraid to feel your jealous power","s":100.94,"e":104.4},{"t":"We would not weep when you were weeping","s":106.72,"e":110.96},{"t":"We would not mourn the way you mourn","s":113.56,"e":117.76},{"t":"You stretched your arms in aching","s":120.28,"e":123.74},{"t":"字幕志愿者 李宗盛","s":152.14,"e":153.58},{"t":"calling many by their name","s":153.96,"e":156.7},{"t":"you send your letters","s":160.04,"e":163.06},{"t":"soaked in longing","s":163.06,"e":165.16},{"t":"we fed our hearts","s":167.12,"e":169.24},{"t":"a lesser flame","s":169.24,"e":170.36},{"t":"you said my blood runs down","s":174.36,"e":177.58},{"t":"they refuse it","s":177.58,"e":179.64},{"t":"my tears fall","s":180.86,"e":182.72},{"t":"字幕志愿者 杨茜茜","s":186.48,"e":193.2},{"t":"字幕志愿者 李宗盛","s":224.78,"e":242.7},{"t":"We wrapped our hearts in hardened forms","s":242.72,"e":245.8},{"t":"Now in this last and trembling hour","s":245.8,"e":249.58},{"t":"Let every hidden wall be torn","s":249.58,"e":252.64},{"t":"We fall repentant to your anguish","s":252.64,"e":256.68},{"t":"Make us a bride who wipes your tears","s":256.68,"e":259.88},{"t":"Oh Lord","s":260.46,"e":261.14},{"t":"Yahushua man of sorrows","s":266.64,"e":270.5},{"t":"优优独播剧场——YoYo Television Series Exclusive","s":274.24,"e":280.8},{"t":"字幕志愿者 杨茜茜","s":315.54,"e":329.14},{"t":"Oh Lord","s":331.5,"e":333.22},{"t":"Make us a bride","s":334.5,"e":336.78},{"t":"Who knows your sorrow","s":336.78,"e":338.76},{"t":"Who feels the spear wound","s":338.76,"e":342.28},{"t":"That you bear","s":342.28,"e":343.54},{"t":"Who kneels to dry","s":346.3,"e":348.7},{"t":"The tears you're shedding","s":348.7,"e":350.76},{"t":"And answer sorrow","s":353.4,"e":355.66},{"t":"With our prayer","s":355.66,"e":357.52},{"t":"We would not weep but now we're weeping","s":360.16,"e":364.68},{"t":"We would not mourn but now we see","s":366.64,"e":371.56},{"t":"Receive our tears where yours were falling","s":372.1,"e":378.32},{"t":"And in your grief keep us with thee","s":381.7,"e":385.96}],"match":null}
