{"v":1,"id":"63ba39c31b14","synced":true,"offset":0,"source":"suno","lines":[{"t":"# In the Quiet","s":0.08,"e":4.66},{"t":"**[Verse 1]**","s":4.44,"e":4.82},{"t":"In the quiet night air,","s":4.84,"e":8.02},{"t":"I feel Your gentle presence","s":8.14,"e":11.01},{"t":"I see You everywhere,","s":11.17,"e":14.19},{"t":"Lord, You meet me in the silence","s":14.25,"e":17.6},{"t":"When every sound fades away,","s":17.65,"e":20.86},{"t":"And the noise inside grows dim","s":20.9,"e":24.1},{"t":"I don't have to say a thing,","s":24.25,"e":26.91},{"t":"You already know where I've been","s":27.01,"e":29.17},{"t":"**[Pre-Chorus]**","s":28.74,"e":30.04},{"t":"And I don't need a sign","s":30.05,"e":32.23},{"t":"I don't need to understand","s":32.39,"e":35.51},{"t":"I just breathe in Your peace","s":35.66,"e":38.3},{"t":"And place my heart in Your hands","s":38.4,"e":42.08},{"t":"**[Chorus]**","s":40.79,"e":42.27},{"t":"In the quiet, You are near","s":42.32,"e":45.32},{"t":"In the silence, I can hear","s":45.44,"e":48.51},{"t":"Something deeper than my fear","s":48.58,"e":51.62},{"t":"Calling me, calling me","s":51.71,"e":55.2},{"t":"When the darkness fills the sky","s":55.26,"e":57.53},{"t":"You're the light that never dies","s":57.55,"e":61.36},{"t":"And I know I'm safe tonight","s":61.44,"e":64.79},{"t":"Here with You, here with You","s":64.89,"e":75.83},{"t":"**[Verse 2]**","s":68.8,"e":81.21},{"t":"I've chased a thousand answers,","s":81.22,"e":84.45},{"t":"I've tried to find my way","s":84.5,"e":86.17},{"t":"But You were in the stillness","s":86.2,"e":90.88},{"t":"Before I ever looked Your way","s":90.92,"e":93.65},{"t":"And every little breath","s":93.71,"e":96.7},{"t":"Feels like a reminder","s":96.8,"e":99.89},{"t":"That I am not alone","s":99.97,"e":102.45},{"t":"Your presence draws me closer","s":102.55,"e":104.76},{"t":"**[Pre-Chorus]**","s":104.38,"e":105.62},{"t":"And I feel safe in Your loving hands","s":105.65,"e":108.94},{"t":"**[Chorus]**","s":108.33,"e":111.16},{"t":"In the quiet, You are near","s":111.19,"e":114.33},{"t":"In the silence, I can hear","s":114.42,"e":116.81},{"t":"Something deeper than my fear","s":116.83,"e":120.72},{"t":"Calling me, calling me","s":120.81,"e":124.28},{"t":"When the darkness fills the sky","s":124.32,"e":126.7},{"t":"You're the light that never dies","s":126.82,"e":130.37},{"t":"And I know I'm safe tonight","s":130.45,"e":133.88},{"t":"Here with You, here with You","s":133.98,"e":144.05},{"t":"**[Bridge]**","s":137.82,"e":150.68},{"t":"Let the whole world disappear","s":150.72,"e":153.43},{"t":"Let every worry lose its voice","s":153.54,"e":156.86},{"t":"I will stay right here","s":157.02,"e":162.37},{"t":"Your still small voice","s":162.47,"e":164.84},{"t":"Has more power than any noise.","s":164.95,"e":168.71},{"t":"Your closer than any fear","s":168.75,"e":171.34},{"t":"**[Final Chorus]**","s":171.24,"e":171.51},{"t":"In the quiet, You are near","s":171.53,"e":180.16},{"t":"In the silence, I can hear","s":180.24,"e":183.59},{"t":"Your still, small voice so clear","s":183.69,"e":186.38},{"t":"Calling me, calling me","s":186.47,"e":189.94},{"t":"When the darkness fills the sky","s":189.99,"e":193.16},{"t":"You're the light that never dies","s":193.19,"e":196.04},{"t":"And I will lift my eyes","s":196.12,"e":199.55},{"t":"Here with You, here with You","s":199.65,"e":203.57},{"t":"**[Outro]**","s":203.43,"e":203.66},{"t":"In the quiet...","s":203.68,"e":212.43},{"t":"You are here.","s":212.53,"e":215.45},{"t":"In the silence...","s":215.56,"e":218.98},{"t":"You are near.","s":219.07,"e":221.79},{"t":"And I don't need anything","s":221.85,"e":228.91},{"t":"But You.","s":229.02,"e":229.87}],"match":null}
