{"v":1,"id":"de96a45b864f","synced":true,"offset":0,"source":"suno","lines":[{"t":"My children…","s":3.99,"e":10.45},{"t":"I still know your names.","s":10.45,"e":16.72},{"t":"Even now…","s":16.77,"e":19.63},{"t":"I still know your names.","s":19.63,"e":26.89},{"t":"I walked among the trees I planted,","s":26.94,"e":32.84},{"t":"Reached for fruit on every limb.","s":32.89,"e":37.3},{"t":"Found the branches bare and broken,","s":37.34,"e":41.53},{"t":"Found the daylight growing dim.","s":41.57,"e":45.66},{"t":"There were cries behind your windows,","s":45.69,"e":49.41},{"t":"There was blood upon your stones,","s":49.44,"e":53.18},{"t":"And you learned to call it living","s":53.22,"e":56.65},{"t":"While you left each other alone.","s":56.7,"e":60.36},{"t":"I have seen the little children","s":60.4,"e":64.07},{"t":"Learn to hide before they pray.","s":64.15,"e":68.22},{"t":"I have heard you ask for mercy,","s":68.3,"e":71.57},{"t":"Then turn the merciful away.","s":71.65,"e":74.45},{"t":"Do you think I do not feel it?","s":74.54,"e":82.18},{"t":"Do you think I cannot weep?","s":82.26,"e":85.69},{"t":"Every heart you leave in pieces","s":85.77,"e":88.96},{"t":"Cuts a wound in Me so deep.","s":89.04,"e":93.74},{"t":"My tears run down,","s":93.78,"e":97.93},{"t":"My blood runs down.","s":98.03,"e":101.37},{"t":"I call your name—","s":101.49,"e":104.46},{"t":"You drown Me out.","s":104.56,"e":107.9},{"t":"My arms are open,","s":107.93,"e":111.24},{"t":"Your fists are closed.","s":111.34,"e":114.69},{"t":"I reach for children","s":114.81,"e":118.0},{"t":"Who won’t come home.","s":118.11,"e":122.74},{"t":"No pleasure in the breaking,","s":122.85,"e":127.37},{"t":"No joy in what must come.","s":127.47,"e":131.68},{"t":"Oh, My people…","s":131.78,"e":137.76},{"t":"What have you done?","s":137.81,"e":143.51},{"t":"Every tree is drinking sorrow,","s":143.54,"e":146.73},{"t":"Every root is wrapped in stone.","s":146.81,"e":149.18},{"t":"There’s a hunger in your houses","s":149.24,"e":152.79},{"t":"Bread and gold have never known.","s":152.84,"e":156.12},{"t":"And the darkness you keep feeding","s":156.18,"e":159.1},{"t":"Has become a canyon wide.","s":159.2,"e":162.81},{"t":"Still I call across the distance;","s":162.85,"e":165.84},{"t":"Still you find a place to hide.","s":165.88,"e":169.44},{"t":"Even those who wore My name","s":169.48,"e":172.5},{"t":"Have learned to turn their eyes.","s":172.6,"e":175.98},{"t":"They have left the wounded waiting","s":176.03,"e":178.96},{"t":"With My words upon their lips.","s":179.04,"e":184.09},{"t":"Must you make a stranger of Me?","s":184.11,"e":188.9},{"t":"Must you teach your hearts to hate?","s":188.95,"e":192.29},{"t":"I am calling through your silence—","s":192.37,"e":195.4},{"t":"Do not turn your face away.","s":195.48,"e":199.23},{"t":"My tears run down,","s":199.28,"e":203.64},{"t":"My blood runs down.","s":203.75,"e":207.33},{"t":"I call your name—","s":207.45,"e":210.16},{"t":"You drown Me out.","s":210.27,"e":213.86},{"t":"My arms are open,","s":213.96,"e":216.96},{"t":"Your fists are closed.","s":217.05,"e":220.49},{"t":"I reach for children","s":220.61,"e":223.72},{"t":"Who won’t come home.","s":223.83,"e":228.19},{"t":"No pleasure in the breaking,","s":228.31,"e":233.17},{"t":"No joy in what must come.","s":233.27,"e":238.83},{"t":"Oh, My people…","s":238.94,"e":243.11},{"t":"What have you done?","s":243.19,"e":244.96},{"t":"You bound My hands…","s":244.96,"e":245.62},{"t":"I would have held you.","s":245.66,"e":250.23},{"t":"You bound My feet…","s":250.25,"e":252.77},{"t":"I came to find you.","s":252.77,"e":254.54},{"t":"You struck My face…","s":254.64,"e":256.28},{"t":"I looked for yours.","s":256.28,"e":258.19},{"t":"You pierced My side…","s":258.27,"e":263.96},{"t":"And still, these arms—","s":264.06,"e":269.78},{"t":"These arms are yours.","s":269.79,"e":274.47},{"t":"And still the hammer rises.","s":274.52,"e":278.08},{"t":"And still I hear the sound.","s":278.18,"e":281.59},{"t":"And still I call you children","s":281.69,"e":284.44},{"t":"As My blood falls to the ground.","s":284.56,"e":288.39},{"t":"I do not want to lose you.","s":288.51,"e":291.58},{"t":"Can you hear Me through the rain?","s":291.62,"e":295.1},{"t":"Have you grown so far from mercy","s":295.15,"e":301.36},{"t":"You no longer know My pain?","s":301.46,"e":307.02},{"t":"My tears run down,","s":307.05,"e":312.15},{"t":"My blood runs down.","s":312.26,"e":315.84},{"t":"There is no gladness","s":315.88,"e":318.27},{"t":"In this wounded sound.","s":318.39,"e":322.29},{"t":"My arms are open—","s":322.39,"e":325.71},{"t":"They’re open still.","s":325.72,"e":329.78},{"t":"You turn against Me…","s":329.88,"e":333.99},{"t":"I love you still.","s":333.99,"e":338.4},{"t":"No pleasure in the breaking—","s":338.51,"e":342.47},{"t":"No pleasure… none at all.","s":342.58,"e":346.95},{"t":"I never stopped calling.","s":347.07,"e":349.35},{"t":"Did you hear Me call?","s":349.39,"e":352.14},{"t":"Did you hear Me call?","s":352.18,"e":356.16},{"t":"OH, MY PEOPLE…","s":356.23,"e":360.96},{"t":"WHY HAVE YOU FORSAKEN ME?","s":360.96,"e":370.25},{"t":"The earth falls quiet.","s":370.27,"e":373.22},{"t":"The branches bow.","s":373.28,"e":377.43},{"t":"I called you then…","s":377.55,"e":379.99},{"t":"I call you now.","s":380.11,"e":386.52},{"t":"My children…","s":386.62,"e":387.77},{"t":"My children…","s":390.8,"e":391.75},{"t":"My arms…","s":394.63,"e":398.46},{"t":"Are open…","s":398.46,"e":404.2},{"t":"Still.","s":404.2,"e":404.84}],"match":null}
