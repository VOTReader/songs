{"v":1,"id":"1d92c163a05c","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Your voice","s":20.34,"e":21.54},{"t":"Lord, you stir my soul, you light my soul","s":24.54,"e":28.44},{"t":"A love which this world has not known","s":28.44,"e":34.86},{"t":"Why, O Lord, do you bless me so?","s":36.94,"e":41.88},{"t":"I have sinned greatly in my life","s":44.72,"e":49.0},{"t":"I have broken your commandments","s":50.74,"e":54.22},{"t":"And desecrated your name","s":54.22,"e":59.0},{"t":"And this temple you gave me","s":59.54,"e":64.14},{"t":"Yet you never forsook me","s":65.68,"e":71.04},{"t":"What have I done to deserve such mercy","s":71.94,"e":78.32},{"t":"Such a thumbable joy","s":78.32,"e":82.98},{"t":"Such overwhelming love","s":86.32,"e":89.98},{"t":"In Your presence","s":93.2,"e":96.02},{"t":"You are my Lord and my God","s":96.02,"e":100.64},{"t":"My Lord","s":100.64,"e":103.64},{"t":"You are my Lord and my God","s":120.74,"e":126.44},{"t":"My Lord","s":126.44,"e":129.38},{"t":"Thank you.","s":156.92,"e":157.14}],"match":{"letter":"timothy:my-redeemer-lives","score":0.88}}
