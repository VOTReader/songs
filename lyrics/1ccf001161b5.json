{"v":1,"id":"1ccf001161b5","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Yeah, yeah, yeah, yeah, yeah, yeah, yeah, yeah","s":0.0,"e":7.0},{"t":"Corrí buscando libertad","s":9.54,"e":11.84},{"t":"Me perdí entre luces y vanidad","s":12.74,"e":16.56},{"t":"Creí que podía vivir sin ti","s":17.82,"e":20.68},{"t":"Pero tu amor siempre estuvo aquí","s":20.68,"e":23.18},{"t":"Mi corazón latía pero no lo sentí","s":23.18,"e":25.84},{"t":"Hoy tus lágrimas me hablan a mí","s":25.84,"e":28.26},{"t":"Y yo siento tu dolor","s":28.26,"e":33.26},{"t":"Cada noche que lloraste por mí","s":33.26,"e":36.86},{"t":"Ay, mi orgullo me cegó","s":36.86,"e":43.52},{"t":"Pero ahora solo quiero ir hacia ti","s":43.52,"e":47.26},{"t":"Nunca te olvidé","s":50.16,"e":52.3},{"t":"Aunque corrí me perdí","s":52.3,"e":54.9},{"t":"Ahora vuelvo a ti","s":54.9,"e":57.3},{"t":"Mi corazón siempre supo que eras tú","s":57.3,"e":60.8},{"t":"Te elegí después del dolor","s":60.8,"e":64.48},{"t":"Mi amor, verdad, eres tú","s":65.6,"e":69.62},{"t":"Jugando con sombras me desvíe","s":71.88,"e":74.34},{"t":"Busqué otros besos pero nada llené","s":74.34,"e":76.92},{"t":"Ahora veo que tú eras mi todo","s":76.92,"e":79.14},{"t":"El único que pudo darme amor puro yo","s":79.14,"e":82.26},{"t":"Volví, baby, volví","s":84.42,"e":86.46},{"t":"Rasgada y herida","s":86.46,"e":87.78},{"t":"Pero tu amor me encontró","s":87.78,"e":91.12},{"t":"No me iré, no, no","s":93.08,"e":96.48},{"t":"Porque tú eres el único que mi corazón eligió","s":96.48,"e":101.18},{"t":"Nunca te olvidé","s":101.18,"e":102.8},{"t":"Aunque corrí, me perdí","s":102.8,"e":105.44},{"t":"Ahora vuelvo a ti","s":105.44,"e":107.8},{"t":"Mi corazón siempre supo que eras tú","s":107.8,"e":111.34},{"t":"Te elegí después del dolor","s":111.34,"e":115.02},{"t":"Mi amor verdad, eres tú","s":115.02,"e":120.14},{"t":"Nunca te olvide","s":120.14,"e":122.9},{"t":"Nunca te olvide","s":125.62,"e":127.98},{"t":"Nunca te olvide","s":130.78,"e":133.04},{"t":"Nunca te olvide","s":133.04,"e":134.3},{"t":"Nunca te olvide","s":134.3,"e":138.1},{"t":"Gracias.","s":145.02,"e":145.74}],"match":null}
