{"v":1,"id":"1ccf001161b5","synced":true,"offset":0,"source":"suno","lines":[{"t":"Corrí buscando libertad,","s":10.35,"e":13.71},{"t":"me perdí entre luces y vanidad.","s":13.78,"e":18.61},{"t":"Creí que podía vivir sin ti,","s":18.65,"e":21.35},{"t":"pero tu amor siempre estuvo aquí.","s":21.41,"e":23.78},{"t":"Mi corazón latía pero no lo sentí,","s":23.89,"e":26.45},{"t":"hoy tus lágrimas me hablan a mí.","s":26.51,"e":30.67},{"t":"Y yo… siento tu dolor,","s":30.78,"e":34.29},{"t":"cada noche que lloraste por mí…","s":34.37,"e":41.82},{"t":"Mi orgullo me cegó,","s":41.92,"e":44.34},{"t":"pero ahora solo quiero ir hacia ti.","s":44.42,"e":47.48},{"t":"Chorus","s":47.56,"e":51.13},{"t":"Nunca te olvidé,","s":51.21,"e":52.27},{"t":"aunque corrí y me perdí.","s":52.29,"e":56.31},{"t":"Ahora vuelvo a ti,","s":56.39,"e":58.81},{"t":"mi corazón siempre supo que eras tú.","s":58.92,"e":61.21},{"t":"Te elegí después del dolor,","s":61.31,"e":66.79},{"t":"mi amor verdadero eres tú.","s":66.9,"e":70.06},{"t":"Verse 2","s":70.15,"e":72.35},{"t":"Jugando con sombras, me desvié,","s":72.38,"e":74.86},{"t":"busqué otros besos, pero nada llené.","s":74.9,"e":77.51},{"t":"Ahora veo que tú eras mi todo,","s":77.56,"e":79.93},{"t":"el único que pudo darme amor puro.","s":80.01,"e":82.27},{"t":"Yeah, yeah, yeah…","s":82.36,"e":85.71},{"t":"Volví, baby, volví,","s":85.75,"e":86.85},{"t":"rasgada y herida,","s":86.91,"e":89.66},{"t":"pero tu amor me encontró.","s":89.74,"e":91.51},{"t":"Yeah, yeah, yeah…","s":91.61,"e":94.9},{"t":"No me iré, no, no…","s":94.96,"e":97.58},{"t":"porque tú eres el único que mi corazón eligió.","s":97.61,"e":101.71},{"t":"Nunca te olvidé,","s":101.79,"e":104.37},{"t":"aunque corrí y me perdí.","s":104.39,"e":106.74},{"t":"Ahora vuelvo a ti,","s":106.82,"e":109.32},{"t":"mi corazón siempre supo que eras tú.","s":109.42,"e":111.71},{"t":"Te elegí después del dolor,","s":111.82,"e":117.38},{"t":"mi amor verdadero eres tú.","s":117.48,"e":121.9},{"t":"Nunca te olvidé,","s":121.98,"e":126.86},{"t":"aunque corrí y me perdí.","s":126.96,"e":137.06},{"t":"Nunca te olvidé,","s":137.14,"e":138.33}],"match":null}
