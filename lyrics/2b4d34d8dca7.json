{"v":1,"id":"2b4d34d8dca7","synced":true,"offset":0,"source":"suno","lines":[{"t":"Those who are Mine receive of Me.","s":31.07,"e":37.64},{"t":"For I know My own,","s":37.74,"e":40.92},{"t":"and they seek Me;","s":41.01,"e":44.67},{"t":"My bride is chosen.","s":44.77,"e":49.39},{"t":"Yet those who reject Me","s":49.45,"e":51.87},{"t":"and My Word have not known Me,","s":51.93,"e":54.85},{"t":"nor will they receive;","s":54.93,"e":57.12},{"t":"My spirit is far removed.","s":57.22,"e":64.6},{"t":"Those who set themselves apart from Me,","s":64.69,"e":70.66},{"t":"whether by word or deed","s":70.75,"e":74.34},{"t":"or by pretense,","s":74.45,"e":78.04},{"t":"their hearts are revealed;","s":78.11,"e":83.24},{"t":"these shall be left to walk through very dry places.","s":83.27,"e":101.31},{"t":"Yet those who seek Me","s":101.41,"e":103.28},{"t":"in truth shall be drawn in quickly,","s":103.36,"e":108.23},{"t":"whether they are near or far,","s":108.28,"e":111.1},{"t":"for I know My own.","s":111.18,"e":115.33},{"t":"And those who are married unto Me shall surely enter in.","s":115.4,"e":125.79},{"t":"Therefore, judge no more by human standards,","s":125.83,"e":129.62},{"t":"discern by right standards,","s":129.67,"e":132.78},{"t":"according to My love and the knowledge you have received in Me.","s":132.81,"e":140.75},{"t":"For I AM THE LORD, whose will is set","s":140.81,"e":146.36},{"t":"And can in no wise be turned back;","s":146.47,"e":151.88},{"t":"Even from the beginning,","s":151.98,"e":154.21},{"t":"It was decided and accomplished.","s":154.31,"e":167.71},{"t":"For I AM...","s":167.78,"e":204.2},{"t":"And My bride has always been","s":204.25,"e":207.56},{"t":"Predestined in The Beloved,","s":207.64,"e":214.68},{"t":"Says The Lord.","s":214.77,"e":218.33}],"match":{"letter":"wtlb1:i-know-my-own","score":1.0}}
