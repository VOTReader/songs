{"v":1,"id":"2b4d34d8dca7","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Thank you very much.","s":7.96,"e":29.42},{"t":"Those who are mine receive of me","s":30.0,"e":35.16},{"t":"For I know my own and they seek me","s":36.36,"e":42.64},{"t":"My bride is chosen","s":42.64,"e":46.54},{"t":"Yet those who reject me","s":48.34,"e":51.0},{"t":"And my word have not known me","s":51.0,"e":53.86},{"t":"Nor will they receive","s":53.86,"e":56.12},{"t":"My spirit is far removed","s":56.12,"e":60.48},{"t":"Those who set themselves apart from me","s":63.02,"e":68.68},{"t":"Whether by word or deed or by pretense","s":69.24,"e":76.02},{"t":"Their hearts are revealed","s":76.92,"e":79.6},{"t":"Shall be left to walk through","s":82.6,"e":85.5},{"t":"Very dry places","s":85.5,"e":87.2},{"t":"Yet those who seek me in truth","s":100.66,"e":103.6},{"t":"Shall be drawn in quickly","s":103.6,"e":105.62},{"t":"Whether they are near or far","s":107.24,"e":110.36},{"t":"For I know my own","s":110.36,"e":113.22},{"t":"And those who are married unto me","s":114.28,"e":118.22},{"t":"Shall surely enter in","s":118.22,"e":121.44},{"t":"Therefore judge no more by human standards","s":124.78,"e":128.66},{"t":"Discern by right standards","s":129.38,"e":131.24},{"t":"According to my love","s":131.24,"e":134.28},{"t":"And the knowledge you have received in me","s":134.28,"e":137.98},{"t":"For I am the Lord whose will is set","s":139.48,"e":145.04},{"t":"And can in no wise be turned back","s":145.04,"e":150.04},{"t":"Even from the beginning it was decided","s":150.04,"e":155.4},{"t":"And accomplished","s":155.4,"e":157.8},{"t":"For I am","s":166.3,"e":168.9},{"t":"And my bride has always been","s":202.78,"e":207.44},{"t":"Predestined in the beloved","s":209.56,"e":212.54},{"t":"Says the Lord","s":212.54,"e":215.56},{"t":"Thank you.","s":233.56,"e":235.86}],"match":{"letter":"wtlb1:i-know-my-own","score":0.934}}
