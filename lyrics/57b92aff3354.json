{"v":1,"id":"57b92aff3354","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Before the dawn","s":26.14,"e":28.5},{"t":"Before the light","s":28.5,"e":30.52},{"t":"You spoke the stars into the night","s":30.52,"e":34.52},{"t":"Every wave and every breath","s":34.52,"e":38.5},{"t":"Held in hands that conquered death","s":38.5,"e":42.58},{"t":"From the dust you call my name","s":42.58,"e":46.56},{"t":"Still your love remains the same","s":46.56,"e":50.6},{"t":"Through every high and every fall","s":50.6,"e":54.6},{"t":"You've been there through it all","s":54.6,"e":58.82},{"t":"No height, no depth could ever change","s":59.76,"e":64.66},{"t":"The mercy pouring down like rain","s":65.68,"e":73.06},{"t":"Your love is never ending","s":76.2,"e":80.32},{"t":"Never fading, never bending","s":80.32,"e":84.32},{"t":"Like the sky that has no end","s":84.32,"e":88.44},{"t":"You are faithful again and again","s":88.98,"e":92.56},{"t":"Your grace keeps overflowing","s":92.56,"e":96.22},{"t":"Every season always growing","s":96.86,"e":100.28},{"t":"Every promise that you've planned","s":100.86,"e":104.42},{"t":"Is forever in your hands","s":105.12,"e":109.06},{"t":"Every mountain, every sea","s":123.46,"e":127.2},{"t":"Paints a glimpse of majesty","s":127.2,"e":130.68},{"t":"Galaxies that spin in place","s":132.32,"e":135.46},{"t":"Echo out your endless grace","s":135.46,"e":139.36},{"t":"And when I feel I've lost my way","s":139.36,"e":143.42},{"t":"You're already making a way","s":143.96,"e":147.42},{"t":"Every step I cannot see","s":147.98,"e":151.38},{"t":"You've written in eternity","s":151.38,"e":154.4},{"t":"No fear, no doubt could ever stand","s":155.9,"e":161.48},{"t":"Against the purpose in your plan","s":162.18,"e":165.84},{"t":"Your love is never ending","s":173.02,"e":177.06},{"t":"Never fading, never ending","s":177.06,"e":181.16},{"t":"Like the sky that has no end","s":181.16,"e":185.14},{"t":"You are faithful again and again","s":185.78,"e":189.34},{"t":"Your grace keeps overflowing","s":189.9,"e":193.04},{"t":"Every season always growing","s":193.04,"e":197.08},{"t":"Every promise that you've planned","s":197.68,"e":201.24},{"t":"Is forever in your hands","s":201.9,"e":205.8},{"t":"You don't stop, you don't change","s":205.8,"e":209.18},{"t":"Every promise still remains","s":209.78,"e":212.88},{"t":"From beginning to the end","s":213.52,"e":217.24},{"t":"You're my savior and my friend","s":217.24,"e":221.28},{"t":"Yeah, who's sure you hold time","s":221.28,"e":225.3},{"t":"Every moment is designed","s":225.9,"e":228.76},{"t":"What you started, you complete","s":229.66,"e":232.9},{"t":"Every plan is good for me","s":233.46,"e":237.82},{"t":"Your love is never ending","s":237.82,"e":241.62},{"t":"Never fading, never bending","s":241.62,"e":245.7},{"t":"Through the ages you remain","s":245.7,"e":249.34},{"t":"May, everlasting is your name","s":249.34,"e":254.02},{"t":"Your light is always shining","s":254.84,"e":257.72},{"t":"Through the dark your truth is rising","s":257.72,"e":261.98},{"t":"All creation sings your plan","s":261.98,"e":265.64},{"t":"Forever held within your hands","s":265.64,"e":270.28},{"t":"Never ending, never ending","s":270.28,"e":274.06},{"t":"Your love goes on and on","s":274.06,"e":278.3},{"t":"Never ending, never ending","s":278.3,"e":282.0},{"t":"In you I belong","s":282.0,"e":285.88}],"match":null}
