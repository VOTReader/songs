{"v":1,"id":"6d74c23ad7f3","synced":true,"offset":0,"source":"suno","lines":[{"t":"A sheep on the prairie,","s":14.52,"e":17.43},{"t":"A sheep upon the hills,","s":17.55,"e":19.55},{"t":"Guided by his Shepherd","s":19.63,"e":20.9},{"t":"Throughout his faithful years.","s":20.94,"e":23.19},{"t":"Wherever the Shepherd led him,","s":23.24,"e":24.84},{"t":"He followed close behind,","s":24.95,"e":27.05},{"t":"Until deceptive whispers","s":27.13,"e":28.64},{"t":"Took root within his mind.","s":28.7,"e":30.8},{"t":"Led away, led away,","s":30.88,"e":32.65},{"t":"Led away, led away,","s":32.75,"e":34.77},{"t":"The night grows dark so quickly","s":34.83,"e":38.3},{"t":"When the wolves come gathering round.","s":38.36,"e":46.22},{"t":"Led away, led away,","s":46.32,"e":48.21},{"t":"Led away, led away,","s":48.31,"e":50.08},{"t":"In a world filled with deception,","s":50.13,"e":53.9},{"t":"Where the enemy seeks to devour.","s":53.94,"e":61.44},{"t":"A lost sheep,","s":61.52,"e":62.77},{"t":"Still standing his ground,","s":62.82,"e":65.31},{"t":"A lost sheep,","s":65.43,"e":66.42},{"t":"Though the night gathers round.","s":66.45,"e":68.24},{"t":"Far from his Shepherd,","s":68.34,"e":70.29},{"t":"And far from the fold,","s":70.37,"e":71.75},{"t":"Fighting a battle","s":71.76,"e":74.2},{"t":"Deep within his soul.","s":74.3,"e":77.31},{"t":"Led away, led away,","s":77.39,"e":79.17},{"t":"Led away, led away,","s":79.27,"e":81.26},{"t":"The night grows dark so quickly","s":81.3,"e":84.81},{"t":"When the wolves come gathering round.","s":84.87,"e":92.65},{"t":"Led away, led away,","s":92.75,"e":94.57},{"t":"Led away, led away,","s":94.67,"e":96.46},{"t":"In a world filled with deception,","s":96.54,"e":100.25},{"t":"Where the enemy seeks to devour.","s":100.29,"e":107.67},{"t":"Alone in the cold, dark night,","s":107.72,"e":109.75},{"t":"With no shelter in sight,","s":109.79,"e":112.5},{"t":"Bearing the wounds","s":112.58,"e":113.62},{"t":"Of the war that he fights.","s":113.74,"e":