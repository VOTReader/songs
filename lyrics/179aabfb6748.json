{"v":1,"id":"179aabfb6748","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Come, all those who know not my ways, I will show you.","s":12.96,"e":24.14},{"t":"Come, all those who have been abandoned","s":26.34,"e":31.7},{"t":"I will comfort you and give you shelter","s":31.7,"e":36.84},{"t":"Come, all those who are crippled","s":39.04,"e":41.94},{"t":"Let us run and leap for joy together","s":41.94,"e":46.42},{"t":"Come all those faithless","s":50.28,"e":53.76},{"t":"I shall fill your cup","s":54.38,"e":57.14},{"t":"And watch how it overflows","s":57.14,"e":62.4},{"t":"Come all murderers","s":63.22,"e":66.9},{"t":"Watch me raise you","s":66.9,"e":69.64},{"t":"And all who sleep","s":69.64,"e":73.6},{"t":"from the grave","s":75.16,"e":77.0},{"t":"come all you who blaspheme","s":83.3,"e":85.82},{"t":"I will give you a new voice","s":85.82,"e":88.72},{"t":"bring with you all those","s":88.72,"e":91.1},{"t":"who are blind and deaf","s":91.1,"e":92.66},{"t":"for they too shall see","s":92.66,"e":95.06},{"t":"and hear indeed","s":95.06,"e":96.54},{"t":"come all those","s":96.54,"e":98.44},{"t":"who have sinned against me","s":98.44,"e":101.1},{"t":"Take my hand","s":101.1,"e":103.46},{"t":"I will lead you to the waters where I shall wash you","s":103.98,"e":110.34},{"t":"And where your new clothes hang upon the tree","s":110.34,"e":116.66},{"t":"Which grows next to the stream","s":118.22,"e":121.06},{"t":"Come one, come all","s":121.06,"e":124.56},{"t":"Ask and it shall be given you","s":124.56,"e":127.82},{"t":"For all things are possible with God","s":127.82,"e":131.32},{"t":"And made manifest through the Son","s":131.32,"e":134.18},{"t":"Says the Lord Yahushua","s":136.02,"e":139.3},{"t":"Thank you.","s":157.84,"e":159.24}],"match":{"letter":"wtlb1:come-love-awaits-you","score":0.987}}
