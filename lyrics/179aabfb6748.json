{"v":1,"id":"179aabfb6748","synced":true,"offset":0,"source":"suno","lines":[{"t":"Come, all those who know not My ways;","s":14.11,"e":22.78},{"t":"I will show you.","s":22.89,"e":27.23},{"t":"Come, all those who have been abandoned;","s":27.32,"e":33.14},{"t":"I will comfort you and give you shelter.","s":33.26,"e":40.13},{"t":"Come, all those who are crippled;","s":40.17,"e":42.38},{"t":"Let us run and leap for joy together!","s":42.48,"e":51.85},{"t":"Come, all those faithless;","s":51.89,"e":55.48},{"t":"I shall fill your cup,","s":55.6,"e":59.32},{"t":"And watch how it overflows!","s":59.39,"e":62.55},{"t":"Come, all murderers;","s":62.59,"e":68.12},{"t":"Watch Me raise you,","s":68.18,"e":72.33},{"t":"And all who sleep, from the grave.","s":72.39,"e":84.25},{"t":"Come, all you who blaspheme,","s":84.29,"e":86.46},{"t":"I will give you a new voice;","s":86.56,"e":89.97},{"t":"Bring with you all those who are blind and deaf,","s":90.02,"e":93.4},{"t":"For they too, shall see and hear!","s":93.46,"e":96.72},{"t":"Indeed, come all those","s":96.73,"e":99.25},{"t":"who have sinned against Me,","s":99.33,"e":102.31},{"t":"take My hand!","s":102.4,"e":105.99},{"t":"I will lead you to the waters","s":106.11,"e":108.7},{"t":"where I shall wash you,","s":108.74,"e":111.93},{"t":"And where your new clothes","s":112.01,"e":115.46},{"t":"hang upon the tree","s":115.56,"e":119.11},{"t":"Which grows next to the stream.","s":119.18,"e":122.49},{"t":"Come one, come all!","s":122.55,"e":124.09},{"t":"Ask, and it shall be given you!","s":124.19,"e":128.83},{"t":"For all things are possible with God","s":128.89,"e":131.8},{"t":"And made manifest through The Son.","s":131.91,"e":136.93},{"t":"Says The Lord YahuShua.","s":136.99,"e":139.78}],"match":{"letter":"wtlb1:come-love-awaits-you","score":1.0}}
