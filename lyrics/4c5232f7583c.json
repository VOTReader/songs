{"v":1,"id":"4c5232f7583c","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 1)","s":5.08,"e":23.62},{"t":"Give ear to my words, O Lord,","s":23.71,"e":28.92},{"t":"Consider my meditation.","s":29.0,"e":33.61},{"t":"Give heed to the voice of my cry,","s":33.66,"e":37.39},{"t":"My King and my God,","s":37.47,"e":39.53},{"t":"For to You I will pray.","s":39.59,"e":43.53},{"t":"(Pre-Chorus)","s":41.08,"e":43.84},{"t":"My voice You shall hear in the","s":43.9,"e":46.25},{"t":"Morning, O Lord;","s":46.34,"e":48.19},{"t":"In the morning I will direct it to You,","s":48.3,"e":52.15},{"t":"And I will look up.","s":52.23,"e":53.85},{"t":"(Chorus)","s":53.47,"e":57.08},{"t":"For You are not a God who takes","s":57.14,"e":59.81},{"t":"Pleasure in wickedness,","s":59.88,"e":61.69},{"t":"Nor shall evil dwell with You.","s":61.81,"e":64.42},{"t":"The boastful shall not stand in","s":64.48,"e":67.87},{"t":"Your sight;","s":67.95,"e":68.91},{"t":"You hate all workers of iniquity.","s":68.99,"e":73.77},{"t":"You shall destroy those who speak","s":73.85,"e":76.89},{"t":"falsehood;","s":76.98,"e":78.78},{"t":"The Lord abhors the bloodthirsty","s":78.84,"e":82.39},{"t":"and deceitful man.","s":82.5,"e":87.47},{"t":"(Verse 2)","s":84.89,"e":87.61},{"t":"But as for me, I will come into Your","s":87.63,"e":90.69},{"t":"House in the multitude of Your","s":90.78,"e":95.4},{"t":"mercy;","s":95.49,"e":97.98},{"t":"In fear of You I will worship","s":98.08,"e":101.54},{"t":"Toward Your holy temple.","s":101.58,"e":108.18},{"t":"Lead me, O Lord, in Your","s":108.27,"e":110.24},{"t":"Righteousness because of my","s":110.33,"e":113.27},{"t":"Enemies;","s":113.36,"e":114.61},{"t":"Make Your way straight before my","s":114.67,"e":117.98},{"t":"Face.","s":118.08,"e":121.38},{"t":"(Chorus)","s":118.08,"e":121.67},{"t":"For there is no faithfulness in their","s":121.69,"e":125.56},{"t":"Mouth;","s":125.65,"e":127.36},{"t":"There inward part is destruction;","s":127.42,"e":133.55},{"t":"There throat is an open tomb;","s":133.64,"e":137.51},{"t":"They flatter with their tongue.","s":137.57,"e":140.05},{"t":"Pronounce them guilty, O God!","s":140.09,"e":143.35},{"t":"Let them fall by their own","s":143.43,"e":146.16},{"t":"counsels;","s":146.25,"e":148.28},{"t":"Cast them out in the multitude of","s":148.34,"e":151.7},{"t":"their transgressions,","s":151.75,"e":153.02},{"t":"For they have rebelled against You.","s":153.04,"e":158.54},{"t":"(Outro)","s":158.22,"e":160.98},{"t":"But let all those rejoice who put","s":161.06,"e":164.09},{"t":"There trust in You;","s":164.19,"e":166.31},{"t":"Let them shout for joy, because","s":166.37,"e":168.96},{"t":"You defend them;","s":169.07,"e":171.83},{"t":"Let those also who love Your name","s":171.91,"e":175.5},{"t":"Be joyful in You.","s":175.62,"e":178.36},{"t":"For You, O Lord, will bless the","s":178.42,"e":180.77},{"t":"Righteous;","s":180.86,"e":182.99},{"t":"With favor You will surround him","s":183.05,"e":187.63},{"t":"As with a shield.","s":187.75,"e":189.63}],"match":null}
