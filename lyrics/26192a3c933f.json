{"v":1,"id":"26192a3c933f","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I had sent to you my son","s":7.42,"e":14.9},{"t":"I had sinned to you, my son","s":31.68,"e":35.82},{"t":"I had sinned to you, my son","s":35.82,"e":42.06},{"t":"In whom the fullness of God dwells","s":44.94,"e":48.96},{"t":"God in the flesh, Emmanuel","s":48.96,"e":53.32},{"t":"A man without sin","s":55.3,"e":57.96},{"t":"Blameless","s":59.88,"e":61.28},{"t":"Who willingly gave up his life","s":61.88,"e":66.72},{"t":"For all who have fallen under judgment","s":67.28,"e":71.86},{"t":"That those who are willing","s":71.86,"e":75.1},{"t":"Might pass from death to life","s":75.1,"e":81.42},{"t":"From darkness","s":83.16,"e":85.96},{"t":"Into the light of life","s":85.96,"e":91.56},{"t":"For He carried the weight","s":95.58,"e":97.94},{"t":"Of the world's sin","s":99.12,"e":102.12},{"t":"To the cross","s":102.72,"e":104.62},{"t":"For He carried the weight","s":107.9,"e":111.22},{"t":"Of the world's sin to the cross","s":111.22,"e":118.24},{"t":"And crucify sin through His suffering","s":121.08,"e":126.58},{"t":"The penalty of sin abolished","s":127.42,"e":133.58},{"t":"As He fell asleep","s":133.58,"e":137.14},{"t":"The victory established for all time","s":141.22,"e":146.04},{"t":"Upon His rising","s":146.04,"e":149.6},{"t":"That those who are willing","s":149.6,"e":152.7},{"t":"Might pass from death to life","s":152.7,"e":157.58},{"t":"From darkness","s":158.16,"e":161.74},{"t":"Into the light of life","s":161.74,"e":167.28},{"t":"From darkness into the light of life","s":167.28,"e":177.9},{"t":"For you carried the weight of the world's sin to the cross","s":181.3,"e":190.18},{"t":"For He carried the weight","s":193.28,"e":196.58},{"t":"Of the world's sin","s":197.56,"e":200.66},{"t":"To the cross","s":201.26,"e":203.36},{"t":"And crucified sin","s":206.28,"e":209.58},{"t":"Through His suffering","s":210.1,"e":211.98},{"t":"The penalty of sin","s":212.48,"e":216.6},{"t":"Abolished","s":217.24,"e":218.92},{"t":"As he fell asleep","s":218.92,"e":222.56},{"t":"Thus he will be your judge at the last day","s":226.5,"e":231.7},{"t":"All peoples of the earth","s":231.7,"e":234.46},{"t":"Because he is both God and man","s":234.46,"e":239.22},{"t":"Because he is both God and man","s":239.22,"e":245.62},{"t":"Therefore, blessed are all those in whom He sees of Himself","s":247.44,"e":255.54},{"t":"For He carried the weight of the world's sin to the cross","s":259.24,"e":268.84},{"t":"For He carried the weight of the world's sin","s":272.02,"e":279.36},{"t":"To the cross","s":279.9,"e":282.06},{"t":"And crucified sin through His suffering","s":285.08,"e":290.64},{"t":"The penalty of sin abolished","s":291.38,"e":297.5},{"t":"As he fell asleep","s":298.62,"e":301.06},{"t":"For these have already passed from judgment into life","s":305.08,"e":308.9},{"t":"Seated forever at his right hand","s":310.76,"e":314.18},{"t":"Says the Lord","s":315.82,"e":317.44}],"match":{"letter":"two:judgment-transgression-word","score":0.806}}
