{"v":1,"id":"8073396067ef","synced":true,"offset":0,"source":"suno","lines":[{"t":"Come, all those who know not My ways;","s":20.59,"e":28.46},{"t":"I will show you.","s":28.56,"e":31.06},{"t":"Come, all those who have been abandoned;","s":31.16,"e":36.98},{"t":"I will comfort you and give you shelter.","s":37.1,"e":42.42},{"t":"Come, all those who are crippled;","s":42.49,"e":47.05},{"t":"Let us run and leap for joy together!","s":47.11,"e":57.23},{"t":"Come, all those faithless;","s":57.33,"e":60.6},{"t":"I shall fill your cup,","s":60.72,"e":63.14},{"t":"And watch how it overflows!","s":63.24,"e":67.53},{"t":"Come, all murderers;","s":67.62,"e":70.82},{"t":"Watch Me raise you,","s":70.88,"e":74.14},{"t":"And all who sleep, from the grave.","s":74.19,"e":87.23},{"t":"Come, all you who blaspheme,","s":87.33,"e":91.17},{"t":"I will give you a new voice;","s":91.28,"e":96.04},{"t":"Bring with you all those who are blind and deaf,","s":96.09,"e":99.77},{"t":"For they too, shall see and hear!","s":99.89,"e":107.18},{"t":"Indeed, come all those","s":107.19,"e":110.13},{"t":"who have sinned against Me,","s":110.23,"e":113.99},{"t":"take My hand!","s":114.06,"e":116.85},{"t":"I will lead you to the waters","s":116.97,"e":119.89},{"t":"where I shall wash you,","s":119.95,"e":123.17},{"t":"And where your new clothes","s":123.23,"e":125.6},{"t":"hang upon the tree","s":125.7,"e":127.26},{"t":"Which grows next to the stream.","s":127.32,"e":151.62},{"t":"Come one, come all!","s":151.72,"e":155.14},{"t":"Ask, and it shall be given you!","s":155.23,"e":161.55},{"t":"For all things are possible with God","s":161.61,"e":165.48},{"t":"And made manifest through The Son.","s":165.59,"e":172.02},{"t":"Says The Lord YahuShua.","s":172.1,"e":182.15},{"t":"Says The Lord YahuShua.","s":182.23,"e":184.63}],"match":null}
