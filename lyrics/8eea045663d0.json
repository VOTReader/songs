{"v":1,"id":"8eea045663d0","synced":true,"offset":0,"source":"suno","lines":[{"t":"Come, all those who know not My ways;","s":21.58,"e":29.45},{"t":"I will show you.","s":29.55,"e":32.05},{"t":"Come, all those who have been abandoned;","s":32.15,"e":37.97},{"t":"I will comfort you and give you shelter.","s":38.09,"e":43.41},{"t":"Come, all those who are crippled;","s":43.48,"e":48.04},{"t":"Let us run and leap for joy together!","s":48.1,"e":58.22},{"t":"Come, all those faithless;","s":58.32,"e":61.59},{"t":"I shall fill your cup,","s":61.71,"e":64.13},{"t":"And watch how it overflows!","s":64.23,"e":68.52},{"t":"Come, all murderers;","s":68.61,"e":71.81},{"t":"Watch Me raise you,","s":71.87,"e":75.13},{"t":"And all who sleep, from the grave.","s":75.18,"e":88.22},{"t":"Come, all you who blaspheme,","s":88.32,"e":92.16},{"t":"I will give you a new voice;","s":92.27,"e":97.03},{"t":"Bring with you all those who are blind and deaf,","s":97.08,"e":100.76},{"t":"For they too, shall see and hear!","s":100.88,"e":108.17},{"t":"Indeed, come all those","s":108.18,"e":111.12},{"t":"who have sinned against Me,","s":111.22,"e":114.98},{"t":"take My hand!","s":115.05,"e":117.84},{"t":"I will lead you to the waters","s":117.96,"e":120.88},{"t":"where I shall wash you,","s":120.94,"e":124.16},{"t":"And where your new clothes","s":124.22,"e":126.59},{"t":"hang upon the tree","s":126.69,"e":128.25},{"t":"Which grows next to the stream.","s":128.31,"e":152.61},{"t":"Come one, come all!","s":152.71,"e":156.13},{"t":"Ask, and it shall be given you!","s":156.22,"e":162.54},{"t":"For all things are possible with God","s":162.6,"e":166.47},{"t":"And made manifest through The Son.","s":166.58,"e":173.01},{"t":"Says The Lord YahuShua.","s":173.09,"e":183.14},{"t":"Says The Lord YahuShua.","s":183.22,"e":185.62}],"match":{"letter":"wtlb1:come-love-awaits-you","score":0.987}}
