{"v":1,"id":"1376bea9d7ce","synced":true,"offset":0,"source":"suno","lines":[{"t":"Our voice cries together...","s":4.79,"e":10.78},{"t":"Whether they hear","s":10.84,"e":16.04},{"t":"and hearts be saved..","s":16.14,"e":21.74},{"t":"or let them forbair,","s":21.8,"e":36.27},{"t":"Come stand with Me a moment,","s":36.3,"e":39.18},{"t":"close enough to feel My breath.","s":39.26,"e":41.99},{"t":"You stayed when others scattered,","s":42.09,"e":44.23},{"t":"unflinching at what comes next.","s":44.34,"e":47.13},{"t":"You shed all bitter ignorance,","s":47.19,"e":50.17},{"t":"you closed distance not your eyes.","s":50.23,"e":53.16},{"t":"You already merged our sorrows","s":53.26,"e":56.09},{"t":"from tears shed through the night.","s":56.17,"e":60.92},{"t":"I brought you beyond surprise.","s":60.94,"e":64.05},{"t":"beyond toil. Away from blame.","s":64.1,"e":66.8},{"t":"you're here because I love you...","s":66.82,"e":69.53},{"t":"and you feel the very same.","s":69.57,"e":77.91},{"t":"So blow the trumpet with Me.","s":77.93,"e":80.82},{"t":"with heartache ... in truth.","s":80.9,"e":82.43},{"t":"Sound the warning call of love,","s":82.45,"e":86.04},{"t":"as mercy's solemn proof.","s":86.14,"e":89.44},{"t":"Our voice cries together...","s":89.52,"e":92.8},{"t":"Whether they hear","s":92.86,"e":96.62},{"t":"and hearts be saved..","s":96.7,"e":98.18},{"t":"or let them forbair.","s":98.24,"e":109.82},{"t":"I sent My servants early,","s":109.84,"e":112.71},{"t":"My words, clear and true.","s":112.77,"e":115.5},{"t":"Through lives hearers overlooked,","s":115.55,"e":117.73},{"t":"Deaf ears forsake good news.","s":117.75,"e":120.7},{"t":"You watched them twist My mercy,","s":120.76,"e":123.72},{"t":"truth trampled, set aside...","s":123.78,"e":126.38},{"t":"You felt how longer waiting","s":126.44,"e":129.49},{"t":"lets the innocent die.","s":129.57,"e":134.86},{"t":"You know this isn’t sudden,","s":134.88,"e":137.55},{"t":"nor fury breaking free.","s":137.63,"e":140.37},{"t":"Let's break the silence...","s":140.39,"e":142.98},{"t":"Let Me shatter their cruelty.","s":143.01,"e":151.47},{"t":"So blow the trumpet with Me.","s":151.49,"e":154.23},{"t":"Let compassion lead the sound.","s":154.31,"e":156.7},{"t":"The final plea to turn back home,","s":156.78,"e":159.79},{"t":"before the lost are bound.","s":159.85,"e":162.85},{"t":"Our voice cries together...","s":162.93,"e":166.28},{"t":"Whether they hear","s":166.34,"e":169.87},{"t":"and hearts be saved..","s":169.97,"e":171.7},{"t":"or let them forbair.","s":171.78,"e":183.87},{"t":"I take no pleasure in the ending","s":183.89,"e":187.1},{"t":"of those who won't choose life.","s":187.22,"e":189.3},{"t":"I waited until love was tested,","s":189.41,"e":192.34},{"t":"beyond what patience could strive.","s":192.4,"e":195.62},{"t":"But mercy without repentance","s":195.68,"e":197.87},{"t":"shelters the oppressor's sword...","s":197.97,"e":200.66},{"t":"I will not betray the helpless","s":200.74,"e":203.22},{"t":"by delaying justice any more.","s":203.34,"e":236.45},{"t":"Stay locked in with Me.","s":236.47,"e":239.0},{"t":"You’ll never stand apart.","s":239.04,"e":241.5},{"t":"This warning rises from grief","s":241.56,"e":244.23},{"t":"that long has broke our heart.","s":244.31,"e":247.6},{"t":"Our voice cries together...","s":247.7,"e":251.02},{"t":"Whether they hear","s":251.07,"e":254.36},{"t":"And they join the trumpet.","s":254.47,"e":256.3},{"t":"or let them forbair","s":256.41,"e":259.02},{"t":"You can not fail.","s":259.04,"e":261.92},{"t":"You can not fall.","s":261.98,"e":264.38},{"t":"A trumpet sounded clear.","s":264.49,"e":267.55},{"t":"Is love giving all.","s":267.66,"e":277.76},{"t":"Warn them from Me, beloved.","s":277.8,"e":285.27},{"t":"Warn them from Me.","s":285.29,"e":292.18}],"match":null}
