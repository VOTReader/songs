{"v":1,"id":"e92900b2e38f","synced":true,"offset":0,"source":"suno","lines":[{"t":"For I tell you the truth,","s":17.86,"e":27.32},{"t":"That which is tipped","s":27.38,"e":34.6},{"t":"Can not be set upright again,","s":34.67,"e":43.87},{"t":"And that which has been set","s":43.91,"e":48.06},{"t":"In motion can not be stopped.","s":48.12,"e":77.85},{"t":"Lo, even that which was held","s":78.06,"e":88.56},{"t":"Captive in the depths of silence","s":88.66,"e":93.83},{"t":"Has been released,","s":93.93,"e":113.36},{"t":"Behold, it comes forth,","s":113.47,"e":121.66},{"t":"Increasing by order of magnitude","s":121.76,"e":127.68},{"t":"And can in no wise","s":127.76,"e":133.76},{"t":"Be put back again,","s":133.81,"e":142.66},{"t":"Says The Lord","s":142.84,"e":146.03}],"match":null}
