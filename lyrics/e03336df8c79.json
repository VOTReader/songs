{"v":1,"id":"e03336df8c79","synced":true,"offset":0,"source":"suno","lines":[{"t":"Beloved, there is a language of which","s":12.24,"e":19.26},{"t":"You know nothing about, says The Lord...","s":19.37,"e":27.37},{"t":"A language","s":27.4,"e":28.56},{"t":"which is pure and beautiful,","s":28.6,"e":34.78},{"t":"A language","s":34.9,"e":36.61},{"t":"in need of no words at all;","s":36.71,"e":42.28},{"t":"A language","s":42.4,"e":43.69},{"t":"which you shall soon come to know,","s":43.73,"e":49.78},{"t":"A language","s":49.9,"e":52.41},{"t":"which I have revealed","s":52.46,"e":54.77},{"t":"To My servant already...","s":54.89,"e":61.12},{"t":"A language","s":61.15,"e":62.9},{"t":"of overwhelming love,","s":62.98,"e":68.81},{"t":"pure and undefiled,","s":68.89,"e":71.53},{"t":"Bringing forth much understanding;","s":71.62,"e":76.03},{"t":"A language","s":76.15,"e":77.83},{"t":"of power and great glory,","s":77.9,"e":83.04},{"t":"In which all My servants shall come to stand...","s":83.14,"e":90.73},{"t":"The unspoken Word of God received in the presence","s":90.76,"e":98.01},{"t":"Of The Almighty, The Holiest of Holies,","s":98.13,"e":102.37},{"t":"Revealing the essence of who I am...","s":102.41,"e":110.99},{"t":"Union in The Spirit of God...","s":111.04,"e":121.18},{"t":"A place","s":121.23,"e":123.16},{"t":"beyond time and space,","s":123.25,"e":128.81},{"t":"beyond the knowledge","s":128.89,"e":130.25},{"t":"Contained within creation,","s":130.33,"e":134.09},{"t":"surpassing all boundaries,","s":134.14,"e":136.15},{"t":"A place","s":136.23,"e":137.52},{"t":"even angels long to know...","s":137.62,"e":143.58},{"t":"The place","s":143.6,"e":144.97},{"t":"where I am and have always been seated,","s":145.01,"e":148.21},{"t":"Where you shall be also...","s":148.3,"e":152.31},{"t":"A place without time, The Eternal,","s":152.35,"e":158.79},{"t":"The Bosom of The Father, of which I AM...","s":158.85,"e":165.67},{"t":"Says The Lord YahuShua.","s":165.71,"e":167.98}],"match":