{"v":1,"id":"ed2e1d35fc7e","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I am the Lord's","s":11.68,"e":15.62},{"t":"And I will no more give myself","s":17.3,"e":22.24},{"t":"To divers lust","s":22.92,"e":25.86},{"t":"To the cares and deceit","s":26.54,"e":29.44},{"t":"Of my flesh and this world","s":29.44,"e":33.5},{"t":"I am the Lord","s":35.66,"e":38.24},{"t":"My heart, it is the Lord","s":38.94,"e":42.74},{"t":"My mind, it is the Lord","s":42.74,"e":46.1},{"t":"My will, it is the Lord","s":46.1,"e":49.48},{"t":"My flesh, it is the Lord","s":49.48,"e":52.78},{"t":"The whole of my body","s":52.78,"e":56.5},{"t":"Even all I am I give to the Lord","s":56.5,"e":61.12},{"t":"I am the Lord","s":65.58,"e":67.9},{"t":"Yeah, I pour out my life before the Lord","s":78.74,"e":85.04},{"t":"Even as He poured out His, let me receive it","s":85.04,"e":91.76},{"t":"In the name of my love, I call out Yahushua's name","s":91.76,"e":100.56},{"t":"I ask to receive it","s":100.56,"e":105.8},{"t":"Yahushua, my life and my righteousness","s":106.74,"e":110.8},{"t":"I want your life","s":110.8,"e":116.6},{"t":"My Lord and my God, I am yours","s":120.28,"e":124.44},{"t":"Do with me as you please","s":125.02,"e":127.74},{"t":"According to the good pleasure of your will","s":128.34,"e":132.52},{"t":"I give myself away","s":133.06,"e":136.86},{"t":"Yeah, who's you are?","s":183.22,"e":188.16},{"t":"My life and my righteousness","s":188.16,"e":190.58},{"t":"I want your love","s":190.58,"e":196.32},{"t":"My Lord and my God","s":199.38,"e":202.7},{"t":"I am yours","s":202.7,"e":204.42},{"t":"Do with me as you please","s":205.04,"e":207.6},{"t":"According to the good pleasure of your will","s":208.34,"e":212.5},{"t":"I give myself away","s":212.5,"e":216.84},{"t":"Amen.","s":219.38,"e":220.78},{"t":"Amen.","s":226.84,"e":227.5}],"match":{"letter":"wtlb2:i-am-the-lord-s","score":0.777}}
