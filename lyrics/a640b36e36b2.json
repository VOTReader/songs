{"v":1,"id":"a640b36e36b2","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 1)","s":0.16,"e":14.5},{"t":"I've prayed night and day askin'","s":14.52,"e":17.87},{"t":"You to take these things away","s":17.98,"e":21.22},{"t":"That are draggin' me down.","s":21.3,"e":27.69},{"t":"Help clean this filth from my soul,","s":27.77,"e":31.52},{"t":"Make me pure and make me whole.","s":31.6,"e":34.88},{"t":"Take away these things in my heart","s":34.98,"e":41.25},{"t":"That have been trying to pull me away","s":41.33,"e":46.2},{"t":"From the start.","s":46.3,"e":47.42},{"t":"(Chorus)","s":46.9,"e":49.13},{"t":"Burn away the dross","s":49.2,"e":50.43},{"t":"That's been coverin' me up.","s":50.45,"e":52.58},{"t":"Clean me Lord, come sweep my heart,","s":52.66,"e":56.0},{"t":"Leave not a corner where the dust can start.","s":56.06,"e":61.91},{"t":"Make me worthy for You.","s":61.99,"e":65.27},{"t":"Help me put all this impurity away.","s":65.35,"e":72.43},{"t":"Until only pure faith remains.","s":72.5,"e":76.15},{"t":"(Verse 2)","s":75.74,"e":89.72},{"t":"Wispers in the wind,","s":89.79,"e":92.27},{"t":"Sayin' \"Come with us and sin,","s":92.31,"e":95.66},{"t":"And you'll feel good again\".","s":95.74,"e":102.41},{"t":"And I used to believe their lies,","s":102.48,"e":106.06},{"t":"But now them I despise.","s":106.16,"e":108.29},{"t":"Help me put away the sins I did,","s":108.38,"e":116.01},{"t":"Help me face the wrong from which I hid.","s":116.09,"e":122.95},{"t":"Lord, wash me till I'm clean.","s":123.03,"e":126.41},{"t":"Scrub off all the mean.","s":126.44,"e":130.08},{"t":"(Chorus)","s":128.4,"e":130.36},{"t":"Burn away the dross","s":130.42,"e":131.49},{"t":"That's been coverin' me up.","s":131.49,"e":133.64},{"t":"Clean me Lord, come sweep my heart,","s":133.72,"e":137.01},{"t":"Leave not a corner where the dust can start.","s":137.1,"e":143.06},{"t":"Make me worthy for You.","s":143.14,"e":146.41},{"t":"Help me put all this impurity away.","s":146.49,"e":153.58},{"t":"Until only pure faith remains.","s":153.64,"e":170.69},{"t":"(Bridge)","s":156.95,"e":170.78},{"t":"Refine me,","s":170.82,"e":174.35},{"t":"Clean me,","s":174.44,"e":176.43},{"t":"Wipe the filth from my soul.","s":176.52,"e":182.5},{"t":"(Final)","s":180.66,"e":184.39},{"t":"Burn away the dross,","s":184.47,"e":186.62},{"t":"And all my sins of yesterday.","s":186.7,"e":190.36},{"t":"Make me new in Your love,","s":190.42,"e":193.9},{"t":"Help clean me today.","s":193.99,"e":195.76},{"t":"I’ve walked through the dust,","s":195.8,"e":200.09},{"t":"Tried doing it all on my own,","s":200.16,"e":203.78},{"t":"But You meet me right where I’m standing,","s":203.86,"e":209.02},{"t":"And call this tired heart back home.","s":209.08,"e":211.76}],"match":null}
