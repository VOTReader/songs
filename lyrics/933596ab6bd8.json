{"v":1,"id":"933596ab6bd8","synced":true,"offset":0,"source":"suno","lines":[{"t":"Come, all those who know not My ways;","s":16.03,"e":21.82},{"t":"I will show you.","s":21.93,"e":28.82},{"t":"Come, all those who have been abandoned;","s":28.91,"e":34.34},{"t":"I will comfort you and give you shelter.","s":34.46,"e":41.43},{"t":"Come, all those who are crippled;","s":41.52,"e":46.72},{"t":"Let us run and leap for joy together!","s":46.78,"e":54.03},{"t":"Come, all those faithless;","s":54.13,"e":57.08},{"t":"I shall fill your cup,","s":57.2,"e":59.3},{"t":"And watch how it overflows!","s":59.4,"e":66.56},{"t":"Come, all murderers;","s":66.65,"e":69.9},{"t":"Watch Me raise you,","s":69.99,"e":72.16},{"t":"And all who sleep, from the grave.","s":72.23,"e":103.58},{"t":"Come, all you who blaspheme,","s":103.67,"e":109.01},{"t":"I will give you a new voice;","s":109.06,"e":114.42},{"t":"Bring with you all those who are blind and deaf,","s":114.51,"e":119.67},{"t":"For they too, shall see and hear!","s":119.75,"e":128.23},{"t":"Indeed, come all those","s":128.25,"e":130.46},{"t":"who have sinned against Me,","s":130.56,"e":133.95},{"t":"take My hand!","s":133.99,"e":135.63},{"t":"I will lead you to the waters","s":135.71,"e":139.1},{"t":"where I shall wash you,","s":139.14,"e":143.21},{"t":"And where your new clothes","s":143.29,"e":146.02},{"t":"hang upon the tree","s":146.11,"e":148.55},{"t":"Which grows next to the stream.","s":148.62,"e":154.01},{"t":"Come one, come all!","s":154.1,"e":158.69},{"t":"Ask, and it shall be given you!","s":158.77,"e":162.89},{"t":"For all things are possible with God","s":162.95,"e":166.74},{"t":"And made manifest through The Son.","s":166.85,"e":178.1},{"t":"Says The Lord YahuShua.","s":178.19,"e":185.26}],"match":{"letter":"wtlb1:come-love-awaits-you","score":1.0}}
