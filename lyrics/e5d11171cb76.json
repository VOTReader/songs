{"v":1,"id":"e5d11171cb76","synced":false,"offset":null,"source":"whisper","lines":[{"t":"BELOVED AWAKE","s":13.46,"e":16.26},{"t":"Awake from your slumber","s":25.84,"e":29.16},{"t":"Awake from your slumber","s":39.58,"e":42.92},{"t":"Awaken your heart to the majesty on high","s":55.18,"e":60.06},{"t":"Embrace the full revelation of who I am","s":61.44,"e":66.34},{"t":"Of all I have done","s":66.34,"e":69.84},{"t":"For the word of the Lord","s":69.84,"e":73.3},{"t":"Flows like water","s":73.88,"e":76.84},{"t":"My love runs pure","s":77.64,"e":81.08},{"t":"Beloved, awake","s":84.64,"e":86.82},{"t":"Awake from your slumber","s":97.88,"e":101.1},{"t":"Therefore embrace my words and receive of my love","s":110.06,"e":118.02},{"t":"That you may be filled with my spirit","s":118.54,"e":123.26},{"t":"Through the bearing of much fruit in the beloved","s":124.46,"e":130.06},{"t":"It's the Lord","s":136.64,"e":138.44}],"match":null}
