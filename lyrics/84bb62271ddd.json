{"v":1,"id":"84bb62271ddd","synced":false,"offset":null,"source":"whisper","lines":[{"t":"The Holy See","s":11.82,"e":13.78},{"t":"The Holy See fell deep into the earth","s":13.78,"e":17.32},{"t":"Planted three days and nights in the grave's dark hole","s":18.7,"e":24.24},{"t":"The grain of wheat surrendered all in love","s":24.24,"e":30.26},{"t":"Yet burst forth in power, shattering death's cold","s":30.84,"e":36.66},{"t":"No tomb could bind the everlasting life","s":37.88,"e":43.62},{"t":"The stone is rolled away, behold the risen King","s":44.18,"e":51.28},{"t":"I am the victory, the firstfruits from death","s":53.86,"e":59.06},{"t":"Risen and alive, breathing resurrection breath","s":60.4,"e":65.52},{"t":"All who believe in me shall not die but live","s":67.02,"e":72.32},{"t":"I shall raise them up at the last day","s":72.32,"e":76.12},{"t":"Glory I give","s":76.12,"e":78.6},{"t":"Firstfruits of the harvest","s":79.92,"e":82.26},{"t":"The way that leads the rest","s":82.26,"e":85.38},{"t":"Death turned backward forever","s":85.38,"e":88.34},{"t":"Only life shall be blessed","s":88.34,"e":91.94},{"t":"The firstborn from the dead","s":91.94,"e":94.98},{"t":"Forever shall reign","s":95.58,"e":98.0},{"t":"Shout it loud","s":98.0,"e":99.82},{"t":"All creation the Holy One has overcome","s":99.82,"e":104.18},{"t":"Behold, I am rising","s":106.56,"e":110.02},{"t":"Your Redeemer lives","s":110.02,"e":112.66},{"t":"The old order is passing","s":113.16,"e":116.52},{"t":"New glory He gives","s":116.52,"e":119.3},{"t":"No more tears, no more pain","s":119.3,"e":122.44},{"t":"No more night shall remain","s":122.44,"e":125.28},{"t":"The promise is fulfilled","s":125.96,"e":128.68},{"t":"The victory is played","s":129.4,"e":132.24},{"t":"The power to lay down, the power to take up again","s":134.4,"e":140.1},{"t":"The Holy One of Israel has overcome the end","s":140.62,"e":146.96},{"t":"Those given to me shall likewise come forth in mine","s":146.96,"e":153.3},{"t":"When the s