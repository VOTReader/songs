{"v":1,"id":"1e445b24026e","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I walk the valley, lost and gray","s":20.42,"e":25.4},{"t":"Chasing echoes that slipped away","s":26.56,"e":30.62},{"t":"Then I saw the sky ignite","s":31.36,"e":35.74},{"t":"The voice of truth, the endless light","s":36.44,"e":42.06},{"t":"You called my name through wind and flame","s":43.46,"e":48.46},{"t":"And now I live to praise your name","s":48.46,"e":53.48},{"t":"Yeah, who's you? Oh, you lift my soul from chains of night to fields of gold. Every tear becomes a sign of mercy's hand.","s":53.48,"e":71.14},{"t":"Of love divine","s":73.44,"e":76.22},{"t":"In your word","s":84.16,"e":87.42},{"t":"My heart awakes","s":87.96,"e":90.26},{"t":"Through every trial","s":90.26,"e":92.78},{"t":"The darkness breaks","s":92.78,"e":95.94},{"t":"The lonely rise","s":96.7,"e":98.18},{"t":"The weary sing","s":98.18,"e":100.54},{"t":"For in your breath","s":101.66,"e":103.6},{"t":"Creation reigns","s":103.6,"e":108.36},{"t":"You split the sea","s":108.36,"e":110.46},{"t":"That bound my mind","s":110.46,"e":113.52},{"t":"And left my fears so far behind","s":114.06,"e":118.04},{"t":"Yeah, who's you?","s":118.94,"e":120.14},{"t":"Oh, you lift my soul","s":120.34,"e":123.5},{"t":"From chains of night","s":123.5,"e":126.2},{"t":"To fields of gold","s":126.2,"e":129.0},{"t":"Every tear becomes a sign","s":129.0,"e":133.08},{"t":"Of mercy's hand","s":133.7,"e":135.82},{"t":"Of love divine","s":138.36,"e":140.82},{"t":"The heavens roar","s":150.28,"e":153.62},{"t":"The kingdom nears, your promise wipes away all tears","s":153.62,"e":161.2},{"t":"No shadow stands, no pain remains","s":162.6,"e":167.1},{"t":"Glory lies where you have reigned","s":167.92,"e":173.94},{"t":"Yahushua, my heart restored","s":175.68,"e":179.88},{"t":"Forever yours, forevermore","s":180.56,"e":185.58},{"t":"Light of lights, my hope, my song","s":186.36,"e":190.98},{"t":"The Lamb will reign","s":191.66,"e":194.06},{"t":"His truth lives on","s":196.2,"e":197.84},{"t":"I am found, I am reborn","s":207.44,"e":212.52},{"t":"In you, Messiah, I am home","s":213.1,"e":218.12},{"t":"The dawn has come, the veil is torn","s":218.8,"e":223.36},{"t":"All praise to you","s":223.36,"e":226.02},{"t":"The rising sun","s":232.0,"e":235.6},{"t":"Thank you.","s":253.36,"e":253.6}],"match":null}
