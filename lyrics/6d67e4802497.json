{"v":1,"id":"6d67e4802497","synced":false,"offset":null,"source":"whisper","lines":[{"t":"1 Those who are mine receive of me,","s":0.0,"e":24.84},{"t":"For I know my own","s":24.84,"e":28.76},{"t":"And they seek me","s":30.6,"e":34.92},{"t":"My bride is chosen","s":34.92,"e":38.92},{"t":"Yet those who reject me","s":38.92,"e":44.12},{"t":"And my word have not known me","s":44.74,"e":49.76},{"t":"Nor will they receive, my spirit is far removed","s":49.76,"e":58.3},{"t":"Those who set themselves apart from me","s":61.74,"e":66.8},{"t":"Whether by word or deed","s":66.8,"e":70.48},{"t":"Or by pretense","s":70.48,"e":76.4},{"t":"Their hearts are revealed","s":76.4,"e":80.08},{"t":"These shall be left to walk through very dry places","s":81.44,"e":86.66},{"t":"Yet those who seek me","s":87.16,"e":90.22},{"t":"In truth shall be drawn in quickly","s":90.86,"e":94.58},{"t":"Whether they are near or far","s":95.94,"e":99.46},{"t":"For I know my own","s":100.58,"e":104.66},{"t":"And those who are married unto me shall surely enter in","s":104.66,"e":115.38},{"t":"Therefore judge no more by human standards","s":115.38,"e":120.58},{"t":"Discerned by right standards","s":121.16,"e":123.88},{"t":"According to my love and the knowledge you have received","s":124.86,"e":133.32},{"t":"in me","s":133.32,"e":135.72},{"t":"For I am the Lord","s":137.92,"e":142.96},{"t":"whose will is set","s":143.64,"e":145.46},{"t":"and can in no wise","s":146.12,"e":148.08},{"t":"be turned back","s":148.08,"e":150.32},{"t":"Even from the beginning","s":151.76,"e":154.92},{"t":"it was decided","s":154.92,"e":157.66},{"t":"and accomplished","s":157.66,"e":160.0},{"t":"For I am","s":162.36,"e":165.68},{"t":"And my bride has always been","s":182.18,"e":187.94},{"t":"predestined in the Beloved, says the Lord.","s":189.46,"e":196.58}],"match":{"letter":"wtlb1:i-know-my-own","score":0.975}}
