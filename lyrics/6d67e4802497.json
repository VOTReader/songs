{"v":1,"id":"6d67e4802497","synced":true,"offset":0,"source":"suno","lines":[{"t":"Those who are Mine receive of Me.","s":21.14,"e":26.98},{"t":"For I know My own,","s":27.02,"e":32.18},{"t":"and they seek Me;","s":32.27,"e":37.41},{"t":"My bride is chosen.","s":37.49,"e":40.88},{"t":"Yet those who reject Me","s":40.97,"e":45.33},{"t":"and My Word have not known Me,","s":45.43,"e":49.91},{"t":"nor will they receive;","s":50.02,"e":55.72},{"t":"My spirit is far removed.","s":55.82,"e":63.37},{"t":"Those who set themselves apart from Me,","s":63.46,"e":68.15},{"t":"whether by word or deed","s":68.24,"e":73.66},{"t":"or by pretense,","s":73.77,"e":78.54},{"t":"their hearts are revealed;","s":78.59,"e":80.38},{"t":"these shall be left to walk through very dry places.","s":80.41,"e":87.63},{"t":"Yet those who seek Me","s":87.73,"e":91.85},{"t":"in truth shall be drawn in quickly,","s":91.96,"e":97.06},{"t":"whether they are near or far,","s":97.12,"e":101.99},{"t":"for I know My own.","s":102.09,"e":106.43},{"t":"And those who are married unto Me shall surely enter in.","s":106.51,"e":116.84},{"t":"Therefore, judge no more by human standards,","s":116.89,"e":122.08},{"t":"discern by right standards,","s":122.13,"e":125.88},{"t":"according to My love and the knowledge you have received in Me.","s":125.91,"e":140.42},{"t":"For I AM THE LORD, whose will is set","s":140.5,"e":146.24},{"t":"And can in no wise be turned back;","s":146.35,"e":152.4},{"t":"Even from the beginning,","s":152.5,"e":156.56},{"t":"It was decided and accomplished.","s":156.67,"e":164.08},{"t":"For I AM...","s":164.15,"e":184.67},{"t":"And My bride has always been","s":184.76,"e":189.89},{"t":"Predestined in The Beloved,","s":189.99,"e":195.25},{"t":"Says The Lord.","s":195.34,"e":196.99}],"match":{"letter":"wtlb1:i-know-my-own","score":1.0}}
