{"v":1,"id":"bffc2dd32558","synced":false,"offset":null,"source":"whisper","lines":[{"t":"The Lord's Table","s":11.88,"e":14.18},{"t":"Always full","s":30.74,"e":32.66},{"t":"And those who drink from my cup","s":33.7,"e":41.96},{"t":"Shall never go thirsty","s":42.48,"e":45.5},{"t":"For my cup overflows","s":48.7,"e":54.76},{"t":"Bearing fruit in every part of your life","s":54.76,"e":61.06},{"t":"Bringing forth an understanding","s":61.7,"e":68.12},{"t":"The Lord's table is a lie, the Lord's table is a bounty.","s":84.76,"e":94.62},{"t":"Says the Lord, Yahushua","s":96.04,"e":105.68},{"t":"Says the Lord, Yahushua","s":108.54,"e":118.08},{"t":"Says the Lord, Yahushua","s":121.2,"e":130.94}],"match":null}
