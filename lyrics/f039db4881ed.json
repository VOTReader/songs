{"v":1,"id":"f039db4881ed","synced":true,"offset":0,"source":"suno","lines":[{"t":"[Trumpet blast 🎺]","s":1.68,"e":3.3},{"t":"[Thunder rumbling ⛈️]","s":2.41,"e":5.16},{"t":"Thus says The Lord God:","s":5.25,"e":8.78},{"t":"Whom shall I send?","s":8.86,"e":11.07},{"t":"Who will go for Me?","s":11.13,"e":13.22},{"t":"The day is far spent,","s":13.28,"e":15.58},{"t":"the sun is setting on this age of men.","s":15.6,"e":21.81},{"t":"Husbandmen, go out and gather!","s":21.82,"e":26.09},{"t":"For the wheat is bundled tight,","s":26.17,"e":29.02},{"t":"and none can loose it.","s":29.08,"e":30.4},{"t":"Neither man nor beast is able,","s":30.48,"e":34.23},{"t":"for nothing in all creation","s":34.31,"e":36.78},{"t":"can separate what The Lord has bound.","s":36.89,"e":41.91},{"t":"Therefore, My sons,","s":41.93,"e":44.08},{"t":"be strong and go forth!","s":44.2,"e":49.31},{"t":"For the trumpet sounds,","s":49.39,"e":51.68},{"t":"the heavens shake,","s":51.74,"e":53.46},{"t":"and the King is coming quickly!","s":53.54,"e":58.74},{"t":"Behold,","s":58.75,"e":59.58},{"t":"The Lord is One,","s":59.64,"e":62.89},{"t":"His name is One…","s":62.99,"e":67.51},{"t":"Forever and ever.","s":67.6,"e":92.42},{"t":"Behold,","s":92.43,"e":93.25},{"t":"The Lord is One,","s":93.31,"e":96.56},{"t":"His name is One…","s":96.66,"e":99.15},{"t":"Forever and ever.","s":99.2,"e":117.71},{"t":"Therefore, My sons,","s":117.72,"e":120.82},{"t":"be strong and go forth!","s":120.93,"e":125.03},{"t":"For the trumpet sounds,","s":125.11,"e":127.4},{"t":"the heavens shake,","s":127.46,"e":129.18},{"t":"and the King is coming quickly!","s":129.26,"e":131.18},{"t":"Behold,","s":131.19,"e":134.08},{"t":"The Lord is One,","s":134.2,"e":136.91},{"t":"His name is One…","s":136.99,"e":141.23},{"t":"Forever and ever.","s":141.32,"e":142.82}],"match":null}
