{"v":1,"id":"7ef29d340a56","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Hear the cry of my heart","s":22.4,"e":25.28},{"t":"For you're the only name that saves","s":27.56,"e":31.52},{"t":"My feet were wandering","s":33.88,"e":37.0},{"t":"Lost in every broken way","s":39.16,"e":42.34},{"t":"You said call upon salvation","s":44.76,"e":47.76},{"t":"So here I am undone","s":50.66,"e":54.18},{"t":"Turn me fully toward your light","s":55.88,"e":59.64},{"t":"Finish what you've begun","s":61.22,"e":64.5},{"t":"Break the chains I fashioned","s":67.74,"e":70.78},{"t":"Pull me from my own designs","s":70.78,"e":74.26},{"t":"Let every tear that falls tonight","s":74.26,"e":78.28},{"t":"Be counted unto life","s":78.84,"e":82.16},{"t":"I cry out for salvation","s":84.58,"e":87.18},{"t":"I call upon Your name","s":89.68,"e":93.06},{"t":"Grant me full repentance","s":96.22,"e":98.96},{"t":"Draw me deeply into flame","s":101.06,"e":103.82},{"t":"I cry out for salvation","s":107.08,"e":109.66},{"t":"No other hope will do","s":111.88,"e":115.38},{"t":"Shepherd, hear my trembling voice","s":118.06,"e":121.0},{"t":"I'm running back to You","s":123.14,"e":126.22},{"t":"Search me, Shepherd","s":129.66,"e":132.08},{"t":"We are now at Upper Session Road","s":143.74,"e":162.06},{"t":"Wash me in Your mercy, Lord","s":163.18,"e":166.8},{"t":"And teach my feet to stand","s":167.34,"e":171.36},{"t":"Every lie I trusted","s":174.36,"e":177.2},{"t":"Falls like dust beneath Your gaze","s":177.2,"e":180.84},{"t":"Let every breath that rises now","s":180.84,"e":184.92},{"t":"Be worship shaped by grace","s":184.92,"e":188.52},{"t":"I cry out for salvation, I call upon Your name","s":190.76,"e":199.34},{"t":"Grant me full repentance, draw me deeply in a flame","s":202.36,"e":210.08},{"t":"I cry out for salvation","s":212.92,"e":215.82},{"t":"No other hope will do","s":218.74,"e":221.6},{"t":"Shepherd, hear my trembling voice","s":224.3,"e":227.16},{"t":"I'm running back to you","s":22