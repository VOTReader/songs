{"v":1,"id":"52e5727787b8","synced":true,"offset":0,"source":"suno","lines":[{"t":"Verse 1","s":9.89,"e":10.08},{"t":"From the dark, You spoke the light,","s":10.09,"e":14.22},{"t":"Stars awakened in the night.","s":14.31,"e":18.75},{"t":"Oceans formed at Your command,","s":18.83,"e":23.29},{"t":"Mountains rising from Your hand.","s":23.36,"e":28.07},{"t":"Chorus","s":28.1,"e":28.24},{"t":"Maker of it all—earth, sea, and sky,","s":28.35,"e":33.07},{"t":"Every living thing, You gave them life.","s":33.11,"e":37.04},{"t":"With every breath, creation calls","s":37.13,"e":41.65},{"t":"Praise to You, the Maker of it all.","s":41.72,"e":44.22},{"t":"Verse 2","s":44.32,"e":54.57},{"t":"Fields of green and rivers wide,","s":54.64,"e":59.13},{"t":"Gentle rain and morning tide.","s":59.22,"e":63.34},{"t":"From flower’s bloom to eagle’s flight,","s":63.4,"e":68.42},{"t":"Every wonder shows Your might.","s":68.46,"e":70.63},{"t":"Chorus","s":70.72,"e":73.09},{"t":"Maker of it all—earth, sea, and sky,","s":73.19,"e":77.99},{"t":"Every living thing, You gave them life.","s":78.03,"e":81.96},{"t":"With every breath, creation calls","s":82.05,"e":86.57},{"t":"Praise to You, the Maker of it all.","s":86.64,"e":97.76},{"t":"Verse 2","s":97.85,"e":99.51},{"t":"Fields of green and rivers wide,","s":99.56,"e":102.62},{"t":"Gentle rain and morning tide.","s":102.71,"e":108.26},{"t":"From flower’s bloom to eagle’s flight,","s":108.32,"e":113.34},{"t":"Every wonder shows Your might.","s":113.38,"e":115.71},{"t":"Chorus","s":115.8,"e":118.01},{"t":"Maker of it all—earth, sea, and sky,","s":118.11,"e":122.83},{"t":"Every living thing, You gave them life.","s":122.87,"e":126.8},{"t":"With every breath, creation calls","s":126.89,"e":131.41},{"t":"Praise to You, the Maker of it all.","s":131.48,"e":134.3},{"t":"Bridge","s":134.39,"e":135.4},{"t":"All the creatures great and small,","s":135.51,"e":140.24},{"t":"Every detail, seen by all—","s":140.29,"e":144.14},{"t":"From Eden’s dawn to world’s