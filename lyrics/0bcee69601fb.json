{"v":1,"id":"0bcee69601fb","synced":true,"offset":0,"source":"suno","lines":[{"t":"My children…","s":4.81,"e":10.91},{"t":"I still know your names.","s":11.03,"e":16.67},{"t":"Even now…","s":16.71,"e":17.1},{"t":"I still know your names.","s":19.33,"e":28.0},{"t":"I walked among the trees I planted,","s":28.02,"e":33.33},{"t":"Reached for fruit on every limb.","s":33.37,"e":37.64},{"t":"Found the branches bare and broken,","s":37.68,"e":41.63},{"t":"Found the daylight growing dim.","s":41.67,"e":45.61},{"t":"There were cries behind your windows,","s":45.63,"e":49.12},{"t":"There was blood upon your stones,","s":49.14,"e":52.72},{"t":"And you learned to call it living","s":52.76,"e":55.95},{"t":"While you left each other alone.","s":55.98,"e":59.42},{"t":"I have seen the little children","s":59.46,"e":62.81},{"t":"Learn to hide before they pray.","s":62.88,"e":66.52},{"t":"I have heard you ask for mercy,","s":66.64,"e":69.58},{"t":"Then turn the merciful away.","s":69.64,"e":74.81},{"t":"Do you think I do not feel it?","s":74.83,"e":79.54},{"t":"Do you think I cannot weep?","s":79.6,"e":82.84},{"t":"Every heart you leave in pieces","s":82.92,"e":85.95},{"t":"Cuts a wound in Me so deep.","s":86.03,"e":90.08},{"t":"My tears run down,","s":90.11,"e":94.04},{"t":"My blood runs down.","s":94.14,"e":97.32},{"t":"I call your name—","s":97.44,"e":100.25},{"t":"You drown Me out.","s":100.35,"e":103.61},{"t":"My arms are open,","s":103.72,"e":106.79},{"t":"Your fists are closed.","s":106.89,"e":109.93},{"t":"I reach for children","s":110.05,"e":113.0},{"t":"Who won’t come home.","s":113.11,"e":117.34},{"t":"No pleasure in the breaking,","s":117.44,"e":121.48},{"t":"No joy in what must come.","s":121.59,"e":126.11},{"t":"Oh, My people…","s":126.22,"e":132.21},{"t":"What have you done?","s":132.28,"e":137.95},{"t":"Every tree is drinking sorrow,","s":137.98,"e":141.01},{"t":"Every root is wrapped in stone.","s":141.09,"e":144.06},{"t":"There’s a hunger in your houses","s":144.09,"e":146.67},{"t":"Bread and gold have never known.","s":146.73,"e":149.98},{"t":"And the darkness you keep feeding","s":150.02,"e":152.74},{"t":"Has become a canyon wide.","s":152.84,"e":156.13},{"t":"Still I call across the distance;","s":156.17,"e":159.08},{"t":"Still you find a place to hide.","s":159.12,"e":162.29},{"t":"Even those who wore My name","s":162.36,"e":165.66},{"t":"Have learned to turn their eyes.","s":165.74,"e":168.33},{"t":"They have left the wounded waiting","s":168.36,"e":171.17},{"t":"With My words upon their lips.","s":171.23,"e":175.98},{"t":"Must you make a stranger of Me?","s":175.99,"e":180.23},{"t":"Must you teach your hearts to hate?","s":180.28,"e":183.37},{"t":"I am calling through your silence—","s":183.45,"e":186.48},{"t":"Do not turn your face away.","s":186.56,"e":190.49},{"t":"My tears run down,","s":190.54,"e":194.81},{"t":"My blood runs down.","s":194.92,"e":198.25},{"t":"I call your name—","s":198.37,"e":201.11},{"t":"You drown Me out.","s":201.21,"e":204.7},{"t":"My arms are open,","s":204.81,"e":207.79},{"t":"Your fists are closed.","s":207.87,"e":211.02},{"t":"I reach for children","s":211.14,"e":214.01},{"t":"Who won’t come home.","s":214.12,"e":218.43},{"t":"No pleasure in the breaking,","s":218.53,"e":222.81},{"t":"No joy in what must come.","s":222.92,"e":227.6},{"t":"Oh, My people…","s":227.71,"e":233.54},{"t":"What have you done?","s":233.61,"e":237.59},{"t":"You bound My hands…","s":237.62,"e":240.1},{"t":"I would have held you.","s":240.1,"e":241.78},{"t":"You bound My feet…","s":241.86,"e":243.45},{"t":"I came to find you.","s":243.45,"e":245.07},{"t":"You struck My face…","s":245.09,"e":246.88},{"t":"I looked for yours.","s":246.88,"e":248.48},{"t":"You pierced My side…","s":248.56,"e":250.18},{"t":"And still, these arms—","s":250.2,"e":260.79},{"t":"These arms are yours.","s":260.8,"e":264.59},{"t":"And still the hammer rises.","s":264.63,"e":267.89},{"t":"And still I hear the sound.","s":267.99,"e":271.32},{"t":"And still I call you children","s":271.42,"e":274.17},{"t":"As My blood falls to the ground.","s":274.29,"e":278.36},{"t":"I do not want to lose you.","s":278.48,"e":281.09},{"t":"Can you hear Me through the rain?","s":281.15,"e":284.51},{"t":"Have you grown so far from mercy","s":284.56,"e":289.73},{"t":"You no longer know My pain?","s":289.81,"e":295.2},{"t":"My tears run down,","s":295.22,"e":299.97},{"t":"My blood runs down.","s":300.07,"e":303.89},{"t":"There is no gladness","s":303.93,"e":306.32},{"t":"In this wounded sound.","s":306.44,"e":310.02},{"t":"My arms are open—","s":310.13,"e":313.44},{"t":"They’re open still.","s":313.46,"e":316.8},{"t":"You turn against Me…","s":316.9,"e":320.81},{"t":"I love you still.","s":320.93,"e":325.51},{"t":"No pleasure in the breaking—","s":325.63,"e":329.25},{"t":"No pleasure… none at all.","s":329.36,"e":333.81},{"t":"I never stopped calling.","s":333.93,"e":338.06},{"t":"Did you hear Me call?","s":338.12,"e":342.64},{"t":"OH, MY PEOPLE…","s":342.73,"e":348.07},{"t":"WHY HAVE YOU FORSAKEN ME?","s":348.17,"e":354.06},{"t":"The earth falls quiet.","s":354.07,"e":357.31},{"t":"The branches bow.","s":357.39,"e":359.98},{"t":"I called you then…","s":360.1,"e":364.13},{"t":"I call you now.","s":364.25,"e":368.67},{"t":"My children…","s":368.77,"e":372.58},{"t":"My children…","s":372.68,"e":375.9},{"t":"My arms…","s":375.9,"e":384.74},{"t":"Are open…","s":384.8,"e":388.51},{"t":"Still.","s":388.6,"e":389.22}],"match":null}
