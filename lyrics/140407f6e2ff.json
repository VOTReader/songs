{"v":1,"id":"140407f6e2ff","synced":true,"offset":0,"source":"suno","lines":[{"t":"You’ve been sounding the shofar, loud and clear,","s":27.07,"e":30.29},{"t":"Trumpeting truth that all should hear.","s":30.31,"e":32.93},{"t":"But even the faithful need to breathe,","s":32.97,"e":35.33},{"t":"The King smiles — “Rest, my child, believe.”","s":35.37,"e":37.62},{"t":"---","s":37.32,"e":37.62},{"t":"The angels cheer, the heavens nod,","s":37.64,"e":41.16},{"t":"Your hands are full, your heart with God.","s":41.21,"e":44.05},{"t":"Pause your voice, catch your flame,","s":44.12,"e":46.64},{"t":"For every note bears His holy name.","s":46.74,"e":50.92},{"t":"---","s":48.87,"e":50.92},{"t":"Holy Cooldown Mode!","s":50.93,"e":53.34},{"t":"Even the bold must pause.","s":53.43,"e":55.58},{"t":"Trumpets rest, harps hum soft,","s":55.61,"e":58.64},{"t":"Yet hearts stay full of awe!","s":58.7,"e":60.74},{"t":"The King sees your every call,","s":60.82,"e":64.12},{"t":"Your voice will rise again!","s":64.15,"e":66.74},{"t":"Holy Cooldown Mode!","s":66.84,"e":71.06},{"t":"Recharging for His reign!","s":71.16,"e":76.78},{"t":"---","s":73.76,"e":76.78},{"t":"Thunder sleeps, the shofars still,","s":76.79,"e":79.19},{"t":"Yet faith and love cannot be stilled.","s":79.29,"e":82.19},{"t":"Even in rest, your light shines bright,","s":82.25,"e":84.4},{"t":"The King will wake the trumpets’ might.","s":84.44,"e":87.49},{"t":"---","s":86.3,"e":87.49},{"t":"Prepare again, the call resumes,","s":87.49,"e":89.5},{"t":"The heavens roar, the fire consumes.","s":89.54,"e":91.44},{"t":"Rest now, warrior, your moment nears,","s":91.51,"e":93.97},{"t":"The King awaits — sound His truth to the spheres!","s":94.01,"e":96.03},{"t":"---","s":95.73,"e":96.03},{"t":"Holy Cooldown Mode!","s":96.04,"e":99.64},{"t":"Even the bold must pause.","s":99.76,"e":101.94},{"t":"Trumpets rest, harps hum soft,","s":101.96,"e":105.0},{"t":"Yet hearts stay full of awe!","s":105.06,"e":107.18},{"t":"The King sees your every call,","s":107.26,"e":110.43},{"t":"Your voice will rise again!","s":110.49,"e":112.94},{"t":"Holy Cooldown Mode!","s":113.04,"e":117.34},{"t":"Recharging for His reign!","s":117.44,"e":142.41},{"t":"---","s":120.04,"e":142.41},{"t":"[Outro – Harp fades, Thunder echoes, Whispered Choir]","s":120.04,"e":143.78},{"t":"“Rest… then rise again.”","s":143.6,"e":147.11},{"t":"“For behold… the King comes.”","s":144.93,"e":152.18},{"t":"YahuShua-YAHuWaH","s":152.23,"e":162.64},{"t":"Holy Cooldown Mode!","s":162.65,"e":165.12},{"t":"Even the bold must pause.","s":165.21,"e":167.36},{"t":"Trumpets rest, harps hum soft,","s":167.39,"e":170.45},{"t":"Yet hearts stay full of awe!","s":170.53,"e":172.66},{"t":"The King sees your every call,","s":172.72,"e":175.92},{"t":"Your voice will rise again!","s":175.97,"e":178.44},{"t":"Holy Cooldown Mode!","s":178.54,"e":182.84},{"t":"Recharging for His reign!","s":182.95,"e":186.09}],"match":null}
