{"v":1,"id":"dabe84124a1d","synced":true,"offset":0,"source":"suno","lines":[{"t":"Touching the Heart of God","s":2.71,"e":9.87},{"t":"The hard of heart have no knowledge;","s":9.93,"e":15.34},{"t":"Even all revelation is hidden from their eyes.","s":15.43,"e":21.83},{"t":"Yet one who shares in My cup,","s":21.89,"e":24.7},{"t":"Weeping heavily upon My chest,","s":24.75,"e":27.85},{"t":"Has touched the heart of God.","s":27.93,"e":33.72},{"t":"For sincere tears open the door to My fullness,","s":33.78,"e":39.63},{"t":"Yet a hard heart is a locked door...","s":39.69,"e":43.6},{"t":"Says The Lord.","s":43.65,"e":47.09},{"t":"Matters of the Heart","s":47.18,"e":49.83},{"t":"The wailing of the penitent","s":49.87,"e":51.54},{"t":"Brings forth healing;","s":51.62,"e":54.83},{"t":"Yet the words of the wicked","s":54.93,"e":57.45},{"t":"Cause only pain.","s":57.53,"e":61.22},{"t":"Love flows outward from","s":61.28,"e":63.03},{"t":"The hearts of the righteous;","s":63.11,"e":67.44},{"t":"Yet the love of the wicked","s":67.54,"e":70.21},{"t":"Grows cold, as hate enters in.","s":70.31,"e":86.03},{"t":"For sincere tears open the door to My fullness,","s":86.07,"e":92.23},{"t":"Yet a hard heart is a locked door...","s":92.31,"e":96.46},{"t":"Says The Lord.","s":96.52,"e":99.97},{"t":"Matters of the Heart","s":100.05,"e":102.67},{"t":"The wailing of the penitent","s":102.73,"e":104.52},{"t":"Brings forth healing;","s":104.59,"e":107.73},{"t":"Yet the words of the wicked","s":107.83,"e":110.35},{"t":"Cause only pain.","s":110.43,"e":114.12},{"t":"Love flows outward from","s":114.18,"e":115.93},{"t":"The hearts of the righteous;","s":116.01,"e":120.34},{"t":"Yet the love of the wicked","s":120.44,"e":123.03},{"t":"Grows cold, as hate enters in.","s":123.13,"e":130.61}],"match":null}
