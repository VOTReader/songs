{"v":1,"id":"2537d9a50cab","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I hear the cry of my heart","s":21.46,"e":25.22},{"t":"For you're the only name that saves","s":27.48,"e":31.4},{"t":"My feet were wandering","s":33.74,"e":36.74},{"t":"Lost in every broken way","s":39.08,"e":42.32},{"t":"You said call upon salvation","s":44.68,"e":47.72},{"t":"So here I am undone","s":50.58,"e":54.08},{"t":"Turn me fully toward your light","s":55.92,"e":59.6},{"t":"Finish what you've begun","s":61.3,"e":64.46},{"t":"Break the chains I fashion","s":67.78,"e":70.8},{"t":"Pull me from my own designs","s":70.8,"e":74.12},{"t":"Let every tear that falls tonight","s":74.72,"e":78.3},{"t":"Be counted unto life","s":78.88,"e":82.2},{"t":"I cry out for salvation","s":84.54,"e":87.2},{"t":"I call upon your name","s":87.98,"e":93.18},{"t":"Grant me full repentance","s":96.3,"e":98.64},{"t":"Draw me deeply into flame","s":101.2,"e":104.1},{"t":"I cry out for salvation","s":107.48,"e":109.92},{"t":"No other hope will do","s":112.74,"e":115.76},{"t":"Shepherd, hear my trembling voice","s":118.48,"e":121.34},{"t":"I'm running back to you","s":123.54,"e":126.6},{"t":"Search me, shepherd","s":130.2,"e":132.5},{"t":"My hidden faults, my shadowed pride","s":134.74,"e":138.12},{"t":"Try my heart","s":141.1,"e":143.62},{"t":"Where old desires still reside","s":146.0,"e":149.26},{"t":"You say turn from all corruption","s":152.04,"e":155.1},{"t":"So I turn with open hands","s":157.58,"e":161.12},{"t":"Wash me in your mercy, Lord","s":164.08,"e":167.52},{"t":"And teach my feet to stand","s":167.52,"e":171.76},{"t":"Every lie I trust in","s":175.04,"e":178.28},{"t":"Falls like dust beneath your gaze","s":178.28,"e":181.62},{"t":"Let every breath that rises now","s":181.62,"e":185.76},{"t":"Be worship shaped by grace","s":185.76,"e":189.42},{"t":"I cry out for salvation","s":191.6,"e":194.46},{"t":"Salvation, I call upon your name, grant me full repentance, draw me deeply in your flame