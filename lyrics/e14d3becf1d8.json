{"v":1,"id":"e14d3becf1d8","synced":true,"offset":0,"source":"suno","lines":[{"t":"Search me, Lord.","s":28.4,"e":30.96},{"t":"my heart’s laid bare before Your face.","s":31.04,"e":40.23},{"t":"Try me, Lord.","s":40.33,"e":41.85},{"t":"test the corners I can’t trace.","s":41.97,"e":51.84},{"t":"You know Your own,","s":51.9,"e":54.81},{"t":"so call me by the name You gave;","s":54.89,"e":61.28},{"t":"Make my love steadfast,","s":61.36,"e":66.54},{"t":"make my faith unmoved and brave.","s":66.62,"e":73.78},{"t":"I am Yours, Lord.","s":73.8,"e":76.74},{"t":"write Your will on my soul.","s":76.81,"e":79.75},{"t":"I am Yours, Lord","s":79.87,"e":82.58},{"t":"make this temple wholly whole.","s":82.68,"e":85.69},{"t":"Not in walls, not for crowds,","s":85.77,"e":88.4},{"t":"but in this heart You set apart…","s":88.48,"e":91.72},{"t":"I am Yours, Lord.","s":91.84,"e":94.61},{"t":"keep Your Kingdom in my heart.","s":94.68,"e":106.26},{"t":"Find me here, within,","s":106.29,"e":108.72},{"t":"where flesh can’t hide.","s":108.78,"e":118.1},{"t":"Speak to me.","s":118.19,"e":119.78},{"t":"Your whisper breaks the noise inside.","s":119.87,"e":128.92},{"t":"The church of brick and stone,","s":128.98,"e":130.74},{"t":"crumbles down like shifting sand","s":130.79,"e":139.15},{"t":"but Your true house rises","s":139.26,"e":144.1},{"t":"in the ones who grasp Your hand.","s":144.22,"e":151.09},{"t":"I am Yours, Lord.","s":151.12,"e":153.99},{"t":"write Your will on my soul.","s":154.07,"e":157.14},{"t":"I am Yours, Lord.","s":157.26,"e":158.89},{"t":"make this temple wholly whole.","s":158.92,"e":163.07},{"t":"Not in walls, not for crowds,","s":163.12,"e":165.7},{"t":"but in this heart You set apart…","s":165.76,"e":168.87},{"t":"I am Yours, Lord.","s":168.99,"e":171.78},{"t":"keep Your Kingdom in my heart.","s":171.86,"e":176.93},{"t":"You search the hearts and minds.","s":176.96,"e":179.2},{"t":"so let Your gaze find faith in me.","s":179.28,"e":182.57},{"t":"You know whose love is steady.","s":182.67,"e":185.11},{"t":"Lord, make mine what You see.","s":185.19,"e":187.86},{"t":"Not the old, not the broken vow,","s":187.9,"e":189.6},{"t":"not the fear that held me back…","s":189.71,"e":193.79},{"t":"Call me “Your remnant now,”","s":193.85,"e":196.04},{"t":"and keep me on Your narrow track.","s":196.12,"e":204.05},{"t":"I am Yours, Lord.","s":204.06,"e":207.03},{"t":"write Your will on my soul.","s":207.1,"e":210.12},{"t":"I am Yours, Lord.","s":210.24,"e":212.95},{"t":"make this temple wholly whole.","s":213.03,"e":215.84},{"t":"You remain, I remain.","s":215.94,"e":218.95},{"t":"never torn again apart…","s":219.04,"e":220.93},{"t":"I am Yours, Lord.","s":221.01,"e":224.76},{"t":"keep Your Kingdom in my heart.","s":224.84,"e":233.21},{"t":"Search me, know me.","s":233.24,"e":244.85},{"t":"See of Yourself in me.","s":244.91,"e":247.14},{"t":"I am Yours.","s":247.26,"e":252.05}],"match":null}
