{"v":1,"id":"84aeba6d59fd","synced":false,"offset":null,"source":"whisper","lines":[{"t":"In the cool of the day, I hear you call my name","s":13.46,"e":19.72},{"t":"Longing for your children to return again","s":20.9,"e":25.98},{"t":"From the garden we wandered","s":25.98,"e":29.9},{"t":"Hearts bruised and torn","s":29.9,"e":32.5},{"t":"But your promise remains","s":32.5,"e":35.44},{"t":"A new day is born","s":36.02,"e":38.86},{"t":"The mouth of Sheol opened wide","s":40.16,"e":45.24},{"t":"We walked in shadows, learned to hide","s":46.26,"e":51.78},{"t":"But now redemption draws us near","s":51.78,"e":58.12},{"t":"No more sorrow, only tears of release","s":59.0,"e":65.96},{"t":"Return to the garden","s":69.52,"e":72.7},{"t":"Where broken hearts mend","s":74.84,"e":78.8},{"t":"In your presence forever","s":81.56,"e":84.9},{"t":"Where love doesn't end","s":88.28,"e":91.62},{"t":"You defeated the night","s":94.2,"e":97.96},{"t":"Turned death into dawn","s":98.86,"e":101.04},{"t":"Rise up my soul","s":101.86,"e":104.24},{"t":"The old ways are gone","s":104.24,"e":107.46},{"t":"The mystery revealed","s":109.04,"e":111.64},{"t":"In your eyes the truth","s":112.46,"e":115.04},{"t":"From valleys of darkness","s":115.04,"e":118.62},{"t":"You carry us through","s":118.62,"e":121.38},{"t":"The shepherd, the friend","s":121.38,"e":124.42},{"t":"The father, the guide","s":125.02,"e":127.7},{"t":"In the book of life","s":127.7,"e":130.38},{"t":"Our names you have inscribed","s":130.38,"e":134.08},{"t":"You fed the hungry, you clothed the cold","s":134.64,"e":140.7},{"t":"For every wounded exile your arms unfold","s":141.28,"e":148.08},{"t":"I am risen, you declare, let life begin","s":148.08,"e":153.3},{"t":"All things restored, we are home","s":154.02,"e":158.14},{"t":"No more pain, no more tears","s":164.54,"e":170.84},{"t":"Kingdom come, cast out our fears","s":171.9,"e":176.94},{"t":"For every heart that's groaned","s":177.6,"e":184.02},{"t":"Let healing start","s":184.02,"e":186.1},{"t":"Count the days no more","s":190.5,"e":195.86},{"t":"We stand reborn","s":196.92,"e":199.54},{"t":"Return to the garden","s":202.1,"e":205.58},{"t":"Restored in your light","s":209.0,"e":211.44},{"t":"A new creation shining","s":213.76,"e":218.06},{"t":"All things made right","s":221.06,"e":224.82},{"t":"You are the meaning of life","s":226.54,"e":230.76},{"t":"In you we belong","s":231.54,"e":233.36},{"t":"Forever together","s":234.46,"e":236.18},{"t":"Together in glory and song.","s":236.18,"e":240.2},{"t":"Come all who have wandered, take his hand, be renewed.","s":244.72,"e":250.82},{"t":"The riches of Eden created anew.","s":252.28,"e":257.46}],"match":null}
