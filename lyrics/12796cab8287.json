{"v":1,"id":"12796cab8287","synced":true,"offset":0,"source":"suno","lines":[{"t":"We hear it. We feel it.","s":10.29,"e":14.19},{"t":"Breath unsteady in our chests.","s":14.26,"e":16.89},{"t":"You say You’re coming down...","s":16.95,"e":19.95},{"t":"The earth shakes beneath our steps.","s":19.97,"e":22.4},{"t":"The nations quake at prophecy,","s":22.46,"e":26.31},{"t":"Trembling starts within…","s":26.38,"e":28.24},{"t":"Burn what clings to darkness, Lord;","s":28.32,"e":31.12},{"t":"Make all straight when You descend.","s":31.2,"e":33.71},{"t":"You say, “Cry out for Mercy…”","s":33.74,"e":37.12},{"t":"Mercy, Lord is my cry.","s":37.22,"e":39.83},{"t":"Saying, “Lift your voice, ‘Grace! Grace!’”","s":39.92,"e":43.2},{"t":"May Grace become our life.","s":43.24,"e":46.14},{"t":"Grace… grace…","s":46.19,"e":47.61},{"t":"let it pour on us like rain.","s":47.67,"e":51.88},{"t":"Mercy… mercy…","s":51.97,"e":53.19},{"t":"Etch it on our heart again.","s":53.24,"e":56.43},{"t":"Holy One of Israel...","s":56.52,"e":59.16},{"t":"Prepare us for Your flame.","s":59.2,"e":63.05},{"t":"Grace… grace…","s":63.14,"e":66.78},{"t":"We call upon Your name.","s":66.86,"e":72.32},{"t":"You warned the world of judgment...","s":72.34,"e":76.47},{"t":"Even weak ears heard Your call.","s":76.56,"e":79.03},{"t":"Melt what stands in pride, Lord;","s":79.07,"e":81.73},{"t":"On feet of clay we stood tall","s":81.84,"e":84.41},{"t":"The lofty crash down before You...","s":84.49,"e":88.12},{"t":"so bring our heights to low;","s":88.18,"e":90.1},{"t":"Let reverence be our trembling,","s":90.2,"e":92.87},{"t":"And holy fear be all we know.","s":92.95,"e":95.7},{"t":"You say, “The Lord shall roar…”","s":95.72,"e":98.62},{"t":"so let that roar awaken us.","s":98.7,"e":101.35},{"t":"You said You’d search the hearts of men...","s":101.45,"e":104.3},{"t":"Find in us the fire You seek.","s":104.34,"e":108.2},{"t":"Grace… grace…","s":108.25,"e":109.53},{"t":"let it pour on us like rain.","s":109.59,"e":113.79},{"t":"Mercy… mercy…","s":113.88,"e":115.1},{"t":"pull me from our former ways.","s":115.15,"e":118.5},{"t":"Holy One of Israel...","s":118.6,"e":121.08},{"t":"prepare us for Your flame.","s":121.12,"e":124.96},{"t":"Grace… grace…","s":125.05,"e":128.64},{"t":"We call upon Your name.","s":128.75,"e":140.54},{"t":"And as we cry, we hear the others","s":140.55,"e":143.78},{"t":"voices rising where we stand.","s":143.87,"e":146.41},{"t":"Our trembling gathers into one,","s":146.49,"e":149.54},{"t":"Our hearts moved by Your hand.","s":149.64,"e":152.15},{"t":"You say, “Peoples of the earth, cry out!”","s":152.23,"e":155.39},{"t":"so we lift the name You gave…","s":155.45,"e":159.11},{"t":"Grace… grace…","s":159.2,"e":160.47},{"t":"Mercy for the nations You shake.","s":160.56,"e":170.67},{"t":"Grace… grace…","s":170.71,"e":172.05},{"t":"we cry out as Your own.","s":172.15,"e":176.42},{"t":"Mercy… mercy…","s":176.52,"e":177.83},{"t":"let Your righteousness be made known.","s":177.89,"e":181.29},{"t":"Holy One of Israel...","s":181.39,"e":183.81},{"t":"Your footsteps shake the ground.","s":183.85,"e":187.83},{"t":"Grace… grace…","s":187.93,"e":189.91},{"t":"Your remnant gathers now.","s":190.01,"e":192.26},{"t":"We cry out…","s":192.29,"e":197.02},{"t":"We call Your name…","s":197.13,"e":202.44},{"t":"Holy One of Israel...","s":202.53,"e":206.66},{"t":"come down.","s":206.72,"e":209.44},{"t":"Come down.","s":209.52,"e":214.51},{"t":"oh, come!","s":214.61,"e":215.59}],"match":null}
