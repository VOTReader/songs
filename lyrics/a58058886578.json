{"v":1,"id":"a58058886578","synced":true,"offset":0,"source":"suno","lines":[{"t":"When the night is deep and silent,","s":1.22,"e":4.89},{"t":"And the heart feels worn and torn,","s":4.97,"e":8.78},{"t":"Your whisper breaks the darkness,","s":8.85,"e":11.89},{"t":"Calling the lost and the forlorn.","s":11.95,"e":15.16},{"t":"You gather every broken soul,","s":15.22,"e":18.83},{"t":"And bind their wounds with grace,","s":18.89,"e":22.49},{"t":"Your mercy flows like rivers,","s":22.54,"e":27.11},{"t":"A light we can’t replace.","s":27.23,"e":32.77},{"t":"Oh Lord, Your love is endless,","s":32.79,"e":36.29},{"t":"A fire that never fades,","s":36.4,"e":39.84},{"t":"You reach through storms and shadows,","s":39.92,"e":43.59},{"t":"And lift the hearts You’ve made.","s":43.67,"e":47.29},{"t":"Your truth is our foundation,","s":47.32,"e":50.97},{"t":"Your hands our resting place,","s":51.02,"e":55.09},{"t":"Forever we will praise You,","s":55.17,"e":58.41},{"t":"For love that never fails.","s":58.47,"e":63.72},{"t":"Your voice thunders through the heavens,","s":63.74,"e":66.01},{"t":"Yet gentle as the rain,","s":66.09,"e":67.7},{"t":"You call us into freedom,","s":67.8,"e":69.66},{"t":"You heal our deepest pain.","s":69.72,"e":71.39},{"t":"The earth and all creation,","s":71.43,"e":73.35},{"t":"Bow down before Your throne,","s":73.43,"e":75.04},{"t":"For every heart that calls You,","s":75.14,"e":77.0},{"t":"Will never stand alone.","s":77.06,"e":78.87},{"t":"You are the Lamb, the Lion,","s":78.89,"e":81.21},{"t":"The Breath that calls us home,","s":81.25,"e":85.71},{"t":"In Your light we see forever,","s":85.79,"e":89.17},{"t":"We are Yours, we are not our own.","s":89.28,"e":110.23},{"t":"Oh Lord, Your love is endless,","s":110.25,"e":112.72},{"t":"A fire that never fades,","s":112.76,"e":117.47},{"t":"You reach through storms and shadows,","s":117.55,"e":121.14},{"t":"And lift the hearts You’ve made.","s":121.22,"e":124.79},{"t":"Your truth is our salvation,","s":124.86,"e":128.48},{"t":"Your name, our living flame,","s":128.56,"e":132.48},{"t":"Forever we will praise You,","s":132.57,"e":136.23},{"t":"Forever You remain.","s":136.32,"e":138.69}],"match":null}
