{"v":1,"id":"edf0f7bd2eb9","synced":false,"offset":null,"source":"whisper","lines":[{"t":"My Forgiveness","s":12.9,"e":15.7},{"t":"My forgiveness runs far and wide","s":15.7,"e":21.42},{"t":"Entering deep into the hearts of those","s":26.16,"e":30.74},{"t":"Who come to me in sincere repentance","s":30.74,"e":34.44},{"t":"Yet many of my sheep believe themselves to be above reproach","s":38.34,"e":48.92},{"t":"And in this do they greatly err","s":51.12,"e":56.22},{"t":"Therefore let all my beloved grow wise in me","s":56.22,"e":62.1},{"t":"And learn also to walk in my ways","s":65.08,"e":74.06},{"t":"For I am a pillar of strength","s":77.38,"e":83.14},{"t":"To those of low degree","s":84.24,"e":87.0},{"t":"I uphold the powerless and steady","s":90.62,"e":96.46},{"t":"The weary","s":96.46,"e":99.7},{"t":"As I renew the hearts of my land","s":101.2,"e":109.62},{"t":"Behold, I fill all those who come to me","s":121.68,"e":128.04},{"t":"Empty with","s":128.04,"e":129.4},{"t":"Spirit and grace","s":133.14,"e":135.82},{"t":"As they walk with me","s":136.74,"e":138.5},{"t":"Into everlasting life","s":138.5,"e":142.56},{"t":"Indeed","s":147.28,"e":148.68},{"t":"They shall experience","s":148.68,"e":152.12},{"t":"Life in abundance","s":152.8,"e":154.9},{"t":"Life of such a kind","s":165.64,"e":168.64},{"t":"Which is only found in me","s":168.64,"e":171.66},{"t":"And I am","s":171.66,"e":173.96},{"t":"Says the Lord","s":176.18,"e":177.88},{"t":"Thank you.","s":190.74,"e":192.14},{"t":"Thanks for watching!","s":216.0,"e":220.18}],"match":{"letter":"wtlb1:a-pillar-of-strength","score":0.907}}
