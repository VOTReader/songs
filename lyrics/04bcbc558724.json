{"v":1,"id":"04bcbc558724","synced":true,"offset":0,"source":"suno","lines":[{"t":"Let your hearts burst forth with praise!","s":15.46,"e":21.07},{"t":"Let every beat resound in your chests","s":21.17,"e":26.34},{"t":"to the praise of My glory!","s":26.45,"e":35.66},{"t":"Bless the name of pure, unending love!","s":35.71,"e":44.49},{"t":"Bless the name of mercy and grace,","s":44.56,"e":47.6},{"t":"the name of righteousness!","s":47.66,"e":53.35},{"t":"Bless the name of Him, who bore your sins upon the tree!","s":53.42,"e":62.17},{"t":"Kiss the Son! Says YAHUWAH, The Holy!","s":62.22,"e":71.04},{"t":"Kiss Him upon His feet,","s":71.09,"e":73.21},{"t":"Kiss Him upon His hands,","s":73.28,"e":74.97},{"t":"put your hand in His side...","s":75.03,"e":78.09},{"t":"TASTE and see!","s":78.14,"e":79.23},{"t":"Come Close and kiss My wounds, which I received...","s":79.33,"e":83.96},{"t":"Yes, each one you gave Me....","s":84.05,"e":88.83},{"t":"Kiss Me , and be separated no longer....","s":88.88,"e":92.93},{"t":"Partake of His fullness and receive of Me!","s":92.98,"e":99.6},{"t":"AWAKEN YOUR HEARTS!","s":99.66,"e":101.95},{"t":"ROUSE FROM YOUR SLUMBER!...","s":102.03,"e":103.91},{"t":"YOUR KING COMES TO YOU!","s":103.96,"e":105.74},{"t":"He is just,","s":105.84,"e":109.45},{"t":"He is your salvation!","s":109.53,"e":114.88},{"t":"His garment is righteousness!...","s":114.96,"e":118.83},{"t":"Have you grasped it?!...","s":118.86,"e":122.1},{"t":"Hurry, lay hold on Him!","s":122.19,"e":140.37},{"t":"He is My heart, says The Father!","s":140.43,"e":145.03},{"t":"Press your ear against My chest,","s":145.09,"e":147.25},{"t":"and listen to the sound of My love...","s":147.31,"e":152.05},{"t":"Every beat of My mercy.","s":152.1,"e":154.53},{"t":"Feel the embrace of My arms,","s":154.61,"e":157.85},{"t":"Strong and gentle.","s":157.9,"e":159.13},{"t":"I AM YOUR FATHER!","s":159.24,"e":162.91},{"t":"Your heart's one embrace.","s":162.99,"e":165.01},{"t":"My children, have you heard?","s":165.12,"e":169.05},{"t":"Have you truly considered?","s":169.13,"e":171.69},{"t":"THE DESIRE OF AGES IS COME!","s":171.77,"e":180.08},{"t":"Therefore, Sing!","s":180.12,"e":184.0},{"t":"Sing for me!","s":184.09,"e":191.3},{"t":"THE BRIDEGROOM APPROACHES!","s":191.36,"e":209.83},{"t":"He is My heart, says The Father!","s":209.87,"e":214.52},{"t":"Press your ear against My chest,","s":214.59,"e":216.39},{"t":"and listen to the sound of My love...","s":216.49,"e":221.67},{"t":"Every beat of My mercy.","s":221.71,"e":224.19},{"t":"Feel the embrace of My arms,","s":224.27,"e":227.93},{"t":"Strong and gentle.","s":227.99,"e":230.37},{"t":"Therefore, Sing!","s":230.42,"e":235.23},{"t":"Sing for me!","s":235.32,"e":239.89},{"t":"THE BRIDEGROOM APPROACHES!","s":239.95,"e":242.46}],"match":{"letter":"wtlb2:the-bridegroom-approaches","score":0.965}}
