{"v":1,"id":"878df3658c18","synced":true,"offset":0,"source":"suno","lines":[{"t":"Eat of me","s":21.06,"e":24.26},{"t":"Partake of my words","s":24.36,"e":26.49},{"t":"And be filled","s":26.6,"e":29.04},{"t":"Breathe me in","s":29.11,"e":31.12},{"t":"That the song of the lamb may dwell within you","s":31.2,"e":36.06},{"t":"For it is the knowledge of my love","s":36.17,"e":42.93},{"t":"The revelation of who I truly am","s":43.01,"e":49.71},{"t":"A song","s":49.87,"e":53.22},{"t":"A chorus","s":53.38,"e":56.33},{"t":"Soon to be a symphony","s":56.43,"e":63.11},{"t":"A great outpouring of revelation to the praise of my glory","s":63.27,"e":91.78},{"t":"Beloved","s":91.89,"e":93.83},{"t":"It is also the music we share","s":93.95,"e":99.1},{"t":"Sweet melodies of grace and peace playing softly","s":99.19,"e":105.8},{"t":"Within your heart","s":105.86,"e":107.95},{"t":"Each string plucked gently and surely","s":108.05,"e":113.3},{"t":"The sound of my love revealed in you and through you","s":113.4,"e":123.91},{"t":"My spirit","s":124.03,"e":125.27},{"t":"My breath","s":125.39,"e":126.94},{"t":"My life","s":127.06,"e":128.79},{"t":"given and received","s":128.88,"e":132.29},{"t":"Bearing much fruit","s":132.35,"e":134.15},{"t":"in The Beloved...","s":134.26,"e":138.01},{"t":"Says The Lord","s":138.1,"e":149.46},{"t":"YahuShua","s":149.56,"e":152.95}],"match":null}
