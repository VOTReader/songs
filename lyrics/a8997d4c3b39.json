{"v":1,"id":"a8997d4c3b39","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I am the Lord, and I will no more give myself to divers lost","s":11.72,"e":25.86},{"t":"To the cares and deceit of my flesh and this world","s":25.86,"e":33.54},{"t":"I am the Lord","s":35.36,"e":38.44},{"t":"My heart it is the Lord's, my mind it is the Lord's","s":38.44,"e":45.86},{"t":"My will it is the Lord's, my flesh it is the Lord's","s":46.46,"e":53.12},{"t":"The whole of my body","s":53.12,"e":56.36},{"t":"Even all I am I give to the Lord","s":56.36,"e":61.04},{"t":"I am the Lord","s":65.58,"e":68.08},{"t":"Yeah, I pour out my life","s":78.68,"e":82.88},{"t":"Before the Lord","s":83.12,"e":85.02},{"t":"Even as He poured out His","s":85.02,"e":89.22},{"t":"Let me receive it","s":89.74,"e":91.78},{"t":"In the name of my love","s":91.78,"e":96.3},{"t":"I call out Yahushua's name","s":96.3,"e":100.5},{"t":"I ask to receive it","s":100.5,"e":105.54},{"t":"Yahushua, my life and my righteousness","s":106.78,"e":110.64},{"t":"I want your light","s":110.64,"e":116.56},{"t":"My Lord and my God, I am yours","s":119.34,"e":124.5},{"t":"Do with me as you please","s":125.04,"e":127.7},{"t":"According to the good pleasure of your will","s":128.34,"e":132.54},{"t":"I give myself away","s":133.1,"e":136.84},{"t":"Yeah, who's you are?","s":181.9,"e":188.16},{"t":"My life and my righteousness","s":188.16,"e":190.58},{"t":"I want your love","s":190.58,"e":196.4},{"t":"My Lord and my God","s":199.36,"e":202.68},{"t":"I am yours","s":202.68,"e":204.42},{"t":"Do with me as you please","s":205.04,"e":207.64},{"t":"According to the good pleasure of your will","s":208.34,"e":212.52},{"t":"I give myself away","s":212.52,"e":217.04},{"t":"No way","s":217.04,"e":217.46},{"t":"Amen","s":219.32,"e":220.72},{"t":"Amen","s":223.38,"e":224.78}],"match":{"letter":"wtlb2:i-am-the-lord-s","score":0.766}}
