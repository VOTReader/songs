{"v":1,"id":"5ad34d32a030","synced":true,"offset":0,"source":"suno","lines":[{"t":"Sabbath peace…","s":17.07,"e":22.06},{"t":"Set-apart time…","s":22.1,"e":26.63},{"t":"YahuShua reigns…","s":26.69,"e":29.32},{"t":"On the Sabbath day, I guard my tongue,","s":29.33,"e":32.79},{"t":"No careless word, no evil one,","s":32.87,"e":36.64},{"t":"Only praise rising from my mouth,","s":36.73,"e":42.69},{"t":"Beauty clothed in truth and light.","s":42.77,"e":45.89},{"t":"Grace surrounds me like a shield,","s":45.98,"e":49.0},{"t":"Gentle heart, my spirit kneels,","s":49.09,"e":55.63},{"t":"Humility walks by my side,","s":55.73,"e":62.15},{"t":"In stillness, Yah is glorified.","s":62.23,"e":68.16},{"t":"Sabbath peace, let the world be still,","s":68.18,"e":71.03},{"t":"Put away the work, submit the will,","s":71.13,"e":74.38},{"t":"From sunset glow to evening star,","s":74.47,"e":77.43},{"t":"I remember You — You remember me, Yah.","s":77.55,"e":84.15},{"t":"Sabbath peace, holy rest,","s":84.2,"e":87.37},{"t":"Seventh day, forever blessed,","s":87.45,"e":90.36},{"t":"I let it go, every care released,","s":90.48,"e":92.9},{"t":"In Your presence — Sabbath peace.","s":93.01,"e":112.93},{"t":"Lay down burdens, lay down fear,","s":112.95,"e":115.99},{"t":"The noise of man won’t enter here,","s":116.05,"e":119.23},{"t":"No buying, selling, no heavy load,","s":119.34,"e":125.63},{"t":"Just awe of Yah and His holy road.","s":125.68,"e":128.99},{"t":"Heaven and earth by His command,","s":129.05,"e":132.23},{"t":"All creation from His hand,","s":132.33,"e":138.69},{"t":"Even Yahuwah paused and blessed,","s":138.78,"e":145.23},{"t":"And called this day His sacred rest.","s":145.33,"e":151.37},{"t":"Sabbath peace, let the world be still,","s":151.37,"e":154.09},{"t":"Put away the work, submit the will,","s":154.19,"e":157.68},{"t":"From sunset glow to evening star,","s":157.77,"e":160.65},{"t":"I remember You — You remember me, Yah.","s":160.77,"e":167.35},{"t":"Sabbath peace, holy rest,","s":167.39,"e":170.59},{"t":"Seventh day, forever blessed,","s":170.66,"e":173.58},{"t":"I let it go, every care released,","s":173.7,"e":177.07},{"t":"In Your presence — Sabbath peace.","s":177.18,"e":188.71},{"t":"Remember the Sabbath…","s":188.72,"e":192.19},{"t":"And your God…","s":192.25,"e":193.86},{"t":"And He shall remember you.","s":193.92,"e":198.1},{"t":"Love one another…","s":198.16,"e":200.32},{"t":"As I have loved you…","s":200.37,"e":202.99},{"t":"Rest… and be renewed.","s":203.09,"e":208.94},{"t":"Crown of glory, promised true,","s":208.96,"e":212.25},{"t":"Given by the Faithful and True,","s":212.34,"e":215.51},{"t":"Says the Lord, YahuShua reigns,","s":215.59,"e":221.78},{"t":"Sabbath peace remains…","s":221.84,"e":231.36},{"t":"Sabbath peace remains…","s":231.41,"e":235.77}],"match":null}
