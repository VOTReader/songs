{"v":1,"id":"8c327f9a6a4f","synced":true,"offset":0,"source":"suno","lines":[{"t":"The heavens split, the sky ignites,","s":21.7,"e":25.25},{"t":"A white horse cuts through fierce and might.","s":25.37,"e":28.95},{"t":"Eyes like flame, the earth stands still,","s":29.01,"e":32.29},{"t":"The King advances by His will.","s":32.35,"e":36.49},{"t":"many crowns upon His head,","s":36.58,"e":39.38},{"t":"A name unknown, a path of dread.","s":39.49,"e":43.09},{"t":"Faithful, True - He rides ahead","s":43.16,"e":49.93},{"t":"The ground shakes hard beneath His feet,","s":49.99,"e":53.71},{"t":"Justice rolls with thunder’s beat.","s":53.8,"e":57.25},{"t":"Nations cut through with the sword,","s":57.37,"e":60.08},{"t":"All creation will know the Lord.","s":60.16,"e":62.82},{"t":"(Chorus)","s":62.37,"e":64.75},{"t":"He rides to war,","s":64.81,"e":66.7},{"t":"In righteous flame,","s":66.78,"e":68.32},{"t":"The Word of God","s":68.42,"e":70.37},{"t":"Eternal Name!","s":70.46,"e":72.26},{"t":"King of kings!","s":72.33,"e":73.96},{"t":"Lord of lords!","s":74.04,"e":75.32},{"t":"The nations fall","s":75.4,"e":79.15},{"t":"Before His sword!","s":79.22,"e":93.89},{"t":"(Verse 2)","s":79.96,"e":94.08},{"t":"The armies follow, clothed in white,","s":94.1,"e":97.8},{"t":"Pure and ready for the fight.","s":97.87,"e":101.36},{"t":"He speaks once, His truth cuts deep,","s":101.46,"e":104.81},{"t":"Kings grow silent, strongholds weep.","s":104.87,"e":108.46},{"t":"From His mouth the sword goes forth,","s":108.51,"e":111.82},{"t":"Judgment burns from south to north.","s":111.86,"e":115.45},{"t":"No throne stands, no crown remains,","s":115.53,"e":118.52},{"t":"When He steps onto the plain.","s":118.55,"e":120.68},{"t":"(Pre-Chorus)","s":120.37,"e":122.33},{"t":"The winepress waits, the hour near,","s":122.38,"e":126.03},{"t":"Time is at hand, not ruled by fear.","s":126.08,"e":129.34},{"t":"He does not fail, He does not stall,","s":129.41,"e":132.49},{"t":"The true King now calls it all.","s":132.53,"e":137.19},{"t":"He rides to war,","s":137.29,"e":138.86},{"t":"In righteous flame,","s":138.96,"e":140.66},{"t":"The Word of God","s":140.74,"e":142.66},{"t":"Eternal Name!","s":142.75,"e":144.6},{"t":"King of kings!","s":144.65,"e":146.31},{"t":"Lord of lords!","s":146.38,"e":147.61},{"t":"The nations fall","s":147.69,"e":151.44},{"t":"Before His sword!","s":151.5,"e":165.68},{"t":"Trumpets cry,","s":165.7,"e":168.83},{"t":"Lightening collide!","s":168.91,"e":172.78},{"t":"Heaven’s host at His side!","s":172.83,"e":179.77},{"t":"Steel and fire, truth and might,","s":179.82,"e":186.57},{"t":"He rules the age, He wins the fight!","s":186.68,"e":195.44},{"t":"He rides to war!","s":195.54,"e":197.1},{"t":"No rival stands!","s":197.21,"e":198.91},{"t":"The world is judged","s":198.99,"e":200.59},{"t":"By nail-pierced hands!","s":200.7,"e":202.85},{"t":"King of kings!","s":202.9,"e":204.49},{"t":"Lord of lords!","s":204.57,"e":206.27},{"t":"All bow down","s":206.37,"e":209.68},{"t":"Before the Lord!","s":209.75,"e":212.82},{"t":"(Outro)","s":210.5,"e":224.08},{"t":"On His robe, on His thigh,","s":224.14,"e":227.48},{"t":"Written across the burning night:","s":227.57,"e":231.03},{"t":"KING OF KINGS — LORD OF LORDS","s":231.08,"e":235.93}],"match":null}
