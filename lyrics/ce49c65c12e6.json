{"v":1,"id":"ce49c65c12e6","synced":true,"offset":0,"source":"suno","lines":[{"t":"Verse 1","s":13.48,"e":18.87},{"t":"Shadows tried to claim me,","s":18.92,"e":22.92},{"t":"Pulled me to the ground—","s":22.95,"e":26.8},{"t":"But You were in the whisper,","s":26.85,"e":29.87},{"t":"The fire breaking out.","s":29.94,"e":35.59},{"t":"Every wound I carried","s":35.62,"e":37.76},{"t":"You turned to burning gold,","s":37.86,"e":41.92},{"t":"Now the darkness trembles","s":41.99,"e":44.99},{"t":"At the story that You wrote.","s":45.07,"e":50.15},{"t":"Pre-Chorus","s":50.21,"e":50.47},{"t":"I was fading, barely breathing,","s":50.5,"e":54.33},{"t":"But Your love kept reaching in...","s":54.38,"e":57.31},{"t":"Chorus","s":57.4,"e":58.44},{"t":"Now I rise with an unbreakable flame,","s":58.51,"e":63.78},{"t":"Your power roaring through my veins.","s":63.87,"e":67.06},{"t":"No fear, no chains—I'm alive again,","s":67.16,"e":71.8},{"t":"’Cause You call my heart by name.","s":70.38,"e":75.07},{"t":"And the night can’t hold me, no, not again—","s":75.13,"e":83.59},{"t":"I burn with an unbreakable flame.","s":83.69,"e":92.71},{"t":"Verse 2","s":92.78,"e":93.17},{"t":"Storms were crashing over,","s":93.19,"e":95.88},{"t":"I thought I'd drown alone—","s":95.98,"e":101.24},{"t":"But You were in the thunder,","s":101.3,"e":104.27},{"t":"The strength within the roar.","s":104.33,"e":107.1},{"t":"Every doubt that haunted","s":107.19,"e":112.31},{"t":"You shattered with Your light;","s":112.41,"e":116.4},{"t":"Now I stand unshaken,","s":116.46,"e":119.91},{"t":"A soldier of Your fire.","s":119.99,"e":122.8},{"t":"Pre-Chorus","s":122.85,"e":124.67},{"t":"I was fading, almost breaking,","s":124.78,"e":128.77},{"t":"But Your mercy pulled me in...","s":128.82,"e":132.79},{"t":"Chorus","s":132.8,"e":132.93},{"t":"Now I rise with an unbreakable flame,","s":132.98,"e":136.82},{"t":"Your power roaring through my veins.","s":136.84,"e":141.58},{"t":"No fear, no chains—I'm alive again,","s":141.68,"e":146.32},{"t":"’Cause You call my heart by name.","s":144.9,"e":149.51},{"t":"And the night can’t hold me, no, not again—","s":149.57,"e":158.03},{"t":"I burn with an unbreakable flame.","s":158.13,"e":161.74},{"t":"Bridge","s":161.83,"e":163.44},{"t":"No, I won’t bow to the fear inside—","s":163.54,"e":170.86},{"t":"You’re the voice that steadies my fight.","s":170.87,"e":175.09},{"t":"With Your fire, I’m burning bright,","s":175.16,"e":178.84},{"t":"You make me unbreakable.","s":178.9,"e":185.92},{"t":"Final Chorus","s":186.01,"e":190.81},{"t":"Now I rise with an unbreakable flame—","s":190.88,"e":196.14},{"t":"Your glory rushing through my veins.","s":196.23,"e":198.62},{"t":"All fear erased—I’m alive again,","s":198.66,"e":204.44},{"t":"Held forever in Your name.","s":204.53,"e":207.44},{"t":"And the night can’t stop me, no, not again—","s":207.49,"e":216.04},{"t":"I burn with an unbreakable flame.","s":216.14,"e":220.05}],"match":null}
