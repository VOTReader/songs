{"v":1,"id":"b3293c499479","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Satsang with Mooji","s":12.48,"e":13.46},{"t":"Before the first sunrise","s":36.28,"e":38.9},{"t":"Before the oceans roared","s":38.9,"e":42.98},{"t":"A plan of love was spoken","s":42.98,"e":46.42},{"t":"A promise from the Lord","s":46.42,"e":50.0},{"t":"Beyond all generations","s":50.0,"e":53.42},{"t":"Before the dust was formed","s":54.74,"e":57.66},{"t":"Salvation's fire was kindled","s":57.66,"e":61.36},{"t":"A covenant reborn","s":61.36,"e":64.48},{"t":"Then into our darkness","s":66.12,"e":68.74},{"t":"A holy light appeared","s":68.74,"e":72.9},{"t":"Born into the silence","s":73.46,"e":76.12},{"t":"The one the heavens feared","s":76.12,"e":79.48},{"t":"In flesh you walked among us","s":79.48,"e":83.68},{"t":"Yet carried something more","s":83.68,"e":87.06},{"t":"The hope of every nation","s":87.06,"e":90.64},{"t":"The world was waiting for","s":90.64,"e":94.12},{"t":"Four steps of redemption","s":95.88,"e":97.78},{"t":"One story of grace","s":99.48,"e":101.72},{"t":"For known in the heavens","s":103.24,"e":105.62},{"t":"Revealed in time and space","s":106.66,"e":109.02},{"t":"Completed on the cross","s":110.54,"e":112.6},{"t":"Where the veil was torn apart","s":113.44,"e":116.24},{"t":"Forever sealed in power","s":117.38,"e":119.98},{"t":"Now alive inside my heart","s":119.98,"e":124.24},{"t":"The cross stood in the shadow","s":139.14,"e":142.08},{"t":"Of all our guilt and pain","s":142.08,"e":145.76},{"t":"Yet there you chose to carry","s":145.76,"e":149.38},{"t":"What we could never claim","s":149.38,"e":153.02},{"t":"It wasn't just a moment","s":153.02,"e":157.02},{"t":"It changed eternity","s":157.02,"e":159.32},{"t":"The weight of every sin was nailed","s":161.04,"e":165.04},{"t":"There willingly","s":165.04,"e":167.18},{"t":"The grave thought it had won","s":168.48,"e":171.38},{"t":"The stone was standing still","s":171.38,"e":174.92},{"t":"But death was never str