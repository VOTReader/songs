{"v":1,"id":"ec51c3968bd3","synced":false,"offset":null,"source":"whisper","lines":[{"t":"🎵","s":5.22,"e":6.62},{"t":"When I was young","s":28.3,"e":30.72},{"t":"I always longed for the light","s":32.08,"e":36.96},{"t":"As I grew older","s":40.62,"e":44.1},{"t":"Darkness crept inside","s":47.58,"e":50.64},{"t":"The void got deep and wide","s":53.34,"e":57.04},{"t":"I longed for love","s":58.82,"e":62.04},{"t":"But nothing ever satisfied","s":64.88,"e":69.92},{"t":"Then you stepped in","s":73.88,"e":77.26},{"t":"Revealing a love I'd never known","s":78.88,"e":83.78},{"t":"My life full of sin, still grace was shown.","s":87.04,"e":92.08},{"t":"Your mercy held me.","s":93.4,"e":96.66},{"t":"Your love healed me.","s":97.88,"e":99.98},{"t":"Your spirit filled me.","s":101.06,"e":103.32},{"t":"And now I praise you.","s":105.76,"e":108.46},{"t":"Hallelujah.","s":108.78,"e":109.92},{"t":"All that I am I give to you","s":109.92,"e":120.08},{"t":"You are so beautiful","s":120.08,"e":122.92},{"t":"Perfect, righteous, merciful","s":122.92,"e":127.18},{"t":"Humble, just and wonderful","s":129.9,"e":134.0},{"t":"Wonderful, who am I to be known by you?","s":134.0,"e":143.06},{"t":"I had never felt worth or value, but you called me beautiful and treasured.","s":145.56,"e":156.44},{"t":"Oh, that my life would be for your pleasure","s":156.44,"e":162.58},{"t":"You stepped in, revealing a love I'd never known","s":162.58,"e":170.3},{"t":"My life full of sin, still grace was shown","s":172.34,"e":178.58},{"t":"Your mercy held me","s":178.58,"e":183.16},{"t":"Your love healed me","s":183.16,"e":186.5},{"t":"Your spirit filled me","s":186.5,"e":189.86},{"t":"And now I praise you","s":191.42,"e":194.98},{"t":"Hallelujah, Yeshua","s":194.98,"e":197.6},{"t":"All that I am I give to you","s":201.06,"e":206.56},{"t":"You are so beautiful","s":206.56,"e":209.38},{"t":"Perfect, righteous","s":209.38,"e":212.26},{"t":"Righteous, merciful, humble, just, and wonderful.","s":212.26,"e":221.0},{"t":