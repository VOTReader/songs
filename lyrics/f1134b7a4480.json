{"v":1,"id":"f1134b7a4480","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Bilabe","s":28.3,"e":29.7},{"t":"Prepare your hearts","s":31.92,"e":33.94},{"t":"And do not abandon hope","s":33.94,"e":38.74},{"t":"Though much death draws near","s":42.28,"e":44.68},{"t":"And the pain of death increases in every corner","s":44.68,"e":47.86},{"t":"Though heavy sorrows overtake the land","s":49.9,"e":53.1},{"t":"And tears fill your eyes","s":53.1,"e":57.28},{"t":"Hold fast","s":59.34,"e":60.94},{"t":"Hold fast","s":65.54,"e":67.7},{"t":"Embrace me fully","s":68.24,"e":70.32},{"t":"And do not waver","s":70.32,"e":72.48},{"t":"Do not waver.","s":86.14,"e":87.76},{"t":"Says the Lord.","s":93.72,"e":95.04},{"t":"Yahushua.","s":96.68,"e":97.36},{"t":"Sous-titrage Société Radio-Canada","s":103.86,"e":105.26}],"match":null}
