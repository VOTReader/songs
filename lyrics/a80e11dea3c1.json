{"v":1,"id":"a80e11dea3c1","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Mmm, yeah","s":10.38,"e":13.18},{"t":"Mmm, yeah","s":21.88,"e":24.68},{"t":"Yeah, yeah","s":24.68,"e":27.7},{"t":"I've been walking through the fire with a heavy soul","s":30.3,"e":34.06},{"t":"Trying to keep it together, but the hurt don't go","s":34.06,"e":38.7},{"t":"Every corner of my heart got a story to tell","s":38.7,"e":43.26},{"t":"I've been crying out for mercy, Lord, you know me well","s":43.26,"e":47.48},{"t":"When the night gets long and the road runs cold","s":48.9,"e":53.2},{"t":"I hear your voice in the still","s":53.2,"e":55.46},{"t":"Deep down in my soul","s":55.46,"e":57.82},{"t":"It's the heart of the man","s":57.82,"e":59.22},{"t":"No, the heart of the fire","s":61.24,"e":63.78},{"t":"When my world falls apart","s":65.78,"e":68.48},{"t":"You make it right","s":70.34,"e":72.56},{"t":"Take this broken heart","s":74.4,"e":77.12},{"t":"And wash it clean","s":77.12,"e":79.3},{"t":"You're the mercy in my misery","s":79.3,"e":81.62},{"t":"The joy in my need","s":81.62,"e":84.02},{"t":"It's the heart of the matter","s":84.66,"e":86.7},{"t":"Where your love comes through","s":86.7,"e":89.08},{"t":"I got nothing left to hide","s":89.08,"e":92.28},{"t":"When I come to you","s":92.84,"e":96.06},{"t":"I've been wearing my pride","s":99.62,"e":101.32},{"t":"Like a tarnished crown","s":101.32,"e":103.24},{"t":"But the weight of this old world","s":103.24,"e":105.98},{"t":"Keeps pulling me down","s":105.98,"e":107.86},{"t":"So I lay it at the altar","s":107.86,"e":109.42},{"t":"Every fear, every scar","s":109.42,"e":111.56},{"t":"Cause you can heal the wounded places","s":111.56,"e":114.06},{"t":"In a troubled heart","s":114.06,"e":115.84},{"t":"When the storm blows wild","s":116.48,"e":119.3},{"t":"And I lose my way","s":119.3,"e":121.44},{"t":"You stand in my soul","s":121.44,"e":123.82},{"t":"And you hear me praise","s":123.82,"e":126.02},{"t":"The heart of the matter","s":126.02,"e":127.56},{"t":"The heart of the fight","s":127.56,"e":132.04},{"t":"When my world falls apart","s":132.04,"e":137.06},{"t":"You make it right","s":138.66,"e":140.9},{"t":"Hey, I take this broken heart","s":142.36,"e":145.32},{"t":"And wash it clean","s":145.92,"e":147.48},{"t":"You're the mercy in my misery","s":147.48,"e":149.78},{"t":"The joy in my need","s":149.78,"e":152.18},{"t":"It's the heart of the matter","s":152.78,"e":154.86},{"t":"Where your love comes through","s":154.86,"e":157.2},{"t":"I got nothing left to hide","s":157.2,"e":160.38},{"t":"When I come to you","s":161.2,"e":164.26},{"t":"Oh, I surrender, I surrender now","s":165.94,"e":170.92},{"t":"Take my shaking hands and turn this sorrow around","s":170.92,"e":175.9},{"t":"From the ashes, from the pain, let your goodness arise","s":176.46,"e":180.3},{"t":"Make a hallelujah out of these weary nights","s":181.02,"e":185.72},{"t":"It's the heart of the matter","s":187.64,"e":188.78},{"t":"Lord, the heart of the faith","s":188.78,"e":193.32},{"t":"When my world falls apart","s":195.0,"e":198.26},{"t":"You make it right","s":199.9,"e":202.42},{"t":"Take this broken heart and wash it clean","s":203.88,"e":208.76},{"t":"You're the mercy in my misery","s":208.76,"e":211.1},{"t":"The joy in my need","s":211.1,"e":213.54},{"t":"It's the heart of the matter","s":214.08,"e":216.16},{"t":"Where your love comes through","s":216.16,"e":218.58},{"t":"I got nothing left to hide","s":218.58,"e":221.78},{"t":"When I come to you","s":222.42,"e":225.76},{"t":"Yeah, I got nothing left to hide","s":227.32,"e":230.68},{"t":"When I come to you","s":231.84,"e":235.14},{"t":"It's the heart of the matter","s":236.92,"e":239.18},{"t":"And you're bringing me through","s":240.66,"e":243.64},{"t":"Thank you.","s":246.74,"e":246.9}],"match":null}
