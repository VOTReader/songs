{"v":1,"id":"806bdc618604","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Oh Lord","s":25.22,"e":27.32},{"t":"Lord, how shall I thank you for all you have done?","s":27.32,"e":35.96},{"t":"I haven't the words to express my gratitude","s":36.38,"e":42.04},{"t":"For what you did for me on the cross","s":42.04,"e":47.46},{"t":"I am forever indebted to you","s":48.34,"e":53.08},{"t":"You are my Passover","s":53.08,"e":56.52},{"t":"You rescued me from death","s":57.26,"e":61.66},{"t":"You restored my soul","s":62.62,"e":67.62},{"t":"Oh my God, my God","s":72.56,"e":75.88},{"t":"In the name of Yahushua","s":77.7,"e":82.7},{"t":"You are my Savior, I say amen, amen, forever I'm in Him.","s":82.7,"e":94.86},{"t":"My ready, my lips","s":94.86,"e":98.56},{"t":"My ready, my lips","s":106.28,"e":109.78},{"t":"My Reddy Murleys","s":129.16,"e":132.76},{"t":"My Reddy Murleys","s":132.76,"e":138.88}],"match":{"letter":"timothy:my-redeemer-lives","score":0.744}}
