{"v":1,"id":"6b10fcfbaefb","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I feel Your hand upon me","s":11.26,"e":14.58},{"t":"Oh Lord, I offer myself to You","s":17.72,"e":21.62},{"t":"My Lord and my God","s":24.14,"e":26.84},{"t":"Take my life","s":28.3,"e":30.78},{"t":"It's yours","s":30.78,"e":33.24},{"t":"You offered yourself up","s":36.92,"e":39.96},{"t":"Suffering and death","s":39.96,"e":43.06},{"t":"On account of what I have done","s":43.06,"e":47.24},{"t":"I deserve my punishment","s":49.62,"e":52.56},{"t":"Yeah, you bore my sins on the tree","s":52.56,"e":56.38},{"t":"Even the sins of those I love","s":56.38,"e":60.02},{"t":"I cannot approach your love","s":65.82,"e":70.68},{"t":"By any and all means","s":72.64,"e":76.3},{"t":"I shall strive to show you my love and my gratitude","s":78.82,"e":84.3},{"t":"I leave my heart open to you","s":84.3,"e":88.8},{"t":"Molding, creating me a pure heart","s":93.0,"e":98.24},{"t":"For I long to see your face","s":99.76,"e":105.58},{"t":"Renew with me your right spirit","s":106.98,"e":111.12},{"t":"That I may be steadfast","s":114.48,"e":118.38},{"t":"For your purpose","s":119.16,"e":121.54},{"t":"And walk in your way","s":121.54,"e":124.3},{"t":"You are the love of my life","s":131.46,"e":135.96},{"t":"Of which I had forgotten","s":135.96,"e":141.06},{"t":"How wealthy I was in my innocence","s":143.64,"e":148.02},{"t":"How blessed I was in my youth","s":150.34,"e":154.62},{"t":"How could I have departed?","s":160.08,"e":163.26},{"t":"How could I have turned away?","s":166.62,"e":170.64},{"t":"I weep, I cry","s":174.68,"e":179.12},{"t":"Because of that place which was left barren inside me","s":179.88,"e":186.48},{"t":"A place the world could never fill","s":187.82,"e":192.16},{"t":"Leaving me broken and void","s":195.48,"e":198.74},{"t":"My heart hardened, my countenance bared","s":198.74,"e":205.66},{"t":"Yet you filled me with wonder and awe","s":211.58,"e":216.92},{"t":"A love I never thought possible","s":216.92,"e":222.8},{"t":"My heart softened","s":224.28,"e":227.64},{"t":"My countenance lifted","s":228.26,"e":231.32},{"t":"My spirit brightened","s":231.32,"e":235.26},{"t":"As your life rushed in","s":235.26,"e":238.08},{"t":"Creating me a pure heart","s":240.26,"e":244.14},{"t":"For I long to see your face","s":245.76,"e":251.4},{"t":"Renewing me, your right spirit","s":253.48,"e":257.06},{"t":"That I may be steadfast","s":260.44,"e":264.32},{"t":"For your purpose","s":265.14,"e":267.5},{"t":"And walk in your way","s":267.5,"e":270.12},{"t":"Thanks for watching!","s":276.12,"e":292.9}],"match":{"letter":"timothy:my-redeemer-lives","score":0.833}}
