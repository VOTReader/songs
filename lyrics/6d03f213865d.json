{"v":1,"id":"6d03f213865d","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse)","s":5.52,"e":17.41},{"t":"Shadows whisper through my pain,","s":17.5,"e":21.73},{"t":"You breathe fire through my veins.","s":21.83,"e":26.1},{"t":"From the ashes I arise,","s":26.18,"e":30.39},{"t":"Your light breaking through my lies.","s":30.46,"e":34.66},{"t":"(Chorus)","s":33.62,"e":34.78},{"t":"You turn my pain into power,","s":34.84,"e":39.85},{"t":"My sorrow into flame.","s":39.96,"e":43.5},{"t":"Through death I’m reborn,","s":43.59,"e":47.82},{"t":"Your love remains the same.","s":47.91,"e":68.79},{"t":"(Bridge)","s":51.09,"e":69.05},{"t":"If I must die, then make me new,","s":69.16,"e":73.83},{"t":"Resurrection in my view.","s":73.93,"e":77.74},{"t":"You turn my pain into power,","s":77.84,"e":82.85},{"t":"And my dying into life.","s":82.95,"e":86.18}],"match":null}
