{"v":1,"id":"7efa135d6ff1","synced":true,"offset":0,"source":"suno","lines":[{"t":"[Trumpet blast 🎺]","s":1.91,"e":2.37},{"t":"[Thunder rumbling ⛈️]","s":2.12,"e":2.9},{"t":"Thus says The Lord God:","s":2.93,"e":11.2},{"t":"Whom shall I send?","s":11.22,"e":12.75},{"t":"Who will go for Me?","s":12.81,"e":15.3},{"t":"The day is far spent,","s":15.36,"e":17.61},{"t":"the sun is setting on this age of men.","s":17.67,"e":25.98},{"t":"Husbandmen, go out and gather!","s":26.01,"e":30.06},{"t":"For the wheat is bundled tight,","s":30.12,"e":32.53},{"t":"and none can loose it.","s":32.59,"e":34.68},{"t":"Neither man nor beast is able,","s":34.73,"e":38.28},{"t":"for nothing in all creation","s":38.34,"e":41.65},{"t":"can separate what The Lord has bound.","s":41.76,"e":48.53},{"t":"Therefore, My sons,","s":48.54,"e":50.93},{"t":"be strong and go forth!","s":51.04,"e":53.12},{"t":"For the trumpet sounds,","s":53.18,"e":55.61},{"t":"the heavens shake,","s":55.69,"e":57.75},{"t":"and the King is coming quickly!","s":57.81,"e":64.66},{"t":"Behold,","s":64.67,"e":66.04},{"t":"The Lord is One,","s":66.1,"e":68.16},{"t":"His name is One…","s":68.26,"e":70.86},{"t":"Forever and ever.","s":70.95,"e":85.63},{"t":"Behold,","s":85.64,"e":86.79},{"t":"The Lord is One,","s":86.85,"e":88.98},{"t":"His name is One…","s":89.08,"e":91.69},{"t":"Forever and ever.","s":91.78,"e":93.35}],"match":null}
