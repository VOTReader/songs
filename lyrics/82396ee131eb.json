{"v":1,"id":"82396ee131eb","synced":false,"offset":null,"source":"whisper","lines":[{"t":"By my name","s":14.36,"e":17.84},{"t":"Is your heart sealed","s":17.84,"e":21.44},{"t":"For in my name","s":21.44,"e":23.98},{"t":"Is the spirit given the spirit which also testifies of my name?","s":23.98,"e":38.3},{"t":"By my name are you established in life","s":42.76,"e":49.18},{"t":"As a bride","s":49.18,"e":53.1},{"t":"Prepared for her husband","s":54.62,"e":58.78},{"t":"Therefore, everyone who refused","s":74.16,"e":78.14},{"t":"He refuses to take my name, shall not see life, for there is but one way into life.","s":78.14,"e":93.18},{"t":"I am the way, says the Lord Yahushua.","s":104.48,"e":107.74},{"t":"Thank you.","s":116.6,"e":116.66},{"t":"© transcript Emily Beynon","s":148.36,"e":152.64}],"match":{"letter":"wtlb1:blessed-is-the-name-of-the-lord","score":0.87}}
