{"v":1,"id":"106572602358","synced":true,"offset":0,"source":"suno","lines":[{"t":"Verse 1","s":16.52,"e":16.66},{"t":"I’ve been holding on to shadows,","s":16.68,"e":20.27},{"t":"Trying not to lose my way.","s":20.35,"e":24.03},{"t":"Every heartbeat felt so hollow","s":24.12,"e":27.37},{"t":"Till Your whisper filled the ache.","s":27.41,"e":31.2},{"t":"You stepped into my silence,","s":31.28,"e":34.83},{"t":"A calm within the storm,","s":34.95,"e":38.32},{"t":"And suddenly the pieces","s":38.42,"e":42.13},{"t":"Began to feel reborn.","s":42.22,"e":46.85},{"t":"You lift the veil of all I’ve carried,","s":46.9,"e":50.41},{"t":"The weight I thought was mine alone.","s":50.47,"e":54.12},{"t":"In every tear, Your mercy met me—","s":54.23,"e":57.41},{"t":"Now I know I’m finally home.","s":57.45,"e":59.3},{"t":"Chorus","s":59.39,"e":62.58},{"t":"So take my heart—","s":62.69,"e":65.59},{"t":"Make it Your kingdom.","s":65.66,"e":69.59},{"t":"Let every wall","s":69.69,"e":72.61},{"t":"Fall where Your light comes.","s":72.71,"e":76.29},{"t":"Write Your love","s":76.38,"e":78.99},{"t":"On every heartbeat.","s":79.11,"e":80.64},{"t":"Reign in me,","s":80.69,"e":82.86},{"t":"Until I am complete.","s":82.9,"e":87.95},{"t":"My heart…","s":88.06,"e":90.24},{"t":"Your kingdom.","s":90.32,"e":91.54},{"t":"Verse 2","s":91.63,"e":95.52},{"t":"There were roads I walked in darkness,","s":95.55,"e":99.06},{"t":"There were wounds I hid so deep.","s":99.1,"e":102.35},{"t":"But Your love kept gently calling,","s":102.41,"e":105.96},{"t":"Awakening what fell asleep.","s":106.04,"e":109.71},{"t":"You pulled me from the wreckage,","s":109.79,"e":112.9},{"t":"You breathed hope into my dust,","s":112.98,"e":116.33},{"t":"And from the ashes of my story","s":116.41,"e":120.08},{"t":"You built something I can trust.","s":120.16,"e":123.86},{"t":"Pre-Chorus","s":123.96,"e":125.64},{"t":"You take the ruins of my trying,","s":125.7,"e":129.24},{"t":"And shape them with a holy hand.","s":129.3,"e":132.79},{"t":"You’re the peace my soul’s been craving—","s":132.81,"e":136.02},{"t":"The One who helps me stand.","s":136.08,"e":138.77},{"t":"Chorus","s":138.86,"e":140.51},{"t":"So take my heart—","s":140.59,"e":144.34},{"t":"Make it Your kingdom.","s":144.41,"e":147.95},{"t":"Let every wall","s":148.05,"e":149.04},{"t":"Fall where Your light comes.","s":149.14,"e":151.98},{"t":"Write Your love","s":152.05,"e":154.31},{"t":"On every heartbeat.","s":154.43,"e":155.96},{"t":"Reign in me,","s":156.01,"e":158.1},{"t":"Until I am complete.","s":158.14,"e":163.19},{"t":"My heart…","s":163.3,"e":165.34},{"t":"Your kingdom.","s":165.43,"e":171.41},{"t":"Open every door in me,","s":171.5,"e":174.0},{"t":"Let Your presence fill the rooms.","s":174.06,"e":176.44},{"t":"Shine through every memory","s":176.46,"e":180.4},{"t":"And heal the places I once knew.","s":181.12,"e":184.18},{"t":"If all I am is Yours, O Lord,","s":184.28,"e":187.88},{"t":"Then I will never be alone—","s":187.95,"e":191.41},{"t":"You built a kingdom in my heart,","s":191.49,"e":194.7},{"t":"And called this wandering soul Your home.","s":194.8,"e":198.02},{"t":"Final Chorus","s":198.05,"e":202.26},{"t":"So take my heart—","s":202.34,"e":205.28},{"t":"Make it Your kingdom.","s":205.34,"e":209.92},{"t":"Every breath","s":209.97,"e":211.99},{"t":"A place Your light runs.","s":212.15,"e":216.0},{"t":"Hold my soul","s":216.1,"e":219.02},{"t":"Till all is restored…","s":219.12,"e":223.1},{"t":"Yours forever,","s":223.19,"e":226.04},{"t":"Now and evermore.","s":226.12,"e":231.25},{"t":"My heart…","s":231.36,"e":234.27},{"t":"Your kingdom.","s":234.37,"e":235.53}],"match":null}
