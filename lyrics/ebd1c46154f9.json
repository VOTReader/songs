{"v":1,"id":"ebd1c46154f9","synced":true,"offset":0,"source":"suno","lines":[{"t":"Those who are Mine receive of Me.","s":20.03,"e":25.87},{"t":"For I know My own,","s":25.91,"e":31.07},{"t":"and they seek Me;","s":31.16,"e":36.3},{"t":"My bride is chosen.","s":36.38,"e":39.77},{"t":"Yet those who reject Me","s":39.86,"e":44.22},{"t":"and My Word have not known Me,","s":44.32,"e":48.8},{"t":"nor will they receive;","s":48.91,"e":54.61},{"t":"My spirit is far removed.","s":54.71,"e":62.26},{"t":"Those who set themselves apart from Me,","s":62.35,"e":67.04},{"t":"whether by word or deed","s":67.13,"e":72.55},{"t":"or by pretense,","s":72.66,"e":77.43},{"t":"their hearts are revealed;","s":77.48,"e":79.27},{"t":"these shall be left to walk through very dry places.","s":79.3,"e":86.52},{"t":"Yet those who seek Me","s":86.62,"e":90.74},{"t":"in truth shall be drawn in quickly,","s":90.85,"e":95.95},{"t":"whether they are near or far,","s":96.01,"e":100.88},{"t":"for I know My own.","s":100.98,"e":105.32},{"t":"And those who are married unto Me shall surely enter in.","s":105.4,"e":115.73},{"t":"Therefore, judge no more by human standards,","s":115.78,"e":120.97},{"t":"discern by right standards,","s":121.02,"e":124.77},{"t":"according to My love and the knowledge you have received in Me.","s":124.8,"e":139.31},{"t":"For I AM THE LORD, whose will is set","s":139.39,"e":145.13},{"t":"And can in no wise be turned back;","s":145.24,"e":151.29},{"t":"Even from the beginning,","s":151.39,"e":155.45},{"t":"It was decided and accomplished.","s":155.56,"e":162.97},{"t":"For I AM...","s":163.04,"e":183.56},{"t":"And My bride has always been","s":183.65,"e":188.78},{"t":"Predestined in The Beloved,","s":188.88,"e":194.14},{"t":"Says The Lord.","s":194.23,"e":195.88}],"match":null}
