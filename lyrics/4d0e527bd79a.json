{"v":1,"id":"4d0e527bd79a","synced":true,"offset":0,"source":"suno","lines":[{"t":"Lo, shall I speak","s":2.58,"e":10.12},{"t":"Through donkeys instead,","s":10.16,"e":13.97},{"t":"For they have no sin?","s":14.02,"e":19.45},{"t":"Shall I send the birds of the air","s":19.5,"e":24.72},{"t":"To be My messengers,","s":24.78,"e":29.48},{"t":"For they have no sin?","s":29.53,"e":35.96},{"t":"Shall the sins of men","s":36.02,"e":39.75},{"t":"Prevent Me in anywise?!","s":39.79,"e":44.54},{"t":"Shall My voice be stopped","s":44.58,"e":47.3},{"t":"By any means?!","s":47.42,"e":51.26},{"t":"Behold, by the mouth of Caiaphas","s":51.4,"e":55.7},{"t":"I did speak and declare My will","s":55.74,"e":61.69},{"t":"And the means by which you would be saved,","s":61.75,"e":67.56},{"t":"Though he had the greater sin!","s":67.6,"e":74.42},{"t":"FOR I AM THE LORD;","s":74.49,"e":83.01},{"t":"I DO NOT CHANGE!","s":83.12,"e":92.53},{"t":"My words declare My glory,","s":92.65,"e":96.19},{"t":"My message reveals My majesty","s":96.26,"e":99.72},{"t":"And the power of My strength!","s":99.79,"e":105.56},{"t":"STOP STARING AT MY MESSENGERS!","s":105.63,"e":111.4},{"t":"Look past them and see with greater eyes!","s":111.45,"e":121.92},{"t":"Therefore, O ignorant and vain peoples,","s":121.96,"e":127.18},{"t":"Flee from all these arrogant pastors","s":127.25,"e":130.49},{"t":"And prideful teachers, blind guides","s":130.55,"e":134.39},{"t":"Who closely adhere to every form","s":134.45,"e":138.16},{"t":"Of doctrine and tradition of men,","s":138.26,"e":141.94},{"t":"While forsaking Me and My Word!","s":141.97,"e":146.25},{"t":"Escape all these chains","s":146.36,"e":148.97},{"t":"And come out from among them,","s":149.03,"e":152.8},{"t":"And seek to buy new oil","s":152.85,"e":156.59},{"t":"From those who sell the pure oil;","s":156.66,"e":160.42},{"t":"They will not withhold,","s":160.46,"e":164.24},{"t":"For I have sent them;","s":164.29,"e":167.81},{"t":"They will gladly pour out.","s":167.86,"e":172.91},{"t":"Yea, they have received","s":172.96,"e":176.63},{"t":"An abundance of oil","s":176.75,"e":181.06},{"t":"From the storehouses","s":181.13,"e":184.09},{"t":"By which you may surely","s":184.14,"e":188.4},{"t":"Relight your lamps,","s":188.48,"e":191.64},{"t":"If you so choose to receive them.","s":191.68,"e":202.47},{"t":"Says The Lord God","s":202.63,"e":207.16}],"match":{"letter":"rebuke:gnashing-children","score":0.981}}
