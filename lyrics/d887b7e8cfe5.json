{"v":1,"id":"d887b7e8cfe5","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Transcription by ESO, translation by —","s":27.18,"e":29.88},{"t":"You shall not desecrate the Sabbath","s":43.44,"e":46.0},{"t":"The seventh day of the week","s":46.0,"e":51.0},{"t":"Which I have commanded you to remember","s":53.72,"e":56.22},{"t":"Remember and keep holy","s":56.22,"e":60.58},{"t":"For as I had spoken it","s":63.38,"e":66.42},{"t":"To my servant Moses","s":68.02,"e":70.94},{"t":"So it is and shall be","s":73.9,"e":76.76},{"t":"Even to this day","s":78.36,"e":80.36},{"t":"And as I had spoken it","s":83.14,"e":85.98},{"t":"Before the congregation","s":87.92,"e":90.02},{"t":"So shall it be done","s":92.92,"e":95.02},{"t":"With the blowing of the great trumpet","s":95.02,"e":99.84},{"t":"With lightnings and thunderings","s":102.66,"e":105.68},{"t":"Did I declare my law","s":107.32,"e":109.82},{"t":"Before the tribes of Israel","s":111.82,"e":114.9},{"t":"And in the presence of angels","s":114.9,"e":119.22},{"t":"Did I put my power on open display?","s":119.22,"e":124.1},{"t":"Behold, by my own finger","s":150.74,"e":154.4},{"t":"Was it engraving upon tablets of stone?","s":156.8,"e":163.66},{"t":"And by the power of my spirit","s":166.52,"e":170.94},{"t":"Is it established within the hearts of the penitent?","s":170.94,"e":182.56},{"t":"Stop desecrating my Sabbath","s":186.22,"e":188.28},{"t":"The seventh day is the Sabbath","s":188.28,"e":193.12},{"t":"Which I had ordained","s":195.32,"e":198.08},{"t":"From the beginning","s":200.58,"e":202.68},{"t":"Seize from your heresies","s":205.76,"e":208.08},{"t":"Hold your tongue from your blasphemies","s":208.78,"e":213.08},{"t":"Turn back from this wicked way","s":214.98,"e":218.0},{"t":"You have chosen","s":220.7,"e":222.68},{"t":"And repent","s":225.42,"e":226.8},{"t":"repent, and I may yet have mercy upon you, for I am the Lord, and I do not change.","s":226.8,"e":247.36},{"t":"I do not change","s":264.24,"e":266.58},{"t":"Oh, my God.","s":313.92,"e":316.72},{"t":"Christ is the Lord.","s":316.8,"e":317.88}],"match":{"letter":"three:you-shall-not-desecrate-the-sabbath","score":0.842}}
