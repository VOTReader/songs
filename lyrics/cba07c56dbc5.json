{"v":1,"id":"cba07c56dbc5","synced":true,"offset":0,"source":"suno","lines":[{"t":"Those who are Mine receive of Me.","s":30.08,"e":36.65},{"t":"For I know My own,","s":36.75,"e":39.93},{"t":"and they seek Me;","s":40.02,"e":43.68},{"t":"My bride is chosen.","s":43.78,"e":48.4},{"t":"Yet those who reject Me","s":48.46,"e":50.88},{"t":"and My Word have not known Me,","s":50.94,"e":53.86},{"t":"nor will they receive;","s":53.94,"e":56.13},{"t":"My spirit is far removed.","s":56.23,"e":63.61},{"t":"Those who set themselves apart from Me,","s":63.7,"e":69.67},{"t":"whether by word or deed","s":69.76,"e":73.35},{"t":"or by pretense,","s":73.46,"e":77.05},{"t":"their hearts are revealed;","s":77.12,"e":82.25},{"t":"these shall be left to walk through very dry places.","s":82.28,"e":100.32},{"t":"Yet those who seek Me","s":100.42,"e":102.29},{"t":"in truth shall be drawn in quickly,","s":102.37,"e":107.24},{"t":"whether they are near or far,","s":107.29,"e":110.11},{"t":"for I know My own.","s":110.19,"e":114.34},{"t":"And those who are married unto Me shall surely enter in.","s":114.41,"e":124.8},{"t":"Therefore, judge no more by human standards,","s":124.84,"e":128.63},{"t":"discern by right standards,","s":128.68,"e":131.79},{"t":"according to My love and the knowledge you have received in Me.","s":131.82,"e":139.76},{"t":"For I AM THE LORD, whose will is set","s":139.82,"e":145.37},{"t":"And can in no wise be turned back;","s":145.48,"e":150.89},{"t":"Even from the beginning,","s":150.99,"e":153.22},{"t":"It was decided and accomplished.","s":153.32,"e":166.72},{"t":"For I AM...","s":166.79,"e":203.21},{"t":"And My bride has always been","s":203.26,"e":206.57},{"t":"Predestined in The Beloved,","s":206.65,"e":213.69},{"t":"Says The Lord.","s":213.78,"e":217.34}],"match":null}
