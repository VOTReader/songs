{"v":1,"id":"825aa3d5ea69","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I kept the watch, I held the line","s":15.94,"e":20.34},{"t":"I waited in the hush","s":20.34,"e":22.98},{"t":"Saw fields turn gold, heard heavens lean","s":24.54,"e":28.38},{"t":"The breath before the rush","s":28.38,"e":31.2},{"t":"First blast went out to wake the heart","s":33.88,"e":36.9},{"t":"Second blast to warm then silence","s":36.9,"e":39.4},{"t":"Hung like patient flame","s":39.4,"e":41.44},{"t":"The hush before the dawn","s":41.44,"e":43.98},{"t":"Father and I, one voice, one plan","s":47.36,"e":51.18},{"t":"He counts the hour and I obey","s":51.18,"e":54.24},{"t":"I'm thrilled to what I work compared","s":54.24,"e":58.54},{"t":"We move within our ways","s":58.54,"e":61.24},{"t":"The great trumpet blasts","s":63.4,"e":65.4},{"t":"I go, I go","s":65.4,"e":66.9},{"t":"When the trumpet calls","s":66.9,"e":69.38},{"t":"Our harvest flows","s":69.38,"e":71.3},{"t":"Lift my bride, ascend the stair","s":72.08,"e":75.74},{"t":"Angels climb with glory there","s":76.28,"e":80.02},{"t":"The great trumpet blasts","s":80.02,"e":82.32},{"t":"Let's go","s":85.4,"e":86.36},{"t":"Let's go","s":89.7,"e":90.68},{"t":"Let's go","s":90.68,"e":97.84},{"t":"Angels climb the ladder's light","s":98.8,"e":101.0},{"t":"They bear my lifted ones","s":101.0,"e":103.56},{"t":"Hands that reach from heaven down","s":107.02,"e":109.54},{"t":"Now that the bundles are done","s":109.54,"e":112.38},{"t":"He times the breath","s":114.78,"e":117.06},{"t":"I answer quick","s":117.06,"e":118.1},{"t":"His will and mine entwine","s":118.1,"e":120.88},{"t":"The fields are white","s":123.62,"e":125.72},{"t":"The reapers move","s":125.72,"e":126.66},{"t":"My bride's promise meets mine","s":127.18,"e":129.74},{"t":"The bride says come","s":131.36,"e":133.78},{"t":"The bridegroom says come","s":133.78,"e":138.34},{"t":"Come, oh come my beautiful bride","s":138.34,"e":142.1},{"t":"Come, the great trumpet blast","s":