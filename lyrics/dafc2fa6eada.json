{"v":1,"id":"dafc2fa6eada","synced":true,"offset":0,"source":"suno","lines":[{"t":"Blessed are My servants who seek to","s":13.64,"e":19.87},{"t":"Obey My commands without hesitation,","s":20.03,"e":26.15},{"t":"For their trust is apparent;","s":26.21,"e":29.91},{"t":"Blessed are those who seek to please Me,","s":29.98,"e":36.2},{"t":"For in them am I well pleased.","s":36.26,"e":42.65},{"t":"For no man can step forward without trust,","s":42.72,"e":49.07},{"t":"And one who is void of belief is","s":49.15,"e":55.77},{"t":"Consumed by doubt and fear.","s":55.8,"e":61.64},{"t":"And I have already told you that pride blinds","s":61.68,"e":68.54},{"t":"The eyes and arrogance stops the ears.","s":68.64,"e":80.22},{"t":"Therefore let My servants step","s":80.28,"e":86.57},{"t":"Forward without hesitation, and ask,","s":86.66,"e":95.95},{"t":"That their blessing may be compounded","s":96.0,"e":100.93},{"t":"And their belief increased!...","s":101.01,"e":112.23},{"t":"Says The Lord.","s":112.31,"e":113.78}],"match":{"letter":"wtlb1:without-hesitation","score":1.0}}
