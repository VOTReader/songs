{"v":1,"id":"6f77ffa5b35d","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Thank you for watching.","s":9.14,"e":29.98},{"t":"Built from the dust","s":35.76,"e":38.68},{"t":"Breathe life in my lungs","s":40.68,"e":43.76},{"t":"Holding the weight of the songs","s":47.3,"e":51.88},{"t":"Left on the sun","s":52.8,"e":54.7},{"t":"I am the clay","s":57.68,"e":60.62},{"t":"You're the hand that designs","s":62.34,"e":65.98},{"t":"Break through the dark","s":68.76,"e":71.8},{"t":"Let your holiness shine","s":71.8,"e":76.76},{"t":"Climb the stairs, break the chain","s":82.54,"e":85.54},{"t":"Call my name through the rain","s":85.54,"e":88.52},{"t":"Show me how to live","s":91.28,"e":93.84},{"t":"Take this broken heart","s":96.16,"e":98.98},{"t":"And let it show me how to live","s":100.36,"e":104.86},{"t":"We'll be right back.","s":114.24,"e":119.62},{"t":"But I hear the whisper","s":136.04,"e":139.58},{"t":"That I'm not alone","s":139.58,"e":142.9},{"t":"Without my soul","s":156.24,"e":159.74},{"t":"Oh, make me whole","s":159.74,"e":165.46},{"t":"We'll be right back.","s":201.04,"e":203.2},{"t":"Show me how to live","s":224.38,"e":226.9}],"match":null}
