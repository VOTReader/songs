{"v":1,"id":"7d6a5df72ecd","synced":true,"offset":0,"source":"suno","lines":[{"t":"Beloved, I am forever,","s":13.64,"e":21.56},{"t":"And forever shall I be,","s":21.66,"e":25.31},{"t":"And so shall you be with me.","s":25.41,"e":32.39},{"t":"Oh how unsearchable is My love for you;","s":32.47,"e":38.35},{"t":"Accept it,","s":38.41,"e":38.82},{"t":"And an eternity of love shall you dwell in.","s":38.86,"e":50.31},{"t":"For I gave everything to this end;","s":50.38,"e":53.74},{"t":"I suffered,","s":53.86,"e":55.45},{"t":"So you don’t have to;","s":55.53,"e":58.84},{"t":"I spilled my blood,","s":58.96,"e":62.34},{"t":"So yours may become pure;","s":62.45,"e":68.74},{"t":"I died,","s":68.86,"e":69.49},{"t":"So you would not know death;","s":69.53,"e":75.12},{"t":"I rose,","s":75.24,"e":77.42},{"t":"So you could have life eternal.","s":77.53,"e":88.91},{"t":"Look around you,","s":89.0,"e":90.89},{"t":"Love surrounds you.","s":90.99,"e":92.61},{"t":"Behold, even all creation testifies to my glory.","s":92.67,"e":107.49},{"t":"Call upon me,","s":107.59,"e":109.59},{"t":"I am your Sanctuary;","s":109.71,"e":113.96},{"t":"Ask of Me,","s":114.06,"e":115.39},{"t":"For I am your Reward…","s":115.49,"e":119.44},{"t":"Receive of Me.","s":119.52,"e":125.59},{"t":"Offer up Thanksgiving,","s":125.67,"e":127.24},{"t":"And sing praises to your God!","s":127.3,"e":129.91},{"t":"For He sent His Only Begotten to save you!","s":129.93,"e":143.2},{"t":"And now I am returning to gather up my daughters,","s":143.26,"e":151.94},{"t":"Even all who remain in my love,","s":151.99,"e":155.43},{"t":"To heal their hearts forevermore!","s":155.51,"e":159.1},{"t":"Look around you,","s":159.14,"e":165.41},{"t":"Love surrounds you.","s":165.51,"e":167.21},{"t":"Behold, even all creation testifies to my glory.","s":167.27,"e":182.09},{"t":"Call upon me,","s":182.19,"e":184.11},{"t":"I am your Sanctuary;","s":184.23,"e":188.48},{"t":"Ask of Me,","s":188.58,"e":189.91},{"t":"For I am your Reward…","s":190.01,"e":196.42},{"t":"Receive of Me.","s":196.48,"e":198.27}],"match":null}
