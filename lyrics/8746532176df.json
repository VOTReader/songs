{"v":1,"id":"8746532176df","synced":false,"offset":null,"source":"whisper","lines":[{"t":"You speak in the hush of morning","s":10.68,"e":16.72},{"t":"A whisper drifting through the light","s":17.3,"e":23.3},{"t":"I am making all things new, you say","s":24.98,"e":29.82},{"t":"And the shadows begin to melt from sight","s":29.82,"e":36.26},{"t":"The mountains bow in reverence","s":37.5,"e":41.68},{"t":"The oceans breathe your name","s":42.24,"e":45.3},{"t":"For the kingdom comes in quiet steps","s":45.3,"e":50.16},{"t":"And nothing will remain the same","s":50.16,"e":54.7},{"t":"Every tear you gather, every heart you mend","s":57.26,"e":63.1},{"t":"You lift the broken from the dust and make them whole again","s":63.1,"e":69.42},{"t":"Behold the kingdom coming","s":69.42,"e":74.14},{"t":"A dawn without an end","s":74.14,"e":81.34},{"t":"Where sorrow cannot follow","s":82.6,"e":86.68},{"t":"And peace is born again","s":87.58,"e":90.62},{"t":"Your light falls on the nations","s":94.86,"e":100.1},{"t":"And every fear is gone","s":101.54,"e":104.48},{"t":"The new earth rises in your love","s":104.48,"e":108.56},{"t":"Oh Lord, forever strong","s":108.56,"e":110.86},{"t":"You walk beside the humble","s":114.28,"e":117.44},{"t":"You call the weary home","s":117.44,"e":120.46},{"t":"You plant the gardens of the new world","s":120.46,"e":124.8},{"t":"Where living waters flow","s":124.8,"e":126.9},{"t":"And all creation listens","s":126.9,"e":130.32},{"t":"The trees lift up their hands","s":130.32,"e":133.58},{"t":"For the Son of Glory speaks again","s":133.58,"e":137.04},{"t":"And healing covers every land","s":137.04,"e":140.54},{"t":"You are the God who dwells with men","s":140.54,"e":143.7},{"t":"Closer than our breath","s":143.7,"e":146.2},{"t":"You silence every memory","s":146.72,"e":149.62},{"t":"Of pain and loss and death","s":149.62,"e":152.78},{"t":"In the brightness of your presence","s":153.3,"e":156.18},{"t":"The old has passed away","s":156.18,"e":159.0},{"t":"We rise to see the new earth bloom","s":159.0,"e":162.86},{"t":"Bathed in endless day","s":163.5,"e":165.5},{"t":"Behold the kingdom coming","s":165.5,"e":170.2},{"t":"A dawn without an end","s":171.88,"e":176.92},{"t":"Where every child is sheltered","s":178.2,"e":183.64},{"t":"And everyone can","s":183.64,"e":185.88},{"t":"Your light becomes our dwelling","s":190.14,"e":194.54},{"t":"Your voice our perfect peace","s":194.54,"e":197.52},{"t":"The new earth sings beneath your feet","s":197.52,"e":201.46},{"t":"Where all our striving ceases","s":201.46,"e":205.48},{"t":"Behold the kingdom coming","s":207.54,"e":211.8},{"t":"A dawn without an end","s":212.58,"e":218.88},{"t":"Where every child is sheltered","s":220.18,"e":225.24},{"t":"And every wound can mend","s":225.24,"e":228.32},{"t":"Your light, You make all things new","s":232.42,"e":237.96},{"t":"And we belong to You","s":237.96,"e":243.66},{"t":"Forever, forever","s":247.04,"e":249.84},{"t":"Amen","s":251.92,"e":253.32},{"t":"Amen.","s":258.8,"e":260.2}],"match":null}
