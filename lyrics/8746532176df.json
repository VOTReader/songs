{"v":1,"id":"8746532176df","synced":true,"offset":0,"source":"suno","lines":[{"t":"Verse 1 — soft, warm, gently rising)","s":2.96,"e":13.2},{"t":"You speak in the hush of morning,","s":13.3,"e":19.6},{"t":"A whisper drifting through the light…","s":19.72,"e":26.39},{"t":"“I am making all things new,” You say,","s":23.16,"e":32.09},{"t":"And the shadows begin to melt from sight.","s":32.16,"e":38.76},{"t":"The mountains bow in reverence,","s":38.82,"e":43.55},{"t":"The oceans breathe Your name…","s":43.61,"e":46.37},{"t":"For the Kingdom comes in quiet steps,","s":46.45,"e":51.49},{"t":"And nothing will remain the same.","s":51.59,"e":58.55},{"t":"Every tear You gather,","s":58.6,"e":61.82},{"t":"Every heart You mend…","s":61.87,"e":64.34},{"t":"You lift the broken from the dust","s":64.44,"e":67.43},{"t":"And make them whole again.","s":67.54,"e":70.78},{"t":"Behold, the Kingdom coming,","s":70.86,"e":77.2},{"t":"A dawn without an end…","s":77.32,"e":83.47},{"t":"Where sorrow cannot follow,","s":83.55,"e":88.41},{"t":"And peace is born again.","s":88.49,"e":96.45},{"t":"Your light falls on the nations,","s":96.51,"e":102.88},{"t":"And every fear is gone…","s":102.98,"e":105.71},{"t":"The New Earth rises in Your love,","s":105.77,"e":109.12},{"t":"O Lord, forever strong.","s":109.24,"e":115.54},{"t":"You walk beside the humble,","s":115.62,"e":117.74},{"t":"You call the weary home…","s":117.78,"e":121.95},{"t":"You plant the gardens of the new world","s":122.05,"e":125.12},{"t":"Where living waters flow.","s":125.2,"e":128.36},{"t":"And all creation listens,","s":128.42,"e":131.48},{"t":"The trees lift up their hands…","s":131.54,"e":134.31},{"t":"For the Son of Glory speaks again,","s":134.41,"e":137.88},{"t":"And healing covers every land.","s":137.96,"e":141.23},{"t":"You are the God who dwells with men,","s":141.31,"e":144.76},{"t":"Closer than our breath…","s":144.85,"e":146.34},{"t":"You silence every memory","s":147.54,"e":150.65},{"t":"Of pain and loss and death.","s":150.77,"e":153.68},{"t":"In the brightness of Your presence,","s":153.76,"e":157.11},{"t":"The old has passed away…","s":157.19,"e":160.33},{"t":"We rise to see the New Earth bloom,","s":160.44,"e":163.93},{"t":"Bathed in endless day.","s":163.97,"e":166.77},{"t":"Behold, the Kingdom coming,","s":166.85,"e":173.19},{"t":"A dawn without an end…","s":173.31,"e":179.55},{"t":"Where every child is sheltered","s":179.64,"e":184.32},{"t":"And every wound can mend.","s":184.43,"e":192.43},{"t":"Your light becomes our dwelling,","s":192.5,"e":195.57},{"t":"Your voice our perfect peace…","s":195.65,"e":198.82},{"t":"The New Earth sings beneath Your feet,","s":198.88,"e":201.93},{"t":"Where all our striving ceases.","s":201.98,"e":205.66},{"t":"Behold, the Kingdom coming,","s":205.7,"e":214.84},{"t":"A dawn without an end…","s":214.96,"e":221.19},{"t":"Where every child is sheltered","s":221.29,"e":225.89},{"t":"And every wound can mend.","s":225.99,"e":233.89},{"t":"Oh Lord, You make all things new…","s":234.0,"e":240.43},{"t":"And we belong to You.","s":240.53,"e":247.04},{"t":"Forever.","s":247.13,"e":250.23},{"t":"Forever.","s":250.32,"e":254.0},{"t":"Amen.","s":254.11,"e":260.6}],"match":null}
