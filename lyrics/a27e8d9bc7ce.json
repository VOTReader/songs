{"v":1,"id":"a27e8d9bc7ce","synced":true,"offset":0,"source":"suno","lines":[{"t":"Every line—","s":9.66,"e":12.21},{"t":"Every sign—","s":12.25,"e":13.8},{"t":"To the promised One, aligned.","s":13.85,"e":18.82},{"t":"Hear the question through the night:","s":18.86,"e":22.35},{"t":"If He leads, why not follow?","s":22.42,"e":25.81},{"t":"Not an echo.","s":25.83,"e":27.09},{"t":"Not a shadow.","s":27.14,"e":28.33},{"t":"He’s the One the shadows follow.","s":28.33,"e":34.38},{"t":"Lord of the Law!","s":34.44,"e":39.38},{"t":"Lord of the Sabbath!","s":39.45,"e":44.38},{"t":"Follow His steps—","s":44.45,"e":49.28},{"t":"Put faith into practice!","s":49.33,"e":50.6},{"t":"Every page like a road, every word like a flame,","s":50.61,"e":53.08},{"t":"All the lines drawing close to the weight of His name.","s":53.11,"e":55.57},{"t":"Torah has a target, not a road without end,","s":55.6,"e":58.12},{"t":"And the goal is the Messiah—not a truth to bend.","s":58.15,"e":60.57},{"t":"He obeyed every word, never stepped out of line,","s":60.61,"e":63.14},{"t":"Perfect faithfulness revealed in the fullness of time.","s":63.17,"e":65.53},{"t":"Not a crown made of noise, not a throne built on hype,","s":65.57,"e":68.23},{"t":"But obedience that shines like a blade through the night.","s":68.28,"e":70.77},{"t":"Let the question hit deep when the low end shakes:","s":70.8,"e":73.24},{"t":"What’s a song of devotion if the footsteps break?","s":73.24,"e":75.7},{"t":"If His path is the pattern and His way is the light,","s":75.75,"e":78.34},{"t":"Why applaud from a distance? Why not walk in His sight?","s":78.39,"e":80.75},{"t":"Every sign points to Him,","s":80.76,"e":83.11},{"t":"Every road finds its aim.","s":83.17,"e":85.62},{"t":"Let the rhythm fall silent—","s":85.66,"e":87.87},{"t":"There is weight in His name.","s":87.97,"e":90.44},{"t":"He is Lord of the Law,","s":90.45,"e":92.91},{"t":"He is Lord of the Sabbath!","s":92.97,"e":95.12},{"t":"Every word fulfilled in Him—","s":95.17,"e":97.92},{"t":"Let the whole room chant it!","s":97.98,"e":99.9},{"t":"Follow, follow—","s":99.96,"e":101.1},{"t":"Where His footsteps go!","s":101.13,"e":103.53},{"t":"If He is Lord of the Sabbath,","s":103.58,"e":105.25},{"t":"Why not follow?","s":105.31,"e":106.45},{"t":"Lord of the—","s":106.47,"e":108.41},{"t":"Lord of the—","s":108.48,"e":109.27},{"t":"Lord of the Sabbath!","s":110.18,"e":116.07},{"t":"Follow the—","s":116.11,"e":120.36},{"t":"Follow the—","s":120.37,"e":120.54},{"t":"Follow His pattern!","s":120.57,"e":131.45},{"t":"Not a name for a slogan, not a line for a show,","s":131.46,"e":134.04},{"t":"Not a truth to salute, then refuse where it goes.","s":134.09,"e":136.52},{"t":"He’s the goal Torah points to, the center, the aim,","s":136.53,"e":138.94},{"t":"Not a footnote pushed aside at the sound of His name.","s":138.98,"e":141.55},{"t":"Every command obeyed, every step held true,","s":141.6,"e":144.09},{"t":"Now the question cuts the thunder and it’s breaking through:","s":144.15,"e":146.53},{"t":"If the Master walked faithfully, steady and clear,","s":146.59,"e":149.15},{"t":"Why should following His footsteps be a thing to fear?","s":149.18,"e":151.73},{"t":"No performance can replace what obedience means,","s":151.77,"e":154.29},{"t":"No amount of flashing lights makes a wandering path clean.","s":154.36,"e":156.78},{"t":"Let the bass shake the floor, let the melody climb—","s":156.84,"e":159.23},{"t":"Still the call is to follow, not just echo the rhyme.","s":159.27,"e":161.74},{"t":"Every sign points to Him,","s":161.75,"e":164.08},{"t":"Every road finds its aim.","s":164.13,"e":166.6},{"t":"When the anthem is over,","s":166.63,"e":169.41},{"t":"Let the footsteps remain.","s":169.46,"e":171.4},{"t":"He is Lord of the Law,","s":171.41,"e":173.92},{"t":"He is Lord of the Sabbath!","s":173.96,"e":176.08},{"t":"Every word fulfilled in Him—","s":176.13,"e":178.89},{"t":"Let the whole room chant it!","s":178.94,"e":180.89},{"t":"Follow, follow—","s":180.95,"e":182.03},{"t":"Where His footsteps go!","s":182.07,"e":184.48},{"t":"If He is Lord of the Sabbath,","s":184.55,"e":186.19},{"t":"Why not follow?","s":186.25,"e":187.47},{"t":"Who fulfilled it?","s":187.48,"e":189.01},{"t":"The Messiah!","s":189.05,"e":189.94},{"t":"Who’s the goal?","s":189.96,"e":191.55},{"t":"The Messiah!","s":191.57,"e":192.55},{"t":"Lord of the Law—","s":192.6,"e":195.05},{"t":"Lord of the Sabbath—","s":195.12,"e":196.28},{"t":"Faithful in every command!","s":196.34,"e":198.88},{"t":"Not just a chorus—","s":198.93,"e":200.13},{"t":"Not just an anthem—","s":200.19,"e":201.37},{"t":"Follow the path where He stands!","s":201.43,"e":203.38},{"t":"Every line!","s":203.41,"e":204.56},{"t":"Every sign!","s":204.61,"e":205.78},{"t":"To the promised One, aligned!","s":205.84,"e":208.37},{"t":"Every line!","s":208.42,"e":209.6},{"t":"Every sign!","s":209.65,"e":210.54},{"t":"Let the walk match the rhyme!","s":210.6,"e":212.79},{"t":"Lord of the Law!","s":212.85,"e":214.7},{"t":"Lord of the Sabbath!","s":214.76,"e":219.67},{"t":"Follow His steps—","s":219.73,"e":223.85},{"t":"Put faith into practice!","s":223.89,"e":225.38},{"t":"Follow, follow—","s":225.45,"e":227.43},{"t":"Where His footsteps go!","s":227.49,"e":229.93},{"t":"If He is Lord of the Sabbath,","s":229.99,"e":234.22},{"t":"Why not follow?","s":234.27,"e":238.97},{"t":"When the anthem is over,","s":238.98,"e":243.98},{"t":"Let the footsteps remain.","s":244.04,"e":249.45},{"t":"Lord of the Law.","s":249.5,"e":253.18},{"t":"Lord of the Sabbath.","s":253.24,"e":254.68},{"t":"The Messiah—","s":254.73,"e":258.06},{"t":"The goal.","s":258.1,"e":260.43}],"match":null}
