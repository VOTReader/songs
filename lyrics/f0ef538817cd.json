{"v":1,"id":"f0ef538817cd","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 1)","s":8.53,"e":16.09},{"t":"I've prayed night and day askin'","s":16.11,"e":18.5},{"t":"You to take these things away","s":18.61,"e":23.45},{"t":"That are draggin' me down.","s":23.53,"e":27.9},{"t":"Help clean this filth from my soul,","s":27.97,"e":30.14},{"t":"Make me pure and make me whole.","s":30.2,"e":34.88},{"t":"Take away these things in my heart","s":34.97,"e":38.29},{"t":"That have been trying to pull me away","s":38.35,"e":41.88},{"t":"From the start.","s":41.98,"e":42.86},{"t":"(Chorus)","s":42.47,"e":46.67},{"t":"Burn away the dross","s":46.75,"e":47.94},{"t":"That's been coverin' me up.","s":47.96,"e":50.4},{"t":"Clean me Lord, come sweep my heart,","s":50.47,"e":53.42},{"t":"Leave not a corner where the dust can start.","s":53.48,"e":61.08},{"t":"Make me worthy for You.","s":61.13,"e":62.93},{"t":"Help me put all this impurity away.","s":62.99,"e":68.56},{"t":"Until only pure faith remains.","s":68.58,"e":73.03},{"t":"(Verse 2)","s":72.62,"e":91.63},{"t":"Wispers in the wind,","s":91.67,"e":93.05},{"t":"Sayin' \"Come with us and sin,","s":93.08,"e":95.1},{"t":"And you'll feel good again\".","s":95.18,"e":98.63},{"t":"And I used to believe their lies,","s":98.67,"e":102.58},{"t":"But now them I despise.","s":102.64,"e":105.2},{"t":"Help me put away the sins I did,","s":105.25,"e":109.84},{"t":"Help me face the wrong from which I hid.","s":109.91,"e":113.47},{"t":"Lord, wash me till I'm clean.","s":113.56,"e":117.78},{"t":"Scrub off all the mean.","s":117.81,"e":119.94},{"t":"(Chorus)","s":119.55,"e":121.6},{"t":"Burn away the dross","s":121.7,"e":122.94},{"t":"That's been coverin' me up.","s":122.96,"e":125.39},{"t":"Clean me Lord, come sweep my heart,","s":125.44,"e":128.42},{"t":"Leave not a corner where the dust can start.","s":128.48,"e":136.16},{"t":"Make me worthy for You.","s":136.21,"e":137.93},{"t":"Help me put all this impurity away.","s":137.99,"e":143.69},{"t":"Until only pure faith remains.","s":143.77,"e":151.03},{"t":"(Bridge)","s":147.93,"e":151.43},{"t":"Refine me,","s":151.51,"e":155.43},{"t":"Clean me,","s":155.52,"e":158.23},{"t":"Wipe the filth from my soul.","s":158.32,"e":163.59},{"t":"(Final)","s":162.86,"e":170.34},{"t":"Burn away the dross,","s":170.42,"e":171.77},{"t":"And all my sins of yesterday.","s":171.85,"e":177.18},{"t":"Make me new in Your love,","s":177.25,"e":179.42},{"t":"Help clean me today.","s":179.48,"e":184.9},{"t":"I’ve walked through the dust,","s":184.94,"e":186.83},{"t":"Tried doing it all on my own,","s":186.88,"e":192.16},{"t":"But You meet me right where I’m standing,","s":192.2,"e":196.19},{"t":"And call this tired heart back home.","s":196.27,"e":201.06}],"match":null}
