{"v":1,"id":"c76e299ffa4f","synced":true,"offset":0,"source":"suno","lines":[{"t":"Full plate, empty feeling…","s":8.46,"e":12.96},{"t":"There’s gotta be more than this.","s":12.98,"e":18.51},{"t":"I’ve been living off a neon glow,","s":18.52,"e":20.83},{"t":"Taking every little high to go.","s":20.88,"e":23.06},{"t":"Sugar promises upon my tongue,","s":23.13,"e":25.07},{"t":"Sweet for a second, then the feeling’s gone.","s":25.13,"e":27.7},{"t":"Got a whole world saying, “Take one more,”","s":27.75,"e":30.07},{"t":"But it leaves me hungry like it did before.","s":30.1,"e":32.25},{"t":"Now I’m turning down the counterfeit,","s":32.29,"e":34.52},{"t":"There’s a deeper kind of life than this.","s":34.52,"e":36.83},{"t":"Let the glitter lose its shine,","s":36.84,"e":39.13},{"t":"Let the noise fall out of time.","s":39.17,"e":41.17},{"t":"There’s a hunger underneath","s":41.19,"e":43.38},{"t":"That the world can never feed.","s":43.45,"e":45.5},{"t":"Hungry for the real, real,","s":45.53,"e":47.72},{"t":"Something I can feel, feel.","s":47.78,"e":49.71},{"t":"All this gold can’t fill me up,","s":49.77,"e":52.07},{"t":"All this more is not enough.","s":52.13,"e":54.36},{"t":"Heaven has the bread I need,","s":54.44,"e":56.57},{"t":"More than anything I see.","s":56.64,"e":58.88},{"t":"Oh, I’m hungry for the real, real—","s":58.93,"e":62.02},{"t":"Only Heaven satisfies.","s":62.1,"e":69.09},{"t":"More, more—never enough.","s":69.11,"e":71.46},{"t":"Gold, gold—turning to dust.","s":71.54,"e":73.76},{"t":"Real, real—give me the real.","s":73.83,"e":79.33},{"t":"Something this world can’t give.","s":79.38,"e":82.53},{"t":"There’s a table in the endless scroll,","s":82.53,"e":84.53},{"t":"Selling little bites of being whole.","s":84.58,"e":87.11},{"t":"I can taste the wanting in the air,","s":87.15,"e":89.44},{"t":"Everybody reaching, nothing there.","s":89.49,"e":91.75},{"t":"But the manna isn’t bought or sold,","s":91.78,"e":93.97},{"t":"Doesn’t need a spotlight to be gold.","s":93.99,"e":96.29},{"t":"And the One who calls His beloved near","s":96.33,"e":98.46},{"t":"Offers life that doesn’t disappear.","s":98.49,"e":100.84},{"t":"Let the glitter lose its shine,","s":100.86,"e":103.1},{"t":"Let the noise fall out of time.","s":103.15,"e":105.17},{"t":"There’s a hunger underneath","s":105.19,"e":107.38},{"t":"That the world can never feed.","s":107.45,"e":109.52},{"t":"Hungry for the real, real,","s":109.55,"e":111.72},{"t":"Something I can feel, feel.","s":111.78,"e":113.78},{"t":"All this gold can’t fill me up,","s":113.85,"e":116.07},{"t":"All this more is not enough.","s":116.13,"e":118.32},{"t":"Heaven has the bread I need,","s":118.41,"e":120.58},{"t":"More than anything I see.","s":120.65,"e":123.05},{"t":"Oh, I’m hungry for the real, real—","s":123.08,"e":126.01},{"t":"Only Heaven satisfies.","s":126.08,"e":132.25},{"t":"Not an empty plate—","s":132.26,"e":134.54},{"t":"It’s the empty chase.","s":134.54,"e":136.88},{"t":"Not another thing","s":136.96,"e":139.16},{"t":"That I need to taste.","s":139.2,"e":141.42},{"t":"I can leave behind","s":141.46,"e":143.65},{"t":"What could never last.","s":143.7,"e":145.97},{"t":"There’s a life ahead—","s":145.97,"e":148.04},{"t":"I’m not turning back.","s":148.04,"e":152.88},{"t":"Hungry for the real, real,","s":152.9,"e":155.1},{"t":"Something I can feel, feel.","s":155.17,"e":157.16},{"t":"All this gold can’t fill me up,","s":157.22,"e":159.51},{"t":"All this more is not enough.","s":159.57,"e":161.76},{"t":"Heaven has the bread I need,","s":161.84,"e":164.0},{"t":"More than anything I see.","s":164.07,"e":166.48},{"t":"Oh, I’m hungry for the real, real—","s":166.53,"e":169.44},{"t":"Only Heaven satisfies.","s":169.51,"e":176.6},{"t":"More, more—never enough.","s":176.64,"e":186.23},{"t":"Real, real—","s":186.24,"e":187.74},{"t":"Only Heaven satisfies.","s":187.82,"e":191.01}],"match":null}
