{"v":1,"id":"03633f869012","synced":true,"offset":0,"source":"suno","lines":[{"t":"You’ve been sounding the shofar, loud and clear,","s":26.57,"e":29.79},{"t":"Trumpeting truth that all should hear.","s":29.81,"e":32.43},{"t":"But even the faithful need to breathe,","s":32.47,"e":34.83},{"t":"The King smiles — “Rest, my child, believe.”","s":34.87,"e":37.12},{"t":"---","s":36.82,"e":37.12},{"t":"The angels cheer, the heavens nod,","s":37.14,"e":40.66},{"t":"Your hands are full, your heart with God.","s":40.71,"e":43.55},{"t":"Pause your voice, catch your flame,","s":43.62,"e":46.14},{"t":"For every note bears His holy name.","s":46.24,"e":50.42},{"t":"---","s":48.37,"e":50.42},{"t":"Holy Cooldown Mode!","s":50.43,"e":52.84},{"t":"Even the bold must pause.","s":52.93,"e":55.08},{"t":"Trumpets rest, harps hum soft,","s":55.11,"e":58.14},{"t":"Yet hearts stay full of awe!","s":58.2,"e":60.24},{"t":"The King sees your every call,","s":60.32,"e":63.62},{"t":"Your voice will rise again!","s":63.65,"e":66.24},{"t":"Holy Cooldown Mode!","s":66.34,"e":70.56},{"t":"Recharging for His reign!","s":70.66,"e":76.28},{"t":"---","s":73.26,"e":76.28},{"t":"Thunder sleeps, the shofars still,","s":76.29,"e":78.69},{"t":"Yet faith and love cannot be stilled.","s":78.79,"e":81.69},{"t":"Even in rest, your light shines bright,","s":81.75,"e":83.9},{"t":"The King will wake the trumpets’ might.","s":83.94,"e":86.99},{"t":"---","s":85.8,"e":86.99},{"t":"Prepare again, the call resumes,","s":86.99,"e":89.0},{"t":"The heavens roar, the fire consumes.","s":89.04,"e":90.94},{"t":"Rest now, warrior, your moment nears,","s":91.01,"e":93.47},{"t":"The King awaits — sound His truth to the spheres!","s":93.51,"e":95.53},{"t":"---","s":95.23,"e":95.53},{"t":"Holy Cooldown Mode!","s":95.54,"e":99.14},{"t":"Even the bold must pause.","s":99.26,"e":101.44},{"t":"Trumpets rest, harps hum soft,","s":101.46,"e":104.5},{"t":"Yet hearts stay full of awe!","s":104.56,"e":106.68},{"t":"The King sees your every call,","s":106.76,"e":109.93},{"t":"Your voice will rise again!","s":109.99,"e":112.44},{"t":"Holy Cooldown Mode!","s":112.54,"e":116.84},{"t":"Recharging for His reign!","s":116.94,"e":141.91},{"t":"---","s":119.54,"e":141.91},{"t":"[Outro – Harp fades, Thunder echoes, Whispered Choir]","s":119.54,"e":143.28},{"t":"“Rest… then rise again.”","s":143.1,"e":146.61},{"t":"“For behold… the King comes.”","s":144.43,"e":151.68},{"t":"YahuShua-YAHuWaH","s":151.73,"e":162.14},{"t":"Holy Cooldown Mode!","s":162.15,"e":164.62},{"t":"Even the bold must pause.","s":164.71,"e":166.86},{"t":"Trumpets rest, harps hum soft,","s":166.89,"e":169.95},{"t":"Yet hearts stay full of awe!","s":170.03,"e":172.16},{"t":"The King sees your every call,","s":172.22,"e":175.42},{"t":"Your voice will rise again!","s":175.47,"e":177.94},{"t":"Holy Cooldown Mode!","s":178.04,"e":182.34},{"t":"Recharging for His reign!","s":182.45,"e":185.59}],"match":null}
