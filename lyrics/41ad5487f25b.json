{"v":1,"id":"41ad5487f25b","synced":true,"offset":0,"source":"suno","lines":[{"t":"Blessed are all those who raise their voices","s":16.76,"e":21.71},{"t":"To Heaven and give Me perfect praise;","s":21.83,"e":30.47},{"t":"Blessed are those who offer up thanksgiving,","s":30.53,"e":35.91},{"t":"Without ceasing, in My Holy name...","s":35.99,"e":43.59},{"t":"[Chorus]","s":40.24,"e":43.78},{"t":"I shall be their God,","s":43.79,"e":50.01},{"t":"And they shall be My people.","s":50.07,"e":57.75},{"t":"Yet even more blessed are those","s":57.77,"e":60.89},{"t":"Who bow down and kiss the feet of My Son;","s":60.99,"e":65.41},{"t":"Their sins are forgiven them...","s":65.46,"e":67.92},{"t":"For those who embrace The Son of God","s":67.94,"e":75.65},{"t":"Have touched The Kingdom of Heaven...","s":75.73,"e":85.37},{"t":"[Bridge]","s":78.05,"e":85.52},{"t":"[Build-up]","s":85.38,"e":85.69},{"t":"Everlasting life is their reward,","s":85.7,"e":90.45},{"t":"Dwelling in union with","s":90.49,"e":93.44},{"t":"The Messiah, forever.","s":93.55,"e":140.21},{"t":"[Interlude]","s":96.57,"e":140.28},{"t":"[Subtle Choral Hum]","s":140.21,"e":140.39},{"t":"[Piano and Cello solo]","s":140.35,"e":140.51},{"t":"Blessed are those who worship with gratitude,","s":140.51,"e":145.47},{"t":"Giving thanks for the birth of My Son...","s":145.56,"e":154.2},{"t":"Even more blessed are those who","s":154.23,"e":156.39},{"t":"Worship and give thanks","s":156.48,"e":157.91},{"t":"For His death and resurrection.","s":157.96,"e":167.69},{"t":"Blessed is he who reveres My name","s":167.72,"e":173.31},{"t":"And gives Me perfect praise...","s":173.41,"e":182.86},{"t":"For I am coming quickly!","s":182.89,"e":186.4},{"t":"[Climax]","s":184.06,"e":186.44},{"t":"[Fortissimo]","s":186.4,"e":186.49},{"t":"I am The First!","s":186.49,"e":187.55},{"t":"Behold, I am also The Last!...","s":187.59,"e":222.68},{"t":"[Outro]","s":190.08,"e":222.79},{"t":"Blessed therefore are all those","s":222.8,"e":225.25},{"t":"Who bow down before Me;","s":225.33,"e":229.14},{"t":"For in them shall the vision be made","s":229.2,"e":231.87},{"t":"Complete and The Word established,","s":231.95,"e":236.45},{"t":"Even as it was at the first","s":236.48,"e":239.93},{"t":"And shall also be at the last...","s":240.03,"e":246.45},{"t":"Trust in Me therefore, for I AM HE!","s":246.47,"e":249.78},{"t":"[End]","s":249.35,"e":250.38}],"match":{"letter":"blessed:blessed-are-those-who-worship-me","score":1.0}}
