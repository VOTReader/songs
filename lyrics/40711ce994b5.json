{"v":1,"id":"40711ce994b5","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Oh, these roots been haunting me","s":10.86,"e":14.72},{"t":"Can't run, can't hide","s":16.68,"e":20.42},{"t":"I'm walking through these neon shadows","s":36.6,"e":40.48},{"t":"Oh, doctrine weighing down my soul","s":40.48,"e":43.94},{"t":"Slick talkers fed me idols","s":45.12,"e":48.14},{"t":"Let my faith out in the cold","s":48.14,"e":51.18},{"t":"Tonight lightning strikes my memory","s":51.18,"e":55.02},{"t":"All those altars built on sand","s":55.02,"e":58.42},{"t":"I hear a fire-spun voice inside me","s":58.42,"e":62.3},{"t":"Calling me to take a stand","s":62.3,"e":65.08},{"t":"There's a crossroads in my conscience","s":79.56,"e":82.72},{"t":"Where the honest bluesmen moan","s":82.72,"e":86.14},{"t":"Guitar wails, wind is restless","s":86.14,"e":89.36},{"t":"Every lie now disowned","s":89.36,"e":92.74},{"t":"I'm emptying out the poison","s":92.74,"e":96.32},{"t":"Breaking from these chains","s":96.32,"e":99.8},{"t":"Truth and love arising","s":100.54,"e":103.04},{"t":"Old man washed away in rain","s":103.04,"e":106.14},{"t":"Roots are crying out","s":108.12,"e":110.12},{"t":"Pull me from the mud","s":111.12,"e":113.28},{"t":"Blow away the faith","s":114.92,"e":116.78},{"t":"Let the real one flood","s":117.86,"e":120.14},{"t":"Empty hands, open spirit","s":120.14,"e":123.82},{"t":"Genuine and humble","s":124.98,"e":126.96},{"t":"I draw near it","s":126.96,"e":129.06},{"t":"Fasting from the old self","s":148.9,"e":151.28},{"t":"Speaking clear and bold","s":151.28,"e":154.26},{"t":"Resisting all accusing voices","s":154.26,"e":157.5},{"t":"Let humility take hold","s":157.5,"e":160.88},{"t":"Honest words throw shadows","s":162.28,"e":164.56},{"t":"Where pride once held my crown","s":164.56,"e":167.7},{"t":"Faith grows wild and holy","s":167.7,"e":171.14},{"t":"When flesh is laying down","s":171.14,"e":174.4},{"t":"Roots are crying out","s":175.78,"e":178.06},{"t":"Deep beneat