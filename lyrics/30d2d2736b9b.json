{"v":1,"id":"30d2d2736b9b","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I searched everywhere, didn't know what to do","s":11.3,"e":19.68},{"t":"I looked here and there","s":24.84,"e":27.34},{"t":"Didn't know where to go","s":29.4,"e":31.86},{"t":"But then one day I looked, I listened","s":36.6,"e":40.66},{"t":"And I saw you, Lord","s":41.74,"e":44.72},{"t":"Oh, I saw you, Lord","s":46.12,"e":48.28},{"t":"Oh, it was You who lifted my burdens","s":48.28,"e":54.12},{"t":"It was You, Lord, who helped me begin again","s":54.12,"e":62.26},{"t":"Oh, it was You","s":66.0,"e":68.9},{"t":"Lord, it's You, it's You","s":71.14,"e":76.88},{"t":"You help me to stand","s":76.88,"e":79.74},{"t":"It's you, it's you","s":80.34,"e":82.9},{"t":"Let me out of this dark land","s":82.9,"e":85.94},{"t":"Yeah, who's you up?","s":86.66,"e":87.72},{"t":"With you I'm safe","s":87.94,"e":89.22},{"t":"And when you hold me close to you","s":89.22,"e":91.9},{"t":"I feel comforted","s":91.9,"e":94.74},{"t":"Oh, oh, it's you","s":97.48,"e":99.76},{"t":"When I was in the darkest night","s":104.94,"e":107.34},{"t":"And I couldn't seem to find a light","s":107.34,"e":110.42},{"t":"When I didn't know which path to take","s":110.42,"e":113.54},{"t":"I didn't know which choice to make","s":113.54,"e":116.6},{"t":"It was you, Lord, you, Lord","s":116.6,"e":120.54},{"t":"You showed me where to go, just what to do","s":120.54,"e":124.28},{"t":"Oh, it's you, Lord","s":126.22,"e":128.36},{"t":"My Father, my home, I'm never alone because I'm always with you, Lord.","s":128.36,"e":139.8},{"t":"You're my shepherd, my shelter, Yahushua.","s":141.36,"e":149.96},{"t":"Lord, it's you, it's you","s":153.48,"e":156.78},{"t":"You help me to stand","s":156.78,"e":159.6},{"t":"It's you, it's you","s":160.3,"e":162.9},{"t":"Let me out of this dark land","s":162.9,"e":165.9},{"t":"Yahushua, with you I'm safe","s":166.86,"e":169.28},{"t":"And when you hold me close to you","s":169.28,"e":171.9},{"t":"I feel comforted","s":171.9,"e":174.96},{"t":"Oh, it's you, oh Lord, it's you, it's you, Lord, it's you.","s":174.96,"e":198.14},{"t":"And I know I'm never gonna be alone","s":201.82,"e":206.34},{"t":"With you I'm always home","s":206.34,"e":208.84},{"t":"You hold me safe in your bosom","s":208.84,"e":212.26},{"t":"You love me endlessly","s":212.26,"e":213.9},{"t":"It's you, Lord","s":215.3,"e":219.64},{"t":"Who's always there with me","s":220.72,"e":224.04},{"t":"Lord, it's you, it's you","s":227.32,"e":230.6},{"t":"You help me to stand","s":231.12,"e":233.44},{"t":"It's you, it's you","s":234.16,"e":236.76},{"t":"Let me out of this dark land","s":236.76,"e":239.74},{"t":"Yahushua, with you I'm safe","s":240.64,"e":243.1},{"t":"And when you hold me close to you","s":243.1,"e":245.72},{"t":"I feel comforted","s":245.72,"e":248.74},{"t":"Oh, it's you","s":248.74,"e":253.6},{"t":"Yahushua","s":254.2,"e":255.2},{"t":"You always held me close","s":255.2,"e":259.38},{"t":"You're my father, my guide","s":260.88,"e":264.58},{"t":"My shelter, my home","s":264.58,"e":267.52},{"t":"With you I'm never alone","s":268.04,"e":271.84},{"t":"Oh, Lord","s":272.64,"e":274.9},{"t":"It's you","s":276.6,"e":278.22}],"match":null}
