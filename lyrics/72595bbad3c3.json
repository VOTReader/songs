{"v":1,"id":"72595bbad3c3","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Behold, He is near","s":25.52,"e":29.08},{"t":"The earth trembles and falls","s":31.24,"e":35.72},{"t":"The mountains bow low","s":36.74,"e":42.5},{"t":"And the seas give up their hold","s":45.04,"e":49.16},{"t":"The voice of the Lord","s":52.3,"e":56.28},{"t":"Shatter silence and stone","s":58.98,"e":63.1},{"t":"I have come down","s":66.42,"e":69.96},{"t":"And I dwell in my own","s":72.36,"e":77.08},{"t":"He will not tarry","s":80.18,"e":84.1},{"t":"His jealousy burns","s":86.46,"e":90.78},{"t":"No more to endure","s":93.38,"e":97.32},{"t":"The wicked and the scorned","s":100.24,"e":105.0},{"t":"He will stand on the earth","s":107.1,"e":110.98},{"t":"In His fierce holy flame","s":110.98,"e":114.12},{"t":"To lift up the weak","s":114.82,"e":117.7},{"t":"Who call on His name","s":117.7,"e":121.8},{"t":"Behold, behold","s":126.3,"e":128.72},{"t":"The hand of the Holy One","s":129.9,"e":132.98},{"t":"Stretching forth","s":134.28,"e":135.94},{"t":"To gather every chosen son","s":135.94,"e":139.8},{"t":"The dead in the dust shall rise and sing","s":139.8,"e":146.3},{"t":"The children of Zion shall see their King","s":147.38,"e":154.84},{"t":"Look for I do a new and terrible thing","s":157.6,"e":162.56},{"t":"Oh, hearts will fail from the brightness of His face","s":166.26,"e":172.64},{"t":"The multitude shall wail, but the humble will embrace","s":173.22,"e":179.56},{"t":"His mercy, His fire, His fierce holy breath","s":180.56,"e":186.38},{"t":"The Lord of hosts triumphs, conquering death","s":186.38,"e":193.4},{"t":"Come, Lord, come, let the earth be still","s":195.24,"e":201.28},{"t":"Come, Lord, come, let Thy justice fill","s":202.82,"e":208.48},{"t":"He whispers in thunder","s":214.9,"e":218.74},{"t":"My wrath has begun","s":221.86,"e":225.46},{"t":"Yet love sings over Zion","s":227.02,"e":232.46},{"t":"The war is won","s":234.04,"e":237.7},{"t":"And the Lamb who was slain","s":240.28,"e":245.06},{"t":"Holy Yahushua reigns","s":247.92,"e":253.78},{"t":"Behold I make all things","s":253.78,"e":259.84},{"t":"new","s":262.68,"e":264.08}],"match":null}
