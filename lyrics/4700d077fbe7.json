{"v":1,"id":"4700d077fbe7","synced":true,"offset":0,"source":"suno","lines":[{"t":"The morning dove rests peacefully","s":16.43,"e":23.89},{"t":"Beside a nearby pecan tree","s":24.01,"e":30.75},{"t":"Cooing sweet and softly","s":30.79,"e":35.99},{"t":"Nature’s sunrise choir","s":36.13,"e":43.83},{"t":"Gentle sounds are echoing","s":43.87,"e":51.07},{"t":"Throughout the universe","s":51.15,"e":58.44},{"t":"Shabbat Shalom","s":58.53,"e":61.89},{"t":"Shabbat Shalom","s":61.97,"e":65.4},{"t":"Shabbat Shalom","s":65.45,"e":72.3},{"t":"Calling to its Creator","s":72.36,"e":78.84},{"t":"As each line is rehearsed","s":79.05,"e":86.04},{"t":"Shabbat Shalom","s":86.12,"e":89.48},{"t":"Shabbat Shalom","s":89.57,"e":92.98},{"t":"Shabbat Shalom","s":93.03,"e":101.52},{"t":"The morning dove has wings","s":101.54,"e":104.63},{"t":"So beautiful and white","s":104.89,"e":108.19},{"t":"When soaring toward the sun","s":108.25,"e":111.02},{"t":"You behold God’s awesome light","s":111.09,"e":114.99},{"t":"So radiant in beauty","s":115.03,"e":118.95},{"t":"Dazzling and bright","s":119.03,"e":121.97},{"t":"No words can describe it","s":122.17,"e":125.25},{"t":"As the dove takes flight","s":125.41,"e":132.4},{"t":"It praises its Creator","s":132.41,"e":135.85},{"t":"And coos, “Shabbat Shalom”","s":135.93,"e":139.46},{"t":"The Sabbath peace He gave us","s":139.49,"e":142.91},{"t":"A rest that will not cease","s":143.08,"e":146.57},{"t":"Calling to its Creator","s":146.62,"e":153.08},{"t":"As each line is rehearsed","s":153.29,"e":160.33},{"t":"Shabbat Shalom","s":160.38,"e":163.77},{"t":"Shabbat Shalom","s":163.82,"e":167.23},{"t":"Shabbat Shalom","s":167.32,"e":196.24},{"t":"The Sabbath peace He gave us","s":196.26,"e":199.79},{"t":"This rest will never cease","s":199.88,"e":206.73},{"t":"Shabbat Shalom","s":206.78,"e":209.66}],"match":null}
