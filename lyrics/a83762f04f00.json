{"v":1,"id":"a83762f04f00","synced":false,"offset":null,"source":"whisper","lines":[{"t":"詞曲 李宗盛","s":0.0,"e":1.7},{"t":"I will extol you","s":52.88,"e":57.92},{"t":"Oh Lord","s":57.92,"e":60.04},{"t":"For you have lifted me up","s":60.62,"e":63.58},{"t":"And have not let my foes rejoice","s":65.58,"e":69.44},{"t":"Over me","s":69.44,"e":71.66},{"t":"Oh Lord my God","s":71.66,"e":73.52},{"t":"I cried out to you","s":73.52,"e":76.22},{"t":"And you healed me","s":79.02,"e":81.48},{"t":"Oh Lord","s":81.48,"e":83.24},{"t":"You brought my soul","s":83.8,"e":87.12},{"t":"中文字幕志愿者 李宗盛","s":101.2,"e":112.82},{"t":"字幕志愿者 李宗盛","s":129.66,"e":133.48},{"t":"I said I shall never be moved","s":147.12,"e":150.96},{"t":"Lord by your favor","s":150.96,"e":152.8},{"t":"You have made my mountain stand strong","s":152.8,"e":156.5},{"t":"You hid your face","s":156.5,"e":159.42},{"t":"And I was troubled","s":163.62,"e":165.66},{"t":"I cried out to you oh Lord","s":168.0,"e":172.06},{"t":"优优独播剧场——YoYo Television Series Exclusive","s":174.22,"e":181.08},{"t":"祈祷哦 主 祈祷我","s":202.06,"e":206.36},{"t":"主 祈祷我","s":206.36,"e":219.1},{"t":"祢把我的早晨变成了跳舞","s":219.1,"e":224.82},{"t":"祢把我的衣服脱掉","s":227.06,"e":229.56},{"t":"中文字幕志愿者 李宗盛","s":233.48,"e":239.76},{"t":"由 Amara.org 社群提供的字幕","s":270.4,"e":275.3}],"match":null}
