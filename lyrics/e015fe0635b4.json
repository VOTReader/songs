{"v":1,"id":"e015fe0635b4","synced":true,"offset":0,"source":"suno","lines":[{"t":"My love is equal for all who breathe..","s":10.45,"e":12.9},{"t":"Forgiveness for everyone alike..","s":12.93,"e":15.64},{"t":"I spilled My blood freely,","s":15.72,"e":18.54},{"t":"My offer crosses every line.","s":18.64,"e":44.56},{"t":"I did not measure for worth,","s":44.68,"e":49.09},{"t":"nor favor by name…","s":49.19,"e":54.48},{"t":"What differs is the answers,","s":54.54,"e":57.62},{"t":"when truth is forsaken or claimed.","s":57.72,"e":60.82},{"t":"I stand before them openly,","s":60.83,"e":69.77},{"t":"with nothing held behind.","s":69.8,"e":74.79},{"t":"No hidden terms, no double edges.","s":74.89,"e":79.16},{"t":"only mercy on borrowed time.","s":79.26,"e":85.41},{"t":"They choose death.","s":85.44,"e":87.73},{"t":"for what reason no one knows.","s":87.77,"e":94.28},{"t":"They lock arms in rebellion","s":94.32,"e":96.62},{"t":"against the Lover of their souls.","s":96.64,"e":104.22},{"t":"When struck upon My cheek,","s":104.31,"e":109.27},{"t":"I do not pull away…","s":109.39,"e":114.11},{"t":"They turn from Life itself,","s":114.21,"e":118.46},{"t":"and welcome darkness as if day..","s":118.52,"e":120.99},{"t":"I wait past what mercy asks,","s":121.0,"e":129.86},{"t":"past what patience can endure.","s":129.91,"e":135.04},{"t":"I bear the weight of every plea,","s":135.16,"e":138.94},{"t":"wishing hearts would still be cured.","s":138.97,"e":144.77},{"t":"I am long-suffering.","s":144.89,"e":147.81},{"t":"through suffering they can see…","s":147.85,"e":150.42},{"t":"But rejected love.","s":150.52,"e":156.01},{"t":"cannot force itself to be.","s":156.03,"e":164.39},{"t":"You know this grief already","s":164.4,"e":168.75},{"t":"it lives inside My chest.","s":168.83,"e":174.18},{"t":"My love is without coercion","s":174.26,"e":178.0},{"t":"It is Mine to risk.","s":178.09,"e":179.86},{"t":"They choose death.","s":179.87,"e":180.42},{"t":"for what reason no one knows.","s":180.44,"e":192.49},{"t":"They lock arms in rebellion","s":192.54,"e":195.96},{"t":"against the Lover of their souls.","s":196.0,"e":202.12},{"t":"When struck upon My cheek,","s":202.21,"e":207.01},{"t":"I do not pull away…","s":207.13,"e":211.77},{"t":"They turn from Life itself,","s":211.87,"e":214.67},{"t":"and welcome darkness as if day..","s":214.71,"e":222.32},{"t":"I am not divided in My heart.","s":222.34,"e":226.95},{"t":"I love those who cause My pain.","s":227.07,"e":232.08},{"t":"The same hands stretch out to heal","s":232.14,"e":234.5},{"t":"wearing scars that will always remain","s":234.57,"e":241.2},{"t":"I grieve what would perish,","s":241.36,"e":242.97},{"t":"even as I stand to act…","s":242.98,"e":251.4},{"t":"Justice rises from love itself,","s":251.47,"e":255.22},{"t":"not from absence nor lack.","s":255.28,"e":260.85},{"t":"They choose death.","s":260.87,"e":263.1},{"t":"for what reason no one knows.","s":263.14,"e":269.23},{"t":"They lock arms in rebellion","s":269.27,"e":272.63},{"t":"against the Lover of their souls.","s":272.68,"e":275.67},{"t":"My love is still the same.","s":275.75,"e":283.43},{"t":"My forgiveness still stands wide…","s":283.54,"e":288.21},{"t":"But life cannot be forced","s":288.31,"e":291.86},{"t":"on those who choose the other side.","s":291.98,"e":298.12},{"t":"This is My ache.","s":298.14,"e":302.84},{"t":"This is My grief.","s":302.89,"e":304.11},{"t":"I've given you a taste, My child,","s":304.15,"e":311.85},{"t":"because you stay with Me.","s":311.89,"e":316.56},{"t":"oh . My scars remain forever.","s":316.66,"e":327.17},{"t":"My scars remain","s":327.27,"e":330.56}],"match":null}
