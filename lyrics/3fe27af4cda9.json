{"v":1,"id":"3fe27af4cda9","synced":false,"offset":null,"source":"whisper","lines":[{"t":"In the rush of this world, so many voices call","s":12.26,"e":18.96},{"t":"Pulling my eyes left and right, trying to take it all","s":18.96,"e":25.18},{"t":"But I quiet my soul, let the noise fade away","s":25.18,"e":32.04},{"t":"Till I see only your light breaking through the grey","s":32.58,"e":38.18},{"t":"No more chasing shadows, no more divided heart","s":39.96,"e":45.96},{"t":"I'm laying down the ways that kept us apart","s":45.96,"e":51.42},{"t":"Only you, my King","s":53.76,"e":57.4},{"t":"You're the one I seek","s":60.74,"e":64.0},{"t":"The center of my everything","s":66.98,"e":71.78},{"t":"Where my spirit's free","s":73.8,"e":77.94},{"t":"I have nothing to fear.","s":99.28,"e":104.56},{"t":"All my focus on You, all my days belong","s":107.94,"e":115.78},{"t":"Only You, my King","s":115.78,"e":121.46},{"t":"Only You in this song","s":121.46,"e":128.14},{"t":"Through the storms that rise","s":131.22,"e":135.12},{"t":"And the valley's low","s":135.12,"e":138.3},{"t":"Your voice is the anchor","s":139.06,"e":142.06},{"t":"That helps me grow","s":142.06,"e":144.68},{"t":"Every step I take","s":144.68,"e":148.1},{"t":"Every breath I breathe","s":149.12,"e":151.42},{"t":"Is yours to guide","s":152.38,"e":155.04},{"t":"Yours to receive","s":155.74,"e":158.34},{"t":"Let every crown I wore","s":160.06,"e":163.98},{"t":"Fall at your feet","s":163.98,"e":166.1},{"t":"Every dream I chase","s":166.76,"e":170.5},{"t":"Now bows in defeat","s":171.06,"e":172.66},{"t":"You're the beginning","s":172.66,"e":176.0},{"t":"The end, the way","s":176.62,"e":178.94},{"t":"My heart beats for you","s":179.88,"e":182.68},{"t":"Alone every day","s":183.22,"e":185.64},{"t":"Only you, my King","s":187.54,"e":190.66},{"t":"You're the one I see","s":193.98,"e":197.3},{"t":"The center of my everything","s":199.82,"e":205.14},{"t":"Where my spirit's free","s":207.06,"e":211.44},{"t":"Yahushua, my Savior","s":214.78,"e":218.06},{"t":"Savior, draw me ever near.","s":218.06,"e":225.06},{"t":"In your presence alone, I have nothing to fear.","s":228.08,"e":237.94},{"t":"All my focus on you","s":241.16,"e":246.04},{"t":"All my days belong","s":246.04,"e":249.04},{"t":"Only you, my King","s":249.04,"e":254.82},{"t":"Only you in this song","s":255.96,"e":261.46},{"t":"In the silence","s":264.06,"e":266.84},{"t":"In the fire, in the calm or the roar","s":266.84,"e":274.48},{"t":"Only you, my King","s":275.92,"e":281.5},{"t":"Forevermore","s":286.84,"e":288.24}],"match":null}
