{"v":1,"id":"b06a93563e98","synced":false,"offset":null,"source":"whisper","lines":[{"t":"We are now at Upper Session Road","s":17.04,"e":28.26},{"t":"The universe is filled with his glory","s":30.0,"e":34.42},{"t":"And that glory shall abide with men","s":34.42,"e":40.38},{"t":"Even in them and among them","s":40.38,"e":44.66},{"t":"I shall be a father unto them","s":44.66,"e":49.94},{"t":"And they shall be my beloved children","s":50.7,"e":57.2},{"t":"Children forever","s":57.2,"e":59.08},{"t":"Lord, return to innocence","s":59.08,"e":64.44},{"t":"Paradise lost is","s":64.44,"e":68.38},{"t":"Paradise found","s":70.2,"e":72.06},{"t":"Return to the garden","s":104.3,"e":106.58},{"t":"The universe your playground","s":107.88,"e":110.66},{"t":"Thus as I have spoken","s":111.92,"e":113.98},{"t":"So shall it be done","s":113.98,"e":117.42},{"t":"The mystery of God revealed","s":119.12,"e":123.78},{"t":"The counting of days no more","s":124.36,"e":126.78},{"t":"Forever young","s":126.78,"e":128.52},{"t":"In the presence of your shepherd","s":128.52,"e":132.66},{"t":"Your redeemer, your father, your brother","s":132.66,"e":140.4},{"t":"Father, your most beloved friend","s":140.4,"e":145.36},{"t":"The fulfillment of all things for which your hearts have groaned","s":145.9,"e":151.64},{"t":"I am the meaning of life","s":156.26,"e":158.62},{"t":"And all who live in me","s":171.38,"e":174.5},{"t":"And I in them","s":174.5,"e":177.34},{"t":"Will live forever","s":178.86,"e":180.84},{"t":"Thank you.","s":209.16,"e":210.58}],"match":null}
