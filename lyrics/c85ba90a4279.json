{"v":1,"id":"c85ba90a4279","synced":false,"offset":null,"source":"whisper","lines":[{"t":"‫הוא לא נועה ולא הדל","s":15.4,"e":21.94},{"t":"‫השמע חובות ידועת שולי","s":21.94,"e":28.2},{"t":"נבזה ונדע, נעוץ את פי, ובחבורתו נרפא לנו.","s":28.2,"e":39.94},{"t":"יהושע אלוהינו, רחום וחלונתך,","s":43.92,"e":53.84},{"t":"הוא נשא את אבוננו, הוא שם את נפשו בחבך,","s":53.84,"e":66.9},{"t":"ובחבורתו נרפא לנו, ובדמו נפאר לנו.","s":70.12,"e":80.08},{"t":"יחושו אלוהינו, קדושו שמור.","s":84.48,"e":94.22},{"t":"כבש את אבך הוא נהל","s":106.88,"e":110.52},{"t":"הוא קשיב לי וניגוז איזהה","s":110.52,"e":113.72},{"t":"הוא לא יפתח בי ולצדק","s":113.72,"e":117.0},{"t":"אבל נשא את חטאותינו","s":117.58,"e":120.82},{"t":"נתקרבה עבורנו","s":120.82,"e":123.56},{"t":"נתקל בו עוננו השלום שלו עלינו הוא שלום לנו","s":123.56,"e":133.02},{"t":"המין צדק לו עבד מתאונות אף שלום לנו","s":133.6,"e":140.86},{"t":"עבד לחתותינו קיים ברית חדשה","s":140.86,"e":147.26},{"t":"יחושה מלך הכבוד לעולם ואת","s":147.26,"e":159.04},{"t":"קדוש קדוש קדוש הוא אדוני","s":160.1,"e":165.48},{"t":"ברוך הבא בשם אדוני","s":167.0,"e":172.44},{"t":"תודה רבה.","s":188.26,"e":189.16}],"match":null}
