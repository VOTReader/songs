{"v":1,"id":"9f2d5aa2835f","synced":true,"offset":0,"source":"suno","lines":[{"t":"The morning dove rests peacefully","s":13.55,"e":20.21},{"t":"Beside a nearby pecan tree","s":20.31,"e":26.07},{"t":"Cooing sweet and softly,","s":26.09,"e":30.28},{"t":"Nature’s sunrise choir","s":30.35,"e":33.81},{"t":"Gentle sounds are echoing","s":33.83,"e":36.47},{"t":"Throughout the universe","s":36.53,"e":39.16},{"t":"Shabbat Shalom","s":39.25,"e":45.39},{"t":"Shabbat Shalom","s":45.48,"e":52.89},{"t":"Calling to its Creator","s":52.92,"e":55.97},{"t":"As each line is rehearsed","s":56.09,"e":59.51},{"t":"The morning dove has wings","s":59.52,"e":65.53},{"t":"So beautiful and white","s":65.75,"e":72.59},{"t":"When soaring toward the sun","s":72.66,"e":78.8},{"t":"You behold God’s awesome light","s":79.01,"e":85.64},{"t":"So radiant in beauty,","s":85.68,"e":89.5},{"t":"Dazzling and bright","s":89.6,"e":92.27},{"t":"No words can describe it","s":92.48,"e":95.4},{"t":"As the dove takes flight","s":95.48,"e":131.6},{"t":"It praises its Creator","s":131.61,"e":134.85},{"t":"And coos, Shabbat Shalom","s":134.95,"e":138.29},{"t":"The Sabbath peace He gave us","s":138.33,"e":141.34},{"t":"This rest will never cease","s":141.43,"e":150.04},{"t":"Shabbat Shalom","s":150.06,"e":156.67},{"t":"Shabbat Shalom","s":156.75,"e":161.41},{"t":"This rest will never cease","s":161.5,"e":165.65}],"match":null}
