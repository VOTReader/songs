{"v":1,"id":"9f04de6fffb1","synced":true,"offset":0,"source":"suno","lines":[{"t":"Verse 1","s":-0.37,"e":19.07},{"t":"I’ve spent too many days","s":19.1,"e":23.33},{"t":"living in the numbness","s":23.41,"e":26.44},{"t":"I fell asleep and forgot Your ways","s":26.6,"e":29.31},{"t":"and was at peace in the silence","s":29.39,"e":32.44},{"t":"Verse 2","s":32.53,"e":33.87},{"t":"Yet You didn’t leave me in my slumber","s":33.92,"e":37.37},{"t":"Did not let darkness cradle me","s":37.43,"e":41.04},{"t":"Your mercy cut where I was numb","s":41.1,"e":44.79},{"t":"A healing blade, a faithful love","s":44.95,"e":48.62},{"t":"You saw the sickness in my heart","s":48.7,"e":50.61},{"t":"and still Your love would not depart","s":50.64,"e":56.2},{"t":"No shadow deep, no hidden stain","s":56.28,"e":59.39},{"t":"Could make You turn Your face away","s":59.44,"e":62.12},{"t":"Chorus","s":62.21,"e":63.94},{"t":"Faithful in the wound","s":64.03,"e":67.69},{"t":"Faithful in the breaking","s":67.78,"e":71.52},{"t":"Even when I cause You pain","s":71.58,"e":74.39},{"t":"Your love for me remains the same","s":74.45,"e":78.14},{"t":"You won’t let me go","s":78.22,"e":79.74},{"t":"You won’t leave me lost","s":79.78,"e":85.0},{"t":"Your mercy holds me close","s":85.1,"e":89.55},{"t":"No matter what it costs","s":89.67,"e":93.31},{"t":"Verse 3","s":93.41,"e":95.01},{"t":"You gave Yourself up to torture and suffering","s":95.02,"e":99.44},{"t":"You didn’t hold back, You gave up everything","s":99.47,"e":115.48},{"t":"There’s no sin so dark You won’t forgive","s":115.5,"e":119.23},{"t":"Your love and mercy have no end","s":119.33,"e":122.98},{"t":"When I am blind, You help me see","s":123.06,"e":126.65},{"t":"When I am bound, You set me free","s":126.71,"e":130.64},{"t":"There’s nothing You won’t do","s":130.66,"e":134.31},{"t":"To lead me back to You","s":134.43,"e":136.56},{"t":"Chorus","s":136.65,"e":138.54},{"t":"Faithful in the wound","s":138.63,"e":141.17},{"t":"Faithful in the breaking","s":141.21,"e":146.2},{"t":"Even when I cause You pain","s":146.26,"e":148.91},{"t":"Your love for me remains the same","s":148.97,"e":152.74},{"t":"You won’t let me go","s":152.79,"e":156.33},{"t":"You won’t leave me lost","s":156.41,"e":159.36},{"t":"Your mercy holds me close","s":159.46,"e":163.99},{"t":"No matter what it costs","s":164.11,"e":174.69},{"t":"Bridge","s":174.79,"e":179.79},{"t":"I know Your correction is love","s":179.95,"e":182.5},{"t":"Healing flames from above","s":182.59,"e":196.31},{"t":"Exposing lies and unbelief","s":196.43,"e":207.95},{"t":"Till only truth remains in me","s":208.01,"e":211.86},{"t":"Oh Lord, come and search my heart","s":211.98,"e":215.53},{"t":"Shine Your light into the dark","s":215.61,"e":219.13},{"t":"I will trust Your endless grace","s":219.28,"e":222.56},{"t":"Through every trial I face","s":222.59,"e":225.28},{"t":"Final Chorus","s":225.29,"e":226.94},{"t":"Faithful in the wound","s":227.03,"e":230.53},{"t":"Faithful in the breaking","s":230.62,"e":235.8},{"t":"When my pride shatters, You give me grace","s":235.86,"e":240.35},{"t":"I’m held even tighter in Your strong embrace","s":240.51,"e":244.42},{"t":"So I offer up all my weakness","s":244.54,"e":251.92},{"t":"You alone are my righteousness","s":252.0,"e":259.11},{"t":"Outro","s":259.12,"e":259.18},{"t":"You will not leave me…","s":259.28,"e":266.54},{"t":"You will not leave me…","s":266.64,"e":277.31},{"t":"You will never leave me…","s":277.41,"e":281.28}],"match":null}
