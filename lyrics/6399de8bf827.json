{"v":1,"id":"6399de8bf827","synced":true,"offset":0,"source":"suno","lines":[{"t":"The power of The Lord is without end!","s":24.37,"e":29.09},{"t":"His love covers His creation like a blanket,","s":29.14,"e":33.77},{"t":"and the light of His glory reaches beyond","s":33.8,"e":37.91},{"t":"the stars of heaven!","s":37.97,"e":43.2},{"t":"His majesty is beyond comprehension;","s":43.28,"e":47.87},{"t":"it transcends space and time!","s":47.96,"e":53.13},{"t":"The Everlasting is His name!","s":53.17,"e":57.44},{"t":"The express image of The Holy is revealed,","s":57.48,"e":61.55},{"t":"He is known of His own!","s":61.59,"e":66.54},{"t":"His glory shines from the east","s":66.61,"e":69.78},{"t":"even unto the west,","s":69.88,"e":72.34},{"t":"The Sh’khinah of The Father’s only Son!","s":72.38,"e":78.96},{"t":"WONDERFUL","s":79.04,"e":81.28},{"t":"is His name! (wonderful)","s":81.39,"e":83.74},{"t":"WONDERFUL","s":83.83,"e":85.88},{"t":"are His ways! (are His ways)","s":85.96,"e":88.28},{"t":"He wears TRUTH as a garment,","s":88.36,"e":91.09},{"t":"and GLORY is His vesture,","s":91.13,"e":93.42},{"t":"and LOVE is His crowning glory!","s":93.51,"e":100.84},{"t":"All life proceeds from Him;","s":100.93,"e":105.03},{"t":"He holds all things together by the Word of His power!","s":105.11,"e":109.79},{"t":"His way is from everlasting,","s":109.85,"e":113.75},{"t":"And with His mouth He testifies","s":113.85,"e":118.68},{"t":"To the Truth, always!","s":118.8,"e":123.79},{"t":"Therefore, let us testify also;","s":123.84,"e":128.41},{"t":"The Father and The Son are One!","s":128.49,"e":132.35},{"t":"ONE!...","s":132.45,"e":133.48},{"t":"YAHUSHUA-YAHUWAH!","s":133.52,"e":136.88},{"t":"YAHUSHUA-YAHUWAH!","s":136.93,"e":141.54},{"t":"YAHUSHUA-YAHUWAH!","s":141.61,"e":146.7},{"t":"WONDERFUL","s":146.78,"e":149.08},{"t":"is His name! (wonderful)","s":149.15,"e":151.4},{"t":"WONDERFUL","s":151.48,"e":153.78},{"t":"are His ways! (are His ways)","s":153.86,"e":155.96},{"t":"He wears TRU