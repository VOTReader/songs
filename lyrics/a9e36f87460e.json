{"v":1,"id":"a9e36f87460e","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I walk through the fire, shadows in my mind","s":14.58,"e":20.28},{"t":"Thought I was defeated, running out of time","s":20.28,"e":26.14},{"t":"Then your voice like thunder cut through all the lies","s":26.84,"e":32.08},{"t":"Now I'm standing fearless with you by my side","s":32.92,"e":38.24},{"t":"Every chain is breaking, falling at my feet","s":39.0,"e":41.96},{"t":"I was born for battle, made for victory","s":41.96,"e":44.72},{"t":"You make me unshakable, stronger than before","s":46.76,"e":50.8},{"t":"When the darkness closes in, you open up the door","s":50.8,"e":53.94},{"t":"I'll carry your light, I'm never going back","s":53.94,"e":56.88},{"t":"With your name on my heart, I'm ready for the attack","s":56.88,"e":59.8},{"t":"You make me unbreakable","s":59.8,"e":62.64},{"t":"I'm burning with your fire","s":62.64,"e":65.32},{"t":"Standing in the storm","s":65.86,"e":68.36},{"t":"I'm only rising higher","s":68.36,"e":71.14},{"t":"I remember nights when","s":74.54,"e":77.5},{"t":"Hope was wearing thin","s":77.5,"e":79.94},{"t":"Echoes of my failures","s":81.3,"e":83.36},{"t":"Screaming from within","s":83.36,"e":85.84},{"t":"But you wrote a new song","s":86.86,"e":89.52},{"t":"Over every scar","s":89.52,"e":91.98},{"t":"Now I'm chasing giants","s":92.84,"e":95.32},{"t":"Knowing who you are","s":95.32,"e":98.22},{"t":"Every fear is fading","s":98.74,"e":100.66},{"t":"Courage floods my veins","s":100.66,"e":102.04},{"t":"I was made to echo the power of your name","s":102.04,"e":105.02},{"t":"You make me unshakable","s":106.62,"e":109.14},{"t":"Stronger than before","s":109.14,"e":110.78},{"t":"When the darkness closes in","s":110.78,"e":112.48},{"t":"You open up the door, I'll carry your light","s":112.48,"e":115.38},{"t":"I'm never going back with your name on my heart","s":115.38,"e":118.52},{"t":"I'm ready for the attack, you make me unbreakable","s":118.52,"e":122.6},{"t":"I'm burning with your fire, standing in the storm","s":122.6,"e":128.3},{"t":"I'm only rising higher","s":128.3,"e":131.18},{"t":"I won't bow to the pressure, I won't run from the fight","s":131.18,"e":136.46},{"t":"You're the strength in the battle","s":137.42,"e":139.66},{"t":"You're the blaze in the night","s":139.66,"e":142.78},{"t":"When the world tries to shame me","s":143.38,"e":145.82},{"t":"I remember the cross","s":145.82,"e":148.44},{"t":"What they call a weakness","s":149.76,"e":151.58},{"t":"You have turned into a curse","s":151.58,"e":154.98},{"t":"I am not forgotten","s":155.78,"e":157.86},{"t":"I am not alone","s":158.82,"e":160.82},{"t":"Every step I'm taking","s":161.82,"e":164.1},{"t":"You are on the throne","s":164.1,"e":167.0},{"t":"Fear has lost its power","s":167.78,"e":170.06},{"t":"Shame has lost its hold","s":170.86,"e":173.02},{"t":"With your spirit in me","s":173.02,"e":175.9},{"t":"I'm a lion boy","s":175.9,"e":179.1},{"t":"You make me unshakable","s":179.1,"e":181.1},{"t":"Stronger than before","s":181.1,"e":182.76},{"t":"When the darkness closes in","s":182.76,"e":184.46},{"t":"You open up the door","s":184.46,"e":185.94},{"t":"I'll carry your light","s":185.94,"e":187.36},{"t":"I'm never going back","s":187.36,"e":188.86},{"t":"With your name on my heart","s":188.86,"e":190.46},{"t":"I'm ready for the attack","s":190.46,"e":191.78},{"t":"You make me unbreakable, I'm burning with your fire","s":191.78,"e":197.42},{"t":"Standing in the storm, I'm only rising higher","s":197.92,"e":203.42},{"t":"Higher","s":205.7,"e":206.78},{"t":"You make me unstoppable, with every breath I see","s":208.7,"e":214.92},{"t":"I'm sure","s":214.92,"e":216.22},{"t":"Higher","s":216.22,"e":218.2},{"t":"You're the reason my heart is gonna ring","s":220.96,"e":226.28}],"match":null}
