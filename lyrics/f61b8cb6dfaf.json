{"v":1,"id":"f61b8cb6dfaf","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 1)","s":2.49,"e":12.29},{"t":"In the quiet of the morning,","s":12.34,"e":15.47},{"t":"When the world is barely bright,","s":15.52,"e":18.97},{"t":"I feel You in the stillness,","s":19.09,"e":22.01},{"t":"Like a whisper made of light.","s":22.06,"e":25.27},{"t":"Every shadow slowly softens,","s":25.31,"e":28.55},{"t":"Every worry fades away—","s":28.59,"e":31.56},{"t":"You’re the calm within my heartbeat,","s":31.58,"e":34.43},{"t":"The One who holds my days.","s":34.53,"e":37.86},{"t":"(Pre-Chorus)","s":37.54,"e":39.74},{"t":"And when I tremble, when I wander,","s":39.8,"e":42.85},{"t":"When I lose my way again…","s":42.91,"e":46.04},{"t":"Your love gathers all my pieces,","s":46.11,"e":49.37},{"t":"Teaching broken hearts to mend.","s":49.41,"e":54.81},{"t":"(Chorus)","s":51.74,"e":55.09},{"t":"And I find You","s":55.11,"e":57.63},{"t":"In the gentle things,","s":57.75,"e":61.03},{"t":"In the tears I cry,","s":61.09,"e":62.95},{"t":"In the hope You bring.","s":63.0,"e":68.26},{"t":"You are near me","s":68.36,"e":70.71},{"t":"In the quiet truth—","s":70.83,"e":74.26},{"t":"Every time I fall apart,","s":74.3,"e":76.8},{"t":"You pull me through.","s":76.9,"e":78.77},{"t":"And I know I’m safe and new…","s":78.85,"e":82.94},{"t":"Here where my heart finds You.","s":83.03,"e":90.54},{"t":"(Verse 2)","s":85.74,"e":90.83},{"t":"Every memory You’ve carried,","s":90.86,"e":93.81},{"t":"Every tear You’ve seen me hide—","s":93.85,"e":96.82},{"t":"You’re the One who sits beside me,","s":96.84,"e":100.12},{"t":"When I’m drowning deep inside.","s":100.17,"e":103.19},{"t":"You turn sorrow into softness,","s":103.27,"e":106.66},{"t":"Lift the coldness from my bones—","s":106.71,"e":109.91},{"t":"You remind me I am cherished,","s":110.01,"e":113.28},{"t":"I am never walking alone.","s":113.4,"e":115.67},{"t":"(Pre-Chorus)","s":115.27,"e":118.16},{"t":"So when the winds begin their shaking,","s"