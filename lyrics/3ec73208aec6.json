{"v":1,"id":"3ec73208aec6","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Peace is in the knowing that I am who I am","s":14.08,"e":23.54},{"t":"And you are in life because of me","s":23.54,"e":32.12},{"t":"Beloved, you were made for me","s":37.48,"e":41.32},{"t":"Created for love's purpose","s":41.32,"e":45.06},{"t":"I created you in my image","s":48.52,"e":52.26},{"t":"And gave you my breath, my life","s":52.26,"e":56.76},{"t":"Therefore this is life, I am here","s":57.94,"e":62.24},{"t":"Beloved, you worry","s":75.06,"e":77.48},{"t":"Yet I am here","s":77.48,"e":80.26},{"t":"You weep, yet I am He","s":82.26,"e":85.98},{"t":"You stumble, yet I am He","s":86.66,"e":89.42},{"t":"Your hearts tear and break over all these sorrows","s":89.42,"e":94.24},{"t":"Yet I am He","s":95.68,"e":98.12},{"t":"You struggle and are in turmoil, you feel lost","s":98.12,"e":102.88},{"t":"Yet I am He","s":102.88,"e":104.84},{"t":"You grasp at the wind and have no understanding","s":104.84,"e":108.5},{"t":"Yet I am here","s":108.5,"e":110.88},{"t":"You are persecuted by those you love","s":110.88,"e":114.68},{"t":"Yet I am here","s":115.2,"e":116.84},{"t":"The world hates you","s":116.84,"e":119.24},{"t":"Yet I am here","s":119.8,"e":122.12},{"t":"Everything you have is passing away","s":122.94,"e":126.14},{"t":"Yet I am here","s":126.9,"e":128.88},{"t":"Death comes to take you into darkness","s":128.88,"e":132.38},{"t":"Yet I am here","s":132.38,"e":134.9},{"t":"Do you not understand?","s":134.9,"e":136.66},{"t":"I am enough","s":136.66,"e":139.04},{"t":"The one who sees","s":139.58,"e":141.58},{"t":"The one who knows","s":142.3,"e":144.66},{"t":"No matter the time or the season","s":146.14,"e":150.04},{"t":"In every moment of your life","s":150.04,"e":153.66},{"t":"I am He","s":154.3,"e":155.86},{"t":"Says the Lord","s":159.42,"e":162.5},{"t":"Thank you.","s":172.44,"e":173.92}],"match":null}
