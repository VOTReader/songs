{"v":1,"id":"b57437e3aed7","synced":true,"offset":0,"source":"suno","lines":[{"t":"The watchmen have cried from the walls,","s":7.66,"e":12.09},{"t":"The Word has gone forth across the earth,","s":12.13,"e":16.83},{"t":"Yet who will listen?","s":16.91,"e":20.92},{"t":"Who will hear?","s":21.02,"e":25.04},{"t":"The trumpet sounds in the distance,","s":25.07,"e":29.32},{"t":"The earth begins to tremble…","s":29.36,"e":34.29},{"t":"And still The Way of the Lord is not known.","s":34.32,"e":60.83},{"t":"You have forgotten the Way,","s":60.85,"e":64.43},{"t":"You have hidden your eyes from the innocent,","s":64.47,"e":68.58},{"t":"You have turned your hearts from the truth,","s":68.62,"e":76.32},{"t":"You ask where the darkness came from,","s":76.39,"e":79.99},{"t":"You ask why devastation fills the land,","s":80.03,"e":84.69},{"t":"But the warning was spoken long ago,","s":84.73,"e":87.89},{"t":"And the Word has stood from the beginning.","s":87.93,"e":90.46},{"t":"The proud will fall,","s":90.5,"e":96.02},{"t":"The hidden things will be revealed,","s":96.06,"e":101.48},{"t":"Every heart will be searched,","s":101.54,"e":103.62},{"t":"Every one will be brought into the light.","s":103.67,"e":111.01},{"t":"Hear the call across the field,","s":111.02,"e":113.17},{"t":"Hear the voice upon the mountain,","s":113.2,"e":115.51},{"t":"The testimony has gone forth.","s":115.57,"e":119.12},{"t":"Open your eyes,","s":119.2,"e":121.13},{"t":"Open your heart,","s":121.23,"e":122.03},{"t":"Return before the darkness falls.","s":122.06,"e":127.22},{"t":"The Lord is calling,","s":127.23,"e":131.15},{"t":"Let the sleeping hearts awaken!","s":131.21,"e":135.62},{"t":"Let the whole earth tremble!","s":135.65,"e":137.75},{"t":"The Holy One is drawing near,","s":137.79,"e":140.68},{"t":"His judgment is at the door!","s":140.78,"e":154.08},{"t":"Who among you remembers His Way?","s":154.09,"e":158.22},{"t":"Who among you thirsts for truth?","s":158.3,"e":161.39},{"t":"Who will drink from the living waters?","s":161.45,"e":165.54},{"t":"Who will eat from the Tree of Life?","s":165.6,"e":169.24},{"t":"The messengers have spoken,","s":169.29,"e":171.3},{"t":"The prophets have seen,","s":171.38,"e":172.88},{"t":"The Word of Truth is upon their lips,","s":172.94,"e":175.41},{"t":"Yet they are rejected and hated.","s":175.45,"e":177.51},{"t":"But the Word shall not be silenced,","s":177.54,"e":179.66},{"t":"The truth cannot be buried,","s":179.72,"e":181.14},{"t":"The light won’t surrender to darkness,","s":181.16,"e":185.94},{"t":"For the Holy One is coming,","s":185.98,"e":190.19},{"t":"The warning must not stop","s":190.25,"e":194.29},{"t":"Take the lantern into the darkness,","s":194.3,"e":196.38},{"t":"Search the houses one by one.","s":196.4,"e":198.48},{"t":"Is there one who still remembers?","s":198.54,"e":200.56},{"t":"Is there one who truly knows Him?","s":200.61,"e":203.09},{"t":"Open your eyes,","s":203.18,"e":205.15},{"t":"Open your heart,","s":205.24,"e":207.14},{"t":"Return before the darkness falls.","s":207.23,"e":210.17},{"t":"The Lord is calling,","s":210.18,"e":217.16},{"t":"Let the sleeping hearts awaken!","s":217.22,"e":221.55},{"t":"Let the whole earth tremble!","s":221.59,"e":223.62},{"t":"The Holy One is coming,","s":223.68,"e":226.62},{"t":"His judgment is at the door!","s":226.72,"e":236.11},{"t":"The darkness covers the land.","s":236.12,"e":240.26},{"t":"The decree has gone forth,","s":240.28,"e":244.75},{"t":"The hour is in His hand.","s":244.79,"e":247.36},{"t":"The ancient warning makes a stand,","s":247.4,"e":251.83},{"t":"His Truth is in the land,","s":251.93,"e":259.4},{"t":"The Holy One is coming…","s":259.4,"e":263.68},{"t":"The Holy One is coming…","s":263.74,"e":267.78},{"t":"Let every heart awaken!","s":267.79,"e":269.46},{"t":"Let every soul remember!","s":269.48,"e":276.24},{"t":"Let the trumpet sound!","s":276.25,"e":280.27},{"t":"The Lord is calling,","s":280.33,"e":284.42},{"t":"Let the sleeping hearts awaken!","s":284.48,"e":288.81},{"t":"Let the whole earth tremble!","s":288.85,"e":290.96},{"t":"The Holy One is here,","s":291.02,"e":293.88},{"t":"His kingdom shall stand forever!","s":293.98,"e":304.81},{"t":"And still His soft voice calls…","s":304.82,"e":310.79},{"t":"His hands gather His flock,","s":310.83,"e":314.58},{"t":"His voice calls to His lambs.","s":314.64,"e":318.43}],"match":null}
