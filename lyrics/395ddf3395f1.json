{"v":1,"id":"395ddf3395f1","synced":true,"offset":0,"source":"suno","lines":[{"t":"You think the fight is in desires,","s":1.05,"e":7.19},{"t":"in the pull you feel inside…","s":7.27,"e":12.84},{"t":"but the real temptation whispers","s":12.9,"e":18.36},{"t":"you should handle this alone tonight.","s":18.44,"e":24.61},{"t":"Independence is labeled strength,","s":24.64,"e":29.21},{"t":"you call on courage to endure,","s":29.29,"e":34.78},{"t":"but I never asked you to be fearless...","s":34.84,"e":41.18},{"t":"only close, only secure.","s":41.26,"e":46.58},{"t":"Every intent that makes for distance,","s":46.61,"e":52.47},{"t":"every time you brace for space,","s":52.51,"e":57.86},{"t":"Each transgression simply highlights","s":57.94,"e":63.86},{"t":"you’ve forgotten My embrace.","s":63.96,"e":68.56},{"t":"Stay with Me.","s":68.61,"e":73.03},{"t":"That’s what obedience has been.","s":73.05,"e":78.68},{"t":"Not proving you’re enough,","s":78.76,"e":80.76},{"t":"just locking in.","s":80.84,"e":84.72},{"t":"Every trial is a chance","s":84.77,"e":86.9},{"t":"to stop, and look to Me.","s":87.02,"e":89.07},{"t":"Don’t fight alone.","s":89.09,"e":90.36},{"t":"No! Stay with Me.","s":90.46,"e":95.41},{"t":"I see the moment pressure rises,","s":95.43,"e":101.45},{"t":"when the old resolve kicks in…","s":101.48,"e":106.53},{"t":"you start assembling your answers,","s":106.61,"e":112.44},{"t":"trying not to need Me then.","s":112.53,"e":116.98},{"t":"But child, the way through every trial","s":117.06,"e":120.25},{"t":"is never you alone, outpacing fear...","s":120.37,"e":129.44},{"t":"It was always us together,","s":129.47,"e":134.74},{"t":"step by step, right here.","s":134.79,"e":140.23},{"t":"What you call temptation’s voice","s":140.24,"e":146.1},{"t":"is calling for lonely strife.","s":146.22,"e":148.22},{"t":"But My Spirit quiet, in your heart...","s":148.26,"e":156.85},{"t":"Says “Let Me empower your life.”","s":156.9,"e":162.11},{"t":"Chorus]","s":162.15,"e":162.45},{"t":"Stay with Me.","s":162.49,"e":166.46},{"t":"That’s what obedience has been.","s":166.48,"e":172.11},{"t":"Not proving you’re enough,","s":172.19,"e":174.19},{"t":"just locking in.","s":174.27,"e":178.23},{"t":"Every trial is a chance","s":178.28,"e":180.33},{"t":"to stop, and look to Me.","s":180.45,"e":181.73},{"t":"Don’t fight alone.","s":181.77,"e":184.03},{"t":"No! Stay with Me.","s":184.13,"e":186.75},{"t":"The days ahead will test your footing,","s":186.76,"e":192.38},{"t":"not testing worth, nor what I see…","s":192.46,"e":197.86},{"t":"You won’t survive by standing stronger...","s":197.92,"e":203.03},{"t":"you’ll endure by leaning on Me.","s":203.04,"e":207.27},{"t":"When the weight feels impossible,","s":207.31,"e":210.33},{"t":"human wisdom runs thin and small,","s":210.41,"e":213.66},{"t":"Remember this before you wonder:","s":213.73,"e":218.75},{"t":"I have already carried it all.","s":218.87,"e":222.1},{"t":"Chorus]","s":222.18,"e":223.43},{"t":"Stay with Me.","s":223.53,"e":227.9},{"t":"That’s what obedience has been.","s":227.91,"e":233.55},{"t":"Not proving you’re enough,","s":233.63,"e":235.61},{"t":"just locking in.","s":235.67,"e":239.59},{"t":"Every trial is a chance","s":239.64,"e":241.85},{"t":"to stop, and look to Me.","s":241.93,"e":243.94},{"t":"Don’t fight alone.","s":243.96,"e":245.46},{"t":"No! Stay with Me.","s":245.57,"e":251.23},{"t":"This is how you’re kept.","s":251.25,"e":256.81},{"t":"This is how you stand.","s":256.86,"e":262.93},{"t":"Not alone. No!","s":263.03,"e":268.11},{"t":"Never alone.","s":268.2,"e":269.69}],"match":null}
