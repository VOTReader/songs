{"v":1,"id":"e13e538b6eca","synced":true,"offset":0,"source":"suno","lines":[{"t":"My child, in my embrace…","s":23.87,"e":29.28},{"t":"Trembling as though lost to Me.","s":29.34,"e":36.41},{"t":"You fear the fire","s":36.51,"e":41.02},{"t":"as if it burned your destiny.","s":41.14,"e":48.54},{"t":"But hear Me now...","s":48.59,"e":53.35},{"t":"I am the Judge of earth and sky,","s":53.39,"e":59.75},{"t":"yet I kept you in Salvation...","s":59.81,"e":65.93},{"t":"even when you cherished lies..","s":65.98,"e":74.01},{"t":"Discipline is not rejection;","s":74.02,"e":77.46},{"t":"Refinement bears My name.","s":77.52,"e":80.14},{"t":"You were not cast away...","s":80.24,"e":90.07},{"t":"I called through the flame.","s":90.17,"e":96.6},{"t":"You were always Mine...","s":96.62,"e":101.69},{"t":"no one could steal you from My hand.","s":101.76,"e":108.58},{"t":"You were always Mine...","s":108.64,"e":113.56},{"t":"your story written as I planned.","s":113.62,"e":115.98},{"t":"Not doomed to wrath,","s":116.02,"e":118.1},{"t":"not turned aside,","s":118.18,"e":119.67},{"t":"but held in love through trials.","s":119.73,"e":126.61},{"t":"You were always Mine…","s":126.67,"e":132.36},{"t":"and nothing breaks the line.","s":132.42,"e":138.81},{"t":"I searched your heart...","s":138.83,"e":143.57},{"t":"I knew what veiled your sight.","s":143.63,"e":151.01},{"t":"I saw the pride","s":151.13,"e":155.52},{"t":"That dimmed My living light.","s":155.58,"e":162.82},{"t":"So I must refine you...","s":162.88,"e":168.04},{"t":"Not as beasts that roam alone...","s":168.1,"e":173.91},{"t":"but as the sheep of My promise,","s":173.95,"e":180.27},{"t":"You're one I vowed to own.","s":180.29,"e":188.1},{"t":"The lost may be left to wander;","s":188.12,"e":191.64},{"t":"But redeemed are carried through.","s":191.7,"e":200.78},{"t":"You fear you’d slipped away...","s":200.87,"e":203.03},{"t":"but child, that fear was never true.","s":203.07,"e":210.92},{"t":"You were always Mine...","s":210.94,"e":215.95},{"t":"no one could steal you from My hand.","s":216.01,"e":222.86},{"t":"You were always Mine...","s":222.94,"e":227.81},{"t":"your story written as I planned.","s":227.87,"e":230.84},{"t":"Not doomed to wrath,","s":230.91,"e":232.27},{"t":"not turned aside,","s":232.35,"e":233.85},{"t":"but held in love through trials.","s":233.91,"e":240.81},{"t":"You were always Mine…","s":240.89,"e":246.84},{"t":"and nothing breaks the line.","s":246.89,"e":259.67},{"t":"When you fall, I am beside you.","s":259.69,"e":263.66},{"t":"When you hide, I still pursue.","s":263.69,"e":271.87},{"t":"If trumpet leaves you for next harvest,","s":271.98,"e":278.57},{"t":"My vow still covers you.","s":278.68,"e":286.81},{"t":"Refinement is My kindness...","s":286.88,"e":289.65},{"t":"its fire proves My claim.","s":289.69,"e":293.09},{"t":"Only My true children","s":293.18,"e":294.98},{"t":"are corrected in My name.","s":295.09,"e":309.21},{"t":"You are always Mine...","s":309.22,"e":314.14},{"t":"your place with Me was never shaken.","s":314.2,"e":320.97},{"t":"You are always Mine...","s":321.03,"e":322.69},{"t":"My covenant cannot be taken.","s":322.72,"e":329.56},{"t":"So rise, beloved…","s":329.66,"e":332.9},{"t":"lift your eyes..","s":332.99,"e":337.72},{"t":"the chosen never are denied.","s":337.78,"e":344.45},{"t":"You are always Mine…","s":344.53,"e":350.34},{"t":"Now and for all time.","s":350.4,"e":357.75},{"t":"Rest now in My promise...","s":357.78,"e":360.51},{"t":"salvation sealed and divine.","s":360.6,"e":369.11},{"t":"Walk forward in My refining…","s":369.19,"e":375.76},{"t":"My child, you’re wholly Mine.","s":375.86,"e":412.63},{"t":"... always mine.","s":377.99,"e":413.55}],"match":null}
