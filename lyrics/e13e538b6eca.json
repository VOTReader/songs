{"v":1,"id":"e13e538b6eca","synced":false,"offset":null,"source":"whisper","lines":[{"t":"My Child in My Embrace","s":22.86,"e":27.66},{"t":"Trembling as though lost to me","s":28.82,"e":31.68},{"t":"You feel the fire","s":35.4,"e":37.6},{"t":"As if it burned your destiny","s":39.68,"e":43.38},{"t":"But hear me now","s":47.6,"e":49.66},{"t":"I am the judge of earth and sky","s":52.48,"e":56.1},{"t":"Yet I kept you in salvation","s":57.68,"e":61.68},{"t":"Even when you cherished lies","s":64.78,"e":68.42},{"t":"Discipline is not rejection","s":73.6,"e":76.08},{"t":"But famine bears my name","s":76.08,"e":79.7},{"t":"You were not cast away","s":85.36,"e":88.28},{"t":"I crawled through the flame","s":88.28,"e":91.92},{"t":"You were always mine","s":95.48,"e":98.06},{"t":"No one could steal you from my hand","s":100.56,"e":104.48},{"t":"You were always mine","s":107.54,"e":110.46},{"t":"Your story written as I planned","s":111.02,"e":116.02},{"t":"Not doomed for off, not turned aside","s":116.02,"e":118.9},{"t":"But held in love through trials","s":118.9,"e":121.86},{"t":"You were always mine","s":125.36,"e":128.14},{"t":"Nothing breaks the line","s":131.24,"e":134.08},{"t":"I searched your heart","s":136.58,"e":140.1},{"t":"I knew what veiled your sight","s":141.6,"e":145.84},{"t":"I saw the pride","s":150.14,"e":152.54},{"t":"The dim, my living light","s":154.52,"e":157.92},{"t":"So I must refine you","s":161.76,"e":165.06},{"t":"Not as beasts that roam alone","s":167.08,"e":170.2},{"t":"But as the sheep of my promise","s":172.96,"e":176.56},{"t":"You're one I vow to own","s":179.26,"e":182.48},{"t":"The lost may be left to wander","s":187.14,"e":190.72},{"t":"But redeemed I'll carry through","s":190.72,"e":194.0},{"t":"You fear you'd slipped away","s":199.16,"e":202.42},{"t":"Wait, but child, that fear was never true","s":202.42,"e":206.24},{"t":"You were always mine","s":209.88,"e":212.34},{"t":"No one could steal you from my head","s":214.82,"e":218.64},{"t":"You were always mine","s":221.8,"e":224.46},{"t":"Your story written as I planned","s":226.82,"e":230.3},{"t":"Not doomed to wrath, not turned aside","s":230.3,"e":233.18},{"t":"But held in love through trials","s":233.18,"e":236.36},{"t":"You were always mine","s":239.86,"e":242.28},{"t":"Nothing breaks the line","s":245.92,"e":248.26},{"t":"When you fall, I am beside you","s":258.52,"e":263.72},{"t":"When you hide, I still pursue","s":263.72,"e":268.5},{"t":"If trumpet leaves you for next harvest","s":270.48,"e":275.16},{"t":"We are now at Upper Session Road","s":288.6,"e":304.96},{"t":"You are always mine","s":307.96,"e":310.8},{"t":"Your place with me was never shaken","s":312.66,"e":316.6},{"t":"You are always mine","s":319.82,"e":322.52},{"t":"My covenant cannot be taken","s":324.7,"e":328.5},{"t":"So rise, beloved","s":328.5,"e":330.48},{"t":"Love has left your eyes","s":330.48,"e":334.72},{"t":"It shows that never are denied","s":335.74,"e":339.92},{"t":"You are always mine","s":343.24,"e":346.04},{"t":"Now and for all time","s":349.28,"e":352.14},{"t":"Rest now in my promise, salvation, sealed and divine","s":356.58,"e":363.38},{"t":"Walk forward in my refining, my child, your holy mind","s":368.06,"e":377.94},{"t":"Oh, oh, oh, oh, oh.","s":386.14,"e":396.12},{"t":"Always mine","s":412.14,"e":413.12}],"match":null}
