{"v":1,"id":"371408a2788c","synced":true,"offset":0,"source":"suno","lines":[{"t":"(Verse 2)","s":27.23,"e":27.54},{"t":"The dawn has come, the shadows flee,","s":27.57,"e":33.93},{"t":"The veil is gone, eternity.","s":34.01,"e":39.83},{"t":"Light unending fills the air,","s":39.91,"e":46.04},{"t":"The King of Glory everywhere.","s":46.1,"e":54.15},{"t":"Every tear is washed away,","s":54.19,"e":57.43},{"t":"Every night has turned to day.","s":57.47,"e":60.14},{"t":"Heaven’s breath, forever here,","s":60.19,"e":63.37},{"t":"Whispers peace — “You’re home, My child.”","s":63.45,"e":67.06},{"t":"No more pain, no more fight,","s":67.09,"e":70.31},{"t":"Only love, only light.","s":70.39,"e":72.92},{"t":"The Lamb who reigns upon the throne,","s":72.98,"e":76.36},{"t":"Calls His children to His home.","s":76.43,"e":79.45},{"t":"YahuShua (echo: YahuShua…),","s":79.49,"e":84.99},{"t":"You are the light of the eternal morning.","s":85.04,"e":89.92},{"t":"The heavens sing, creation shouts,","s":89.98,"e":93.46},{"t":"Forever Yours, no more doubts.","s":93.55,"e":96.74},{"t":"Glory rising, endless grace,","s":96.83,"e":99.91},{"t":"Heaven shining on Your face.","s":99.99,"e":103.36},{"t":"Every soul in perfect peace,","s":103.45,"e":106.32},{"t":"In Your love, we are Your masterpiece.","s":106.43,"e":111.78},{"t":"The rivers flow from crystal streams,","s":111.84,"e":115.05},{"t":"The sound of peace in endless dreams.","s":115.11,"e":118.54},{"t":"The voice that called from worlds unknown,","s":118.58,"e":121.53},{"t":"Now lives within the hearts — His throne.","s":121.61,"e":125.12},{"t":"Holy… holy…","s":125.22,"e":131.52},{"t":"Pure and bright…","s":131.62,"e":136.85},{"t":"YahuShua… (echo: YahuShua…)","s":136.93,"e":140.7},{"t":"Endless Light…","s":140.79,"e":144.43},{"t":"(Verse 2)","s":141.58,"e":144.65},{"t":"Time has bowed, the circle complete,","s":144.68,"e":151.33},{"t":"Every promise now concrete.","s":151.37,"e":156.38},{"t":"The Alpha and Omega speaks, the end made new,","s":156.44,"e":163.11},{"t":"Forever starts and ends in You.","s":163.2,"e":170.54},{"t":"The saints rejoice, the heavens gleam,","s":170.59,"e":173.97},{"t":"Love eternal, the endless beam.","s":174.07,"e":176.71},{"t":"The Bride adorned, the song is sung,","s":176.75,"e":179.98},{"t":"The King and Bride in peace, forever young.","s":180.02,"e":188.66},{"t":"You are the light of the eternal morning.","s":188.76,"e":194.15},{"t":"Every heart forever free,","s":194.25,"e":197.41},{"t":"Every soul in unity.","s":197.49,"e":200.47},{"t":"Glory rising, never fades,","s":200.56,"e":203.65},{"t":"Love eternal never sways.","s":203.75,"e":207.06},{"t":"Endless dawn, no more sorrow,","s":207.13,"e":210.19},{"t":"Eternal morning, no tomorrow.","s":210.28,"e":225.3},{"t":"The light remains, the song still rings,","s":225.34,"e":231.7},{"t":"The Bride rests near the feet of the King.","s":231.76,"e":237.43},{"t":"The sky forever in heavenly glow,","s":237.47,"e":244.18},{"t":"Eternal morning — and now we know.","s":244.27,"e":251.99}],"match":null}
