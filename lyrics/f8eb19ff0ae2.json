{"v":1,"id":"f8eb19ff0ae2","synced":false,"offset":null,"source":"whisper","lines":[{"t":"It is the one who endures through the pain","s":11.16,"e":16.08},{"t":"Pressing forward, the winds may rage","s":17.74,"e":22.2},{"t":"Through every trial, they stand again","s":22.2,"e":28.14},{"t":"Their heart beats strong upon the stage","s":28.14,"e":34.3},{"t":"When the shadows fall and the road grows cold","s":35.36,"e":40.48},{"t":"They find their strength in the stories told","s":40.48,"e":46.2},{"t":"For it is the one who finishes the race","s":47.22,"e":52.18},{"t":"Who holds their faith","s":52.18,"e":55.06},{"t":"Who keeps the faith","s":55.06,"e":57.9},{"t":"Yet the soul who surrenders","s":58.92,"e":61.74},{"t":"All to the Lord","s":61.74,"e":64.1},{"t":"Will rise above","s":64.1,"e":66.8},{"t":"Forever restored","s":66.8,"e":69.92},{"t":"They will fly","s":70.46,"e":73.38},{"t":"Fly with eagle's wings","s":73.38,"e":76.22},{"t":"Lifted high","s":76.84,"e":79.32},{"t":"By the King of Kings","s":80.28,"e":82.28},{"t":"Every tear, every scar, every flame","s":83.88,"e":88.06},{"t":"Refines the spirit, shapes the name","s":88.06,"e":91.14},{"t":"Through every storm their heart proclaims","s":91.14,"e":94.72},{"t":"Hope remains, it never wanes","s":94.72,"e":97.04},{"t":"Oh, and the way it feels","s":98.92,"e":101.56},{"t":"Too much to bear","s":101.56,"e":103.08},{"t":"They lift their eyes","s":104.18,"e":106.44},{"t":"And find mercy there","s":106.44,"e":109.14},{"t":"In the hands of grace","s":109.74,"e":112.22},{"t":"They're not alone","s":113.38,"e":114.96},{"t":"The broken made whole","s":115.62,"e":118.02},{"t":"The lost made known","s":118.02,"e":119.52},{"t":"For it is the one","s":119.52,"e":121.06},{"t":"Who finishes the race","s":121.06,"e":124.06},{"t":"Who holds their faith","s":124.72,"e":126.84},{"t":"Who keeps the faith","s":127.36,"e":129.78},{"t":"Yet the soul who surrenders","s":130.8,"e":133.6},{"t":"All to the Lord will rise above, forever restored.","s":133.6,"e":141.78},{"t":"They will fly, fly with eagles' wings, lifted high by the King of kings.","s":142.72,"e":154.26},{"t":"Endure the pain","s":154.26,"e":157.16},{"t":"Let faith remain","s":157.7,"e":159.84},{"t":"For victory sings","s":160.7,"e":163.22},{"t":"And heaven's refrain","s":164.84,"e":165.82},{"t":"They will fly","s":165.82,"e":169.18},{"t":"Fly with eagle's wings","s":172.14,"e":175.64}],"match":null}
