{"v":1,"id":"a3efba747a4e","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Stonewalls built on shifting ground","s":12.44,"e":15.8},{"t":"Voices echo, but truths drowned out","s":15.8,"e":21.58},{"t":"Altars burned with borrowed light","s":21.58,"e":26.78},{"t":"They preach the day, but fear the night","s":26.78,"e":32.22},{"t":"Hands raised high, but hearts grow cold","s":33.36,"e":37.82},{"t":"Silver crowns these thrones of gold","s":37.82,"e":43.14},{"t":"The sacred words are dressed in pride","s":44.3,"e":48.42},{"t":"While the humble truth waits outside","s":48.42,"e":52.42},{"t":"In the churches of men","s":55.14,"e":58.02},{"t":"The towers sway","s":58.64,"e":60.7},{"t":"They call to heaven","s":61.26,"e":63.66},{"t":"But fade away","s":63.66,"e":66.02},{"t":"Paper saints in stained disguise","s":66.78,"e":69.0},{"t":"Lose their soul beneath the lies","s":69.58,"e":71.86},{"t":"In the churches of men","s":71.86,"e":74.36},{"t":"We break and bend","s":74.36,"e":75.92},{"t":"But love was meant to have no end","s":75.92,"e":80.06},{"t":"Empty prayers through iron skies","s":85.16,"e":89.46},{"t":"Faithful sail where mercy dies","s":90.06,"e":95.0},{"t":"A voice still calls beyond the noise","s":95.0,"e":100.38},{"t":"The shepherd cries","s":100.98,"e":102.5},{"t":"Hear my voice","s":103.14,"e":105.58},{"t":"The stones will crack","s":106.34,"e":108.68},{"t":"The veils will tear","s":108.68,"e":111.26},{"t":"The truth returns","s":111.26,"e":113.58},{"t":"To clear the air","s":114.68,"e":116.78},{"t":"No crown to seat","s":117.68,"e":119.54},{"t":"No temple flame","s":119.54,"e":121.98},{"t":"Just love that burns","s":122.68,"e":124.62},{"t":"Without a name","s":125.68,"e":127.74},{"t":"In the churches of men","s":129.68,"e":131.68},{"t":"The towers sway","s":132.68,"e":134.34},{"t":"They call to heaven","s":134.34,"e":137.36},{"t":"Heaven would fade away","s":137.36,"e":139.72},{"t":"Paid for saints in stained disguise","s":140.44,"e":142.7},{"t":"Lose the soul beneath the lies","s":142.7,"e":145.54},{"t":"In the churches of men","s":145.54,"e":148.02},{"t":"We break and bend","s":148.02,"e":149.6},{"t":"But love was meant to have no way","s":149.6,"e":153.54},{"t":"Life falls to broken glass","s":164.1,"e":166.58},{"t":"Revealing all we tried to mask","s":166.58,"e":169.32},{"t":"The walls collapse, the voices fade","s":169.32,"e":172.04},{"t":"Only truth remains unafraid","s":172.04,"e":174.94},{"t":"No preacher stands, no choir sings","s":174.94,"e":178.12},{"t":"Just freedom beating","s":179.6,"e":182.62},{"t":"And broken wings","s":182.62,"e":185.32},{"t":"In the churches of men","s":187.06,"e":188.94},{"t":"The towers fall","s":189.54,"e":191.6},{"t":"But through the ruin","s":192.16,"e":194.66},{"t":"You still call","s":194.66,"e":197.18},{"t":"No gold, no name, no crowns remain","s":198.84,"e":201.96},{"t":"Only love beyond the pain","s":201.96,"e":204.84},{"t":"In the ashes we begin again","s":204.84,"e":207.44},{"t":"Far from the church's heart","s":207.44,"e":210.58},{"t":"Oh, oh, oh, oh, oh","s":210.58,"e":232.38}],"match":null}
