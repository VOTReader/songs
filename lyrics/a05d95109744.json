{"v":1,"id":"a05d95109744","synced":true,"offset":0,"source":"suno","lines":[{"t":"I came to you with servant hands,","s":9.76,"e":15.45},{"t":"no sword upon My side.","s":15.56,"e":21.13},{"t":"I wore the weight you couldn’t lift,","s":21.25,"e":26.08},{"t":"I let My innocence be tried.","s":26.2,"e":32.3},{"t":"A thorny crown left these marks...","s":32.42,"e":38.18},{"t":"They pierced hand and feet.","s":38.24,"e":43.5},{"t":"This was not weakness, child...","s":43.56,"e":48.94},{"t":"I gave all for My sheep.","s":49.02,"e":54.87},{"t":"Do not mistake the quiet","s":54.89,"e":60.11},{"t":"for a heart that does not burn.","s":60.16,"e":66.27},{"t":"Mercy called in gentle whispers","s":66.36,"e":71.04},{"t":"so the world could finally learn.","s":71.16,"e":77.86},{"t":"I am the same One.","s":77.88,"e":82.26},{"t":"That banked wrath into a cup.","s":82.31,"e":87.46},{"t":"The hand that healed and holds you","s":87.52,"e":92.66},{"t":"will pour wrath out when time is up.","s":92.74,"e":99.16},{"t":"I can not shift My nature","s":99.28,"e":104.31},{"t":"My eyes burn with Holy flame.","s":104.43,"e":110.97},{"t":"I am the same One.","s":111.09,"e":115.44},{"t":"I will always remain.","s":115.56,"e":121.29},{"t":"I did not come confused or late,","s":121.32,"e":126.89},{"t":"nor unaware of men.","s":126.97,"e":132.44},{"t":"I knew the cost of waiting long,","s":132.56,"e":138.02},{"t":"I knew what terries then.","s":138.14,"e":143.47},{"t":"The Lamb who stood before you","s":143.53,"e":148.91},{"t":"was never blind to wrong…","s":149.02,"e":154.54},{"t":"I chose to bear it silently","s":154.66,"e":159.52},{"t":"until the time was gone.","s":159.6,"e":161.53},{"t":"Compassion held the hour,","s":161.53,"e":171.31},{"t":"patience stayed My hand…","s":171.38,"e":176.42},{"t":"But justice was not sleeping,","s":176.48,"e":181.64},{"t":"only waiting to stand.","s":181.74,"e":188.13},{"t":"I am the same One.","s":188.15,"e":192.46},{"t":"That banked wrath into a cup.","s":192.52,"e":197.72},{"t":"The One that heals and holds you","s":197.78,"e":202.85},{"t":"will pour out wrath when time is up.","s":202.91,"e":209.27},{"t":"I can not shift My nature","s":209.39,"e":214.34},{"t":"My eyes burn with Holy flame.","s":214.46,"e":220.92},{"t":"I am the same One.","s":221.04,"e":225.47},{"t":"I will always remain.","s":225.59,"e":232.09},{"t":"To show love by suffering,","s":232.11,"e":236.48},{"t":"I chose the longest road.","s":236.6,"e":242.98},{"t":"To heal wounds by waiting,","s":243.06,"e":247.33},{"t":"I carried every load.","s":247.45,"e":252.62},{"t":"But a love without passion","s":252.68,"e":257.9},{"t":"will not rise and guard the pure…","s":257.98,"e":263.41},{"t":"So My justice carried out,","s":263.49,"e":268.51},{"t":"is evil's final cure","s":268.59,"e":275.31},{"t":"I am the same One.","s":275.33,"e":279.75},{"t":"That banked wrath into a cup.","s":279.81,"e":284.97},{"t":"The One that heals and holds you","s":284.99,"e":290.22},{"t":"will pour out wrath when time is up.","s":290.29,"e":296.39},{"t":"Do not fear the hour coming..","s":296.49,"e":301.81},{"t":"Dread mistaking Who I AM","s":301.9,"e":308.17},{"t":"I am the same One, child.","s":308.33,"e":313.07},{"t":"I always have been.","s":313.19,"e":319.51},{"t":"Stay close.","s":319.55,"e":323.53},{"t":"I will help you see...","s":323.65,"e":329.6},{"t":"To understand what comes,","s":329.7,"e":334.18},{"t":"Seek to know Me.","s":334.26,"e":335.69}],"match":null}
