{"v":1,"id":"53078544cdc7","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Oh, oh, oh, oh","s":0.58,"e":3.46},{"t":"Hey, hey, hey","s":7.42,"e":9.72},{"t":"Oh golly","s":9.72,"e":10.86},{"t":"Woo, woo, woo","s":10.86,"e":13.52},{"t":"Oh golly, jingle jolly","s":13.52,"e":15.92},{"t":"The lights are burning bright","s":15.92,"e":17.66},{"t":"Crowd chase the glitter","s":17.66,"e":20.22},{"t":"Hearts lost in the night","s":20.22,"e":22.76},{"t":"They dress up the trees","s":22.76,"e":24.26},{"t":"And call it divine","s":24.78,"e":26.64},{"t":"But truth stands outside","s":26.64,"e":30.4},{"t":"Calling out through time","s":30.92,"e":32.9},{"t":"Break away from the shimmering town","s":33.46,"e":36.54},{"t":"The Lord is not found","s":37.08,"e":39.1},{"t":"Where the idols abound","s":39.64,"e":42.1},{"t":"Listen all people","s":43.14,"e":44.74},{"t":"His warning is clear","s":44.74,"e":46.78},{"t":"Your hearts must awaken","s":47.52,"e":49.32},{"t":"For judgment draws near","s":49.88,"e":52.04},{"t":"They honor the feast","s":53.4,"e":55.34},{"t":"But forget his name","s":55.34,"e":56.52},{"t":"Wrap gifts for each other while the humble remain","s":56.52,"e":59.0},{"t":"The carols are hollow, their cheer a disguise","s":59.0,"e":61.72},{"t":"But truth was traded for comfort in life","s":61.72,"e":64.4},{"t":"Break away from the shimmering sound","s":66.14,"e":69.74},{"t":"The Lord is not found","s":70.24,"e":72.46},{"t":"Where the idols abound","s":72.46,"e":75.04},{"t":"Listen all people, his warning is clear","s":76.4,"e":79.96},{"t":"Your hearts must awaken","s":80.52,"e":82.52},{"t":"Waking, but judgment draws near","s":82.52,"e":85.2},{"t":"The world celebrates what God despises","s":86.62,"e":90.12},{"t":"Turning His truth into man-made prizes","s":90.12,"e":92.62},{"t":"He calls through the storm, He cries through the cold","s":92.62,"e":95.06},{"t":"Return to the shepherd, leave what's been sown","s":95.06,"e":97.82},{"t":"He's shimmering sound","s":101.32,"e":103.0},{"t":"Shimmering sound","s":104.6,"e":105.54},{"t":"Crying for joy in the aisles of hell","s":106.78,"e":110.66},{"t":"Oh golly, jingle jolly, come fall on your knees","s":111.96,"e":115.3},{"t":"Let truth be the candle that sets captives free","s":115.3,"e":118.94}],"match":null}
