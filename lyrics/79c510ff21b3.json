{"v":1,"id":"79c510ff21b3","synced":true,"offset":0,"source":"suno","lines":[{"t":"Our voice cries together...","s":6.86,"e":13.65},{"t":"Whether they hear","s":13.71,"e":19.07},{"t":"and hearts be saved..","s":19.18,"e":25.25},{"t":"or let them forbear,","s":25.31,"e":40.01},{"t":"Come stand with Me a moment,","s":40.03,"e":42.94},{"t":"close enough to feel My breath.","s":43.03,"e":45.72},{"t":"You stayed when others scattered,","s":45.8,"e":47.9},{"t":"unflinching at what comes next.","s":48.01,"e":50.88},{"t":"You shed all bitter ignorance,","s":50.94,"e":53.86},{"t":"you closed distance not your eyes.","s":53.94,"e":56.75},{"t":"You already merged our sorrows","s":56.85,"e":59.68},{"t":"from tears shed through the night.","s":59.76,"e":64.5},{"t":"I brought you beyond surprise.","s":64.51,"e":67.56},{"t":"beyond toil. Away from blame.","s":67.61,"e":69.04},{"t":"you're here because I love you...","s":69.06,"e":73.05},{"t":"and you feel the very same.","s":73.09,"e":81.26},{"t":"So blow the trumpet with Me.","s":81.28,"e":84.16},{"t":"with heartache ... in truth.","s":84.22,"e":86.7},{"t":"Sound the warning call of love,","s":86.76,"e":89.15},{"t":"as mercy's solemn proof.","s":89.26,"e":92.39},{"t":"Our voice cries together...","s":92.47,"e":95.67},{"t":"Whether they hear","s":95.73,"e":97.98},{"t":"and hearts be saved..","s":99.49,"e":100.97},{"t":"or let them forbear.","s":101.03,"e":112.31},{"t":"I sent My servants early,","s":112.33,"e":115.08},{"t":"My words, clear and true.","s":115.19,"e":117.74},{"t":"Through lives hearers overlooked,","s":117.79,"e":119.8},{"t":"Deaf ears forsake good news.","s":119.82,"e":122.77},{"t":"You watched them twist My mercy,","s":122.83,"e":125.64},{"t":"truth trampled, set aside...","s":125.69,"e":128.3},{"t":"You felt how longer waiting","s":128.35,"e":131.49},{"t":"lets the innocent die.","s":131.54,"e":136.46},{"t":"You know this isn’t sudden,","s":136.47,"e":139.09},{"t":"nor fury breaking free.","s":139.19,"e":141.72},{"t":"Let's break the silence...","s":141.74,"e":144.3},{"t":"Let Me shatter their cruelty.","s":144.34,"e":152.35},{"t":"So blow the trumpet with Me.","s":152.37,"e":155.03},{"t":"Let compassion lead the sound.","s":155.11,"e":157.48},{"t":"The final plea to turn back home,","s":157.54,"e":160.34},{"t":"before the lost are bound.","s":160.38,"e":163.4},{"t":"Our voice cries together...","s":163.48,"e":166.6},{"t":"Whether they hear","s":166.66,"e":170.03},{"t":"and hearts be saved..","s":170.15,"e":171.82},{"t":"or let them forbear.","s":171.88,"e":183.23},{"t":"I take no pleasure in the ending","s":183.25,"e":186.22},{"t":"of those who won't choose life.","s":186.34,"e":188.42},{"t":"I waited until love was tested,","s":188.54,"e":191.08},{"t":"beyond what patience could strive.","s":191.15,"e":194.36},{"t":"But mercy without repentance","s":194.44,"e":196.52},{"t":"shelters the oppressor's sword...","s":196.6,"e":199.33},{"t":"I will not betray the helpless","s":199.39,"e":201.86},{"t":"by delaying justice any more.","s":201.98,"e":211.47},{"t":"Stay locked in with Me.","s":211.49,"e":213.93},{"t":"You’ll never stand apart.","s":213.95,"e":216.19},{"t":"This warning rises from grief","s":216.24,"e":218.78},{"t":"that long has broke our heart.","s":218.84,"e":222.05},{"t":"Our voice cries together...","s":222.13,"e":225.22},{"t":"Whether they hear","s":225.27,"e":228.51},{"t":"And they join the trumpet.","s":228.59,"e":230.13},{"t":"or let them forbear","s":230.24,"e":235.57},{"t":"You can not fail.","s":235.6,"e":240.88},{"t":"You can not fall.","s":240.96,"e":245.78},{"t":"A trumpet sounded clear.","s":245.9,"e":248.4},{"t":"Is love giving all.","s":248.51,"e":256.39},{"t":"Warn them from Me, beloved.","s":256.4,"e":261.85},{"t":"Warn them from Me.","s":261.88,"e":263.54}],"match":null}
