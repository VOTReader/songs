{"v":1,"id":"f2462b56d87e","synced":true,"offset":0,"source":"suno","lines":[{"t":"All you who carry My name…","s":11.57,"e":12.85},{"t":"Listen closely.","s":17.95,"e":21.59},{"t":"Take these words to heart.","s":21.64,"e":26.91},{"t":"Do you really love Me?","s":26.94,"e":33.52},{"t":"Follow Me…","s":33.61,"e":39.91},{"t":"Follow Me…","s":40.0,"e":48.7},{"t":"You wear My name upon your sleeve,","s":48.72,"e":55.03},{"t":"But will you walk the road with Me?","s":55.09,"e":57.71},{"t":"Beyond the words, beyond the song,","s":57.82,"e":63.62},{"t":"Will you still follow?","s":63.65,"e":64.2},{"t":"Will you still follow?","s":64.31,"e":68.3},{"t":"Even if the road gets long?","s":68.34,"e":72.25},{"t":"I know your heart, I hear your prayer,","s":72.37,"e":75.4},{"t":"I see the burdens that you bear.","s":75.48,"e":78.55},{"t":"Beloved, you don’t have to hide—","s":78.59,"e":81.73},{"t":"Just take My hand and leave your pride.","s":81.77,"e":84.77},{"t":"Not just your lips—","s":84.79,"e":86.33},{"t":"Give Me your heart.","s":86.41,"e":88.01},{"t":"Not just one day—","s":88.09,"e":89.6},{"t":"Right where you are.","s":89.66,"e":91.15},{"t":"When I call your name,","s":91.18,"e":94.28},{"t":"Will you turn My way?","s":94.32,"e":97.86},{"t":"If you love Me, love Me—","s":97.87,"e":101.1},{"t":"Follow Me!","s":101.19,"e":104.18},{"t":"Let your life say what your lips believe.","s":104.24,"e":110.58},{"t":"If you love Me, love Me—","s":110.67,"e":113.71},{"t":"Follow Me!","s":113.8,"e":116.86},{"t":"Hear My voice above the noise,","s":116.9,"e":120.05},{"t":"Take My hand and make your choice.","s":120.1,"e":123.17},{"t":"Step by step!","s":123.23,"e":124.69},{"t":"Walk with Me!","s":124.76,"e":126.28},{"t":"Heart and soul!","s":126.33,"e":127.93},{"t":"Come follow Me!","s":128.03,"e":131.16},{"t":"Follow Me….","s":131.19,"e":132.87},{"t":"Follow Me…","s":132.96,"e":134.31},{"t":"More than words—let your love be seen.","s":134.35,"e":142.19},{"t":"Follow Me…","s":142.28,"e":145.38},{"t":"Follow Me….","s":145.48,"e":147.33},{"t":"If you love Me, love Me—","s":147.39,"e":148.94},{"t":"Follow Me.","s":149.0,"e":150.27},{"t":"When someone’s hungry, make them room.","s":150.28,"e":153.46},{"t":"When hope is fading, help it bloom.","s":153.49,"e":156.8},{"t":"Forgive the one who caused you pain;","s":156.82,"e":159.22},{"t":"Don’t let your anger hold the reins.","s":159.26,"e":161.83},{"t":"Don’t pass the wounded on the street,","s":161.85,"e":164.44},{"t":"Then sing of how you walk with Me.","s":164.52,"e":169.13},{"t":"The love you give when no one sees—","s":169.19,"e":171.9},{"t":"Beloved, that is love for Me.","s":171.94,"e":173.79},{"t":"Not just your lips—","s":173.79,"e":174.89},{"t":"Give Me your heart.","s":174.97,"e":176.51},{"t":"Not just one day—","s":176.61,"e":177.99},{"t":"Right where you are.","s":178.06,"e":179.63},{"t":"When I call your name,","s":179.66,"e":182.74},{"t":"Will you turn My way?","s":182.78,"e":186.33},{"t":"If you love Me, love Me—","s":186.34,"e":189.51},{"t":"Follow Me…","s":189.6,"e":191.1},{"t":"Follow Me…","s":191.19,"e":192.51},{"t":"Let your life say what your lips believe.","s":192.57,"e":198.83},{"t":"If you love Me, love Me—","s":198.91,"e":201.95},{"t":"Follow Me…","s":202.04,"e":203.85},{"t":"Follow Me…","s":203.91,"e":205.02},{"t":"Hear My voice above the noise,","s":205.07,"e":208.13},{"t":"Take My hand and make your choice.","s":208.18,"e":211.3},{"t":"Step by step!","s":211.36,"e":212.79},{"t":"Walk with Me!","s":212.87,"e":214.43},{"t":"Heart and soul!","s":214.47,"e":215.63},{"t":"Come follow Me!","s":215.68,"e":217.67},{"t":"Follow Me…","s":217.71,"e":220.78},{"t":"Follow Me…","s":220.87,"e":222.25},{"t":"More than words—let your love be seen.","s":222.3,"e":230.12},{"t":"Follow Me…","s":230.21,"e":233.23},{"t":"Follow Me…","s":233.32,"e":244.31},{"t":"Take these words to heart…","s":244.35,"e":248.06},{"t":"And follow Me.","s":248.14,"e":250.37}],"match":null}
