{"v":1,"id":"393b79271136","synced":true,"offset":0,"source":"suno","lines":[{"t":"The darkness rushes at me,","s":17.55,"e":20.62},{"t":"I feel it clawing at my chest.","s":20.74,"e":23.54},{"t":"My heartbeat’s getting violent,","s":23.62,"e":26.71},{"t":"Like it’s fighting to resist.","s":26.78,"e":29.28},{"t":"Your fire cracks the shadows,","s":29.36,"e":32.47},{"t":"Burns the fear I’ve let inside—","s":32.55,"e":35.15},{"t":"I hear You in the chaos,","s":35.27,"e":39.03},{"t":"Calling me to rise.","s":39.12,"e":41.34},{"t":"I was drowning, suffocating,","s":41.34,"e":44.94},{"t":"Lost beneath the weight of sin—","s":45.03,"e":46.62},{"t":"But Your mercy split the silence,","s":46.64,"e":50.7},{"t":"Dragged me back again.","s":50.74,"e":53.67},{"t":"Wake me again!","s":53.74,"e":55.44},{"t":"Wake me again!","s":55.5,"e":57.49},{"t":"Tear the chains from my soul where the darkness has been!","s":57.54,"e":61.16},{"t":"When the lies start to break me and fear closes in—","s":61.21,"e":64.79},{"t":"Yahushua, You crash through the madness,","s":64.87,"e":67.76},{"t":"You shatter the night I’ve been trapped in!","s":67.86,"e":72.91},{"t":"Wake me again!","s":72.97,"e":78.35},{"t":"Wake me again!","s":78.43,"e":84.54},{"t":"⸻","s":79.88,"e":84.54},{"t":"I feel the war inside me,","s":84.55,"e":88.14},{"t":"Every scar You’ve seen before.","s":88.19,"e":90.28},{"t":"I’m running from the shadows,","s":90.32,"e":93.61},{"t":"But they’re screaming at my door.","s":93.71,"e":96.45},{"t":"Still Your voice cuts like thunder,","s":96.52,"e":99.49},{"t":"Breaking through my unbelief—","s":99.56,"e":102.39},{"t":"So I lift my shaking hands now,","s":102.5,"e":105.24},{"t":"Let Your power make me free.","s":105.32,"e":107.32},{"t":"I was drowning, suffocating,","s":107.33,"e":111.77},{"t":"Till Your light came crashing in—","s":111.83,"e":114.45},{"t":"Every breath became a weapon,","s":114.49,"e":117.3},{"t":"Every heartbeat born again.","s":117.39,"e":122.42},{"t":"Wake me again!","s":122.47,"e":124.44},{"t":"Tear the chains from my soul where the darkness has been!","s":124.48,"e":128.09},{"t":"When the lies start to break me and fear closes in—","s":128.12,"e":131.7},{"t":"Yahushua, You crash through the madness,","s":131.76,"e":134.7},{"t":"You shatter the night I’ve been trapped in!","s":134.8,"e":139.85},{"t":"Wake me again!","s":139.91,"e":145.31},{"t":"Wake me again!","s":145.4,"e":151.14},{"t":"⸻","s":146.74,"e":151.14},{"t":"[Bridge – Screamed]","s":146.74,"e":151.48},{"t":"( Screams: )","s":151.3,"e":158.54},{"t":"Break me open—","s":158.62,"e":160.82},{"t":"Tear the shadows from my veins!","s":160.87,"e":164.22},{"t":"Light the fire—","s":164.31,"e":166.56},{"t":"Burn the fear, destroy the shame!","s":166.61,"e":170.05},{"t":"Rip the walls down—","s":170.15,"e":172.46},{"t":"Let Your glory flood within!","s":172.5,"e":175.79},{"t":"Yahushua—","s":175.89,"e":180.54},{"t":"Wake me again!","s":180.61,"e":186.32},{"t":"⸻","s":181.61,"e":186.32},{"t":"Wake me again!","s":186.33,"e":188.44},{"t":"Rip the chains from my soul where the darkness has been!","s":188.5,"e":192.08},{"t":"When the lies try to crush me and drag me to sin—","s":192.11,"e":195.68},{"t":"Yahushua, You roar through the ruin,","s":195.72,"e":197.91},{"t":"You reign in the storm I’ve been drowning in!","s":197.95,"e":203.84},{"t":"Wake me again…","s":203.9,"e":209.3},{"t":"Wake me again!","s":209.39,"e":215.12},{"t":"Wake me again!","s":215.22,"e":217.18}],"match":null}
