{"v":1,"id":"baafe92d3783","synced":true,"offset":0,"source":"suno","lines":[{"t":"When the night is deep and silent,","s":0.48,"e":4.15},{"t":"And the heart feels worn and torn,","s":4.23,"e":8.04},{"t":"Your whisper breaks the darkness,","s":8.11,"e":11.15},{"t":"Calling the lost and the forlorn.","s":11.21,"e":14.42},{"t":"You gather every broken soul,","s":14.48,"e":18.09},{"t":"And bind their wounds with grace,","s":18.15,"e":21.75},{"t":"Your mercy flows like rivers,","s":21.8,"e":26.37},{"t":"A light we can’t replace.","s":26.49,"e":32.03},{"t":"Oh Lord, Your love is endless,","s":32.05,"e":35.55},{"t":"A fire that never fades,","s":35.66,"e":39.1},{"t":"You reach through storms and shadows,","s":39.18,"e":42.85},{"t":"And lift the hearts You’ve made.","s":42.93,"e":46.55},{"t":"Your truth is our foundation,","s":46.58,"e":50.23},{"t":"Your hands our resting place,","s":50.28,"e":54.35},{"t":"Forever we will praise You,","s":54.43,"e":57.67},{"t":"For love that never fails.","s":57.73,"e":62.98},{"t":"Your voice thunders through the heavens,","s":63.0,"e":65.27},{"t":"Yet gentle as the rain,","s":65.35,"e":66.96},{"t":"You call us into freedom,","s":67.06,"e":68.92},{"t":"You heal our deepest pain.","s":68.98,"e":70.65},{"t":"The earth and all creation,","s":70.69,"e":72.61},{"t":"Bow down before Your throne,","s":72.69,"e":74.3},{"t":"For every heart that calls You,","s":74.4,"e":76.26},{"t":"Will never stand alone.","s":76.32,"e":78.13},{"t":"You are the Lamb, the Lion,","s":78.15,"e":80.47},{"t":"The Breath that calls us home,","s":80.51,"e":84.97},{"t":"In Your light we see forever,","s":85.05,"e":88.43},{"t":"We are Yours, we are not our own.","s":88.54,"e":109.49},{"t":"Oh Lord, Your love is endless,","s":109.51,"e":111.98},{"t":"A fire that never fades,","s":112.02,"e":116.73},{"t":"You reach through storms and shadows,","s":116.81,"e":120.4},{"t":"And lift the hearts You’ve made.","s":120.48,"e":124.05},{"t":"Your truth is our salvation,","s":124.12,"