{"v":1,"id":"0612c6b3e861","synced":false,"offset":null,"source":"whisper","lines":[{"t":"Thank you for watching!","s":11.9,"e":29.98},{"t":"A place beyond space and time","s":47.36,"e":53.66},{"t":"Where eternity dwells","s":54.22,"e":57.22},{"t":"And life has no end","s":57.22,"e":60.02},{"t":"Where life takes its form","s":60.02,"e":63.08},{"t":"And goodness is revealed","s":63.08,"e":66.22},{"t":"Where the eyes of the redeemed","s":66.22,"e":69.3},{"t":"May look upon the glory of God","s":69.3,"e":72.0},{"t":"And see His face","s":72.0,"e":73.3},{"t":"Where heaven meets the earth","s":74.56,"e":77.16},{"t":"And the eternal dwells with men","s":77.16,"e":81.64},{"t":"A place where everlasting love","s":85.1,"e":89.42},{"t":"Can be embraced and healing flows like a gentle stream","s":90.06,"e":95.62},{"t":"A place where time has no meaning","s":95.62,"e":102.0},{"t":"And the stars flee away","s":103.56,"e":106.5},{"t":"Where the brightness is excellent","s":109.7,"e":113.4},{"t":"And the warmth thereof very soothing","s":113.4,"e":119.44},{"t":"A place where joy comes by knowledge","s":147.32,"e":152.46},{"t":"With pure understanding","s":152.46,"e":154.94},{"t":"Where fulfillment comes by","s":155.6,"e":158.08},{"t":"A strong embrace","s":158.62,"e":160.8},{"t":"And love's completion","s":161.7,"e":164.12},{"t":"is met with great satisfaction","s":164.12,"e":168.16},{"t":"through many tears","s":168.16,"e":169.94},{"t":"flowing down the cheeks","s":171.4,"e":173.82},{"t":"of the forever young","s":174.4,"e":175.92},{"t":"a place where understanding","s":175.92,"e":178.52},{"t":"bursts forth in realization","s":178.52,"e":181.22},{"t":"revelation beyond words","s":181.82,"e":184.88},{"t":"a place where the hearts","s":188.3,"e":191.16},{"t":"of the chosen are revealed","s":191.16,"e":192.82},{"t":"They all, they're uncovered","s":195.22,"e":197.2},{"t":"Revealing their true form","s":198.3,"e":199.92},{"t":"The image in which I created them","s":201.8,"e":204.36},{"t":"Restored","s":205.82,"e":206.58},{"t":"A simple quiet place","s":206.58,"e":210.68},{"t":"Set apart","s":211.76,"e":212.78},{"t":"In the arms of the king","s":226.72,"e":228.58}],"match":null}
