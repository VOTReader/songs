{"v":1,"id":"25d1f0e356a4","synced":false,"offset":null,"source":"whisper","lines":[{"t":"I don't know what to do","s":0.0,"e":29.78},{"t":"I walk through the silence","s":30.0,"e":32.54},{"t":"Searching for a sign","s":33.9,"e":35.62},{"t":"A whisper in the darkness","s":35.62,"e":37.72},{"t":"A promise through time","s":37.72,"e":40.7},{"t":"Those shadows tried to steal","s":40.7,"e":43.28},{"t":"The light I knew","s":43.96,"e":45.74},{"t":"Every step brought me closer to the truth","s":45.74,"e":49.84},{"t":"Faith is the fire","s":49.84,"e":52.52},{"t":"That never dies","s":52.52,"e":55.06},{"t":"The voice that calls beyond the skies","s":55.06,"e":59.66},{"t":"Through every storm","s":60.58,"e":62.74},{"t":"Through doubt and fear","s":63.4,"e":65.24},{"t":"I feel your presence drawing near","s":66.92,"e":70.22},{"t":"Mountains tremble","s":81.52,"e":83.68},{"t":"Oceans rise and fall","s":85.04,"e":86.96},{"t":"Still I hear your love","s":86.96,"e":89.5},{"t":"Above it all the word is living","s":90.16,"e":93.92},{"t":"Breathing through my soul","s":95.24,"e":97.34},{"t":"Breaking these chains","s":97.34,"e":99.52},{"t":"Making me whole","s":100.18,"e":102.0},{"t":"Faith is the fire","s":102.0,"e":103.9},{"t":"That never dies","s":103.9,"e":106.58},{"t":"The voice that calls beyond the skies","s":108.1,"e":110.88},{"t":"Through every storm, through doubt and fear","s":110.88,"e":116.54},{"t":"I feel your presence drawing near","s":117.1,"e":121.48},{"t":"When the world grows dim and hope runs thin","s":143.3,"e":148.4},{"t":"Your truth ignites the light within","s":148.4,"e":153.32},{"t":"I'll walk by trust, not by my side","s":153.32,"e":158.96},{"t":"Guided home by your endless light","s":159.5,"e":163.8},{"t":"Faith is the fire that never dies","s":165.68,"e":170.84},{"t":"The voice that calls beyond the skies","s":172.2,"e":174.98},{"t":"Your word endures, your promise clear","s":175.92,"e":180.88},{"t":"Forever you're the one I'll hear","s":182.02,"e":185.64},{"t":"Yeah","s":185.64,"e":187.12},{"t":"Thanks for watching!","s":217.3,"e":219.66}],"match":null}
