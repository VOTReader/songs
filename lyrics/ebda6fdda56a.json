{"v":1,"id":"ebda6fdda56a","synced":true,"offset":0,"source":"suno","lines":[{"t":"Where will you be","s":26.49,"e":30.32},{"t":"On that day?","s":30.44,"e":34.2},{"t":"Well as for me","s":34.24,"e":37.58},{"t":"I'm shameless to say","s":37.66,"e":38.94},{"t":"I'll be waiting","s":39.02,"e":44.2},{"t":"I'll be waiting on that day","s":44.28,"e":57.18},{"t":"Of these 10 virgins","s":57.23,"e":61.68},{"t":"5 were wise","s":58.35,"e":65.03},{"t":"Others were sleeping","s":65.11,"e":66.46},{"t":"On through the night","s":66.54,"e":70.07},{"t":"But I'll be waiting","s":70.17,"e":75.08},{"t":"I'll be waiting for My King","s":75.16,"e":87.47},{"t":"Be on the alert now","s":87.58,"e":90.56},{"t":"For you know not the hour or the day","s":90.67,"e":111.36},{"t":"The Lord has spoken","s":111.42,"e":115.13},{"t":"The Time is Here","s":115.21,"e":119.2},{"t":"Are you listening?","s":119.31,"e":122.82},{"t":"Or plugging your ears?","s":122.93,"e":125.15},{"t":"I'll be waiting","s":125.19,"e":129.29},{"t":"I'll be waiting on that day","s":129.34,"e":141.65},{"t":"Be on the alert then","s":141.76,"e":144.73},{"t":"For you know not the hour or the day","s":144.84,"e":189.28},{"t":"Can't you feel it?","s":189.29,"e":193.03},{"t":"Or see the signs?","s":193.14,"e":197.33},{"t":"Are you watching?","s":197.43,"e":200.9},{"t":"Or closing your eyes?","s":200.98,"e":203.5},{"t":"I'll be waiting","s":203.54,"e":207.41},{"t":"I'll be waiting to sing","s":207.45,"e":219.76},{"t":"(instrumental)","s":211.93,"e":220.51},{"t":"Be on the alert then","s":220.56,"e":222.93},{"t":"For you know not the hour or the day","s":223.03,"e":227.95}],"match":null}
